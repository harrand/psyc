== build ==
{
	$add_source_directory_recursive("src");
	$output_name("psyc_out");
};

== debug ==
{
	$debug_symbols(true);
	$set_optimization(0);
	build();
};

== release ==
{
	$debug_symbols(false);
	$set_optimization(3);
	build();
};

== default ==
{
	debug();
};

$bare $entrypoint
psyc_main : func(-> v0)
{
	collect_args_linux(ref argc, ref argv, ref envp);

	setup_arenas();
	lex_init();
	grammar_setup();

	parse_args();
	compile();

	teardown_arenas();
	linux_exit(0);
};

argc : s64 mut;
argv : u8?? mut;
envp : u8?? mut;

collect_args_linux : asm(_ : u64 weak, _ : u64 weak, _ : u64 weak ->)
{
	mov $0, QWORD PTR [rsp]
	lea rax, QWORD PTR [rsp + 8]
	mov $1, rax
	lea rax, QWORD PTR [rsp + 16]
	mov rbx, $0
	shl rbx, imm8 3
	add rax, rbx
	mov $2, rax
};

global_arena_value : arena mut;
global_arena : arena mut? mut;
scratch_arena_value : arena mut;
scratch_arena : arena mut? mut;

setup_arenas : func(-> v0)
{
	global_arena = ref global_arena_value;
	arena_create_virtual(8000000000, 4096 * 1024, global_arena);
	global_arena->aalign = 16;
	scratch_arena = ref scratch_arena_value;
	arena_create_virtual(8000000000, 4096 * 1024, scratch_arena);
	scratch_arena->aalign = 16;
};

teardown_arenas : func(-> v0)
{
	arena_destroy(global_arena);
	arena_destroy(scratch_arena);
};

dump_timings : func(-> v0)
{
	putzstr("tokenisation:  \0");
	putuint(compile_timings.tokenise / 1000000);
	putzstr(" ms\nparse tokens:  \0");
	putuint(compile_timings.parse / 1000000);
	putzstr(" ms\nbuild regions: \0");
	if(compile_timings.build_regions_plus_tokenise_and_parse < (compile_timings.tokenise + compile_timings.parse))
	{
		putuint(0);
	}
	else
	{
		putuint(((compile_timings.build_regions_plus_tokenise_and_parse - (compile_timings.tokenise + compile_timings.parse))) / 1000000);
	}
	putzstr(" ms\ntype-checking: \0");
	putuint(compile_timings.pre_codegen / 1000000);
	putzstr(" ms\ngenerate ir:   \0");
	putuint(compile_timings.codegen / 1000000);
	putzstr(" ms\0");
	if(args_should_skip_ir())
	{
		colour_red();
		putzstr(" (skipped)\0");
		colour_reset();
	}
	putzstr("\noptimise ir:   \0");
	putuint(compile_timings.optimise_ir / 1000000);
	putzstr(" ms\0");
	if(prog.opt@s64 <= program_optimisation.O0@s64)
	{
		colour_red();
		putzstr(" (skipped)\0");
		colour_reset();
	}
	putzstr("\nlower to asm:  \0");
	putuint(compile_timings.assembly / 1000000);
	putzstr(" ms\0");
	if(args_should_skip_asm())
	{
		colour_red();
		putzstr(" (skipped)\0");
		colour_reset();
	}
	else
	{
		putzstr("\n\tinstruction-generation:  \0");
		putuint(compile_timings.assembly_generation / 1000000);
		putzstr(" ms\0");

		putzstr("\n\tliveness-analysis:  \0");
		putuint(compile_timings.assembly_liveness_analysis / 1000000);
		putzstr(" ms\0");

		putzstr("\n\tregister-allocation:  \0");
		putuint(compile_timings.assembly_register_allocation / 1000000);
		putzstr(" ms\0");

		putzstr("\n\tlegalisation:  \0");
		putuint(compile_timings.assembly_legalisation / 1000000);
		putzstr(" ms\0");
	}
	putzstr("\noptimise asm:  \0");
	putuint(compile_timings.optimise_asm / 1000000);
	putzstr(" ms\0");
	if(prog.opt@s64 <= program_optimisation.O0@s64)
	{
		colour_red();
		putzstr(" (skipped)\0");
		colour_reset();
	}
	putzstr("\nwrite \0");
	putchars(prog.output_dir.data, prog.output_dir.len);
	putchar('/');
	putchars(prog.output_name.data, prog.output_name.len);
	putzstr(": \0");
	putuint(compile_timings.object_write / 1000000);
	putzstr(" ms\0");
	if(args_should_skip_object_write())
	{
		colour_red();
		putzstr(" (skipped)\0");
		colour_reset();
	}
	putzstr("\n\t=> \0");
	putuint(((compile_timings.build_regions_plus_tokenise_and_parse) + (compile_timings.pre_codegen) + (compile_timings.codegen) + (compile_timings.optimise_ir) + (compile_timings.assembly) + (compile_timings.optimise_asm) + (compile_timings.object_write)) / 1000000);
	putzstr(" ms (\0");
	putuint(global_arena->cur / 1024);
	putzstr(" KiB global, \0");
	putuint(scratch_arena->cur / 1024);
	putzstr(" KiB scratch)\n\0");
};


scratch_reset : func(-> v0)
{
	arena_clear(scratch_arena);
};

