== default ==
{
	add_source_file("src/compile.psy");
	add_source_file("src/prog.psy");
	add_source_file("src/scope.psy");
	add_source_file("src/val.psy");
	add_source_directory("src/common");
	add_source_directory("src/frontend");
	add_source_directory("src/backend/ir");
	add_source_directory("src/backend/x64");
	add_source_directory("src/backend/elf");
	add_source_directory("src/backend/abi");
	entrypoint("_start");

	//prebuild_command("echo prebuild command test");
	//prebuild_command("sleep 1");
};

global_arena_value : arena mut;
global_arena : arena mut? mut;
scratch_arena_value : arena mut;
scratch_arena : arena mut? mut;

setup_arenas : func(-> v0)
{
	global_arena = ref global_arena_value;
	arena_create_virtual(8000000000, 4096 * 1024, global_arena);
	global_arena->aalign = 16;
	scratch_arena = ref scratch_arena_value;
	arena_create_virtual(8000000000, 4096 * 1024, scratch_arena);
	scratch_arena->aalign = 16;
};

teardown_arenas : func(-> v0)
{
	arena_destroy(global_arena);
	arena_destroy(scratch_arena);
};

dump_timings : func(-> v0)
{
	putzstr("tokenisation:  \0");
	putuint(compile_timings.tokenise / 1000000);
	putzstr(" ms\nparse tokens:  \0");
	putuint(compile_timings.parse / 1000000);
	putzstr(" ms\nbuild regions: \0");
	if(compile_timings.build_regions_plus_tokenise_and_parse < (compile_timings.tokenise + compile_timings.parse))
	{
		putuint(0);
	}
	else
	{
		putuint(((compile_timings.build_regions_plus_tokenise_and_parse - (compile_timings.tokenise + compile_timings.parse))) / 1000000);
	}
	putzstr(" ms\ntype-checking: \0");
	putuint(compile_timings.pre_codegen / 1000000);
	putzstr(" ms\ngenerate ir:   \0");
	putuint(compile_timings.codegen / 1000000);
	putzstr(" ms\noptimise ir:   \0");
	putuint(compile_timings.optimise_ir / 1000000);
	putzstr(" ms\nlower to asm:  \0");
	putuint(compile_timings.assembly / 1000000);
	putzstr(" ms\noptimise asm:  \0");
	putuint(compile_timings.optimise_asm / 1000000);
	putzstr(" ms\nwrite \0");
	putchars(prog.output.data, prog.output.len);
	putzstr(": \0");
	putuint(compile_timings.object_write / 1000000);
	putzstr(" ms\n\t=> \0");
	putuint(((compile_timings.build_regions_plus_tokenise_and_parse) + (compile_timings.pre_codegen) + (compile_timings.codegen) + (compile_timings.optimise_ir) + (compile_timings.assembly) + (compile_timings.optimise_asm) + (compile_timings.object_write)) / 1000000);
	putzstr(" ms (\0");
	putuint(global_arena->cur / 1024);
	putzstr(" KiB global, \0");
	putuint(scratch_arena->cur / 1024);
	putzstr(" KiB scratch)\n\0");
};


scratch_reset : func(-> v0)
{
	arena_clear(scratch_arena);
};

pargc : s64? mut;
pargv : u8??? mut;
argc : s64 mut;
argv : u8?? mut;
__start : asm("{rax},{rcx}" -> v0)
{
	mov r8, rsp
	add r8, 8
	mov $0, r8
	add r8, 8
	mov $1, r8
};

_start : func(-> v0)
{
	__start(ref(pargc), ref(argv));
	argc = [pargc];

	linux_exit(main());
	unreachable;
};

main : func(-> s32)
{
	setup_arenas();

	lex_init();
	grammar_setup();
	parse_args();

	compile();

	teardown_arenas();
	return 0;
};
