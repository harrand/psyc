source_context : struct
{
	src : source;
	node : ast mut?;
	parent_fn : function_t mut?;
	type_only : bool;
};

program_optimisation : enum
{
	.O0 := 0;
	.O1 := 1;
	.O2 := 2;
	.O3 := 3;
};

source_file : struct
{
	node : ast;
	src : u8?;
	src_len : u64;
	path : path;
};

source : enum
{
	.invalid := ~0;
};

postbuild_command_t : struct
{
	cmd : u8?;
	rel : file;
};

prog_t : struct
{
	stack_size : u64;
	debug_symbols : bool;
	opt : program_optimisation;
	output_dir : sstr;
	output_name : sstr;
	entrypoint : sstr;

	source_files : source_file mut?;
	source_files_count : u64;
	source_files_cap : u64;

	global_scope : scope_t;
	postbuild_commands : postbuild_command_t mut?;
	postbuild_commands_count : u64;
	postbuild_commands_cap : u64;
};
// whole program state
prog ::= prog_t mut
{
	// defaults are all here :)
	.stack_size := 8000000;
	.debug_symbols := false;
	.opt := program_optimisation.O0;
	.output_dir := sstr{.data := "build"; .len := 5;};
	.output_name := sstr{.data := "psyout"; .len := 6;};
	.entrypoint := sstr{.data := zero; .len := zero;};
	.source_files := zero;
	.source_files_count := zero;
	.source_files_cap := zero;
	.global_scope := zero;
	.postbuild_commands := zero;
	.postbuild_commands_count := zero;
	.postbuild_commands_cap := zero;
};

prog_add_postbuild_command : func(cmd : postbuild_command_t mut? -> v0)
{
	if(prog.postbuild_commands == zero)
	{
		prog.postbuild_commands_cap = 8;
		prog.postbuild_commands = arena_alloc(global_arena, prog.postbuild_commands_cap * sizeof typeof([prog.postbuild_commands]));
	}
	while(prog.postbuild_commands_count >= prog.postbuild_commands_cap)
	{
		i : u64 mut;
		oldcap ::= prog.postbuild_commands_cap;
		olddata ::= prog.postbuild_commands;
		prog.postbuild_commands_cap = prog.postbuild_commands_cap * 2;
		prog.postbuild_commands = arena_alloc(global_arena, prog.postbuild_commands_cap * sizeof typeof([prog.postbuild_commands]));
		for(i = 0; i < oldcap; i = i + 1)
		{
			[prog.postbuild_commands # i] = [olddata # i];
		}
	}

	[prog.postbuild_commands # prog.postbuild_commands_count] = [cmd];
	prog.postbuild_commands_count = prog.postbuild_commands_count + 1;
};

prog_add_source_file : func(src : source_file? -> source)
{
	if(prog.source_files == zero)
	{
		prog.source_files_cap = 8;
		prog.source_files = arena_alloc(global_arena, prog.source_files_cap * sizeof source_file);
	}
	while(prog.source_files_count >= prog.source_files_cap)
	{
		i : u64 mut;
		oldcap ::= prog.source_files_cap;
		olddata ::= prog.source_files;
		prog.source_files_cap = prog.source_files_cap * 2;
		prog.source_files = arena_alloc(global_arena, prog.source_files_cap * sizeof source_file);
		for(i = 0; i < oldcap; i = i + 1)
		{
			[prog.source_files # i] = [olddata # i];
		}
	}

	[prog.source_files # prog.source_files_count] = [src];

	ret : source mut := prog.source_files_count@s64@source;
	prog.source_files_count = prog.source_files_count + 1;

	return ret;
};

prog_get_source : func(s : source -> source_file mut?)
{
	if(s == source.invalid)
	{
		panic_begin();
		putzstr("attempted to get an invalid source\0");
		panic_end();
	}
	return prog.source_files # (s@s64);
};

prog_find_global_variable : func(name : u8?, name_len : u64 -> variable_t mut?)
{
	return scope_find_variable(ref prog.global_scope, name, name_len);
};

prog_add_global_variable : func(var : variable_t mut? -> v0)
{
	scope_add_variable(ref prog.global_scope, var);
};

prog_find_function : func(name : u8?, name_len : u64 -> function_t mut?)
{
	return scope_find_function(ref prog.global_scope, name, name_len);
};

prog_add_function : func(fn : function_t mut? -> v0)
{
	scope_add_function(ref prog.global_scope, fn);
};

prog_find_assembly : func(name : u8?, name_len : u64 -> assembly_t mut?)
{
	return scope_find_assembly(ref prog.global_scope, name, name_len);
};

prog_add_assembly : func(fn : assembly_t mut? -> v0)
{
	scope_add_assembly(ref prog.global_scope, fn);
};

putsrc : func(s : source, begin : u64, end : u64, col : putcol -> v0)
{
	src ::= prog_get_source(s);
	line_begin : u64 mut := 0;
	line_begin_cursor : u64 mut := 0;

	i : u64 mut;
	for(i = 0; i < begin; i = i + 1)
	{
		if([src->src # i] == '\n')
		{
			line_begin = line_begin + 1;
			line_begin_cursor = i;
		}
	}

	line_end : u64 mut := 0;
	line_end_cursor : u64 mut := 0;
	
	for(i = begin; i < end; i = i + 1)
	{
		if([src->src # i] == '\n')
		{
			line_end = line_begin + 1;
		}
	}
	for(i = end; (i < src->src_len) && ([src->src # i] != '\n'); i = i + 1)
	{
	}
	line_end_cursor = i;

	// print the lines containing begin/end
	// but highlight the specific part
	colour_reset();

	putzstr(path2zstr(src->path));
	putchar('(');
	putuint(line_begin + 1);
	putchar(':');
	putuint(1 + begin - line_begin_cursor);
	putzstr("):\n\0");

	putchars(src->src # line_begin_cursor, begin - line_begin_cursor);
	put_setcol(col);
	putchars(src->src # begin, end - begin);
	colour_reset();
	putchars(src->src # end, line_end_cursor - end);
	putchar('\n');
};

putsrc_noquote : func(s : source, begin : u64, end : u64 -> v0)
{
	src ::= prog_get_source(s);
	line_begin : u64 mut := 0;
	line_begin_cursor : u64 mut := 0;

	i : u64 mut;
	for(i = 0; i < begin; i = i + 1)
	{
		if([src->src # i] == '\n')
		{
			line_begin = line_begin + 1;
			line_begin_cursor = i;
		}
	}

	line_end : u64 mut := 0;
	line_end_cursor : u64 mut := 0;
	
	for(i = begin; i < end; i = i + 1)
	{
		if([src->src # i] == '\n')
		{
			line_end = line_begin + 1;
		}
	}
	for(i = end; (i < src->src_len) && ([src->src # i] != '\n'); i = i + 1)
	{
	}
	line_end_cursor = i;

	colour_reset();

	putzstr(path2zstr(src->path));
	putchar('(');
	putuint(line_begin + 1);
	putchar(':');
	putuint(1 + begin - line_begin_cursor);
	putzstr(")\n\0");
};

