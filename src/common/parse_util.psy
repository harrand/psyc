parseutil_number_tag : enum
{
	.integer := 1;
	.floating_point := 2;
};

parseutil_number : struct
{
	tag : parseutil_number_tag;
	f : f64;
	i : s64;
};

parseutil_parse_number : func(str : u8?, len : u64, out : parseutil_number mut? -> u64)
{
	cursor : u64 mut := 0;
	sign : s64 mut := 1;
	if([str # cursor] == '-')
	{
		sign = -1;
		cursor = cursor + 1;
	}

	base : s64 mut := 10;
	if([str # cursor] == '0')
	{
		cursor = cursor + 1;
		if([str # cursor] == 'x')
		{
			base = 16;
			cursor = cursor + 1;
		}
		if([str # cursor] == 'b')
		{
			base = 2;
			cursor = cursor + 1;
		}
	}

	[out] = zero;
	out->tag = parseutil_number_tag.integer;
	digit_val : s64 mut := 0;
	frac_div : f64 mut := 1.0;

	while(cursor < len)
	{
		ch ::= [str # cursor];
		if(ch == '.')
		{
			out->tag = parseutil_number_tag.floating_point;
		}
		if((ch >= '0') && (ch <= '9'))
		{
			digit_val = (ch - '0')@s64;
		}
		if((ch >= 'a') && (ch <= 'f'))
		{
			digit_val = ((ch - 'a') + 10@u8)@s8@s64;
		}
		if((ch >= 'A') && (ch <= 'F'))
		{
			digit_val = ((ch - 'A') + 10@u8)@s8@s64;
		}

		if(out->tag == parseutil_number_tag.integer)
		{
			out->i = (out->i * base) + digit_val;
		}
		else
		{
			//if(ch >= '0' && (ch <= '9'))
			//{
			//	frac_div = (frac_div / (base@f64));
			//	out->f = (out->f + (digit_val@f64) * frac_div);
			//}
		}
		cursor = cursor + 1;
	}

	if(out->tag == parseutil_number_tag.integer)
	{
		out->i = sign * out->i;
	}
	else
	{
		//out->f = sign@f64 * out->f;
	}
	return cursor;
};

parseutil_escape_char_literal : func(str : u8 mut?, str_len : u64 -> bool)
{
	if(str_len == 0)
	{
		return false;
	}
	return parseutil_escape_char(str, str_len) == str_len;
};

parseutil_escape_char : func(str : u8 mut?, str_len : u64 -> u64)
{
	if(str_len == 0)
	{
		return 0;
	}
	ch ::= [str # 0]@s64 weak;
	if(ch != 92) // '\'
	{
		//if(str_len > 1)
		//{
		//	panic_begin();
		//	putzstr("char-literal had more than 1 character inside: '\0");
		//	putchars(str, str_len);
		//	putzstr("'\n\0");
		//	panic_end();
		//}
		return 1;
	}
	// \<stuff>
	nxt ::= [str # 1];
	if(nxt == 'x')
	{
		v : u8 mut := 0;
		i : u64 mut := 2;
		keep_going : bool mut := true;
		while(keep_going)
		//for(i = 2; i < str_len; i = i + 1)
		{
			digit ::= [str # i];
			digit_val : u8 mut;
			keep_going = false;
			if((digit >= '0') && (digit <= '9'))
			{
				digit_val = digit - '0';
				keep_going = true;
				i = i + 1;
			}
			if((digit >= 'a') && (digit <= 'f'))
			{
				digit_val = digit - 'a';
				keep_going = true;
				i = i + 1;
			}
			if((digit >= 'A') && (digit <= 'F'))
			{
				digit_val = digit - 'A';
				keep_going = true;
				i = i + 1;
			}
			if(keep_going)
			{
				v = (v * 16) + (digit_val);
			}
		}
		[str # 0] = v;
		return i;
	}
	//if(str_len != 2)
	//{
	//	panic_begin();
	//	putzstr("malformed char literal");
	//	putchars(str, str_len);
	//	putzstr("'\n\0");
	//	panic_end();
	//}
	if(nxt == 'n')
	{
		[str # 0] = '\n';
		return 2;
	}
	if(nxt == 'r')
	{
		[str # 0] = '\r';
		return 2;
	}
	if(nxt == 't')
	{
		[str # 0] = '\t';
		return 2;
	}
	if(nxt == '0')
	{
		[str # 0] = '\0';
		return 2;
	}
	if(nxt == 92)
	{
		return 1;
	}
	panic_begin();
	putzstr("malformed char literal");
	putchars(str, str_len);
	putzstr("'\n\0");
	panic_end();
	unreachable;
};

parseutil_escape_string : func(str : u8 mut?, str_len : u64 -> u64)
{
	len : u64 mut := str_len;
	i : u64 mut := 0;
	while(i < len)
	{
		cur ::= parseutil_escape_char(str # i, len);
		i = i + 1;
		if(cur > 1)
		{
			len - len - (cur - 1);
		}
	}
	return len;
};

parseutil_is_whitespace : func(char : u8 -> bool)
{
	return (char == ' ') || (char == '\n') || (char == '\r') || (char == '\t');
};

parseutil_is_digit : func(char : u8 -> bool)
{
	return (char >= '0') && (char <= '9');
};
