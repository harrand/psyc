parseutil_number_tag : enum
{
	.integer := 1;
	.floating_point := 2;
};

parseutil_number : struct
{
	tag : parseutil_number_tag;
	f : f64;
	i : s64;
};

parseutil_parse_number : func(str : u8?, len : u64, out : parseutil_number mut? -> u64)
{
	cursor : u64 mut := 0;
	sign : s64 mut := 1;
	if([str # cursor] == '-')
	{
		sign = -1;
		cursor = cursor + 1;
	}

	base : s64 mut := 10;
	if([str # cursor] == '0')
	{
		cursor = cursor + 1;
		if([str # cursor] == 'x')
		{
			base = 16;
		}
		if([str # cursor] == 'b')
		{
			base = 2;
		}
	}

	[out] = zero;
	out->tag = parseutil_number_tag.integer;
	digit_val : s64 mut := 0;
	frac_div : f64 mut := 1.0;

	while(cursor < len)
	{
		ch ::= [str # cursor];
		if(ch == '.')
		{
			out->tag = parseutil_number_tag.floating_point;
		}
		if((ch >= '0') && (ch <= '9'))
		{
			digit_val = (ch - '0')@s64;
		}
		if((ch >= 'a') && (ch <= 'f'))
		{
			digit_val = (10 + (ch - 'a'));
		}
		if((ch >= 'A') && (ch <= 'F'))
		{
			digit_val = (10 + (ch - 'A'));
		}

		if(out->tag == parseutil_number_tag.integer)
		{
			out->i = (out->i * base) + digit_val;
		}
		else
		{
			//if(ch >= '0' && (ch <= '9'))
			//{
			//	frac_div = (frac_div / (base@f64));
			//	out->f = (out->f + (digit_val@f64) * frac_div);
			//}
		}
		cursor = cursor + 1;
	}

	if(out->tag == parseutil_number_tag.integer)
	{
		out->i = sign * out->i;
	}
	else
	{
		//out->f = sign@f64 * out->f;
	}
	return cursor;
};

parseutil_escape_char : func(str : u8?, str_len : u64 -> u8)
{
	if(str_len == 0)
	{
		panic_begin();
		putzstr("zero-sized char literal\0");
		panic_end();
	}
	ch ::= [str # 0]@s64 weak;
	if(ch != 92) // '\'
	{
		if(str_len > 1)
		{
			panic_begin();
			putzstr("char-literal had more than 1 character inside: '\0");
			putchars(str, str_len);
			putzstr("'\n\0");
			panic_end();
		}
		return ch;
	}
	// \<stuff>
	nxt ::= [str # 1];
	if(nxt == 'x')
	{
		v : u8 mut := 0;
		i : u64 mut;
		for(i = 2; i < str_len; i = i + 1)
		{
			digit ::= [str # i];
			digit_val : u8 mut;
			if((digit >= '0') && (digit <= '9'))
			{
				digit_val = digit - '0';
			}
			if((digit >= 'a') && (digit <= 'f'))
			{
				digit_val = digit - 'a';
			}
			if((digit >= 'A') && (digit <= 'F'))
			{
				digit_val = digit - 'A';
			}
			v = (v * 16) + (digit_val);
		}
		return v;
	}
	if(str_len != 2)
	{
		panic_begin();
		putzstr("malformed char literal");
		putchars(str, str_len);
		putzstr("'\n\0");
		panic_end();
	}
	if(nxt == 'n')
	{
		return '\n';
	}
	if(nxt == 'r')
	{
		return '\r';
	}
	if(nxt == 't')
	{
		return '\t';
	}
	if(nxt == '0')
	{
		return '\0';
	}
	if(nxt == 92)
	{
		return 92;
	}
	panic_begin();
	putzstr("malformed char literal");
	putchars(str, str_len);
	putzstr("'\n\0");
	panic_end();
	unreachable;
};

parseutil_escape_string : func(str : u8?, str_len : u64, out_str : u8 mut? mut?, out_len : u64 mut? -> v0)
{
	warn_begin();
	putzstr("nyi: parseutil_escape_string NYI, just returning as-is\0");
	warn_end();
};

parseutil_is_whitespace : func(char : u8 -> bool)
{
	return (char == ' ') || (char == '\n') || (char == '\r') || (char == '\t');
};
