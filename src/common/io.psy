putchars : func(chars : u8?, count : u64 -> v0)
{
	linux_write(1, chars, count);
};

putzstr : func(z : u8? -> v0)
{
	putchars(z, zstrlen(z));
};

putchar : func(c : u8 -> v0)
{
	storage : u8 := c;
	putchars(ref storage, 1);
};

putuint : func(i : u64 weak -> v0)
{
	if(i > 9)
	{
		putuint(i / 10);
	}
	digit ::= i - ((i / 10) * 10);
	putchar(digit + '0');
};

putsint : func(i : s64 weak -> v0)
{
	if(i < 0)
	{
		putchar('-');
		putuint(-i@u64);
	}
	else
	{
		putuint(i@u64);
	}
};

putcol : enum
{
	.reset := 0;
	.red := 1;
	.red_underline := 2;
	.yellow := 3;
	.yellow_underline := 4;
	.blue := 5;
	.blue_underline := 6;
	.green := 7;
	.green_underline := 8;
};

putcol_tbl ::= func(-> v0)[countof putcol]
{
	.0 := colour_reset;
	.1 := colour_red;
	.2 := colour_red_underline;
	.3 := colour_yellow;
	.4 := colour_yellow_underline;
	.5 := colour_blue;
	.6 := colour_blue_underline;
	.7 := colour_green;
	.8 := colour_green_underline;
};

put_setcol : func(col : putcol -> v0)
{
	[putcol_tbl # col@s64]();
};

colour_red : func(-> v0)
{
	ansi_esc_char : u8 := 27;
	linux_write(1, ref ansi_esc_char, 1);
	linux_write(1, "[91m", 4);
};

colour_red_underline : func(-> v0)
{
	ansi_esc_char : u8 := 27;
	linux_write(1, ref ansi_esc_char, 1);
	linux_write(1, "[4;91m", 6);
};

colour_dark_red : func(-> v0)
{
	ansi_esc_char : u8 := 27;
	linux_write(1, ref ansi_esc_char, 1);
	linux_write(1, "[0;31m", 6);
};

