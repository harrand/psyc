// opaque handle representing a file descriptor
file : enum
{
	.none := ~0;
	.cwd := ~1;
};

// files arent necessarily actual files, they can also represent directories for example
file_type : enum
{
	// the file doesnt exist
	.notfound := 0;
	// the file is a normal file
	.file := 1;
	// the file is a directory
	.dir := 2;
};

// basic information about a file
file_stats : struct
{
	// size in bytes.
	size : u64;
	// what type of file are we? if type == notfound, then the file doesnt actually exist.
	type : file_type;
};

file_access : enum
{
	// we want to be able to read the file
	.read := 0;
	// we want to be able to write to the file
	.write := 1;
	// read + write
	.read_write := 2;
	// we expect the file to be a directory
	.directory := 4;
};

// opaque handle representing a path to a file (in reality its a char-pointer underneath)
path : enum
{
};

// given a parent path and a child path, combine them to make one singular path
// e.g: path_combine("/usr/lib"path, "foo.txt"path) => "/usr/lib/foo.txt"path
// the arena is used for memory allocation
path_combine : func(lhs : path, rhs : path, ar : arena mut? -> path)
{
	lhsz ::= path2zstr(lhs);
	rhsz ::= path2zstr(rhs);
	lhslen ::= zstrlen(lhsz);
	if([lhsz # (lhslen - 1)] == '/')
	{
		// no need for a combinator
		return zstr2path(zstrcombz(lhsz, rhsz, zero, ar));
	}
	return zstr2path(zstrcombz(lhsz, rhsz, '/', ar));
};

// deep-copy a path using the given arena. the result has the exact same contents.
path_dupe : func(p : path, ar : arena mut? -> path)
{
	p_zstr ::= path2zstr(p);
	len ::= zstrlen(p_zstr);
	ptr : u8 mut? := arena_alloc(ar, len + 1);
	memcopy(ptr, p_zstr, len);
	[p_zstr # len] = '\0';
	return zstr2path(ptr);
};

// given a path, try to get the parent part of the path. return a file descriptor representing the parent directory (relative to the argument which can be file.cwd)
// e.g path_get_parent("foo/baz.png"path, file.cwd, ref output) => a directory file descriptor for "./foo"
// if the path had no parent path, just return the relative argument back
// e.g path_get_parent("baz.png"path, dir_foo, ref output) => dir_foo
path_get_parent : func(p : path, relative_to : file, out_path : path mut? -> file)
{
	// if the path contains a parent path, then make a new file descriptor for it relative to the param
	// otherwise if theres no parent path, just return relative_to
	path_zstr ::= path2zstr(p);
	len ::= zstrlen(path_zstr);

	if(len == 0)
	{
		[out_path] = p;
		return relative_to;
	}

	i : u64 mut;
	last_found_slash : u64 mut := ~0;
	for(i = 0; i < len - 1; i = i + 1)
	{
		if([path_zstr # i] == '/')
		{
			last_found_slash = i;
		}
	}

	// if we never found a slash, there is no parent path
	if((last_found_slash == ~0))
	{
		[out_path] = p;
		return relative_to;
	}
	parent_path_zstr ::= sstr2zstr(path_zstr, last_found_slash, global_arena);
	[out_path] = zstr2path(path_zstr # (last_found_slash + 1));
	parent_dir ::= path_open(zstr2path(parent_path_zstr), relative_to, file_access.directory, zero);
	if(!file_is_valid(parent_dir))
	{
		warn_begin();
		putzstr("fucked up parent path: \0");
		putzstr(parent_path_zstr);
		warn_end();
	}
	return parent_dir;
};

// given a path to a file, retrieve stats about that file (relative to another file, which can be file.cwd)
// use 'out->type != file_type.notfound' to check if the file actually exists. otherwise have a look at the file_stats struct and take what you need.
path_get_stats : func(p : path, out : file_stats mut?, relative_to : file -> err)
{
	linux_out : linux_stat_t mut;

	linux_dirfd : s32 mut := relative_to@s64@s32;
	if(relative_to == file.cwd)
	{
		linux_dirfd = -100; // AT_FDCWD
	}

	linux_err : s32 := linux_fstatat(linux_dirfd, path2zstr(p), ref linux_out, 0);
	if(linux_err == -13) // EACCESS
	{
		return err.noperm;
	}
	if(linux_err == -14) // EFAULT
	{
		return err.badparam;
	}
	if(linux_err == -2) // ENOENT
	{
		out->size = 0;
		out->type = file_type.notfound;
		return zero;
	}
	if(linux_err == -20) // ENOTDIR
	{
		return err.badparam;
	}
	if(linux_err == -9) // EBADF
	{
		return err.badparam;
	}
	if(linux_err == 0)
	{
		__linux_stat2file_stats(ref linux_out, out);
		return zero;
	}
	return err.unknown;
};

// controls optional behaviours when opening a file
path_open_flag : enum
{
	// if the file already has content, truncate it so that it is empty
	.truncate := 0x0200;
	// if the file does not exist, create it (file perms are rw-rw-r-- if supported)
	.create_if_notfound := 0x40;
	// if we are creating the file (i.e via create_if_notfound), make the file permissions executable (file perms are rwxr-xr-x if supported)
	.create_executable := 0x01;
};

path_open : func(p : path, relative_to : file, access : file_access, flags : path_open_flag -> file)
{
	access_flags : s64 mut := access@s64;
	linux_dirfd : s32 mut := relative_to@s64@s32;
	if(relative_to == file.cwd)
	{
		linux_dirfd = -100; // AT_FDCWD
	}
	flagbits : s64 mut := flags@s64;
	mode : s32 mut := 0x1a4;
	if((flags & path_open_flag.create_if_notfound) != zero)
	{
		// rw-rw-r--
		mode = 0x1a4;
	}
	if((flags & path_open_flag.create_executable) != zero)
	{
		// rwxr-xr-x
		mode = 0x1ed;
		// remove path_open_flag.create_executable from flagbits because it should only affect mode and not flags
		flagbits = flagbits & ~(0x1);
	}

	if((access & file_access.directory) != zero)
	{
		access_flags = file_access.read@s64;
		// if we want to create_if_notfound and its a directory then we should call mkdirat
		if((flags & path_open_flag.create_if_notfound) != zero)
		{
			// make sure the directory exists.
			linux_mkdirat(linux_dirfd, path2zstr(p), 0x1ff); // O777
			// remove the O_CREAT in this case because it implies writing which is not allowed for directories
			flagbits = flagbits & (~path_open_flag.create_if_notfound@s64);
		}
	}
	return linux_openat(linux_dirfd, path2zstr(p), access_flags | flagbits, mode)@s64@file;
};

// given a directory file descriptor, iterate over all files in the directory (non-recursively) and invoke the callback for each filename (and I will pass back the userdata you provide me)
// important: the path provided to the callback should not be cached - as it points to temporary stack memory. if you want to keep ahold of it, do a deep-copy via path_dupe
directory_iterate : func(dir : file, callback : func(p : path, usrdata : v0? weak -> bool), usrdata : v0? weak -> u64)
{
	counter : u64 mut := 0;
	buffer : u8[4096];
	ret : s64 mut := ~0;
	i : u64 mut := 0;
	while(ret != 0)
	{
		ret = linux_getdents(dir@s64@s32, (buffer # 0)@linux_dirent mut?, sizeof typeof(buffer));
		if(ret == 0)
		{
			return counter;
		}
		if(ret < 0)
		{
			return zero;
		}
		while(i < ret@u64)
		{
			d ::= (buffer # i)@linux_dirent mut?;
			child_zstr ::= d->d_name # 0;
			if([child_zstr # 0] != '.')
			{
				callback(zstr2path(child_zstr), usrdata);
				counter = counter + 1;
			}
			i = i + d->d_reclen@u64;
		}
	}
	unreachable;
};

// close a file. all opened files should be closed if you want to reclaim internal/kernel resources
file_close : func(f : file -> err)
{
	linux_err : s32 := linux_close(f@s64@s32);
	if(linux_err == -9) // EBADF
	{
		return err.badparam;
	}
	if(linux_err == 0)
	{
		return zero;
	}
	return err.unknown;
};

// if !file_is_valid(f), yield an error code describing why it isnt valid
// note: calling this on a valid file will yield a garbage result, not necessarily zero.
file_get_error : func(f : file -> err)
{
	return -(f@s64)@err;
};

// returns true if the file is valid (i.e successfully opened). if false, you can get an error code via file_get_error.
file_is_valid : func(f : file -> bool)
{
	return f@s64 > 0;
};

// read data from a file. returns zero on success.
// dev note: this may or may not read 'out_size' bytes, but there is no way for the caller to know lmao because that will still return zero
file_read : func(f : file, out : u8 mut?, out_size : u64 -> err)
{
	ret : s32 := linux_read(f@s64@s32, out, out_size)@s32;
	if(ret >= 0)
	{
		return zero;
	}
	return err.unknown;
};

// write data to a file. returns zero on success
// dev note: this may or may not write 'in_size' bytes, but there is no way for the caller to know lmao because that will still return zero
file_write : func(f : file, in : u8 mut?, in_size  : u64 -> err)
{
	ret : s32 := linux_write(f@s64@s32, in, in_size)@s32;
	if(ret >= 0)
	{
		return zero;
	}
	return err.unknown;
};

// internal impl details.
__linux_stat2file_stats : func(s : linux_stat_t?, out : file_stats mut? -> v0)
{
	out->size = s->st_size@u64;
	out->type = file_type.notfound;
	type ::= s->st_mode & 0xf000;
	if(type == 0x4000)
	{
		out->type = file_type.dir;
	}
	if(type == 0x8000)
	{
		out->type = file_type.file;
	}
};

// convert a zstr to a path
zstr2path : func(zstr : u8? -> path)
{
	return zstr@u64@s64@path;
};

// convert a path to a zstr
path2zstr : func(p : path -> u8?)
{
	return p@s64@u64@u8?;
};
