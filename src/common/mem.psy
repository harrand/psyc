memcopy : func(dst : u8 mut? weak, src : u8? weak, len : u64 -> v0)
{
	prepad : u64 mut := -(dst@u64) & 15;

    if(prepad > len)
    {
        prepad = len;
    }

    memcopy8(dst, src, prepad);

    remaining ::= len - prepad;
    quad_bytes ::= (remaining / 16) * 16;

	if((((dst # prepad)@u64 ^ (src # prepad)@u64) & 15) == 0)
	{
		// both are aligned
		memcopy128_aligned(dst # prepad, src # prepad, quad_bytes);
	}
	else
	{
		memcopy128_unaligned(dst # prepad, src # prepad, quad_bytes);
	}

    postpad : u64 := remaining - quad_bytes;

    memcopy8(dst # (prepad + quad_bytes), src # (prepad + quad_bytes), postpad);
};

cpy128_aligned : asm(_ : v0? weak, _ : v0? weak ->)
{
	mov rax, $1
	movdqa xmm0, XMMWORD PTR [rax]
	mov rax, $0
	movdqa XMMWORD PTR [rax], xmm0
};

memcopy128_aligned : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : u64 mut;
	for(i = 0; i < (len / 8); i = i + 2)
	{
		cpy128_aligned(dst # i, src # i);
	}
};

cpy128_unaligned : asm(_ : v0? weak, _ : v0? weak ->)
{
	mov rax, $1
	movdqu xmm0, XMMWORD PTR [rax]
	mov rax, $0
	movdqu XMMWORD PTR [rax], xmm0
};

memcopy128_unaligned : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : u64 mut;
	for(i = 0; i < (len / 8); i = i + 2)
	{
		cpy128_unaligned(dst # i, src # i);
	}
};

memcopy128_backwards_unaligned : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : s64 mut weak;
	for(i = (len / 8) - 2; i >= 0; i = i - 2)
	{
		cpy128_unaligned(dst # i, src # i);
	}
};

memcopy128_backwards_aligned : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : s64 mut weak;
	for(i = (len / 8) - 2; i >= 0; i = i - 2)
	{
		cpy128_aligned(dst # i, src # i);
	}
};

memcopy64 : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : u64 mut;
	for(i = 0; i < (len / 8); i = i + 1)
	{
		[dst # i] = [src # i];
	}
};

memcopy8 : func(dst : u8 mut? weak, src : u8? weak, len : u64 -> v0)
{
	i : u64 mut;
	for(i = 0; i < len; i = i + 1)
	{
		[dst # i] = [src # i];
	}
};

memcopy8_backwards : func(dst : u8 mut? weak, src : u8? weak, len : u64 -> v0)
{
	i : s64 mut weak;
	for(i = len - 1; i >= 0; i = i - 1)
	{
		[dst # i] = [src # i];
	}
};

memcopy64_backwards : func(dst : u64 mut? weak, src : u64? weak, len : u64 -> v0)
{
	i : s64 mut weak;
	for(i = (len / 8) - 1; i >= 0; i = i - 1)
	{
		[dst # i] = [src # i];
	}
};

memcopy_backwards : func(dst : u8 mut? weak, src : u8? weak, len : u64 -> v0)
{
	postpad : u64 mut := (dst@u64 + len) & 15;

	if(postpad > len)
	{
		postpad = len;
	}

	memcopy8_backwards(dst # (len - postpad), src # (len - postpad), postpad);

	remaining ::= len - postpad;
	quad_bytes ::= (remaining / 16) * 16;

	prepad : u64 := remaining - quad_bytes;

	if((((dst # prepad)@u64 ^ (src # prepad)@u64) & 15) == 0)
	{
		// both are aligned
		memcopy128_backwards_aligned(dst # prepad, src # prepad, quad_bytes);
	}
	else
	{
		memcopy128_backwards_unaligned(dst # prepad, src # prepad, quad_bytes);
	}

	memcopy8_backwards(dst, src, prepad);
};

