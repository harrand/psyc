val_from_node_expr_biop : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	abi : abi_tag := abi_tag.psy64;
	lhs_node ::= ast_biop_get_lhs(ctx->node);
	rhs_node ::= ast_biop_get_rhs(ctx->node);

	lhs_ctx : val_context mut := [ctx];
	lhs_ctx.node = lhs_node;
	lhs_val : val mut;
	val_from_node(ref lhs_ctx, ref lhs_val, resolve);
	rhs_val : val mut;
	rhs_ctx : val_context mut := [ctx];
	rhs_ctx.node = rhs_node;
	val_from_node(ref rhs_ctx, ref rhs_val, resolve);

	tag ::= [ast_biop_get_tag(ctx->node)];
	if(tag@s64 == ~0)
	{
		panic_begin();
		putzstr("invalid/unrecognised binary operator (should be impossible as parser wouldnt allow it) at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	[val_from_node_expr_biop_tbl # (tag@s64)](ref lhs_val, lhs_node, ref rhs_val, rhs_node, out, resolve, ctx);
};

val_from_node_expr_unop_minus : func(operand : val mut?, operand_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	// only integral and floating-point types can be negated
	if((ty_integral_size(operand->type) + ty_floating_point_size(operand->type)) == 0)
	{
		err_begin();
		putzstr("unary operator '-' is only valid on integral or floating-point types. you have provided a \0");
		putchar('"');
		putty(operand->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->type = operand->type;
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(resolve == val_resolve.compiletime_only)
	{
		if(operand->tag == val_tag.scalar_literal)
		{
			out->tag = val_tag.scalar_literal;
			out->type = out->type;
			if(ty_floating_point_size(operand->type) > 0)
			{
				[val_scalar_literal_get_floating_point(out)] = -[val_scalar_literal_get_floating_point(operand)];
			}
			else
			{
				[val_scalar_literal_get_integer(out)] = -[val_scalar_literal_get_integer(operand)];
			}
			return;
		}
		panic_begin();
		putzstr("val_from_node_expr_unop_minus compiletime_only, don't know how to negate val_tag.\0");
		putsint(operand->tag@s64);
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	panic_begin();
	putzstr("reached end of val_from_node_expr_unop_minus for \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop_ref : func(operand : val mut?, operand_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	if(operand->type == ty.invalid)
	{
		err_begin();
		putzstr("operand of unary 'ref' operator did not yield a valid type at \0");
		putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->type = ty_make_pointer(operand->type, zero);
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(operand->tag == val_tag.pointer)
	{
		out->tag = val_tag.scalar;
		[val_scalar_get_irval(out)] = [val_pointer_get_irval(operand)];
		return;
	}
	if(operand->tag == val_tag.variable_reference)
	{
		// variable reference could be a bunch of things
		// - typeonly (but this is an error if we didnt early out via val_resolve.type_only)
		// for a function param:
		//     - a scalar (irval)
		//     - an aggregate (chunked irval)
		// for a local variable:
		// - a pointer (via ir_stack)
		// for a global variable:
		// - a pointer (via irglob)
		var ::= [val_variable_reference_get_variable(operand)];
		storage_ref ::= ref(var->storage);
		if(storage_ref->tag != val_tag.pointer)
		{
			err_begin();
			putzstr("cannot ref non-lvalue variable \0");
			putchar('"');
			putchars([ast_decl_get_name(var->node)], [ast_decl_get_name_len(var->node)]);
			putchar('"');
			if(var->local_param_idx != ~0)
			{
				putzstr(" (because it is a function parameter which is not backed by memory) at \0");
			}
			else
			{
				putzstr(" (though it doesn't seem to be a function parameter and i cant think of why anything else wouldn't be an lvalue...) at \0");
			}
			putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
			err_end();
		}
		out->tag = val_tag.scalar;
		[val_scalar_get_irval(out)] = [val_pointer_get_irval(storage_ref)];
		return;
	}
	panic_begin();
	putzstr("reached end of val_from_node_expr_unop_ref at \0");
	putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop_nyi : func(operand : val mut?, operand_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_unop NYI for ast_unop_tag.\0");
	putsint([ast_unop_get_tag(ctx->node)]@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	abi : abi_tag := abi_tag.psy64;
	operand_node ::= ast_unop_get_operand(ctx->node);

	operand_val : val mut;
	operand_ctx : val_context mut := [ctx];
	operand_ctx.node = operand_node;
	val_from_node(ref operand_ctx, ref operand_val, resolve);

	tag ::= [ast_unop_get_tag(ctx->node)];
	if(tag@s64 == ~0)
	{
		panic_begin();
		putzstr("invalid/unrecognised binary operator (should be impossible as parser wouldnt allow it) at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	[val_from_node_expr_unop_tbl # (tag@s64)](ref operand_val, operand_node, out, resolve, ctx);
};

val_from_node_expr_call : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	abi : abi_tag := abi_tag.psy64;

	callee_val : val mut;
	callee_ctx : val_context mut := [ctx];
	callee_ctx.node = ast_call_get_callee(ctx->node);
	val_from_node(ref callee_ctx, ref callee_val, resolve);
	param_nodes ::= ast_call_get_params(ctx->node);
	param_nodes_count ::= ast_call_get_params_count(ctx->node)@u64;

	i : u64 mut;

	callee_fnty ::= callee_val.type;
	if(ty_is_function(callee_val.type) == false)
	{
		err_begin();
		putzstr("function callee did not yield a function-type, instead yielded a \0");
		putchar('"');
		putty(callee_val.type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, callee_ctx.node->src_beg@u64, callee_ctx.node->src_end@u64, putcol.red_underline);
		err_end();
	}

	callee_u ::= ty_unwrap(callee_fnty);
	// gather a scratch array of vals representing the parameters
	param_vals : val mut? := arena_alloc(scratch_arena, param_nodes_count * sizeof val);
	for(i = 0; i < param_nodes_count; i = i + 1)
	{
		cur_param_val : val mut;
		cur_param_ctx : val_context mut := [ctx];
		cur_param_ctx.node = param_nodes # i;
		val_from_node(ref cur_param_ctx, ref cur_param_val, resolve);
		val_convert(ref cur_param_val, ty_at(callee_fnty, i), ref cur_param_val, resolve, ref cur_param_ctx);
		val_load(abi, ref cur_param_val, param_vals # i, ref cur_param_ctx);
	}

	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		out->type = ty_underlying(callee_fnty);
		return;
	}
	// chunk the params
	// then we can calculate our irval array count and then finally compute the array
	param_chunks : abi_chunk mut? mut;
	param_chunks_count : u64 mut;
	abi_chunk_tys(abi, callee_u->members # 0, callee_u->members_count, ref param_chunks, ref param_chunks_count, scratch_arena);

	param_irvals : irval mut? := arena_alloc(global_arena, param_chunks_count * sizeof irval);
	j : u64 mut;
	for(i = 0; i < param_nodes_count; i = i + 1)
	{
		cur ::= param_vals # i;
		if(cur->tag == val_tag.aggregate)
		{
			cur_agg_count ::= [val_aggregate_get_members_count(cur)];
			cur_agg_vals ::= [val_aggregate_get_members(cur)];
			for(j = 0; j < cur_agg_count; j = j + 1)
			{
				[param_irvals # (i + j)] = [val_scalar_get_irval(cur_agg_vals # j)];
			}
			// add the size of the agg to i (but remember we're about to increment it, so add size-1 and assume we never have a 0-size-agg)
			i = i + (j - 1);
		}
		else
		{
			[param_irvals # i] = [val_scalar_get_irval(cur)];
		}
	}
	// todo: passing references to stack memory incase of chunk_tag.mem (sysv + winx64) would need some code here.
	// todo: error out if param_chunks_count > abi.params_count_max (doesnt exist yet)
	// todo runtime: emit the call
	// todo runtime: return the result?
	panic_begin();
	putzstr("reached end of val_from_node_expr_call for \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_blkinit : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	typename_node ::= ast_blkinit_get_typename(ctx->node);
	typename_ctx : val_context mut := [ctx];
	typename_ctx.node = typename_node;
	type ::= ty_from_typename_node(ref typename_ctx);
	if(type == ty.invalid)
	{
		err_begin();
		putzstr("cannot decipher type of block-initialiser \0");
		putsrc(ctx->src, typename_node->src_beg@u64, typename_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	i : u64 mut;
	out->type = type;
	members : val mut? mut;
	if(resolve == val_resolve.compiletime_only)
	{
		out->tag = val_tag.aggregate_literal;
		members = arena_alloc(global_arena, ty_countof(type) * sizeof val);
		[val_aggregate_literal_get_members(out)] = members;
	}
	runtime_chunks : abi_chunk mut? mut;
	runtime_chunks_count : u64 mut;
	if(resolve == val_resolve.runtime_only)
	{
		out->tag = val_tag.aggregate;
		abi_chunk_tys(abi_tag.psy64, ref type, 1, ref runtime_chunks, ref runtime_chunks_count, global_arena);
		members = arena_alloc(global_arena, runtime_chunks_count * sizeof val);
		[val_aggregate_get_members(out)] = members;
		[val_aggregate_get_chunks(out)] = runtime_chunks;
	}

	init_vals : val mut? := arena_alloc(scratch_arena, ty_countof(type) * sizeof val);
	inits_count ::= ast_blkinit_get_inits_count(ctx->node)@u64;
	for(i = 0; i < inits_count; i = i + 1)
	{
		(init_vals # i)->tag = val_tag.invalid;
	}
	inits ::= ast_blkinit_get_inits(ctx->node);
	for(i = 0; i < inits_count; i = i + 1)
	{
		init_node ::= inits # i;
		init_ctx : val_context mut := [ctx];
		init_ctx.node = ast_init_get_expr(init_node);

		init_tag ::= [ast_init_get_tag(init_node)];
		idx : u64 mut := ~0;
		if(init_tag == ast_init_tag.ellipsis)
		{
			panic_begin();
			putzstr("ellipsis syntax in initialisers is NYI at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			panic_end();
		}
		if(init_tag == ast_init_tag.integer)
		{
			idx = [ast_init_get_integer(init_node)]@u64;
		}
		if(init_tag == ast_init_tag.symbol)
		{
			if(ty_is_structure(type) == false)
			{
				err_begin();
				putzstr("initialiser with symbol-designator doesn't make sense for array-type \0");
				putchar('"');
				putty(type);
				putchar('"');
				putzstr(", only integer-designators (the index of the array) makes sense at \0");
				putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
				err_end();
			}
			idx = ty_struct_find(type, [ast_init_get_symbol(init_node)], [ast_init_get_symbol_len(init_node)]);
		}

		// if the index doesnt look kosher then we need to tell the user their designator is wrong
		if(idx >= ty_countof(type))
		{
			err_begin();
			putzstr("block-initialiser did not correspond to a valid member of the aggregate-type \0");
			putchar('"');
			putty(type);
			putchar('"');
			putzstr(" at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			err_end();
		}

		// warn if the same member has been initialised previously (this is almost certainly unintended)
		if((init_vals # idx)->tag != val_tag.invalid)
		{
			warn_begin();
			putzstr("duplicate initialiser - member index \0");
			putuint(idx);
			putzstr(" of aggregate-type \0");
			putchar('"');
			putty(type);
			putchar('"');
			putzstr(" has already been initialised previously within this block-initialiser at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.yellow_underline);
			warn_end();
		}

		// get the initialiser expression as a val and convert it to whatever the member type expects
		val_from_node(ref init_ctx, init_vals # idx, resolve);
		val_convert(init_vals # idx, ty_at(type, idx), init_vals # idx, resolve, ref init_ctx);
	}

	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}

	if(resolve == val_resolve.compiletime_only)
	{
		for(i = 0; i < ty_countof(type); i = i + 1)
		{
			cur ::= init_vals # i;
			if(cur->tag == val_tag.invalid)
			{
				val_zero_as(ty_at(type, i), members # i);
				warn_begin();
				putzstr("member \0");
				putuint(i);
				putzstr(" of aggregate type \0");
				putchar('"');
				putty(type);
				putchar('"');
				putzstr(" was not initialialised by the block-initialiser at \0");
				putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.yellow_underline);
				warn_end();
			}
			else
			{
				[members # i] = [cur];
			}
		}
		return;
	}
	panic_begin();
	putzstr("todo: val_from_node_expr_blkinit (type: \0");
	putty(type);
	putzstr(")\0");
	panic_end();
};

val_from_node_expr_dereference : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	operand_node ::= ast_dereference_get_operand(ctx->node);
	operand_ctx : val_context mut := [ctx];
	operand_ctx.node = operand_node;
	val_from_node(ref operand_ctx, out, resolve);

	if(ty_is_pointer(out->type) == false)
	{
		err_begin();
		putzstr("cannot dereference non-pointer-type \0");
		putchar('"');
		putty(out->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->type = ty_underlying(out->type);
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	panic_begin();
	putzstr("reached end of val_from_node_expr_dereference at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_cast : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	castee_expr ::= ast_cast_get_castee(ctx->node);
	castee : val mut;

	castee_ctx : val_context mut := [ctx];
	castee_ctx.node = castee_expr;
	val_from_node(ref castee_ctx, ref castee, resolve);

	castee.type = ty_add_weak(castee.type);

	cast_target_node ::= ast_cast_get_cast_typename(ctx->node);
	cast_target_ctx : val_context mut := [ctx];
	cast_target_ctx.node = cast_target_node;
	cast_target ::= ty_from_typename_node(ref cast_target_ctx);

	val_convert(ref castee, cast_target, out, resolve, ctx);
};

val_from_node_expr_field : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	is_ptr_field ::= [ast_field_get_parse_state(ctx->node)] == ast_field_parse_state.finalisedarrow;
	lhs_node : ast mut? := ast_field_get_lhs(ctx->node);
	rhs_node : ast mut? := ast_field_get_rhs(ctx->node);

	lhs_val : val mut := zero;
	lhs_ctx : val_context mut := [ctx];
	lhs_ctx.node = lhs_node;
	val_from_node(ref lhs_ctx, ref lhs_val, resolve);

	if(is_ptr_field == false)
	{
		if((ty_is_enumeration(lhs_val.type) == false) && (ty_is_structure(lhs_val.type) == false))
		{
			err_begin();
			putzstr("field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - only structs and enum typenames are allowed to be the left-hand-side of a field-access at \0");
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
	else
	{
		if(ty_is_pointer(lhs_val.type) == false)
		{
			err_begin();
			putzstr("pointer-field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - only pointer types are allowed to be the left-hand-side of a pointer-field-access at \0");
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			err_end();
		}
		// also the pointee must be a struct type
		if(ty_is_structure(ty_underlying(lhs_val.type)) == false)
		{
			err_begin();
			putzstr("pointer-field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - while the left-hand-side of the pointer-field-access is indeed a pointer, the pointee type is not a structure type, it is of type \0");
			putchar('"');
			putty(ty_underlying(lhs_val.type));
			putchar('"');
			putzstr(" at \0");
	
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}

	// rhs must be either a symbol expression, or a call where the callee is a symbol expression
	// examples that satisfy this:
	// lhs.some_symbol
	// lhs.some_symbol_that_is_called()
	// examples that do not satisfy this:
	// lhs.2
	// lhs.123()
	rhs_symbol_node : ast mut? mut := zero;
	rhs_is_call ::= ast_is_expr(rhs_node, ast_expr_tag.call);
	if(rhs_is_call)
	{
		rhs_symbol_node = ast_call_get_callee(rhs_node);
		if(ast_is_expr(rhs_symbol_node, ast_expr_tag.symbol) == false)
		{
			err_begin();
			putzstr("if the right-hand-side of a field expression is a call, then the callee must itself be a symbol expression, but it is not in this case at \0");
			putsrc(ctx->src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
	else
	{
		rhs_symbol_node = rhs_node;
		if(ast_is_expr(rhs_symbol_node, ast_expr_tag.symbol) == false)
		{
			err_begin();
			putzstr("the right-hand-side of a field expression must be a symbol expression or a call on a symbol expression, but it is neither at \0");
			putsrc(ctx->src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
	struct_memidx : u64 mut;
	if(is_ptr_field)
	{
		struct_memidx = ty_struct_find(ty_underlying(lhs_val.type), [ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
	}
	else
	{
		struct_memidx = ty_struct_find(lhs_val.type, [ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
	}

	if(ty_is_enumeration(lhs_val.type))
	{
		the_entry ::= ty_enum_find(lhs_val.type, [ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
		if(the_entry == zero)
		{
			err_begin();
			putzstr("enum type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" has no entry named \0");
			putchar('"');
			putchars([ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
			putchar('"');
			putzstr(" at \0");
			putsrc(ctx->src, rhs_node->src_beg@u64, rhs_node->src_end@u64, putcol.red_underline);
			err_end();
			return;
		}
		out->type = lhs_val.type;
		if(resolve == val_resolve.type_only)
		{
			out->tag = val_tag.typeonly;
			return;
		}
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_integer(out)] = [the_entry];
		return;
	}

	// its a struct
	if(struct_memidx == ~0)
	{
		err_begin();
		putzstr("structure type \0");
		putchar('"');
		putty(lhs_val.type);
		putchar('"');
		putzstr(" has no member named \0");
		putchar('"');
		putchars([ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(is_ptr_field)
	{
		out->type = ty_at(ty_underlying(lhs_val.type), struct_memidx);
	}
	else
	{
		out->type = ty_at(lhs_val.type, struct_memidx);
	}
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	
	panic_begin();
	putzstr("todo: val_from_node_expr_field at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_countof : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	typename_node ::= ast_countof_get_operand(ctx->node);
	typename_ctx : val_context mut := [ctx];
	typename_ctx.node = typename_node;
	val_from_integer_literal(ty_countof(ty_from_typename_node(ref typename_ctx)), out);
};

val_from_node_expr_typeof : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	expr_node ::= ast_typeof_get_operand(ctx->node);
	expr_context : val_context mut := [ctx];
	expr_context.node = ast_typeof_get_operand(ctx->node);
	val_from_node(ref expr_context, out, val_resolve.type_only);
};

val_from_node_tbl ::= typeof(val_from_node)[countof ast_tag]
{
	.0 := val_from_node_nyi;
	.1 := val_from_node_nyi;
	.2 := val_from_node_expr;
	.3 := val_from_node_stmt;
