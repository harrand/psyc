	{
		val_from_node_expr_biop_at_pointer(lhs, lhs_node, rhs, rhs_node, out, resolve, ctx);
		return;
	}
	if(ty_is_array(lhs->type))
	{
		val_from_node_expr_biop_at_array(lhs, lhs_node, rhs, rhs_node, out, resolve, ctx);
		return;
	}
	err_begin();
	putzstr("lhs operand of 'at' (#) operator must be a pointer or array type, but you have provided a \0");
	putchar('"');
	putty(lhs->type);
	putchar('"');
	putzstr(" at \0");
	putsrc(ctx->src, lhs_node->src_beg@u64, lhs_node->src_end@u64, putcol.red_underline);
