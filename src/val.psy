val_from_node_expr_biop_at : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	// rhs needs to be some integral value so we need to load it if its not a scalar
	val_load_if_pointer(rhs_val, rhs_val);

	if(ty_integral_size(rhs_val->type) == 0)
	{
		err_begin();
		putzstr("rhs of 'at' (#) expression must be an integral value, you have provided a \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, rhs_node->src_beg@u64, rhs_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if((ty_is_pointer(lhs_val->type) == false) && (ty_is_array(lhs_val->type) == false))
	{
		err_begin();
		putzstr("lhs of 'at' (#) expression must be either an array or a pointer, you have provided a \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, lhs_node->src_beg@u64, lhs_node->src_end@u64, putcol.red_underline);
		err_end();
	}

	out->type = ty_make_pointer(ty_underlying(lhs_val->type), zero);
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	// rhs is always a scalar and must be an integral value
	// lhs can be a few things
	lhs_underlying ::= ty_underlying(lhs_val->type);
	// pointer - add displacement 'sizeof(underlying(lhs)) * rhs_scalar'
	// scalar - add displacement 'sizeof(underlying(lhs)) * rhs_scalar'
	// because they are similar we converge quickly into a common codepath
	the_irval : irval mut? mut;
	the_disp : s32 mut? mut;
	if(lhs_val->tag == val_tag.pointer)
	{
		the_irval = val_pointer_get_irval(lhs_val);
		the_disp = val_pointer_get_displacement(lhs_val);
	}
	if(lhs_val->tag == val_tag.scalar)
	{
		the_irval = val_scalar_get_irval(lhs_val);
		the_disp = val_scalar_get_displacement(lhs_val);
	}

	sizeof_element ::= abi_sizeof(abi_tag.psy64, ty_underlying(lhs_val->type));
	// offset our output (which is always a scalar)
	// if we know rhs' value at compile-time this gets very simple
	rhs_irval ::= val_scalar_get_irval(rhs_val);
	[val_scalar_get_irval(out)] = [the_irval];
	if(rhs_irval->tag == irval_tag.imm)
	{
		[val_scalar_get_displacement(out)] = [the_disp] + ([irval_imm_get_integer(rhs_irval)]@s32 * sizeof_element@s32);
		return;
	}
	// realise the displacement now if there is one
	if([the_disp] != 0)
	{
		disp_imm : irval mut;
		irval_dimm([the_disp], ref disp_imm);
		ir_add(val_scalar_get_irval(out), val_scalar_get_irval(out), ref disp_imm);
	}
	// we've applied the displacement (or it was zero before) so we can safely zero it out
	[val_scalar_get_displacement(out)] = 0;
	// we have to do the mul + add for rhs
	rhs_addition_bytes : irval mut;
	sizeof_imm : irval mut;
	irval_dimm(sizeof_element, ref sizeof_imm);
	ir_umul(ref rhs_addition_bytes, rhs_irval, ref sizeof_imm);
	ir_add(val_scalar_get_irval(out), val_scalar_get_irval(out), ref rhs_addition_bytes);
};

val_from_node_expr_call : func(ctx : source_context mut?, out : val mut?  -> v0)
{
	// we expect callee scalar
	callee_node ::= ast_call_get_callee(ctx->node);

	callee_ctx : source_context mut := [ctx];
	callee_ctx.node = callee_node;

	callee_val : val mut;
	val_from_node(ref callee_ctx, ref callee_val);
	val_load_if_pointer(ref callee_val, ref callee_val);
	callee_fnty ::= callee_val.type;
	if(ty_is_function(callee_fnty) == false)
	{
		err_begin();
		putzstr("call to non-callable type \0");
		putchar('"');
		putty(callee_fnty);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, callee_node->src_beg@u64, callee_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(ctx->type_only)
	{
		// return type of the function-type callable
		out->tag = val_tag.invalid;
		out->type = ty_underlying(callee_fnty);
		return;
	}
	fnty_u ::= ty_unwrap(callee_fnty);

	param_chunks : abi_chunk mut? mut;
	param_chunks_count : u64 mut;
	param_chunks_cursor : u64 mut := 0;
	abi_chunk_tys(abi_tag.psy64, fnty_u->members, fnty_u->members_count, ref param_chunks, ref param_chunks_count, scratch_arena);
	param_irvals : irval mut? := arena_alloc(scratch_arena, param_chunks_count * sizeof irval);

	param_count ::= ty_countof(callee_fnty);
	param_nodes ::= ast_call_get_params(ctx->node);
	i : u64 mut;
	for(i = 0; i < param_count; i = i + 1)
	{
		cur_param_val : val mut;
		cur_param_ctx : source_context mut := [ctx];
		cur_param_ctx.node = param_nodes # i;
		val_from_node(ref cur_param_ctx, ref cur_param_val);
		val_load_if_pointer(ref cur_param_val, ref cur_param_val);
		val_conv(ref cur_param_val, ty_at(callee_fnty, i), ref cur_param_val, ref cur_param_ctx);
		
		// place it into param_irvals
		// should be able to safely assume cur_param_val is a scalar with 0 displacement? coz it was loaded? maybe not necessarily?
		if(cur_param_val.tag == val_tag.scalar)
		{
			if([val_scalar_get_displacement(ref cur_param_val)]@u64 != 0)
			{
				panic_begin();
				putzstr("detected scalar call param value with nonzero displacement... should realise the displacement via a fused-multiply-add at \0");
				putsrc(ctx->src, cur_param_ctx.node->src_beg@u64, cur_param_ctx.node->src_end@u64, putcol.red_underline);
				panic_end();
			}
			[param_irvals # param_chunks_cursor] = [val_scalar_get_irval(ref cur_param_val)];
			param_chunks_cursor = param_chunks_cursor + 1;
		}
		if(cur_param_val.tag == val_tag.aggregate)
		{
			j : u64 mut;
			agg_vals ::= [val_aggregate_get_members(ref cur_param_val)];
			agg_vals_count ::= [val_aggregate_get_members_count(ref cur_param_val)];
			for(j = 0; j < agg_vals_count; j = j + 1)
			{
				[param_irvals # (param_chunks_cursor + j)] = [val_scalar_get_irval(agg_vals # j)];
			}
			param_chunks_cursor = param_chunks_cursor + agg_vals_count;
		}
	}

	// now return chunks
	return_chunks : abi_chunk mut? mut;
	return_chunks_count : u64 mut;
	abi_chunk_tys(abi_tag.psy64, ref(fnty_u->underlying), 1, ref return_chunks, ref return_chunks_count, global_arena);
	return_irvals : irval mut? := arena_alloc(scratch_arena, return_chunks_count * sizeof irval);
	return_szs : irsz mut? := arena_alloc(scratch_arena, return_chunks_count * sizeof irsz);
	for(i = 0; i < return_chunks_count; i = i + 1)
	{
		[return_szs # i] = abi_chunk_as_irsz(return_chunks # i);
	}
	ir_call(return_szs, return_chunks_count, val_scalar_get_irval(ref callee_val), param_irvals, param_chunks_count, return_irvals);
	if(return_chunks_count == 0)
	{
		return;
	}
	if(return_chunks_count == 1)
	{
		out->tag = val_tag.scalar;
		[val_scalar_get_irval(out)] = [return_irvals # 0];
		[val_scalar_get_displacement(out)] = 0;
		return;
	}
	out->tag = val_tag.aggregate;
	[val_aggregate_get_chunks(out)] = return_chunks;
	[val_aggregate_get_members_count(out)] = return_chunks_count;
	out_agg_vals : val mut? := arena_alloc(global_arena, return_chunks_count * sizeof val);
	[val_aggregate_get_members(out)] = out_agg_vals;
	for(i = 0; i < return_chunks_count; i = i + 1)
	{
		cur_out_agg_val ::= out_agg_vals # i;
		cur_out_agg_val->tag = val_tag.scalar;
		[val_scalar_get_irval(cur_out_agg_val)] = [return_irvals # i];
		[val_scalar_get_displacement(cur_out_agg_val)] = 0;
	}
};

val_from_node_expr_blkinit : func(ctx : source_context mut?, out : val mut?  -> v0)
{
	out->tag = val_tag.aggregate;
	typename_ctx : source_context mut := [ctx];
	typename_ctx.node = ast_blkinit_get_typename(ctx->node);
	out->type = ty_from_typename_node(ref typename_ctx);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("block initialiser of unknown type at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		out->tag = val_tag.invalid;
		return;
	}
	members_count ::= ty_countof(out->type);
	chunks_count : u64 mut;
	i : u64 mut;
	j : u64 mut;
	// populate the output as an aggregate
	if(ty_is_structure(out->type))
	{
		// struct - chunk the type itself (so the chunker knows we are a struct and respects our alignments/offsets etc)
		abi_chunk_tys(abi_tag.psy64, ref(out->type), 1, val_aggregate_get_chunks(out), ref chunks_count, global_arena);
		// because we only chunked 1 type (the struct), all the src_idx_begins are 0
		// let's manually patch them to what they should be
		for(i = 0; i < members_count; i = i + 1)
		{
			off ::= abi_offsetof_struct(abi_tag.psy64, out->type, i);
			for(j = 0; j < chunks_count; j = j + 1)
			{
				curchunk ::= [val_aggregate_get_chunks(out)] # j;
				if(curchunk->src_byte_offset >= off)
				{
					curchunk->src_idx_begin = i;
					curchunk->src_idx_end = i;
				}
			}
		}
	}
	else
	{
		// array.
		cumulative_array_types : ty mut? := arena_alloc(scratch_arena, members_count * sizeof ty);
		for(i = 0; i < members_count; i = i + 1)
		{
			[cumulative_array_types # i] = ty_underlying(out->type);
		}
		abi_chunk_tys(abi_tag.psy64, cumulative_array_types # 0, members_count, val_aggregate_get_chunks(out), ref chunks_count, global_arena);
	}
	[val_aggregate_get_members_count(out)] = chunks_count;
	chunk_vals : val mut? := arena_alloc(global_arena, chunks_count * sizeof typeof(val));
	[val_aggregate_get_members(out)] = chunk_vals;

	// the output is already ready, but chunk_vals is a pointer to its aggregate values, which we need to populate.
	// fill them all with val_tag.invalid for now and overwrite them later (that lets us check if the user did not initialise everything by checking for invalid-ness)
	for(i = 0; i < chunks_count; i = i + 1)
	{
		(chunk_vals # i)->tag = val_tag.invalid;
	}
	init_nodes ::= ast_blkinit_get_inits(ctx->node);
	inits_count ::= ast_blkinit_get_inits_count(ctx->node)@u64;
	member_idx : u64 mut;
	cur_chunk : abi_chunk mut? mut;

	for(i = 0; i < inits_count; i = i + 1)
	{
		init_node ::= init_nodes # i;
		// find out our member idx
		init_tag ::= [ast_init_get_tag(init_node)];
		if(init_tag == ast_init_tag.ellipsis)
		{
			panic_begin();
			putzstr("ellipsis syntax in initialisers is NYI at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			panic_end();
		}
		if(init_tag == ast_init_tag.integer)
		{
			member_idx = [ast_init_get_integer(init_node)]@u64;
		}
		if(init_tag == ast_init_tag.symbol)
		{
			// todo: assert out->type is a structure and not an array
			member_idx = ty_struct_find(out->type, [ast_init_get_symbol(init_node)], [ast_init_get_symbol_len(init_node)]);
		}
		if(member_idx >= ty_countof(out->type))
		{
			err_begin();
			putzstr("initialiser did not correspond to a valid member of the aggregate-type \0");
			putchar('"');
			putty(out->type);
			putchar('"');
			putzstr(" at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			err_end();
		}
		// our member value will correspond to one (scalar) or more (aggregate) members of chunk_vals
		// let's find the offset to the correct chunk(s) and set member_idx_as_chunk_idx to it
		member_idx_as_chunk_idx : u64 mut := ~0;
		for(j = 0; j < chunks_count; j = j + 1)
		{
			cur_chunk = [val_aggregate_get_chunks(out)] # j;
			if(cur_chunk->src_idx_begin == member_idx)
			{
				member_idx_as_chunk_idx = j;
				j = chunks_count;
			}
		}
		if(member_idx_as_chunk_idx == ~0)
		{
			panic_begin();
			putzstr("for type \0");
			putty(out->type);
			putzstr(", unable to convert member-idx \0");
			putuint(member_idx);
			putzstr(" to a chunk-idx (there are \0");
			putuint(chunks_count);
			putzstr(" chunks) at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			panic_end();
		}
		if((chunk_vals # member_idx_as_chunk_idx)->tag != val_tag.invalid)
		{
			warn_begin();
			putzstr("chunk \0");
			putuint(member_idx_as_chunk_idx);
			putzstr(" within block-initialiser is initialised more than once at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.yellow_underline);
			warn_end();
		}
		// finally get the val for the initialised member and convert it to the type
		cur_member_val : val mut;

		init_expr_ctx : source_context mut := [ctx];
		init_expr_ctx.node = ast_init_get_expr(init_node);
		if(ast_is_expr(init_expr_ctx.node, ast_expr_tag.zero_value))
		{
			// handle zero value
			val_zero_as(ty_at(out->type, member_idx), ref cur_member_val);
		}
		else
		{
			val_from_node(ref init_expr_ctx, ref cur_member_val);
			val_conv(ref cur_member_val, ty_at(out->type, member_idx), ref cur_member_val, ref init_expr_ctx);
		}
		// if we are a scalar we just write to chunk_vals[member_idx_as_chunk_idx]
		// if we are an aggregate then we siomply write to chunk_vals[member_idx_as_chunk_idx...val_aggregate_get_members_count]
		if(cur_member_val.tag == val_tag.scalar)
		{
			[chunk_vals # member_idx_as_chunk_idx] = cur_member_val;
		}
		if(cur_member_val.tag == val_tag.aggregate)
		{
			cur_agg_count ::= [val_aggregate_get_members_count(ref cur_member_val)];
			cur_agg_chunks ::= [val_aggregate_get_members(ref cur_member_val)];
			for(j = 0; j < cur_agg_count; j = j + 1)
			{
				[chunk_vals # (member_idx_as_chunk_idx + j)] = [cur_agg_chunks # j];
			}
		}
		if((cur_member_val.tag != val_tag.scalar) && (cur_member_val.tag != val_tag.aggregate))
		{
			panic_begin();
			putzstr("unexpected val_tag.\0");
			putsint(cur_member_val.tag@s64);
			putzstr(", expected scalar/aggregate at \0");
			putsrc(ctx->src, init_node->src_beg@u64, init_node->src_end@u64, putcol.red_underline);
			panic_end();
		}
	}

	// iterate again and error out if we didnt initialise any of the chunks
	for(i = 0; i < chunks_count; i = i + 1)
	{
		cur_chunk = [val_aggregate_get_chunks(out)] # i;
		if((chunk_vals # i)->tag == val_tag.invalid)
		{
			err_begin();
			putzstr("block initialiser failed to initialise member \0");
			putuint(cur_chunk->src_idx_begin);
			if(ty_is_structure(out->type))
			{
				struct_member_decl ::= ast_structure_get_data_members(ty_unwrap(out->type)->reference) # i;
				putzstr(" ('\0");
				putchars([ast_decl_get_name(struct_member_decl)], [ast_decl_get_name_len(struct_member_decl)]);
				putzstr("')");
			}
			putzstr(" at \0");
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
};

val_from_node_expr_dereference : func(ctx : source_context mut?, out : val mut?  -> v0)
{
	operand_node ::= ast_dereference_get_operand(ctx->node);

	operand_ctx : source_context mut := [ctx];
	operand_ctx.node = operand_node;
	operand_val : val mut;
	val_from_node(ref operand_ctx, ref operand_val);
	val_load_if_pointer(ref operand_val, ref operand_val);
	
	if(ty_is_pointer(operand_val.type) == false)
	{
		err_begin();
		putzstr("cannot dereference non-pointer-type \0");
		putchar('"');
		putty(operand_val.type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->type = ty_underlying(operand_val.type);
	if(ctx->type_only)
	{
		out->tag = val_tag.invalid;
		return;
	}

	// operand_val is always a scalar
	out->tag = val_tag.pointer;
	[val_pointer_get_irval(out)] = [val_scalar_get_irval(ref operand_val)];
	[val_pointer_get_displacement(out)] = [val_scalar_get_displacement(ref operand_val)];
};

val_from_node_expr_cast : func(ctx : source_context mut?, out : val mut?  -> v0)
{
	castee_node ::= ast_cast_get_castee(ctx->node);
	castee_ctx : source_context mut := [ctx];
	castee_ctx.node = castee_node;
	castee_val : val mut;
	val_from_node(ref castee_ctx, ref castee_val);
	// get the castee (as a scalar/aggregate)
	val_load_if_pointer(ref castee_val, ref castee_val);

	cast_to_node ::= ast_cast_get_cast_typename(ctx->node);
	cast_to_ctx : source_context mut := [ctx];
	cast_to_ctx.node = cast_to_node;

	to ::= ty_from_typename_node(ref cast_to_ctx);
	if(to == ty.invalid)
	{
		err_begin();
		putzstr("cast target is not a valid type at \0");
		putsrc(ctx->src, cast_to_node->src_beg@u64, cast_to_node->src_end@u64, putcol.red_underline);
		err_end();
	}

	if(ctx->type_only)
	{
		out->type = to;
		out->tag = val_tag.invalid;
		return;
	}
	// just convert it to the casted-to type (and the result goes into 'out')
	val_conv(ref castee_val, to, out, ctx);
};

val_from_node_expr_field : func(ctx : source_context mut?, out : val mut? -> v0)
{
	// check if lhs is a symbol that matches an enum name
	lhs_node ::= ast_field_get_lhs(ctx->node);
	rhs_node ::= ast_field_get_rhs(ctx->node);
	is_ptr_field ::= [ast_field_get_parse_state(ctx->node)] == ast_field_parse_state.finalisedarrow;
	if(ast_is_expr(lhs_node, ast_expr_tag.symbol) && (is_ptr_field == false))
	{
		lhs_as_type ::= ty_find_by_name([ast_symbol_get_data(lhs_node)], [ast_symbol_get_data_len(lhs_node)]);
		if(lhs_as_type != ty.invalid)
		{
			if(ty_is_enumeration(lhs_as_type))
			{
				val_from_node_expr_enum_field(lhs_as_type, rhs_node, ctx, out);
				return;
			}
		}
	}
	lhs_ctx : source_context mut := [ctx];
	lhs_ctx.node = lhs_node;
	lhs : val mut;
	val_from_node(ref lhs_ctx, ref lhs);

	// check if the lhs type is kosher
	lhs_access_type : ty mut := lhs.type;
	if(is_ptr_field)
	{
		lhs_access_type = ty_underlying(lhs.type);
	}

	if(ty_is_structure(lhs_access_type) == false)
	{
		err_begin();
		putzstr("invalid aggregate access field expression of non-struct-type \0");
		putchar('"');
		putty(lhs_access_type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, lhs_node->src_beg@u64, lhs_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	// e.g global.foo
	// global is a val_tag.pointer and we want to just offset it
	// so we add a displacement to the pointer and thats it
	// but global could also be an aggregate

	// what about global->foo
	// well if its a pointer, we need to load it to get the pointer-scalar
	if(is_ptr_field)
	{
		val_load_if_pointer(ref lhs, ref lhs);
	}

	rhs_sym_node : ast mut? mut;
	// now the rhs is either a symbol or call. lets get the symbol node
	if(ast_is_expr(rhs_node, ast_expr_tag.symbol))
	{
		rhs_sym_node = rhs_node;
	}
	else
	{
		if(ast_is_expr(rhs_node, ast_expr_tag.call))
		{
			rhs_sym_node = ast_call_get_callee(rhs_node);
		}
		else
		{
			err_begin();
			putzstr("an aggregate lhs field expression must have a rhs expression that is either a symbol or call, but you have provided neither at \0");
			putsrc(ctx->src, rhs_node->src_beg@u64, rhs_node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}

	// now find the member associated with the symbol
	struct_memidx ::= ty_struct_find(lhs_access_type, [ast_symbol_get_data(rhs_sym_node)], [ast_symbol_get_data_len(rhs_sym_node)]);
	if(struct_memidx == ~0)
	{
		err_begin();
		putzstr("structure type \0");
		putchar('"');
		putty(lhs_access_type);
		putchar('"');
		putzstr(" has no member named \0");
		putchar('"');
		putchars([ast_symbol_get_data(rhs_sym_node)], [ast_symbol_get_data_len(rhs_sym_node)]);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, rhs_sym_node->src_beg@u64, rhs_sym_node->src_end@u64, putcol.red_underline);
		err_end();
	}

	// remember we inherit mutness etc from the lhs type
	out->type = ty_copy_quals(lhs_access_type, ty_at(lhs_access_type, struct_memidx));
	if(ctx->type_only)
	{
		out->tag = val_tag.invalid;
		return;
	}
	// finally, access lhs using the struct_memidx
	// lhs can be a few things (note: could be bugs in any of these havent really tested yet)
	// pointer - add a displacement to it corresponding to struct_memidx
	if(lhs.tag == val_tag.pointer)
	{
		out->tag = val_tag.pointer;
		[val_pointer_get_irval(out)] = [val_pointer_get_irval(ref lhs)];
		[val_pointer_get_displacement(out)] = [val_pointer_get_displacement(ref lhs)] + abi_offsetof_struct(abi_tag.psy64, lhs_access_type, struct_memidx)@s32;
		return;
	}
	i : u64 mut;
	// aggregate - just grab the relevant values
	if(lhs.tag == val_tag.aggregate)
	{
		chunk_offset_begin : u64 mut := ~0;
		agg_count ::= [val_aggregate_get_members_count(ref lhs)];
		agg_vals ::= [val_aggregate_get_members(ref lhs)];
		agg_chunks ::= [val_aggregate_get_chunks(ref lhs)];
		for(i = 0; i < agg_count; i = i + 1)
		{
			cur_agg_chunk ::= agg_chunks # i;
			if(cur_agg_chunk->src_idx_begin == struct_memidx)
			{
				// this is our chunk
				chunk_offset_begin = i;
				i = agg_count;
			}
		}
		if(chunk_offset_begin == ~0)
		{
			panic_begin();
			putzstr("in field-expr access of aggregate value, failed to match member \0");
			putuint(struct_memidx);
			putzstr(" of struct-type \0");
			putty(lhs_access_type);
			putzstr(" at \0");
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			panic_end();
		}
		// chunk out the output type and see if we are also going to be an aggregate or a scalar
		field_chunks : abi_chunk mut? mut;
		field_chunks_count : u64 mut;
		abi_chunk_tys(abi_tag.psy64, ref(out->type), 1, ref field_chunks, ref field_chunks_count, global_arena);
		if(field_chunks_count == 1)
		{
			out->tag = val_tag.scalar;
			[val_scalar_get_irval(out)] = [val_scalar_get_irval(agg_vals # chunk_offset_begin)];
			[val_scalar_get_displacement(out)] = 0;
			return;
		}
		// more than 1, so its an aggregate aswell
		out->tag = val_tag.aggregate;
		[val_aggregate_get_members_count(out)] = field_chunks_count;
		[val_aggregate_get_chunks(out)] = field_chunks;
		// create members ptr and populate them for the output
		out_agg_members : val mut? := arena_alloc(global_arena, field_chunks_count * sizeof val);
		[val_aggregate_get_members(out)] = out_agg_members;
		for(i = 0; i < field_chunks_count; i = i + 1)
		{
			// gets a little bit nasty but we're almost there.
			out_cur_agg_member ::= out_agg_members # i;
			out_cur_agg_member->type = ty_at(out->type, (field_chunks # i)->src_idx_begin);
			out_cur_agg_member->tag = val_tag.scalar;
			[val_scalar_get_irval(out_cur_agg_member)] = [val_scalar_get_irval(agg_vals # (chunk_offset_begin + i))];
			[val_scalar_get_displacement(out_cur_agg_member)] = 0;
		}
		return;
	}
	// scalar - convert to a pointer and add a displacement to it
	// (we expect to see this if we are a pointer-field and we've just loaded our pointer)
	if(lhs.tag == val_tag.scalar)
	{
		out->tag = val_tag.pointer;
		[val_pointer_get_irval(out)] = [val_scalar_get_irval(ref lhs)];
		[val_pointer_get_displacement(out)] = [val_scalar_get_displacement(ref lhs)] + abi_offsetof_struct(abi_tag.psy64, lhs_access_type, struct_memidx)@s32;
		return;
	}

	panic_begin();
	putzstr("todo: val_from_node_expr_field at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_enum_field : func(type : ty, rhs_symbol_node : ast mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	// we are dealing with a field expression, but the lhs was a symbol that corresponded to an enum type (provided here via the 'type' parameter)
	// in this case, we assume it is not a struct-access and assert that the rhs is a symbol corresponding to an enum entry
	// if it is, 'out' becomes a scalar immediate corresponding to the entry.
	// if it isn't, error out.
	// if we are type only do not do ir stuff.
	out->tag = val_tag.scalar;
	out->type = type;
	if(ctx->type_only)
	{
		out->type = type;
		return;
	}
	if(ast_is_expr(rhs_symbol_node, ast_expr_tag.symbol) == false)
	{
		err_begin();
		putzstr("lhs of field-expression was enum type \0");
		putchar('"');
		putty(type);
		putchar('"');
		putzstr(", but the rhs was not a symbol expression. it should be a symbol corresponding to an entry name of the enum type at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	entry_value ::= ty_enum_find(type, [ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
	if(entry_value == zero)
	{
		err_begin();
		putzstr("enum type \0");
		putchar('"');
		putty(type);
		putchar('"');
		putzstr(" had no entry named \0");
		putchar('"');
		putchars([ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	irval_qimm([entry_value], val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_countof : func(ctx : source_context mut?, out : val mut? -> v0)
{
	countof_typename_ctx : source_context mut := [ctx];
	countof_typename_ctx.node = ast_countof_get_operand(ctx->node);
	type ::= ty_from_typename_node(ref countof_typename_ctx);
	// if we are type only do not do ir stuff.

	out->type = ty_integer_literal();
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}
	irval_qimm(ty_countof(type), val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_stmt : func(ctx : source_context mut?, out : val mut? -> v0)
{
	[val_from_node_stmt_tbl # ([ast_stmt_get_tag(ctx->node)]@s64)](ctx, out);
};

val_from_node_stmt_nyi : func(ctx : source_context mut?, out : val mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node_stmt NYI for ast_stmt_tag.\0");
	putsint([ast_stmt_get_tag(ctx->node)]@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_conv : func(in : val mut?, to : ty, out : val mut?, ctx : source_context mut? -> v0)
{
	conv ::= ty_converts_to(in->type, to);
	if(tyconv_is_valid(conv))
	{
		if(ctx->type_only)
		{
			out->type = to;
			out->tag = val_tag.scalar;
			return;
		}
		val_load_if_pointer(in, in);
		[val_conv_tbl # (in->tag@s64)](in, to, out, conv, ctx);
		return;
	}
	err_begin();
	putzstr("cannot convert value of type \0");
	putchar('"');
	putty(in->type);
	putchar('"');
	putzstr(" to type \0");
	putchar('"');
	putty(to);
	putchar('"');
	if(conv == tyconv.no_cant_add_staticness)
	{
		putzstr(" (because doing so would add staticness)\0");
	}
	if(conv == tyconv.no_but_yes_with_weak)
	{
		putzstr(" (but could if one were marked 'weak')\0");
	}
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	err_end();
};

val_conv_invalid : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	panic_begin();
	putzstr("reached val_conv_invalid at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_conv_scalar : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	[val_conv_scalar_tbl # (conv@s64)](in, to, out, conv, ctx);
};

val_conv_scalar_nyi : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	panic_begin();
	putzstr("reached val_conv_scalar_nyi for tyconv.\0");
	putsint(conv@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_conv_scalar_noop : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	// noop
	[out] = [in];
	out->type = to;
};

val_conv_scalar_trunc : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	size_bytes ::= ty_integral_size(to);
	sz : irsz mut := irsz.none;
	if(size_bytes == 1)
	{
		sz = irsz.b;
	}
	if(size_bytes == 2)
	{
		sz = irsz.w;
	}
	if(size_bytes == 4)
	{
		sz = irsz.d;
	}
	if(size_bytes == 8)
	{
		sz = irsz.q;
	}
	out->tag = val_tag.scalar;
	out->type = to;
	ir_trunc(val_scalar_get_irval(out), sz, val_scalar_get_irval(in));
	[val_scalar_get_displacement(out)] = 0;
};

val_conv_pointer : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	panic_begin();
	putzstr("todo: val_conv_pointer at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_conv_aggregate : func(in : val mut?, to : ty, out : val mut?, conv : tyconv, ctx : source_context mut? -> v0)
{
	if(ty_strip(in->type) != ty_strip(to))
	{
		panic_begin();
		putzstr("requested to convert aggregate value of type \0");
		putty(in->type);
		putzstr(" to dissimilar type \0");
		putty(to);
		putzstr(" - this should've been caught and error'd properly earlier at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	// noop
	[out] = [in];
	out->type = to;
};

val_from_node_tbl ::= typeof(val_from_node)[countof ast_tag]
{
	.0 := val_from_node_nyi;
	.1 := val_from_node_nyi;
	.2 := val_from_node_expr;
	.3 := val_from_node_stmt;
	.4 := val_from_node_nyi;
	.5 := val_from_node_nyi;
	.6 := val_from_node_nyi;
	.7 := val_from_node_nyi;
	.8 := val_from_node_nyi;
	.9 := val_from_node_nyi;
	.10 := val_from_node_nyi;
