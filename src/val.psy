val_tag : enum
{
	// not a valid value (no data)
	.invalid := 0;
	// a type with no value (d0 = type)
	.typeonly := 1;
	// a value of 'zero' with no type (no data)
	.zerovalue := 2;
	// a scalar literal known at compile time (d0 = integer/floating-point/bool)
	.scalar_literal := 3;
	// a string literal (d0 = data u8?, d1 = len)
	.string_literal := 4;
	// an aggregate (struct/array) literal known at compile time (d0 = pointer to val? members, must be size == ty_countof(type))
	.aggregate_literal := 5;
	// a pointer literal known at compile time (d0 = address)
	.pointer_literal := 6;
	// a reference to a function (d0 = function_t mut?)
	.function_reference := 7;
	// a reference to a variable (d0 = variable_t mut?)
	.variable_reference := 8;
	// a reference to an assembly (d0 = assembly_t mut?)
	.assembly_reference := 9;
	// a runtime scalar value (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.scalar := 10;
	// similar to scalar, but the irval stores a pointer to the value instead of the value directly (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.pointer := 11;
	// a bunch of irvals representing a complex value such as a struct value (d0 = member irvals?, d1 = count of members. remember this isnt necessarily the number of members of the struct)
	.aggregate := 12;
};

val : struct
{
	tag : val_tag;
	// datapoint 0 - use depends on tag
	d0 : u64;
	// datapoint 1 - use depends on tag
	d1 : u64;
	// datapoint 2 - use depends on tag
	d2 : u64;
	// datapoint 3 - use depends on tag
	d3 : u64;
	// datapoint 4 - use depends on tag
	d4 : u64;
	// type
	type : ty;
};

val_context : struct
{
	node : ast mut?;
	parent_fn : function_t mut?;
	src : source;
};

val_is_known_at_compile_time : func(v : val mut? -> bool)
{
	t ::= v->tag;
	return (t == val_tag.typeonly)
		|| (t == val_tag.zerovalue)
		|| (t == val_tag.scalar_literal)
		|| (t == val_tag.string_literal)
		|| (t == val_tag.aggregate_literal)
		|| (t == val_tag.pointer_literal)
		|| (t == val_tag.function_reference)
		|| (t == val_tag.variable_reference)
		|| (t == val_tag.assembly_reference);
};

val_scalar_literal_get_integer : func(v : val mut? -> s64 mut?)
{
	return ref(v->d0)@s64 mut?;
};

val_scalar_literal_get_floating_point : func(v : val mut? -> f64 mut?)
{
	return ref(v->d0)@f64 mut?;
};

val_scalar_literal_get_bool : func(v : val mut? -> bool mut?)
{
	return ref(v->d0)@bool mut?;
};

val_string_literal_get_data : func(v : val mut? -> u8 mut? mut?)
{
	return ref(v->d0)@u8 mut? mut?;
};

val_string_literal_get_length : func(v : val mut? -> u64 mut?)
{
	return ref(v->d1)@u64 mut?;
};

val_aggregate_literal_get_members : func(v : val mut? -> val mut? mut?)
{
	return ref(v->d0)@val mut? mut?;
};

// remember the members count is decided by the type and is thus *not* stored separately
val_aggregate_literal_get_members_count : func(v : val mut? -> u64)
{
	return ty_countof(v->type);
};

val_pointer_literal_get_address : func(v : val mut? -> u64 mut?)
{
	return ref(v->d0)@u64 mut?;
};

val_function_reference_get_function : func(v : val mut? -> function_t mut? mut?)
{
	return ref(v->d0)@function_t mut? mut?;
};

val_variable_reference_get_variable : func(v : val mut? -> variable_t mut? mut?)
{
	return ref(v->d0)@variable_t mut? mut?;
};

val_assembly_reference_get_assembly : func(v : val mut? -> assembly_t mut? mut?)
{
	return ref(v->d0)@assembly_t mut? mut?;
};

// note HH: sizeof(val.d1->end) must be >= sizeof(irval) otherwise this will buffer overrun
val_scalar_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d0)@irval mut?;
};

val_pointer_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d0)@irval mut?;
};

val_aggregate_get_members : func(v : val mut? -> val mut? mut?)
{
	return ref(v->d0)@val mut? mut?;
};

val_aggregate_get_members_count : func(v : val mut? -> u64 mut?)
{
	return ref(v->d1)@u64 mut?;
};

val_aggregate_get_chunks : func(v : val mut? -> abi_chunk mut? mut?)
{
	return ref(v->d2)@abi_chunk mut? mut?;
};

val_convert_nyi : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	panic_begin();
	putzstr("val_convert NYI for val_tag.\0");
	putsint(v->tag@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_invalid : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	panic_begin();
	putzstr("val_convert called on an invalid value at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_typeonly : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	out->tag = val_tag.typeonly;
};

val_convert_zerovalue : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	val_zero_as(to, out);
};

val_convert_scalar_literal : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	// same thing
	if(resolve == val_resolve.compiletime_only)
	{
		return;
	}
	// need to turn this into a runtime scalar
	out->tag = val_tag.scalar;
	// workaround enum types being a bit awkward
	real_type : ty mut := to;
	if(ty_is_enumeration(to))
	{
		real_type = ty_underlying(to);
	}
	isz ::= ty_integral_size(real_type);
	fsz ::= ty_floating_point_size(real_type);
	if(isz == 8)
	{
		irval_qimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 4)
	{
		irval_dimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 2)
	{
		irval_wimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 1)
	{
		irval_bimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(fsz == 8)
	{
		irval_gimm([val_scalar_literal_get_floating_point(v)], val_scalar_get_irval(out));
		return;
	}
	if(fsz == 4)
	{
		irval_fimm([val_scalar_literal_get_floating_point(v)], val_scalar_get_irval(out));
		return;
	}
	panic_begin();
	putzstr("val_convert_scalar_literal to runtime value for type \0");
	putchar('"');
	putty(to);
	putchar('"');
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_string_literal : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	if(resolve == val_resolve.compiletime_only)
	{
		// we're at compile-time so we can just keep the string literal
		[out] = [v];
		out->type = to;
		return;
	}
	if(ty_is_pointer(to))
	{
		// assume we are converting to any pointer
		// add a global variable containing the string data
		globref_ptr ::= val_pointer_get_irval(out);
		ir_add_glob([val_string_literal_get_data(v)], [val_string_literal_get_length(v)], false, globref_ptr);
		out->tag = val_tag.pointer;
		return;
	}
	panic_begin();
	putzstr("val_convert_string_literal NYI for non-pointer type \0");
	putchar('"');
	putty(to);
	putchar('"');
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_aggregate_literal : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	// aggregate conversions only happen if the conversion is a noop
};

val_convert_function_reference : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	// what if we are val_resolve.runtime_only?
	[out] = [v];
};

val_convert_variable_reference : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	val_convert(ref([val_variable_reference_get_variable(v)]->storage), to, out, resolve, ctx);
};

val_convert_scalar_nyi : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	panic_begin();
	putzstr("val_convert_scalar NYT for tyconv.\0");
	putsint(conv@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_scalar : func(v : val mut?, to : ty, out : val mut?, conv : tyconv, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	[val_convert_scalar_tbl # conv@s64](v, to, out, conv, resolve, ctx);
};


val_convert : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	if(v->tag == val_tag.zerovalue)
	{
		val_convert_zerovalue(v, to, out, tyconv.noop, resolve, ctx);
		return;
	}
	conv ::= ty_converts_to(v->type, to);
	if((conv == tyconv.no) || (conv == tyconv.no_cant_add_staticness) || (conv == tyconv.no_but_yes_with_weak))
	{
		err_begin();
		putzstr("cannot convert value of type \0");
		putchar('"');
		putty(v->type);
		putchar('"');
		putzstr(" to type \0");
		putchar('"');
		putty(to);
		putchar('"');
		if(conv == tyconv.no_cant_add_staticness)
		{
			putzstr(" (because doing so would add staticness)\0");
		}
		if(conv == tyconv.no_but_yes_with_weak)
		{
			putzstr(" (but could if one were marked 'weak')\0");
		}
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}	
	out->type = to;
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(conv == tyconv.noop)
	{
		return;
	}
	[val_convert_tbl # (v->tag@s64)](v, to, out, conv, resolve, ctx);
};

val_zero_as : func(to : ty, out : val mut? -> v0)
{
	i : u64 mut;
	out->type = to;
	if((ty_integral_size(to) != 0) || ty_is_enumeration(to))
	{
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_integer(out)] = 0;
		return;
	}
	if(ty_is_pointer(to))
	{
		out->tag = val_tag.pointer_literal;
		[val_pointer_literal_get_address(out)] = 0;
		return;
	}
	if(ty_is_function(to))
	{
		out->tag = val_tag.pointer_literal;
		[val_pointer_literal_get_address(out)] = 0;
		return;
	}
	if(ty_is_bool(to))
	{
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_bool(out)] = false;
		return;
	}
	if(ty_is_array(to) || ty_is_structure(to))
	{
		out->tag = val_tag.aggregate_literal;
		members_count ::= ty_countof(to);
		members_ptr : val mut? := arena_alloc(global_arena, members_count * sizeof val);
		for(i = 0; i < members_count; i = i + 1)
		{
			val_zero_as(ty_at(to, i), members_ptr # i);
		}
		[val_aggregate_literal_get_members(out)] = members_ptr;
		return;
	}
	panic_begin();
	putzstr("reached end of val_zero_as for type \0");
	putchar('"');
	putty(to);
	putchar('"');
	panic_end();
};

val_resolve : enum
{
	.type_only := 0;
	.compiletime_only := 1;
	.runtime_only := 2;
};

// val operations

val_from_type : func(type : ty, out : val mut? -> v0)
{
	out->tag = val_tag.typeonly;
	out->type = type;
};

val_from_node : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	[val_from_node_tbl # (ctx->node->tag@s64)](ctx, out, resolve);
};

val_from_node_nyi : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	panic_begin();
	putzstr("val_from_node NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(ctx->node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_node_expr : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	[val_from_node_expr_tbl # ([ast_expr_get_tag(ctx->node)])@s64](ctx, out, resolve);
};

val_from_node_stmt : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	[val_from_node_stmt_tbl # ([ast_stmt_get_tag(ctx->node)]@s64)](ctx, out, resolve);
};

val_from_node_stmt_nyi : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	panic_begin();
	putzstr("val_from_node_stmt NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(ctx->node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_node_expr_nyi : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(ctx->node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_node_expr_literal : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	[val_from_node_expr_literal_tbl # [ast_literal_get_tag(ctx->node)]@s64](ctx, out, resolve);
};

val_from_node_expr_zero_value : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->tag = val_tag.zerovalue;
	out->type = ty.invalid;
};

val_from_node_expr_symbol : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	sym ::= [ast_symbol_get_data(ctx->node)];
	symlen ::= [ast_symbol_get_data_len(ctx->node)];

	scope : scope_t mut? mut := ref(prog.global_scope);
	if(ctx->parent_fn != zero)
	{
		scope = ref(ctx->parent_fn->scope);
	}

	maybe_var ::= scope_find_variable(scope, sym, symlen);
	if(maybe_var != zero)
	{
		out->tag = val_tag.variable_reference;
		[val_variable_reference_get_variable(out)] = maybe_var;
		out->type = maybe_var->type;
		return;
	}

	maybe_func ::= scope_find_function(scope, sym, symlen);
	if(maybe_func != zero)
	{
		out->tag = val_tag.function_reference;
		[val_function_reference_get_function(out)] = maybe_func;
		out->type = maybe_func->type;
		return;
	}

	maybe_ty ::= ty_find_by_name(sym, symlen);
	if(maybe_ty != ty.invalid)
	{
		out->tag = val_tag.typeonly;
		out->type = maybe_ty;
		return;
	}

	if(ctx->parent_fn != zero)
	{
		// we checked the parent-fn and got nothing. let's check the global_scope instead
		top_level_ctx : val_context mut := [ctx];
		top_level_ctx.parent_fn = zero;
		val_from_node_expr_symbol(ref top_level_ctx, out, resolve);
		return;
	}
	panic_begin();
	putzstr("val_from_node_expr_symbol NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(ctx->node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_integer_literal : func(int : s64 weak, out : val mut? -> v0)
{
	out->tag = val_tag.scalar_literal;
	out->type = ty_integer_literal();
	[val_scalar_literal_get_integer(out)] = int;
};

val_from_node_expr_literal_integer : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->type = ty_integer_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_integer(out)] = [ast_literal_get_integer(ctx->node)];
};

val_from_node_expr_literal_floating_point : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->type = ty_floating_point_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_floating_point(out)] = [ast_literal_get_floating_point(ctx->node)];
};

val_from_node_expr_literal_char : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->type = ty_floating_point_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_integer(out)] = [ast_literal_get_char(ctx->node)]@s64;
};

val_from_node_expr_literal_string : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->type = ty_string_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.string_literal;
	[val_string_literal_get_data(out)] = [ast_literal_get_string(ctx->node)];
	[val_string_literal_get_length(out)] = [ast_literal_get_string_len(ctx->node)];
};

val_from_node_expr_literal_boolean : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	out->type = ty_boolean_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_integer(out)] = [ast_literal_get_bool(ctx->node)]@s64;
};

val_from_node_expr_literal_nyi : func(ctx : val_context mut?, out : val mut?, resolve : val_resolve -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_literal NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(ctx->node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.blue_underline);
	panic_end();
};

// if ptr_val is a val_tag.pointer, then 'out' will become either an aggregate or scalar value (depending on the type of 'ptr_val') containing the loaded value of the pointer. it will have the same type
val_load : func(abi : abi_tag, ptr_val : val mut?, out : val mut?, ctx : val_context mut? -> v0)
{
	if(ptr_val->tag != val_tag.pointer)
	{
		[out] = [ptr_val];
		return;
	}
	out->type = ptr_val->type;
	load_chunks : abi_chunk mut? mut;
	load_chunks_count : u64 mut;
	abi_chunk_tys(abi, ref(ptr_val->type), 1, ref load_chunks, ref load_chunks_count, scratch_arena);
	// easier codepath for scalars
	if(load_chunks_count == 1)
	{
		out->tag = val_tag.scalar;
		// todo: emit an ir_load on val_pointer_get_irval(ptr_val). result irval register should be written to val_scalar_get_irval(out)
		panic_begin();
		putzstr("nyi: ir_load call in val_load at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
		return;
	}
	// todo: return agg for 2+ chunks
	panic_begin();
	putzstr("reached end of val_load (load_chunks_count != 1, should be an agg)");
	panic_end();
};

val_from_node_expr_biop_assign : func(lhs : val mut?, lhs_node : ast mut?, rhs : val mut?, rhs_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
{
	rhs_conv : val mut;
	rhs_ctx : val_context mut := [ctx];
	rhs_ctx.node = rhs_node;
	val_convert(rhs, lhs->type, ref rhs_conv, resolve, ref rhs_ctx);

	out->type = lhs->type;
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(resolve == val_resolve.compiletime_only)
	{
		panic_begin();
		putzstr("compile-time assignment is NYI at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
		return;
	}
	rhs_conv : val mut;
	rhs_ctx : val_context mut := [ctx];
	rhs_ctx.node = rhs_node;
	val_load(abi_tag.psy64, rhs, ref rhs_conv, ref rhs_ctx);
	val_convert(ref rhs_conv, lhs->type, ref rhs_conv, resolve, ref rhs_ctx);
	if(rhs_conv.tag == val_tag.scalar)
	{
		ir_store(val_scalar_get_irval(ref rhs_conv), val_pointer_get_irval(lhs), 0);
		return;
	}
	// must be an aggregate then
	i : u64 mut;
	count ::= [val_aggregate_get_members_count(ref rhs_conv)];
	agg_members ::= [val_aggregate_get_members(ref rhs_conv)];
	agg_chunks ::= [val_aggregate_get_chunks(ref rhs_conv)];
	for(i = 0; i < count; i = i + 1)
	{
		ir_store(val_scalar_get_irval(agg_members # i), val_pointer_get_irval(lhs), (agg_chunks # i)->src_byte_offset@s32);
	}
};

val_from_node_expr_biop_compare_equal : func(lhs : val mut?, lhs_node : ast mut?, rhs : val mut?, rhs_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : val_context mut? -> v0)
