val_tag : enum
{
	// not a valid value (no data)
	.invalid := 0;
	// a type with no value (d0 = type)
	.typeonly := 1;
	// a value of 'zero' with no type (no data)
	.zerovalue := 2;
	// a scalar literal known at compile time (d0 = integer/floating-point/bool)
	.scalar_literal := 3;
	// a string literal (d0 = data u8?, d1 = len)
	.string_literal := 4;
	// an aggregate (struct/array) literal known at compile time (d0 = pointer to val? members, must be size == ty_countof(type))
	.aggregate_literal := 5;
	// a pointer literal known at compile time (d0 = address)
	.pointer_literal := 6;
	// a reference to a function (d0 = function_t mut?)
	.function_reference := 7;
	// a reference to a variable (d0 = variable_t mut?)
	.variable_reference := 8;
	// a reference to an assembly (d0 = assembly_t mut?)
	.assembly_reference := 9;
	// a runtime scalar value (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.scalar := 10;
	// similar to scalar, but the irval stores a pointer to the value instead of the value directly (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.pointer := 11;
	// a bunch of irvals representing a complex value such as a struct value (d0 = member irvals?, d1 = count of members. remember this isnt necessarily the number of members of the struct)
	.aggregate := 12;
};

val : struct
{
	tag : val_tag;
	// datapoint 0 - use depends on tag
	d0 : u64;
	// datapoint 1 - use depends on tag
	d1 : u64;
	// datapoint 2 - use depends on tag
	d2 : u64;
	// datapoint 3 - use depends on tag
	d3 : u64;
	// datapoint 4 - use depends on tag
	d4 : u64;
	// type
	type : ty;
};

val_is_known_at_compile_time : func(v : val mut? -> bool)
{
	t ::= v->tag;
	return (t == val_tag.typeonly)
		|| (t == val_tag.zerovalue)
		|| (t == val_tag.scalar_literal)
		|| (t == val_tag.string_literal)
		|| (t == val_tag.aggregate_literal)
		|| (t == val_tag.pointer_literal)
		|| (t == val_tag.function_reference)
		|| (t == val_tag.variable_reference)
		|| (t == val_tag.assembly_reference);
};

val_scalar_literal_get_integer : func(v : val mut? -> s64 mut?)
{
	return ref(v->d0)@s64 mut?;
};

val_scalar_literal_get_floating_point : func(v : val mut? -> f64 mut?)
{
	return ref(v->d0)@f64 mut?;
};

val_scalar_literal_get_bool : func(v : val mut? -> bool mut?)
{
	return ref(v->d0)@bool mut?;
};

val_string_literal_get_data : func(v : val mut? -> u8 mut? mut?)
{
	return ref(v->d0)@u8 mut? mut?;
};

val_string_literal_get_length : func(v : val mut? -> u64 mut?)
{
	return ref(v->d1)@u64 mut?;
};

val_aggregate_literal_get_members : func(v : val mut? -> val mut? mut?)
{
	return ref(v->d0)@val mut? mut?;
};

// remember the members count is decided by the type and is thus *not* stored separately
val_aggregate_literal_get_members_count : func(v : val mut? -> u64)
{
	return ty_countof(v->type);
};

val_pointer_literal_get_address : func(v : val mut? -> u64 mut?)
{
	return ref(v->d0)@u64 mut?;
};

val_function_reference_get_function : func(v : val mut? -> function_t mut? mut?)
{
	return ref(v->d0)@function_t mut? mut?;
};

val_variable_reference_get_variable : func(v : val mut? -> variable_t mut? mut?)
{
	return ref(v->d0)@variable_t mut? mut?;
};

val_assembly_reference_get_assembly : func(v : val mut? -> assembly_t mut? mut?)
{
	return ref(v->d0)@assembly_t mut? mut?;
};

// note HH: sizeof(val.d1->end) must be >= sizeof(irval) otherwise this will buffer overrun
val_scalar_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d0)@irval mut?;
};

val_pointer_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d0)@irval mut?;
};

val_aggregate_get_members : func(v : val mut? -> val mut? mut?)
{
	return ref(v->d0)@val mut? mut?;
};

val_aggregate_get_members_count : func(v : val mut? -> u64 mut?)
{
	return ref(v->d1)@u64 mut?;
};

val_convert_nyi : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	panic_begin();
	putzstr("val_convert NYI for val_tag.\0");
	putsint(v->tag@s64);
	putzstr(" at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_invalid : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	panic_begin();
	putzstr("val_convert called on an invalid value at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_typeonly : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	out->tag = val_tag.typeonly;
	out->type = to;
};

val_convert_zerovalue : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	val_zero_as(to, out);
};

val_convert_scalar_literal : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	// same thing
	out->type = to;
	if(resolve == val_resolve.compiletime_only)
	{
		return;
	}
	// need to turn this into a runtime scalar
	out->tag = val_tag.scalar;
	// workaround enum types being a bit awkward
	real_type : ty mut := to;
	if(ty_is_enumeration(to))
	{
		real_type = ty_underlying(to);
	}
	isz ::= ty_integral_size(real_type);
	fsz ::= ty_floating_point_size(real_type);
	if(isz == 8)
	{
		irval_qimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 4)
	{
		irval_dimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 2)
	{
		irval_wimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(isz == 1)
	{
		irval_bimm([val_scalar_literal_get_integer(v)], val_scalar_get_irval(out));
		return;
	}
	if(fsz == 8)
	{
		irval_gimm([val_scalar_literal_get_floating_point(v)], val_scalar_get_irval(out));
		return;
	}
	if(fsz == 4)
	{
		irval_fimm([val_scalar_literal_get_floating_point(v)], val_scalar_get_irval(out));
		return;
	}
	panic_begin();
	putzstr("val_convert_scalar_literal to runtime value for type \0");
	putchar('"');
	putty(to);
	putchar('"');
	putzstr(" at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert_string_literal : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	if(resolve == val_resolve.compiletime_only)
	{
		// we're at compile-time so we can just keep the string literal
		[out] = [v];
		out->type = to;
		return;
	}
	if(ty_is_pointer(to))
	{
		// assume we are converting to any pointer
		// add a global variable containing the string data
		globref_ptr ::= val_pointer_get_irval(out);
		ir_add_glob([val_string_literal_get_data(v)], [val_string_literal_get_length(v)], false, globref_ptr);
		out->type = to;
		out->tag = val_tag.pointer;
		return;
	}
	panic_begin();
	putzstr("val_convert_string_literal NYI for non-pointer type \0");
	putchar('"');
	putty(to);
	putchar('"');
	putzstr(" at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_convert : func(v : val mut?, to : ty, out : val mut?, resolve : val_resolve, src : source, ctx : ast mut? -> v0)
{
	// todo: ensure that 'v->type' is convertible to 'to'
	[val_convert_tbl # (v->tag@s64)](v, to, out, resolve, src, ctx);
};

val_convert_tbl ::= typeof(val_convert)[countof val_tag]
{
	.0 := val_convert_invalid;
	.1 := val_convert_typeonly;
	.2 := val_convert_zerovalue;
	.3 := val_convert_scalar_literal;
	.4 := val_convert_string_literal;
	.5 := val_convert_nyi;
	.6 := val_convert_nyi;
	.7 := val_convert_nyi;
	.8 := val_convert_nyi;
	.9 := val_convert_nyi;
	.10 := val_convert_nyi;
	.11 := val_convert_nyi;
	.12 := val_convert_nyi;
};

val_zero_as : func(to : ty, out : val mut? -> v0)
{
	i : u64 mut;
	out->type = to;
	if((ty_integral_size(to) != 0) || ty_is_enumeration(to))
	{
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_integer(out)] = 0;
		return;
	}
	if(ty_is_pointer(to))
	{
		out->tag = val_tag.pointer_literal;
		[val_pointer_literal_get_address(out)] = 0;
		return;
	}
	if(ty_is_function(to))
	{
		out->tag = val_tag.function_reference;
		[val_function_reference_get_function(out)] = zero;
		return;
	}
	if(ty_is_bool(to))
	{
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_bool(out)] = false;
		return;
	}
	if(ty_is_array(to) || ty_is_structure(to))
	{
		out->tag = val_tag.aggregate_literal;
		members_count ::= ty_countof(to);
		members_ptr : val mut? := arena_alloc(global_arena, members_count * sizeof val);
		for(i = 0; i < members_count; i = i + 1)
		{
			val_zero_as(ty_at(to, i), members_ptr # i);
		}
		[val_aggregate_literal_get_members(out)] = members_ptr;
		return;
	}
	panic_begin();
	putzstr("reached end of val_zero_as for type \0");
	putchar('"');
	putty(to);
	putchar('"');
	panic_end();
};

val_resolve : enum
{
	.type_only := 0;
	.compiletime_only := 1;
	.runtime_only := 2;
};

// val operations

val_from_type : func(type : ty, out : val mut? -> v0)
{
	out->tag = val_tag.typeonly;
	out->type = type;
};

val_from_node : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	[val_from_node_tbl # (node->tag@s64)](node, out, resolve, src);
};

val_from_node_nyi : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	panic_begin();
	putzstr("val_from_node NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_node_expr : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	[val_from_node_expr_tbl # ([ast_expr_get_tag(node)])@s64](node, out, resolve, src);
};

val_from_node_expr_nyi : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_node_expr_literal : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	[val_from_node_expr_literal_tbl # [ast_literal_get_tag(node)]@s64](node, out, resolve, src);
};

val_from_node_expr_symbol : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	sym ::= [ast_symbol_get_data(node)];
	symlen ::= [ast_symbol_get_data_len(node)];
	maybe_var ::= scope_find_variable(ref(prog.global_scope), sym, symlen);
	if(maybe_var != zero)
	{
		out->tag = val_tag.variable_reference;
		[val_variable_reference_get_variable(out)] = maybe_var;
		out->type = maybe_var->type;
		return;
	}

	maybe_func ::= scope_find_function(ref(prog.global_scope), sym, symlen);
	if(maybe_func != zero)
	{
		out->tag = val_tag.function_reference;
		[val_function_reference_get_function(out)] = maybe_func;
		out->type = maybe_func->type;
		return;
	}

	maybe_ty ::= ty_find_by_name(sym, symlen);
	if(maybe_ty != zero)
	{
		out->tag = val_tag.typeonly;
		out->type = maybe_ty;
		return;
	}
	panic_begin();
	putzstr("val_from_node_expr_symbol NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.blue_underline);
	panic_end();
};

val_from_integer_literal : func(int : s64 weak, out : val mut? -> v0)
{
	out->tag = val_tag.scalar_literal;
	out->type = ty_integer_literal();
	[val_scalar_literal_get_integer(out)] = int;
};

val_from_node_expr_literal_integer : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	out->type = ty_integer_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_integer(out)] = [ast_literal_get_integer(node)];
};

val_from_node_expr_literal_floating_point : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	out->type = ty_floating_point_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_floating_point(out)] = [ast_literal_get_floating_point(node)];
};

val_from_node_expr_literal_char : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	out->type = ty_floating_point_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.scalar_literal;
	[val_scalar_literal_get_integer(out)] = [ast_literal_get_char(node)]@s64;
};

val_from_node_expr_literal_string : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	out->type = ty_string_literal();
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	out->tag = val_tag.string_literal;
	[val_string_literal_get_data(out)] = [ast_literal_get_string(node)];
	[val_string_literal_get_length(out)] = [ast_literal_get_string_len(node)];
};

val_from_node_expr_literal_nyi : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_literal NYI for codepath: \0");
	putchar('\n');
	ast_dump_one(node, zero, zero, 1);
	putzstr("from source \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.blue_underline);
	panic_end();
};

// if ptr_val is a val_tag.pointer, then 'out' will become either an aggregate or scalar value (depending on the type of 'ptr_val') containing the loaded value of the pointer. it will have the same type
val_load : func(abi : abi_tag, ptr_val : val mut?, out : val mut?, src : source, ctx : ast mut? -> v0)
{
	if(ptr_val->tag != val_tag.pointer)
	{
		[out] = [ptr_val];
		return;
	}
	out->type = ptr_val->type;
	load_chunks : abi_chunk mut? mut;
	load_chunks_count : u64 mut;
	abi_chunk_tys(abi, ref(ptr_val->type), 1, ref load_chunks, ref load_chunks_count, scratch_arena);
	// easier codepath for scalars
	if(load_chunks_count == 1)
	{
		out->tag = val_tag.scalar;
		// todo: emit an ir_load on val_pointer_get_irval(ptr_val). result irval register should be written to val_scalar_get_irval(out)
		panic_begin();
		putzstr("nyi: ir_load call in val_load at \0");
		putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
		panic_end();
		return;
	}
	// todo: return agg for 2+ chunks
	panic_begin();
	putzstr("reached end of val_load (load_chunks_count != 1, should be an agg)");
	panic_end();
};

val_from_node_expr_biop_bitwise_or: func(lhs : val mut?, lhs_node : ast mut?, rhs : val mut?, rhs_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : ast mut?, src : source -> v0)
{
	out->type = ty_of_bitwise(lhs->type, rhs->type);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("binary operator '|' is not valid on operands \0");
		putchar('"');
		putty(lhs->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(lhs->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(resolve == val_resolve.compiletime_only)
	{
		if((lhs->tag != val_tag.scalar_literal) || (rhs->tag != val_tag.scalar_literal))
		{
			panic_begin();
			putzstr("lhs and rhs operands were not both val_tag.scalar_literal when doing a compile-time '|'. they were tags  \0");
			putsint(lhs->tag@s64);
			putzstr(" and \0");
			putsint(rhs->tag@s64);
			putzstr(" at \0");
			putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
			panic_end();
		}
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_integer(out)] = ([val_scalar_literal_get_integer(lhs)] | [val_scalar_literal_get_integer(rhs)]);
		return;
	}
	panic_begin();
	putzstr("val_from_node_expr_biop NYI for bitwise_or at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_biop_nyi : func(lhs : val mut?, lhs_node : ast mut?, rhs : val mut?, rhs_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : ast mut?, src : source -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_biop NYI for ast_biop_tag.\0");
	putsint([ast_biop_get_tag(ctx)]@s64);
	putzstr(" at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_biop : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	abi : abi_tag := abi_tag.psy64;
	lhs_node ::= ast_biop_get_lhs(node);
	rhs_node ::= ast_biop_get_rhs(node);

	lhs_val : val mut;
	val_from_node(lhs_node, ref lhs_val, resolve, src);
	rhs_val : val mut;
	val_from_node(rhs_node, ref rhs_val, resolve, src);

	tag ::= [ast_biop_get_tag(node)];
	if(tag@s64 == ~0)
	{
		panic_begin();
		putzstr("invalid/unrecognised binary operator (should be impossible as parser wouldnt allow it) at \0");
		putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	[val_from_node_expr_biop_tbl # (tag@s64)](ref lhs_val, lhs_node, ref rhs_val, rhs_node, out, resolve, node, src);
};

val_from_node_expr_unop_ref : func(operand : val mut?, operand_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : ast mut?, src : source -> v0)
{
	out->type = ty_make_pointer(operand->type, zero);
	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		return;
	}
	if(operand->tag != val_tag.pointer)
	{
		panic_begin();
		putzstr("dont know how to ref a val_tag that isnt val_tag.pointer. this one is val_tag.\0");
		putsint(operand->tag@s64);
		putzstr(" at \0");
		putsrc(src, operand_node->src_beg@u64, operand_node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	out->tag = val_tag.scalar;
	[val_pointer_get_irval(out)] = [val_scalar_get_irval(operand)];
	[out] = [operand];
};

val_from_node_expr_unop_nyi : func(operand : val mut?, operand_node : ast mut?, out : val mut?, resolve : val_resolve, ctx : ast mut?, src : source -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_unop NYI for ast_unop_tag.\0");
	putsint([ast_unop_get_tag(ctx)]@s64);
	putzstr(" at \0");
	putsrc(src, ctx->src_beg@u64, ctx->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	abi : abi_tag := abi_tag.psy64;
	operand_node ::= ast_unop_get_operand(node);

	operand_val : val mut;
	val_from_node(operand_node, ref operand_val, resolve, src);

	tag ::= [ast_unop_get_tag(node)];
	if(tag@s64 == ~0)
	{
		panic_begin();
		putzstr("invalid/unrecognised binary operator (should be impossible as parser wouldnt allow it) at \0");
		putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	[val_from_node_expr_unop_tbl # (tag@s64)](ref operand_val, operand_node, out, resolve, node, src);
};

val_from_node_expr_call : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	abi : abi_tag := abi_tag.psy64;

	callee_val : val mut;
	val_from_node(ast_call_get_callee(node), ref callee_val, resolve, src);
	param_nodes ::= ast_call_get_params(node);
	param_nodes_count ::= ast_call_get_params_count(node)@u64;

	i : u64 mut;

	callee_fnty ::= callee_val.type;
	callee_u ::= ty_unwrap(callee_fnty);
	// gather a scratch array of vals representing the parameters
	param_vals : val mut? := arena_alloc(scratch_arena, param_nodes_count * sizeof val);
	for(i = 0; i < param_nodes_count; i = i + 1)
	{
		cur_param_val : val mut;
		val_from_node(param_nodes # i, ref cur_param_val, resolve, src);
		val_convert(ref cur_param_val, ty_at(callee_fnty, i), ref cur_param_val, resolve, src, param_nodes # i);
		val_load(abi, ref cur_param_val, param_vals # i, src, param_nodes # i);
	}

	if(resolve == val_resolve.type_only)
	{
		out->tag = val_tag.typeonly;
		out->type = ty_underlying(callee_fnty);
		return;
	}
	// chunk the params
	// then we can calculate our irval array count and then finally compute the array
	param_chunks : abi_chunk mut? mut;
	param_chunks_count : u64 mut;
	abi_chunk_tys(abi, callee_u->members # 0, callee_u->members_count, ref param_chunks, ref param_chunks_count, scratch_arena);

	param_irvals : irval mut? := arena_alloc(global_arena, param_chunks_count * sizeof irval);
	j : u64 mut;
	for(i = 0; i < param_nodes_count; i = i + 1)
	{
		cur ::= param_vals # i;
		if(cur->tag == val_tag.aggregate)
		{
			cur_agg_count ::= [val_aggregate_get_members_count(cur)];
			cur_agg_vals ::= [val_aggregate_get_members(cur)];
			for(j = 0; j < cur_agg_count; j = j + 1)
			{
				[param_irvals # (i + j)] = [val_scalar_get_irval(cur_agg_vals # j)];
			}
			// add the size of the agg to i (but remember we're about to increment it, so add size-1 and assume we never have a 0-size-agg)
			i = i + (j - 1);
		}
		else
		{
			[param_irvals # i] = [val_scalar_get_irval(cur)];
		}
	}
	// todo: passing references to stack memory incase of chunk_tag.mem (sysv + winx64) would need some code here.
	// todo: error out if param_chunks_count > abi.params_count_max (doesnt exist yet)
	// todo runtime: emit the call
	// todo runtime: return the result?
	panic_begin();
	putzstr("reached end of val_from_node_expr_call for \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_blkinit : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	typename_node ::= ast_blkinit_get_typename(node);
	type ::= ty_from_typename_node(typename_node, src);
	if(type == ty.invalid)
	{
		err_begin();
		putzstr("cannot decipher type of block-initialiser \0");
		putsrc(src, typename_node->src_beg@u64, typename_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(resolve == val_resolve.type_only)
	{
		val_from_type(type, out);
		return;
	}
	panic_begin();
	putzstr("todo: val_from_node_expr_blkinit (type: \0");
	putty(type);
	putzstr(")\0");
	panic_end();
};

val_from_node_expr_field : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	is_ptr_field ::= [ast_field_get_parse_state(node)] == ast_field_parse_state.finalisedarrow;
	lhs_node : ast mut? := ast_field_get_lhs(node);
	rhs_node : ast mut? := ast_field_get_rhs(node);

	lhs_val : val mut := zero;
	val_from_node(lhs_node, ref lhs_val, resolve, src);
	if(is_ptr_field == false)
	{
		if((ty_is_enumeration(lhs_val.type) == false) && (ty_is_structure(lhs_val.type) == false))
		{
			err_begin();
			putzstr("field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - only structs and enum typenames are allowed to be the left-hand-side of a field-access at \0");
			putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
	else
	{
		if(ty_is_pointer(lhs_val.type) == false)
		{
			err_begin();
			putzstr("pointer-field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - only pointer types are allowed to be the left-hand-side of a pointer-field-access at \0");
			putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
			err_end();
		}
		// also the pointee must be a struct type
		if(ty_is_structure(ty_underlying(lhs_val.type)) == false)
		{
			err_begin();
			putzstr("pointer-field-access on type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" is invalid - while the left-hand-side of the pointer-field-access is indeed a pointer, the pointee type is not a structure type, it is of type \0");
			putchar('"');
			putty(ty_underlying(lhs_val.type));
			putchar('"');
			putzstr(" at \0");
	
			putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}

	// rhs must be either a symbol expression, or a call where the callee is a symbol expression
	// examples that satisfy this:
	// lhs.some_symbol
	// lhs.some_symbol_that_is_called()
	// examples that do not satisfy this:
	// lhs.2
	// lhs.123()
	rhs_symbol_node : ast mut? mut := zero;
	rhs_is_call ::= ast_is_expr(rhs_node, ast_expr_tag.call);
	if(rhs_is_call)
	{
		rhs_symbol_node = ast_call_get_callee(rhs_node);
		if(ast_is_expr(rhs_symbol_node, ast_expr_tag.symbol) == false)
		{
			err_begin();
			putzstr("if the right-hand-side of a field expression is a call, then the callee must itself be a symbol expression, but it is not in this case at \0");
			putsrc(src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}
	else
	{
		rhs_symbol_node = rhs_node;
		if(ast_is_expr(rhs_symbol_node, ast_expr_tag.symbol) == false)
		{
			err_begin();
			putzstr("the right-hand-side of a field expression must be a symbol expression or a call on a symbol expression, but it is neither at \0");
			putsrc(src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
			err_end();
		}
	}

	if(lhs_val.tag == val_tag.typeonly)
	{
		if(ty_is_enumeration(lhs_val.type) == false)
		{
			if(resolve == val_resolve.type_only)
			{
				panic_begin();
				putzstr("todo: struct member type picking based upon field-expression rhs at \0");
				putsrc(src, rhs_symbol_node->src_beg@u64, rhs_symbol_node->src_end@u64, putcol.red_underline);
				panic_end();
			}
			// must be a struct then
			err_begin();
			putzstr("non-enum type-only value \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" passed as left-hand-side of field expression. must either be an enumeration typename or an aggregate value at \0");
			putsrc(src, lhs_node->src_beg@u64, lhs_node->src_end@u64, putcol.red_underline);
			err_end();
			return;
		}
		// is enum type. we have the rhs symbol node so lets find the enum entry
		// todo: search through the entries of lhs_val.type and match rhs_symbol_node data to it. if we find it, then write that entry as a enum value scalar literal into 'out'. if we dont find it, then error out
		// todo: also if resolve == typeonly, write 'typeonly' of the enum type into 'out' and discard the enum value (but still make sure we check its validity on this code path)
		the_entry ::= ty_enum_find_entry_by_name(lhs_val.type, [ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
		if(the_entry == zero)
		{
			err_begin();
			putzstr("enum type \0");
			putchar('"');
			putty(lhs_val.type);
			putchar('"');
			putzstr(" has no entry named \0");
			putchar('"');
			putchars([ast_symbol_get_data(rhs_symbol_node)], [ast_symbol_get_data_len(rhs_symbol_node)]);
			putchar('"');
			putzstr(" at \0");
			putsrc(src, rhs_node->src_beg@u64, rhs_node->src_end@u64, putcol.red_underline);
			err_end();
			return;
		}
		out->type = lhs_val.type;
		if(resolve == val_resolve.type_only)
		{
			out->tag = val_tag.typeonly;
			return;
		}
		out->tag = val_tag.scalar_literal;
		[val_scalar_literal_get_integer(out)] = the_entry->val;
		return;
	}
	panic_begin();
	putzstr("todo: val_from_node_expr_field at \0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_countof : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	typename_node ::= ast_countof_get_operand(node);
	val_from_integer_literal(ty_countof(ty_from_typename_node(typename_node, src)), out);
};

val_from_node_expr_typeof : func(node : ast mut?, out : val mut?, resolve : val_resolve, src : source -> v0)
{
	expr_node ::= ast_typeof_get_operand(node);
	val_from_node(expr_node, out, val_resolve.type_only, src);
};

val_from_node_tbl ::= typeof(val_from_node)[countof ast_tag]
{
	.0 := val_from_node_nyi;
	.1 := val_from_node_nyi;
	.2 := val_from_node_expr;
	.3 := val_from_node_nyi;
	.4 := val_from_node_nyi;
	.5 := val_from_node_nyi;
	.6 := val_from_node_nyi;
	.7 := val_from_node_nyi;
	.8 := val_from_node_nyi;
	.9 := val_from_node_nyi;
	.10 := val_from_node_nyi;
	.11 := val_from_node_nyi;
	.12 := val_from_node_nyi;
	.13 := val_from_node_nyi;
	.14 := val_from_node_nyi;
	.15 := val_from_node_nyi;
	.16 := val_from_node_nyi;
	.17 := val_from_node_nyi;
	.18 := val_from_node_nyi;
	.19 := val_from_node_nyi;
};

val_from_node_expr_tbl ::= typeof(val_from_node)[countof ast_expr_tag]
{
	.0 := val_from_node_expr_symbol;
	.1 := val_from_node_expr_literal;
	.2 := val_from_node_expr_nyi;
	.3 := val_from_node_expr_unop;
	.4 := val_from_node_expr_biop;
	.5 := val_from_node_expr_call;
	.6 := val_from_node_expr_blkinit;
	.7 := val_from_node_expr_nyi;
	.8 := val_from_node_expr_nyi;
	.9 := val_from_node_expr_field;
	.10 := val_from_node_expr_nyi;
	.11 := val_from_node_expr_nyi;
	.12 := val_from_node_expr_countof;
	.13 := val_from_node_expr_typeof;
};

val_from_node_expr_literal_tbl ::= typeof(val_from_node)[countof ast_literal_tag]
{
	.0 := val_from_node_expr_literal_integer;
	.1 := val_from_node_expr_literal_floating_point;
	.2 := val_from_node_expr_literal_char;
	.3 := val_from_node_expr_literal_string;
	.4 := val_from_node_expr_literal_nyi;
};

val_from_node_expr_unop_tbl ::= typeof(val_from_node_expr_unop_nyi)[countof ast_unop_tag]
{
	.0 := val_from_node_expr_unop_nyi;
	.1 := val_from_node_expr_unop_nyi;
	.2 := val_from_node_expr_unop_nyi;
	.3 := val_from_node_expr_unop_ref;
};

val_from_node_expr_biop_tbl ::= typeof(val_from_node_expr_biop_nyi)[countof ast_biop_tag]
{
	.0 := val_from_node_expr_biop_nyi;
	.1 := val_from_node_expr_biop_nyi;
	.2 := val_from_node_expr_biop_nyi;
	.3 := val_from_node_expr_biop_nyi;
	.4 := val_from_node_expr_biop_nyi;
	.5 := val_from_node_expr_biop_nyi;
	.6 := val_from_node_expr_biop_nyi;
	.7 := val_from_node_expr_biop_nyi;
	.8 := val_from_node_expr_biop_nyi;
	.9 := val_from_node_expr_biop_nyi;
	.10 := val_from_node_expr_biop_nyi;
	.11 := val_from_node_expr_biop_bitwise_or;
	.12 := val_from_node_expr_biop_nyi;
	.13 := val_from_node_expr_biop_nyi;
	.14 := val_from_node_expr_biop_nyi;
	.15 := val_from_node_expr_biop_nyi;
	.16 := val_from_node_expr_biop_nyi;
	.17 := val_from_node_expr_biop_nyi;
	.18 := val_from_node_expr_biop_nyi;
	.19 := val_from_node_expr_biop_nyi;
};

