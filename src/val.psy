val_tag : enum
{
	// not a valid value (no data)
	.invalid := 0;
	// a runtime scalar value (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.scalar := 1;
	// similar to scalar, but the irval stores a pointer to the value instead of the value directly (d0 = irval (d1, d2, d3 etc... are a part of the irval object and the rest of the val struct is assumed to be large enough to store the whole thing))
	.pointer := 2;
	// a bunch of irvals representing a complex value such as a struct value (d0 = member irvals?, d1 = count of members. remember this isnt necessarily the number of members of the struct)
	.aggregate := 3;
};

val : struct
{
	tag : val_tag;
	// datapoint 0 - use depends on tag
	d0 : u64;
	// datapoint 1 - use depends on tag
	d1 : u64;
	// datapoint 2 - use depends on tag
	d2 : u64;
	// datapoint 3 - use depends on tag
	d3 : u64;
	// datapoint 4 - use depends on tag
	d4 : u64;
	// datapoint 5 - use depends on tag
	d5 : u64;
	// type
	type : ty;
};

// note HH: sizeof(val.d1->end) must be >= sizeof(irval) otherwise this will buffer overrun
val_scalar_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d1)@irval mut?;
};

val_scalar_get_displacement : func(v : val mut? -> s32 mut?)
{
	return ref(v->d0)@s32 mut?;
};

val_pointer_get_irval : func(v : val mut? -> irval mut?)
{
	return ref(v->d1)@irval mut?;
};

val_pointer_get_displacement : func(v : val mut? -> s32 mut?)
{
	return ref(v->d0)@s32 mut?;
};

val_aggregate_get_members : func(v : val mut? -> val mut? mut?)
{
	return ref(v->d0)@val mut? mut?;
};

val_aggregate_get_members_count : func(v : val mut? -> u64 mut?)
{
	return ref(v->d1)@u64 mut?;
};

val_aggregate_get_chunks : func(v : val mut? -> abi_chunk mut? mut?)
{
	return ref(v->d2)@abi_chunk mut? mut?;
};

val_zero_as : func(to : ty, out : val mut? -> v0)
{
	i : u64 mut;
	out->type = to;
	if((ty_integral_size(to) != 0) || ty_is_enumeration(to))
	{
		out->tag = val_tag.scalar;
		irval_qimm(0, val_scalar_get_irval(out));
		[val_scalar_get_displacement(out)] = zero;
		return;
	}
	if(ty_is_pointer(to))
	{
		out->tag = val_tag.scalar;
		irval_qimm(0, val_scalar_get_irval(out));
		[val_scalar_get_displacement(out)] = zero;
		return;
	}
	if(ty_is_function(to))
	{
		out->tag = val_tag.scalar;
		irval_qimm(0, val_scalar_get_irval(out));
		[val_scalar_get_displacement(out)] = zero;
		return;
	}
	if(ty_is_bool(to))
	{
		out->tag = val_tag.scalar;
		irval_bimm(0, val_scalar_get_irval(out));
		[val_scalar_get_displacement(out)] = zero;
		return;
	}
	if(ty_is_array(to) || ty_is_structure(to))
	{
		out->tag = val_tag.aggregate;
		toty ::= to;
		member_chunks_count : u64 mut;
		agg_chunks : abi_chunk mut? mut;
		abi_chunk_tys(abi_tag.psy64, ref toty, 1, ref agg_chunks, ref member_chunks_count, global_arena);
		member_chunks_ptr : val mut? := arena_alloc(global_arena, member_chunks_count * sizeof val);
		chunk_counter : u64 mut := 0;
		for(i = 0; i < ty_countof(to); i = i + 1)
		{
			// remember, each member might also be an aggregate
			// but we want our top-level aggregate to only hold scalars
			single_member_val : val mut;
			val_zero_as(ty_at(to, i), ref single_member_val);
			if(single_member_val.tag == val_tag.scalar)
			{
				[member_chunks_ptr # chunk_counter] = single_member_val;
				chunk_counter = chunk_counter + 1;
			}
			if(single_member_val.tag == val_tag.aggregate)
			{
				j : u64 mut;
				aggcount ::= [val_aggregate_get_members_count(ref single_member_val)];
				aggmems ::= [val_aggregate_get_members(ref single_member_val)];
				for(j = 0; j < aggcount; j = j + 1)
				{
					[member_chunks_ptr # (chunk_counter + j)] = [aggmems # j];
				}
				chunk_counter = chunk_counter + aggcount;
			}
		}
		[val_aggregate_get_members_count(out)] = member_chunks_count;
		[val_aggregate_get_members(out)] = member_chunks_ptr;
		[val_aggregate_get_chunks(out)] = agg_chunks;
		return;
	}
	panic_begin();
	putzstr("reached end of val_zero_as for type \0");
	putchar('"');
	putty(to);
	putchar('"');
	panic_end();
};

val_load_if_pointer : func(in : val mut?, out : val mut? -> v0)
{
	if(in->tag == val_tag.pointer)
	{
		val_force_load(in, out);
		return;
	}
	if(out != in)
	{
		[out] = [in];
	}
};

val_force_load : func(in : val mut?, out : val mut? -> v0)
{
	// we can load a pointer (expected) or even a scalar by pretending it was a pointer with no offset
	load_chunks : abi_chunk mut? mut;
	load_chunks_count : u64 mut;
	abi_chunk_tys(abi_tag.psy64, ref(in->type), 1, ref load_chunks, ref load_chunks_count, global_arena);

	// prepare the load(s)
	ptr : irval mut? mut;
	disp : s32 mut;

	if(in->tag == val_tag.pointer)
	{
		ptr = val_pointer_get_irval(in);
		disp = [val_pointer_get_displacement(in)];
	}
	else
	{
		ptr = val_scalar_get_irval(in);
		disp = [val_scalar_get_displacement(in)];
	}

	// do one load per chunk
	// if there's only one chunk then we output a scalar
	if(load_chunks_count == 1)
	{
		ir_load(val_scalar_get_irval(out), abi_chunk_as_irsz(load_chunks # 0), ptr, disp);
		[val_scalar_get_displacement(out)] = 0;
		out->tag = val_tag.scalar;
		return;
	}
	// load all chunks at their expected offsets
	i : u64 mut;
	out_members : val mut? := arena_alloc(global_arena, load_chunks_count * sizeof val);
	for(i = 0; i < load_chunks_count; i = i + 1)
	{
		cur_out_member ::= out_members # i;
		cur_out_member->tag = val_tag.scalar;
		ir_load(val_scalar_get_irval(cur_out_member), abi_chunk_as_irsz(load_chunks # i), ptr, disp + (load_chunks # i)->src_byte_offset@s32);
		[val_scalar_get_displacement(cur_out_member)] = 0;
	}
	out->tag = val_tag.aggregate;
	[val_aggregate_get_members(out)] = out_members;
	[val_aggregate_get_chunks(out)] = load_chunks;
	[val_aggregate_get_members_count(out)] = load_chunks_count;
};

type_from_node : func(ctx : source_context mut? -> ty)
{
	ctxcpy : source_context mut := [ctx];
	ctxcpy.type_only = true;
	v : val mut;
	val_from_node(ref ctxcpy, ref v);
	return v.type;
};

val_from_node : func(ctx : source_context mut?, out : val mut? -> v0)
{
	[val_from_node_tbl # (ctx->node->tag@s64)](ctx, out);
};

val_from_node_nyi : func(ctx : source_context mut?, out : val mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node NYI for ast_tag.\0");
	putsint(ctx->node->tag@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr : func(ctx : source_context mut?, out : val mut? -> v0)
{
	[val_from_node_expr_tbl # ([ast_expr_get_tag(ctx->node)])@s64](ctx, out);
};

val_from_node_expr_nyi : func(ctx : source_context mut?, out : val mut?  -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr NYI for ast_expr_tag.\0");
	putsint([ast_expr_get_tag(ctx->node)]@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_symbol : func(ctx : source_context mut?, out : val mut? -> v0)
{
	sym ::= [ast_symbol_get_data(ctx->node)];
	len ::= [ast_symbol_get_data_len(ctx->node)];

	// if we are within a function then use its scope
	// otherwise, we are in the global scope.
	scope : scope_t mut? mut := ref(prog.global_scope);
	if(ctx->parent_fn != zero)
	{
		scope = ref(ctx->parent_fn->scope);
	}

	maybe_var ::= scope_find_variable(scope, sym, len);
	if(maybe_var != zero)
	{
		[out] = maybe_var->storage;
		if(ctx->type_only)
		{
			out->tag = val_tag.invalid;
		}
		return;
	}

	maybe_fn ::= scope_find_function(scope, sym, len);
	if(maybe_fn != zero)
	{
		out->tag = val_tag.scalar;
		out->type = maybe_fn->type;
		irval_fnref(maybe_fn->irfunc_idx, val_scalar_get_irval(out));
		[val_scalar_get_displacement(out)] = 0;
		return;
	}

	if(ctx->parent_fn != zero)
	{
		// we checked the parent-fn and didnt get anything
		// recurse but with no parent_fn (so we get global scope)
		top_level_ctx : source_context mut := [ctx];
		top_level_ctx.parent_fn = zero;
		val_from_node_expr_symbol(ref top_level_ctx, out);
		return;
	}
	panic_begin();
	putzstr("reached end of val_from_node_expr_symbol at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_literal : func(ctx : source_context mut?, out : val mut? -> v0)
{
	[val_from_node_expr_literal_tbl # [ast_literal_get_tag(ctx->node)]@s64](ctx, out);
};

val_from_node_expr_literal_integer : func(ctx : source_context mut?, out : val mut? -> v0)
{
	out->tag = val_tag.scalar;
	out->type = ty_integer_literal();
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		return;
	}
	irval_qimm([ast_literal_get_integer(ctx->node)], val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_literal_floating_point : func(ctx : source_context mut?, out : val mut? -> v0)
{
	out->tag = val_tag.scalar;
	out->type = ty_floating_point_literal();
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		return;
	}
	irval_gimm([ast_literal_get_floating_point(ctx->node)], val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_literal_char : func(ctx : source_context mut?, out : val mut? -> v0)
{
	out->tag = val_tag.scalar;
	out->type = ty_char_literal();
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		return;
	}
	irval_bimm([ast_literal_get_char(ctx->node)], val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_literal_string : func(ctx : source_context mut?, out : val mut? -> v0)
{
	out->tag = val_tag.scalar;
	out->type = ty_string_literal();
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		return;
	}
	ir_add_glob([ast_literal_get_string(ctx->node)], [ast_literal_get_string_len(ctx->node)], false, val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_literal_boolean : func(ctx : source_context mut?, out : val mut? -> v0)
{
	out->tag = val_tag.scalar;
	out->type = ty_boolean_literal();
	// if we are type only do not do ir stuff.
	if(ctx->type_only)
	{
		return;
	}
	irval_bimm([ast_literal_get_bool(ctx->node)], val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

val_from_node_expr_zero_value : func(ctx : source_context mut?, out : val mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_zero_value ought to be unreachable at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop : func(ctx : source_context mut?, out : val mut? -> v0)
{
	operand_ctx : source_context mut := [ctx];
	operand_ctx.node = ast_unop_get_operand(ctx->node);
	operand_val : val mut;
	val_from_node(ref operand_ctx, ref operand_val);

	[val_from_node_expr_unop_tbl # [ast_unop_get_tag(ctx->node)]@s64](ref operand_val, ctx, out);
};
val_from_node_expr_unop_nyi : func(operand : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_unop NYI for unop_tag.\0");
	putsint([ast_unop_get_tag(ctx->node)]@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

val_from_node_expr_unop_minus : func(operand : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	out->type = operand->type;
	out->tag = val_tag.scalar;
	if((ty_integral_size(operand->type) == 0) && (ty_floating_point_size(operand->type) == 0))
	{
		err_begin();
		putzstr("cannot negate non-numeric type \0");
		putchar('"');
		putty(operand->type);
		putchar('"');
		err_end();
	}
	if(ctx->type_only)
	{
		return;
	}
	val_load_if_pointer(operand, operand);
	ir_neg(val_scalar_get_irval(out), val_scalar_get_irval(operand));
	[val_scalar_get_displacement(out)] = [val_scalar_get_displacement(operand)];
};

val_from_node_expr_unop_reference : func(operand : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	out->type = ty_make_pointer(operand->type, zero);
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}
	// operand must be a pointer
	// we just take it and pretend its a scalar instead haha
	if(operand->tag != val_tag.pointer)
	{
		err_begin();
		putzstr("invalid 'ref' of non-lvalue operand at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	[val_scalar_get_irval(out)] = [val_pointer_get_irval(operand)];
	[val_scalar_get_displacement(out)] = [val_pointer_get_displacement(operand)];
};

val_from_node_expr_biop : func(ctx : source_context mut?, out : val mut? -> v0)
{
	// create lhs and rhs vals but don't load them - let the specific biop types do that if they need to
	// but all of them need this so we might aswell just provide it for them instead of them all duping the below code.
	lhs_node ::= ast_biop_get_lhs(ctx->node);
	lhs_ctx : source_context mut := [ctx];
	lhs_ctx.node = lhs_node;
	lhs_val : val mut;
	val_from_node(ref lhs_ctx, ref lhs_val);

	rhs_node ::= ast_biop_get_rhs(ctx->node);
	rhs_ctx : source_context mut := [ctx];
	rhs_ctx.node = rhs_node;
	rhs_val : val mut;
	val_from_node(ref rhs_ctx, ref rhs_val);
	[val_from_node_expr_biop_tbl # [ast_biop_get_tag(ctx->node)]@s64](lhs_node, rhs_node, ref lhs_val, ref rhs_val, ctx, out);
};

val_from_node_expr_biop_nyi : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	panic_begin();
	putzstr("val_from_node_expr_biop NYI for biop_tag.\0");
	putsint([ast_biop_get_tag(ctx->node)]@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};


val_store_generic : func(ptr : val mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	vcpy : val mut := [v];
	val_load_if_pointer(ref vcpy, ref vcpy);
	val_conv(ref vcpy, ptr->type, ref vcpy, ctx);
	if(vcpy.tag == val_tag.scalar)
	{
		ir_store(val_scalar_get_irval(ref vcpy), val_pointer_get_irval(ptr), [val_pointer_get_displacement(ptr)] + [val_scalar_get_displacement(ref vcpy)]);
		return;
	}
	if(vcpy.tag != val_tag.aggregate)
	{
		panic_begin();
		putzstr("expected loaded + converted operand of val_store_generic to be val_tag.aggregate, but it is val_tag.\0");
		putsint(vcpy.tag@s64);
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	i : u64 mut;
	agg ::= [val_aggregate_get_members(ref vcpy)];
	agg_chunks ::= [val_aggregate_get_chunks(ref vcpy)];
	agg_count ::= [val_aggregate_get_members_count(ref vcpy)];
	for(i = 0; i < agg_count; i = i + 1)
	{
		ir_store(val_scalar_get_irval(agg # i), val_pointer_get_irval(ptr), [val_pointer_get_displacement(ptr)] + [val_scalar_get_displacement(agg # i)] + (agg_chunks # i)->src_byte_offset@s32);
	}
};

val_from_node_expr_biop_assign : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_store_generic(lhs_val, rhs_val, ctx);
};

val_from_node_expr_biop_compare_equal : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_load_if_pointer(lhs_val, lhs_val);
	val_load_if_pointer(rhs_val, rhs_val);

	if(ty_equality_comparable_to(lhs_val->type, rhs_val->type) == false)
	{
		err_begin();
		putzstr("cannot compare types \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->type = ty.bool;
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	ir_cmp_eq(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
};

val_from_node_expr_biop_add : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_load_if_pointer(lhs_val, lhs_val);
	val_load_if_pointer(rhs_val, rhs_val);

	out->type = ty_of_arithmetic(lhs_val->type, rhs_val->type);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("cannot add types \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	ir_add(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
};

val_from_node_expr_biop_sub : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_load_if_pointer(lhs_val, lhs_val);
	val_load_if_pointer(rhs_val, rhs_val);

	out->type = ty_of_arithmetic(lhs_val->type, rhs_val->type);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("cannot subtract types \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	ir_sub(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
};

val_from_node_expr_biop_mul : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_load_if_pointer(lhs_val, lhs_val);
	val_load_if_pointer(rhs_val, rhs_val);

	out->type = ty_of_arithmetic(lhs_val->type, rhs_val->type);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("cannot multiply types \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	if(ty_is_signed(out->type))
	{
		ir_smul(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
	}
	else
	{
		ir_umul(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
	}
};

val_from_node_expr_biop_div : func(lhs_node : ast mut?, rhs_node : ast mut?, lhs_val : val mut?, rhs_val : val mut?, ctx : source_context mut?, out : val mut? -> v0)
{
	val_load_if_pointer(lhs_val, lhs_val);
	val_load_if_pointer(rhs_val, rhs_val);

	out->type = ty_of_arithmetic(lhs_val->type, rhs_val->type);
	if(out->type == ty.invalid)
	{
		err_begin();
		putzstr("cannot divide types \0");
		putchar('"');
		putty(lhs_val->type);
		putchar('"');
		putzstr(" and \0");
		putchar('"');
		putty(rhs_val->type);
		putchar('"');
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	out->tag = val_tag.scalar;
	if(ctx->type_only)
	{
		return;
	}

	if(ty_is_signed(out->type))
	{
		ir_sdiv(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
	}
	else
	{
		ir_udiv(val_scalar_get_irval(out), val_scalar_get_irval(lhs_val), val_scalar_get_irval(rhs_val));
	}
};

