compile : func(-> v0)
{
	add_build_file(args.build_file, args.target.data, args.target.len);

	putchar('\r');
	putzstr("finalising...                                 \0");
	putchar('\n');

	t : u64 mut := nanotime();
	old : u64 mut := t;

	semal();
	t = nanotime();
	compile_timings.pre_codegen = t - old;
	old = t;

	codegen_ir();
	t = nanotime();
	compile_timings.codegen = t - old;
	old = t;

	optimise_ir();
	t = nanotime();
	compile_timings.optimise_ir = t - old;
	old = t;

	ir_lower_x64();
	t = nanotime();
	compile_timings.assembly = t - old;
	old = t;

	optimise_x64();
	t = nanotime();
	compile_timings.optimise_asm = t - old;
	old = t;

	write_output_x64();
	t = nanotime();
	compile_timings.object_write = t - old;
	old = t;

	dump_metrics();
	dump_timings();
};

dump_metrics : func(-> v0)
{
	if(args_should_dump_metrics() == false)
	{
		return;
	}
	i : u64 mut;

	total_stmt_count : u64 mut := 0;
	total_irinst_count : u64 mut := 0;
	total_x64inst_count : u64 mut := 0;

	if(args_has_metrics_dump_specific())
	{
		fn ::= prog_find_function(args.metrics_dump_specific.data, args.metrics_dump_specific.len);
		if(fn == zero)
		{
			err_begin();
			putzstr("requested to dump-metrics for function \0");
			putchar('"');
			putchars(args.metrics_dump_specific.data, args.metrics_dump_specific.len);
			putchar('"');
			putzstr(" but no function exists with this name\0");
			err_end();
		}
		dump_metrics_for(fn, zero, zero, zero);
	}
	else
	{
		for(i = 0; i < prog.global_scope.funcs_count; i = i + 1)
		{
			dump_metrics_for(prog.global_scope.funcs # i, ref total_stmt_count, ref total_irinst_count, ref total_x64inst_count);
		}

		colour_green_underline();
		putzstr("total\0");
		colour_reset();
		putzstr("\n\tfunction count: \0");
		putuint(prog.global_scope.funcs_count);
		putzstr("\n\tstmt count: \0");
		putuint(total_stmt_count);
		if(prog.global_scope.funcs_count > 1)
		{
			putzstr(" (\0");
			putuint(total_stmt_count / prog.global_scope.funcs_count);
			putzstr(" avg per func)\0");
		}

		putzstr("\n\tirinst count: \0");
		putuint(total_irinst_count);
		if(prog.global_scope.funcs_count > 1)
		{
			putzstr(" (\0");
			putuint(total_irinst_count / prog.global_scope.funcs_count);
			putzstr(" avg per func)\0");
		}

		putzstr("\n\tx64inst count: \0");
		putuint(total_x64inst_count);
		if(prog.global_scope.funcs_count > 1)
		{
			putzstr(" (\0");
			putuint(total_x64inst_count / prog.global_scope.funcs_count);
			putzstr(" avg per func)\0");
		}
		putchar('\n');
	}
};

dump_metrics_for : func(fn : function_t mut?, out_stmt_count : u64 mut?, out_irinst_count : u64 mut?, out_x64inst_count : u64 mut? -> v0)
{
	colour_green_underline();
	putchars([ast_decl_get_name(fn->node)], [ast_decl_get_name_len(fn->node)]);
	colour_reset();
	putzstr(" : \0");
	putty(fn->type);
	putzstr(":\n\0");
	i : u64 mut;

	putzstr("\tstmt count: \0");
	putuint(ast_get_child_statements_count(fn->node));
	irfn ::= irapi.prog.funcs # fn->irfunc_idx;
	x64fn ::= x64api.prog.funcs # fn->irfunc_idx;
	putzstr("\n\tir-params count: \0");
	putuint(irfn->params_count);
	putzstr("\n\tir-returns count: \0");
	putuint(irfn->returns_count);
	putzstr("\n\tirblk count: \0");
	putuint(irfn->blks_count);
	inst_count : u64 mut := 0;
	for(i = 0; i < irfn->blks_count; i = i + 1)
	{
		inst_count = inst_count + (irfn->blks # i)->insts_count;
	}
	putzstr("\n\tirinst count: \0");
	putuint(inst_count);
	putzstr("\n\tx64inst count: \0");
	putuint(x64fn->insts_count);
	putchar('\n');
	if(out_stmt_count != zero)
	{
		[out_stmt_count] = [out_stmt_count] + ast_get_child_statements_count(fn->node);
	}
	if(out_irinst_count != zero)
	{
		[out_irinst_count] = [out_irinst_count] + inst_count;
	}
	if(out_x64inst_count != zero)
	{
		[out_x64inst_count] = [out_x64inst_count] + x64fn->insts_count;
	}
};

compile_timings_t : struct
{
	tokenise : u64;
	parse : u64;
	build_regions_plus_tokenise_and_parse : u64;
	pre_codegen : u64;
	codegen : u64;
	optimise_ir : u64;
	assembly : u64;
	optimise_asm : u64;
	object_write : u64;
};

compile_timings : compile_timings_t mut := zero;

write_output_x64 : func(-> v0)
{
	if(args_should_skip_object_write())
	{
		return;
	}

	f ::= path_open(zstr2path("build/test.elf\0"), file.cwd, file_access.write, path_open_flag.truncate | path_open_flag.create_if_notfound | path_open_flag.create_executable);

	codestream : bwriter mut;
	code ::= ref codestream;
	bwriter_create_native(code, 1024, scratch_arena);
	readonlystream : bwriter mut;
	readonly ::= ref readonlystream;
	bwriter_create_native(readonly, 1024, scratch_arena);
	mutablestream : bwriter mut;
	mutable ::= ref mutablestream;
	bwriter_create_native(mutable, 1024, scratch_arena);

	meta : x64enc_meta mut := zero;
	x64prog_encode_to(code, readonly, mutable, ref(x64api.prog), ref meta);

	edata : elf_data mut;
	edata.code = code->buf;
	edata.code_len = code->cursor;
	edata.rodata = readonly->buf;
	edata.rodata_len = readonly->cursor;
	edata.data = mutable->buf;
	edata.data_len = mutable->cursor;
	edata.bss_len = meta.mutablezero_size;
	if(x64api.prog.funcs_count == 0)
	{
		edata.entrypoint = 0;
	}
	else
	{
		the_entrypoint ::= prog_find_function(prog.entrypoint.data, prog.entrypoint.len);
		if(the_entrypoint != zero)
		{
			edata.entrypoint = (x64api.prog.funcs # (the_entrypoint->irfunc_idx))->enc_byte_offset_begin;
		}
	}

	// repurpose code to be the final elf writer
	code->cursor = 0;
	code->len = 0;
	code->buf = zero;
	elf_write(code, ref edata);

	file_write(f, code->buf, code->cursor);
	file_close(f);
};

add_build_file : func(p : path, target : u8?, target_len : u64 -> v0)
{
	putchar('\r');
	putzstr(path2zstr(p));
	putzstr("...\0");

	src ::= add_source_file(p);

	file_node ::= ref(prog_get_source(src)->node);
	region_node ::= find_build_region(file_node, target, target_len);
	if(region_node == zero)
	{
		err_begin();
		putzstr("build file '\0");
		putzstr(path2zstr(p));
		putzstr("' has no build-region named '\0");
		putchars(target, target_len);
		putzstr("'\n\0");
		
		err_end();
	}
	t : u64 mut := nanotime();
	execute_build_region(src, region_node);
	compile_timings.build_regions_plus_tokenise_and_parse = compile_timings.build_regions_plus_tokenise_and_parse + (nanotime() - t);
};

add_source_file : func(p : path -> source)
{
	stats : file_stats mut;
	staterr ::= path_get_stats(p, ref stats, file.cwd);
	if(staterr != zero)
	{
		err_begin();
		putzstr("file \0");
		putchar('"');
		putzstr(path2zstr(p));
		putchar('"');
		putzstr(" open failed with error code \0");
		putsint(staterr@s64);
		err_end();
	}
	if(stats.type == file_type.notfound)
	{
		err_begin();
		putzstr("file \0");
		putchar('"');
		putzstr(path2zstr(p));
		putchar('"');
		putzstr(" could not be found\0");
		err_end();
		return source.invalid;
	}
	if(stats.size == 0)
	{
		warn_begin();
		putzstr("file \0");
		putchar('"');
		putzstr(path2zstr(p));
		putchar('"');
		putzstr(" is empty, skipping...\0");
		warn_end();
		return source.invalid;
	}
	ptr : u8 mut? := arena_alloc(global_arena, stats.size);
	f : file := path_open(p, file.cwd, file_access.read, zero);
	file_read(f, ptr, stats.size);
	//linux_write(1, ptr, stats.size);

	src : source_file mut;
	src.node = zero;
	src.src = ptr;
	src.src_len = stats.size;
	src.path = p;


	toks : token_buffer mut;
	toks.tokens = zero;
	toks.tokens_count = 0;
	toks.tokens_cap = 0;

	retfile ::= prog_add_source_file(ref src);
	
	t : u64 mut := nanotime();
	tokenise(ref toks, retfile);
	compile_timings.tokenise = compile_timings.tokenise + (nanotime() - t);
	t = nanotime();
	parse(retfile, ref toks);
	compile_timings.parse = compile_timings.parse + (nanotime() - t);
	treewalk(retfile);
	scratch_reset();

	//return prog_add_source_file(ref src);
	return retfile;
};
