val_from_node_expr_intrinsic_call : func(ctx : source_context mut?, name : u8?, name_len : u64, out : val mut? -> v0)
{
	param_nodes ::= ast_call_get_params(ctx->node);
	param_count ::= ast_call_get_params_count(ctx->node)@u64;
	if(streql(name, name_len, "print", 5))
	{
		val_from_node_expr_intrinsic_call_print(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "message_begin", 13))
	{
		val_from_node_expr_intrinsic_call_message_begin(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "message_end", 11))
	{
		val_from_node_expr_intrinsic_call_message_end(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "warning_begin", 13))
	{
		val_from_node_expr_intrinsic_call_warning_begin(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "warning_end", 11))
	{
		val_from_node_expr_intrinsic_call_warning_end(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "error_begin", 11))
	{
		val_from_node_expr_intrinsic_call_error_begin(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "error_end", 9))
	{
		val_from_node_expr_intrinsic_call_error_end(ctx, param_nodes, param_count, out);
	}
	if(streql(name, name_len, "embed", 5))
	{
		val_from_node_expr_intrinsic_call_embed(ctx, param_nodes, param_count, out);
	}
};

val_from_node_expr_intrinsic_call_print : func(ctx : source_context mut?, param_nodes : ast mut?, params_count : u64, out : val mut? -> v0)
{
	if(params_count != 1)
	{
		err_begin();
		putzstr("invalid call to intrinsic $print - expected 1 param, got \0");
		putuint(params_count);
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	putchars([ast_literal_get_string(param_nodes # 0)], [ast_literal_get_string_len(param_nodes # 0)]);
};

val_from_node_expr_intrinsic_call_message_begin : func(ctx : source_context mut?, param_nodes : ast mut?, params_count : u64, out : val mut? -> v0)
{
	if(params_count != 0)
	{
		err_begin();
		putzstr("invalid call to intrinsic $message_begin - expected 0 params, got \0");
		putuint(params_count);
		putzstr(" at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	msg_begin();
};

val_from_node_expr_intrinsic_call_message_end : func(ctx : source_context mut?, param_nodes : ast mut?, params_count : u64, out : val mut? -> v0)
{
	if(params_count != 0)
	{
		err_begin();
