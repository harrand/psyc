// $embed : intrinsic(filename_string_literal -> u8[N])
//	where N is the size of the file referred to by the string literal. compile-error if file is not found or is not readable
//  suitable as an initialiser for any variable.
val_from_node_expr_intrinsic_call_embed : func(ctx : source_context mut?, param_nodes : ast mut?, params_count : u64, out : val mut? -> v0)
{
	// yields a value of type u8[N], where N is the number of bytes in the file, and the data contains the file data itself
	// the value set to out is a properly-typed aggregate, which means it is suitable as an initialiser for a global variable, or local variable, or even as an rvalue (and the parts you dont use will be optimised away in the latter case!)
	filename_zstr ::= sstr2zstr([ast_literal_get_string(param_nodes # 0)], [ast_literal_get_string_len(param_nodes # 0)], scratch_arena);
	
	stats : file_stats mut;
	staterr ::= path_get_stats(zstr2path(filename_zstr), ref stats, file.cwd);
	if(staterr != zero)
	{
		err_begin();
		putzstr("embed file \0");
		putchar('"');
		putzstr(filename_zstr);
		putchar('"');
		putzstr(" open failed with error code \0");
		putsint(staterr@s64);
		err_end();
	}
	if(stats.type == file_type.notfound)
	{
		err_begin();
		putzstr("embed file \0");
		putchar('"');
		putzstr(filename_zstr);
		putchar('"');
		putzstr(" could not be found\0");
		err_end();
	}

	ptr : u8 mut? := arena_alloc(global_arena, stats.size);
	f : file := path_open(zstr2path(filename_zstr), file.cwd, file_access.read, zero);
	file_read(f, ptr, stats.size);
	file_close(f);

	out->tag = val_tag.aggregate;
	out->type = ty_make_array(ty.u8, stats.size, ty.qual_static);
	member_vals : val mut? := arena_alloc(global_arena, stats.size * sizeof val);
	the_chunks : abi_chunk mut? := arena_alloc(global_arena, stats.size * sizeof abi_chunk);
	i : u64 mut;
	for(i = 0; i < stats.size; i = i + 1)
	{
		chunkptr ::= the_chunks # i;
		chunkptr->tag = abi_chunk_tag.nonfp;
		chunkptr->src_idx_begin = 0;
		chunkptr->src_idx_end = 0;
		chunkptr->src_byte_offset = i;
		chunkptr->sz = 1;
	}
	[val_aggregate_get_members(out)] = member_vals;
	[val_aggregate_get_chunks(out)] = the_chunks;
	[val_aggregate_get_members_count(out)] = stats.size;
	for(i = 0; i < stats.size; i = i + 1)
	{
		cur_val ::= member_vals # i;
		cur_val->tag = val_tag.scalar;
		cur_val->type = ty.u8;
		irval_bimm([ptr # i], val_scalar_get_irval(cur_val));
		[val_scalar_get_displacement(cur_val)] = 0;
	}
};
