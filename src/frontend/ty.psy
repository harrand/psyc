ty : enum
{
	.qual_mut    := 0x8000000000000000; // msb
	.qual_weak   := 0x4000000000000000; // msb-1
	.qual_static := 0x2000000000000000; // msb-2

	.v0   := 0;	
	.u64  := 1;
	.u32  := 2;
	.u16  := 3;
	.u8   := 4;
	.s64  := 5;
	.s32  := 6;
	.s16  := 7;
	.s8   := 8;
	.f64  := 9;
	.f32  := 10;
	.bool := 11;
	.custom_begin := 12;
	.invalid := ~0;
};

ty_name_tbl ::= u8?[12]
{
	.0 := "v0\0";
	.1 := "u64\0";
	.2 := "u32\0";
	.3 := "u16\0";
	.4 := "u8\0";
	.5 := "s64\0";
	.6 := "s32\0";
	.7 := "s16\0";
	.8 := "s8\0";
	.9 := "f64\0";
	.10 := "f32\0";
	.11 := "bool\0";
};

tytag : enum
{
	.prim := 1;
	.structure := 2;
	.enumeration := 3;
	.function := 4;
	.array := 5;
	.ptr := 6;
};

ty_add_mut : func(in : ty -> ty)
{
	return in | ty.qual_mut;
};

ty_add_weak : func(in : ty -> ty)
{
	return in | ty.qual_weak;
};

ty_add_static : func(in : ty -> ty)
{
	return in | ty.qual_static;
};

ty_strip_mut : func(in : ty -> ty)
{
	return in & (~ty.qual_mut);
};

ty_strip_weak : func(in : ty -> ty)
{
	return in & (~ty.qual_weak);
};

ty_strip_static : func(in : ty -> ty)
{
	return in & (~ty.qual_static);
};

ty_strip_static_unless : func(in : ty, cond : bool -> ty)
{
	if(cond)
	{
		return in;
	}
	return ty_strip_static(in);
};

ty_strip : func(in : ty -> ty)
{
	return in & (~(ty.qual_mut | ty.qual_weak | ty.qual_static));
};

ty_is_mut : func(t : ty -> bool)
{
	return t & ty.qual_mut != 0;
};

ty_is_weak : func(t : ty -> bool)
{
	return t & ty.qual_weak != 0;
};

ty_is_static : func(t : ty -> bool)
{
	return t & ty.qual_static != 0;
};

ty_eq : func(lhs : ty, rhs : ty -> bool)
{
	return ty_strip(lhs) == ty_strip(rhs);
};

ty_is_primitive : func(type : ty -> bool)
{
	base : ty := ty.custom_begin;
	return ty_strip(type)@s64 < base@s64;
};

ty_is_v0 : func(type : ty -> bool)
{
	return ty_strip(type) == ty.v0;
};

ty_is_bool : func(type : ty -> bool)
{
	return ty_strip(type) == ty.bool;
};

ty_is_signed : func(type : ty -> bool)
{
	t ::= ty_strip(type);
	return ((t == ty.s64) || (t == ty.s32) || (t == ty.s16) || (t == ty.s8));
};

ty_integral_size : func(type : ty -> u64)
{
	t ::= ty_strip(type);
	if((t == ty.u64) || (t == ty.s64))
	{
		return 8;
	}
	if((t == ty.u32) || (t == ty.s32))
	{
		return 4;
	}
	if((t == ty.u16) || (t == ty.s16))
	{
		return 2;
	}
	if((t == ty.u8) || (t == ty.s8) || (t == ty.bool))
	{
		return 1;
	}
	return 0;
};

ty_floating_point_size : func(type : ty -> u64)
{
	t ::= ty_strip(type);
	if(t == ty.f64)
	{
		return 8;
	}
	if(t == ty.f32)
	{
		return 4;
	}
	return 0;
};

ty_integer_literal : func(-> ty)
{
	return ty.s64 | ty.qual_weak | ty.qual_static;
};

ty_floating_point_literal : func(-> ty)
{
	return ty.f64 | ty.qual_weak | ty.qual_static;
};

ty_string_literal : func(-> ty)
{
	return ty_make_pointer(ty.u8, zero);
};

ty_boolean_literal : func(-> ty)
{
	return ty.bool | ty.qual_static;
};

ty_char_literal : func(-> ty)
{
	return ty.u8 | ty.qual_static;
};

ty_copy_quals : func(from : ty, to : ty -> ty)
{
	return to | (from & 0xe000000000000000);
};

ty_make_pointer : func(underlying : ty, quals : ty -> ty)
{
	data : tydata mut;
	data.tag = tydata_tag.pointer;
	data.underlying = underlying;
	data.name = zero;
	data.name_len = 0;
	return ty_wrap(ref data) | quals;
};

tydata_tag : enum
{
	.pointer := 0;
	.array := 1;
	.enumeration := 2;
	.structure := 3;
	.function := 4;
};

tydata_enum_entry : struct
{
	val : s64;
	name : u8?;
	name_len : u64;
};

tydata : struct
{
	tag : tydata_tag;
	name : u8?;
	name_len : u64;
	underlying : ty;
	// if structure, these are the types of the data members
	// if enumeration, these are the values of the entries (interpret members[n] as a s64 instead of a ty)
	// otherwise this is ignored
	members : ty mut?;
	members_count : u64;
	array_len : u64;
	reference : ast mut?;
	src : source;
};

ty_is_pointer : func(type : ty -> bool)
{
	if(ty_is_primitive(type))
	{
		return false;
	}
	return ty_unwrap(type)->tag == tydata_tag.pointer;
};

ty_is_array : func(type : ty -> bool)
{
	if(ty_is_primitive(type))
	{
		return false;
	}
	return ty_unwrap(type)->tag == tydata_tag.array;
};

ty_is_enumeration : func(type : ty -> bool)
{
	if(ty_is_primitive(type))
	{
		return false;
	}
	return ty_unwrap(type)->tag == tydata_tag.enumeration;
};

ty_is_structure : func(type : ty -> bool)
{
	if(ty_is_primitive(type))
	{
		return false;
	}
	return ty_unwrap(type)->tag == tydata_tag.structure;
};

ty_is_function : func(type : ty -> bool)
{
	if(ty_is_primitive(type))
	{
		return false;
	}
	return ty_unwrap(type)->tag == tydata_tag.function;
};

// if ptr, return type of pointee
// if array, return type of element
// if enumeration, return underling type
// if function, return the type of the function return type
// else, return ty.invalid
ty_underlying : func(type : ty -> ty)
{
	if(ty_is_primitive(type))
	{
		return ty.invalid;
	}
	u ::= ty_unwrap(type);
	if((u->tag == tydata_tag.pointer) || (u->tag == tydata_tag.array) || (u->tag == tydata_tag.enumeration) || (u->tag == tydata_tag.function))
	{
		return u->underlying;
	}
	return ty.invalid;
};

// if struct, return type of data member at idx 
// if function, return type of param at idx
// else, return ty.invalid
ty_at : func(type : ty, idx : u64 -> ty)
{
	if(ty_is_primitive(type))
	{
		return ty.invalid;
	}
	if(ty_is_array(type))
	{
		return ty_underlying(type);
	}
	u ::= ty_unwrap(type);
	if((u->tag == tydata_tag.structure) || (u->tag == tydata_tag.function))
	{
		if(u->members_count <= idx)
		{
			panic_begin();
			putzstr("todo: better panic messaeg for ty_at(type, idx)-out-of-bounds\0");
			panic_end();
		}
		return [u->members # idx];
	}
	return ty.invalid;
};

ty_enum_at : func(type : ty, idx : u64 -> s64 mut?)
{
	if(!ty_is_enumeration(type))
	{
		return zero;
	}
	u ::= ty_unwrap(type);
	return (u->members@s64 mut?) # idx;
};

ty_enum_find : func(type : ty, name : u8?, name_len : u64 -> s64 mut?)
{
	if(ty_is_enumeration(type) == false)
	{
		return zero;
	}
	u ::= ty_unwrap(type);
	i : u64 mut;
	count ::= ast_enumeration_get_entries_count(u->reference)@u64;
	entry_nodes ::= ast_enumeration_get_entries(u->reference);
	
	for(i = 0; i < count; i = i + 1)
	{
		if(streql(name, name_len, [ast_init_get_symbol(entry_nodes # i)], [ast_init_get_symbol_len(entry_nodes # i)]))
		{
			return (u->members)@s64 mut? # i;
		}
	}
	return zero;
};

// if the structure type has a member of that name, return the index to it
// if not, return ~0
ty_struct_find : func(type : ty, name : u8?, name_len : u64 -> u64)
{
	if(ty_is_structure(type) == false)
	{
		return zero;
	}
	u ::= ty_unwrap(type);
	member_nodes ::= ast_structure_get_data_members(u->reference);
	count ::= ast_structure_get_data_members_count(u->reference)@u64;
	i : u64 mut;
	for(i = 0; i < count; i = i + 1)
	{
		if(streql(name, name_len, [ast_decl_get_name(member_nodes # i)], [ast_decl_get_name_len(member_nodes # i)]))
		{
			return i;
		}
	}
	return ~0;
};

// if enum - return number of entries
// if structure - return number of data members
// if array - return number of elements
// otherwise return 0
ty_countof : func(type : ty -> u64)
{
	if(ty_is_primitive(type))
	{
		return 0;
	}
	u ::= ty_unwrap(type);
	if((u->tag == tydata_tag.structure) || (u->tag == tydata_tag.enumeration) || (u->tag == tydata_tag.function))
	{
		return u->members_count;
	}
	if(u->tag == tydata_tag.array)
	{
		return u->array_len;
	}
	return 0;
};

ty_wrap : func(d : tydata mut? -> ty)
{
	already ::= ty_find(d);
	if(already != ty.invalid)
	{
		return already;
	}
	
	ret ::= ty_new_empty();
	[ty_unwrap(ret)] = [d];
	return ret;
};

ty_unwrap : func(type : ty -> tydata mut?)
{
	base : ty := ty.custom_begin;
	id : s64 mut := ty_strip(type)@s64;
	if(id < base@s64)
	{
		panic_begin();
		putzstr("attempt to ty_unwrap primitive type\0");
		panic_end();
	}
	return ty_storage.data # (id - base@s64);
};

ty_find : func(d : tydata mut? -> ty)
{
	if((d->tag == tydata_tag.enumeration) || (d->tag == tydata_tag.structure))
	{
		return ty_find_by_name(d->name, d->name_len);
	}
	base : ty := ty.custom_begin;

	i : u64 mut;
	for(i = 0; i < ty_storage.data_count; i = i + 1)
	{
		cur ::= ty_storage.data # i;
		if(cur->tag == d->tag)
		{
			if((cur->tag == tydata_tag.enumeration) || (cur->tag == tydata_tag.structure))
			{
				if(streql(d->name, d->name_len, cur->name, cur->name_len))
				{
					return (i@s64 + base@s64)@ty;
				}
			}
			if((cur->tag == tydata_tag.pointer))
			{
				if(cur->underlying == d->underlying)
				{
					return (i@s64 + base@s64)@ty;
				}
			}
			if((cur->tag == tydata_tag.array))
			{
				if((cur->underlying == d->underlying) && (cur->array_len == d->array_len))
				{
					return (i@s64 + base@s64)@ty;
				}
			}
			if((cur->tag == tydata_tag.function))
			{
				if((cur->underlying == d->underlying) && (cur->members_count == d->members_count))
				{
					if(cur->members_count == 0)
					{
						return (i@s64 + base@s64)@ty;
					}
					j : u64 mut;
					all_match : bool mut := true;
					for(j = 0; j < cur->members_count; j = j + 1)
					{
						
						if([d->members # j] != [cur->members # j])
						{
							all_match = false;
						}
					}
					if(all_match)
					{
						return (i@s64 + base@s64)@ty;
					}
				}
			}
		}
	}
	return ty.invalid;
};

ty_find_by_name : func(name : u8?, name_len : u64 -> ty)
{
	i : u64 mut;
	for(i = 0; i < countof typeof(ty_name_tbl); i = i + 1)
	{
		curprimname ::= [ty_name_tbl # i];
		if(streql(name, name_len, curprimname, zstrlen(curprimname)))
		{
			return i@s64@ty;
		}
	}
	count ::= ty_storage.data_count;
	base : ty := ty.custom_begin;
	for(i = 0; i < count; i = i + 1)
	{
		cur ::= ty_storage.data # i;
		if(streql(cur->name, cur->name_len, name, name_len))
		{
			return (i@s64 + base@s64)@ty;
		}
	}
	return ty.invalid;
};

ty_storage_new_id : func(-> u64)
{
	if(ty_storage.data == zero)
	{
		ty_storage.data_cap = 512;
		ty_storage.data = arena_alloc(global_arena, ty_storage.data_cap * sizeof typeof([ty_storage.data]));
	}
	while(ty_storage.data_count >= ty_storage.data_cap)
	{
		olddata ::= ty_storage.data;
		oldcap ::= ty_storage.data_cap;
		ty_storage.data_cap = ty_storage.data_cap * 2;
		ty_storage.data = arena_alloc(global_arena, ty_storage.data_cap * sizeof typeof([ty_storage.data]));
		memcopy(ty_storage.data, olddata, oldcap * sizeof typeof([ty_storage.data]));
	}
	ty_storage.data_count = ty_storage.data_count + 1;
	return ty_storage.data_count - 1;
};

ty_new_empty : func(-> ty)
{
	idx ::= ty_storage_new_id();
	base : ty := ty.custom_begin;
	return (idx@s64 + base@s64)@ty;
};

ty_storage_t : struct
{
	data : tydata mut?;
	data_count : u64;	
	data_cap : u64;
};

ty_storage : ty_storage_t mut := zero;

ty_from_typename_node : func(ctx : source_context mut? -> ty)
{
	return [ty_from_typename_node_tbl # [ast_typename_get_tag(ctx->node)]@s64](ctx);
};

ty_from_typename_node_base : func(ctx : source_context mut? -> ty)
{
	return ty_find_by_name([ast_typename_base_get_basename(ctx->node)], [ast_typename_base_get_basename_len(ctx->node)]) | [ast_typename_get_quals(ctx->node)];
};

ty_from_typename_node_array : func(ctx : source_context mut? -> ty)
{
	underlying_ctx : source_context mut := [ctx];
	underlying_ctx.node = ast_typename_array_get_element_type(ctx->node);
	underlying ::= ty_from_typename_node(ref underlying_ctx);
	len_expr_node ::= ast_typename_array_get_length_expr(ctx->node);

	len_val : val mut;
	len_ctx : source_context mut := [ctx];
	len_ctx.node = len_expr_node;
	len_ctx.type_only = false;
	val_from_node(ref len_ctx, ref len_val);
	if((len_val.tag != val_tag.scalar))
	{
		err_begin();
		putzstr("array length did not yield a scalar\n\0");
		putsrc(ctx->src, len_expr_node->src_beg@u64, len_expr_node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(ty_integral_size(len_val.type) == 0)
	{
		err_begin();
		putzstr("array length yielded non-integral-type \0");
		putchar('"');
		putty(len_val.type);
		putchar('"');
		putchar('\n');
		putsrc(ctx->src, len_expr_node->src_beg@u64, len_expr_node->src_end@u64, putcol.red_underline);
		err_end();
	}

	u : tydata mut;
	u.tag = tydata_tag.array;
	u.name = zero;
	u.name_len = zero;
	u.underlying = underlying;
	u.members = zero;
	u.members_count = zero;
	len_imm ::= val_scalar_get_irval(ref len_val);
	u.array_len = [irval_imm_get_integer(len_imm)]@u64;
	u.reference = ctx->node;

	return ty_wrap(ref u) | [ast_typename_get_quals(ctx->node)];
};

ty_from_typename_node_pointer : func(ctx : source_context mut? -> ty)
{
	underlying_ctx : source_context mut := [ctx];
	underlying_ctx.node = ast_typename_pointer_get_pointee_type(ctx->node);
	underlying ::= ty_from_typename_node(ref underlying_ctx);
	
	u : tydata mut;
	u.tag = tydata_tag.pointer;
	u.name = zero;
	u.name_len = zero;
	u.underlying = underlying;
	u.members = zero;
	u.members_count = zero;
	u.array_len = 0;
	u.reference = ctx->node;

	return ty_wrap(ref u) | [ast_typename_get_quals(ctx->node)];
};

ty_from_typename_node_function : func(ctx : source_context mut? -> ty)
{
	ret_ctx : source_context mut := [ctx];
	ret_ctx.node = ast_typename_function_get_return_typename(ctx->node);
	retty ::= ty_from_typename_node(ref ret_ctx);

	u : tydata mut;
	u.tag = tydata_tag.function;
	u.name = zero;
	u.name_len = zero;
	u.underlying = retty;
	u.members_count = ast_typename_function_get_params_count(ctx->node)@u64;
	u.members = arena_alloc(global_arena, u.members_count * sizeof ty);
	member_decl_nodes ::= ast_typename_function_get_param_decls(ctx->node);
	i : u64 mut;
	for(i = 0; i < u.members_count; i = i + 1)
	{
		member_decl_ctx : source_context mut := [ctx];
		member_decl_ctx.node = ast_decl_get_typename(member_decl_nodes # i);
		[u.members # i] = ty_from_typename_node(ref member_decl_ctx);
	}
	u.array_len = 0;
	u.reference = ctx->node;

	return ty_wrap(ref u) | [ast_typename_get_quals(ctx->node)];
};

ty_from_typename_node_type_of : func(ctx : source_context mut? -> ty)
{
	tyval : val mut;
	tyctx : source_context mut := [ctx];
	tyctx.node = ast_typeof_get_operand(ctx->node);
	return type_from_node(ref tyctx) | [ast_typename_get_quals(ctx->node)];
};

ty_from_typename_node_deduced : func(ctx : source_context mut? -> ty)
{
	panic_begin();
	putzstr("getting the type from a deduced-typename-node is impossible\0");
	panic_end();
	return ty.invalid;
};

ty_from_typename_node_tbl ::= typeof(ty_from_typename_node)[countof ast_typename_tag]
{
	.0 := ty_from_typename_node_base;
	.1 := ty_from_typename_node_array;
	.2 := ty_from_typename_node_pointer;
	.3 := ty_from_typename_node_function;
	.4 := ty_from_typename_node_type_of;
	.5 := ty_from_typename_node_deduced;
};

bwrite_ty_primitive : func(w : bwriter mut?, type : ty -> v0)
{
	bwrite_zstr(w, [ty_name_tbl # type@s64]);
};

bwrite_ty : func(w : bwriter mut?, type : ty -> v0)
{
	if(type == ty.invalid)
	{
		bwrite_zstr(w, "<invalid type>\0");
		return;
	}
	if(ty_is_primitive(type))
	{
		bwrite_ty_primitive(w, ty_strip(type));
	}
	else
	{
		count ::= ty_countof(type);
		i : u64 mut;
		if(ty_is_pointer(type))
		{
			bwrite_ty(w, ty_underlying(type));
			bwrite8(w, '?');
		}
		if(ty_is_array(type))
		{
			bwrite_ty(w, ty_underlying(type));
			bwrite8(w, '[');
			bwrite_uint(w, ty_countof(type));
			bwrite8(w, ']');
		}
		if(ty_is_function(type))
		{
			bwrite_zstr(w, "func(\0");
			for(i = 0; i < count; i = i + 1)
			{
				bwrite_ty(w, ty_at(type, i));
				if(i < (count - 1))
				{
					bwrite_zstr(w, ", \0");
				}
			}
			bwrite_zstr(w, " -> \0");
			bwrite_ty(w, ty_underlying(type));
			bwrite8(w, ')');
		}
		if(ty_is_enumeration(type) || ty_is_structure(type))
		{
			u ::= ty_unwrap(type);
			bwrite_bytes(w, u->name, u->name_len);
		}
	}
	// dont forget the quals!
	if(ty_is_mut(type))
	{
		bwrite_zstr(w, " mut\0");
	}
	if(ty_is_weak(type))
	{
		bwrite_zstr(w, " weak\0");
	}
	if(ty_is_static(type))
	{
		bwrite_zstr(w, " static\0");
	}
};

tyconv : enum
{
	// pointer -> pointer conversion
	.ptr2ptr := 0;
	// pointer -> u64 conversion
	.ptr2u64 := 1;
	// u64 -> pointer conversion
	.u642ptr := 2;
	// enum -> s64 conversion
	.enum2s64 := 3;
	// s64 -> enum conversion
	.s642enum := 4;
	// pointer -> function conversion
	.ptr2fn := 5;
	// function -> pointer conversion
	.fn2ptr := 6;
	// integer -> integer conversion (same size)
	.i2i := 7;
	// sign-extend (sX -> sY) where Y > X
	.sext := 8;
	// zero-extend (uX -> uY) where Y > X
	.zext := 9;
	// integral truncate (iX -> iY) where X > Y
	.trunc := 10;
	// floating-point-extend (f32 -> f64)
	.fpext := 11;
	// floating-point-truncate (f64 -> f32)
	.fptrunc := 12;
	// integral to floating-point (iX -> fY)
	.i2fp := 13;
	// floating-point to integral (fX -> iY)
	.fp2i := 14;
	.noop := 15;
	.no := 16;
	.no_cant_add_staticness := 17;
	.no_but_yes_with_weak := 18;
};

tyconv_is_valid : func(c : tyconv -> bool)
{
	fail_base : tyconv := tyconv.no;
	return c@s64 < fail_base@s64;
};

ty_equality_comparable_to : func(from : ty, to : ty -> bool)
{
	if(ty_is_structure(from) || ty_is_structure(to))
	{
		return false;
	}
	if(ty_strip(from) == ty_strip(to))
	{
		return true;
	}
	if((ty_integral_size(from) > 0) && (ty_integral_size(to) > 0))
	{
		return ty_is_weak(from) || ty_is_weak(to);
	}
	warn_begin();
	putzstr("ty_equality_comparable_to NYI for type \0");
	putty(from);
	putzstr(" to \0");
	putty(to);
	putzstr(", just gonna return false\0");
	warn_end();
	return false;
};

ty_inequality_comparable_to : func(from : ty, to : ty -> bool)
{
	if(((ty_floating_point_size(from) > 0) && (ty_floating_point_size(to) > 0))
	|| ((ty_integral_size(from) > 0) && (ty_integral_size(to) > 0)))
	{
		if(ty_strip(from) == ty_strip(to))
		{
			return true;
		}
	}
	return false;
};

ty_converts_to : func(from : ty, to : ty -> tyconv)
{
	from_is_mut ::= ty_is_mut(from);
	from_is_weak ::= ty_is_weak(from);
	from_is_static ::= ty_is_static(from);
	from_underlying ::= ty_underlying(from);
	from_isz ::= ty_integral_size(from);
	from_fsz ::= ty_floating_point_size(from);
	from_is_signed ::= ty_is_signed(from);

	to_is_mut ::= ty_is_mut(to);
	to_is_weak ::= ty_is_weak(to);
	to_is_static ::= ty_is_static(to);
	to_underlying ::= ty_underlying(to);
	to_isz ::= ty_integral_size(to);
	to_fsz ::= ty_floating_point_size(to);

	either_is_weak ::= from_is_weak || to_is_weak;

	if((!from_is_static) && to_is_static)
	{
		return tyconv.no_cant_add_staticness;
	}
	if(ty_strip(from) == ty_strip(to))
	{
		return tyconv.noop;
	}
	if(ty_is_pointer(from) && ty_is_pointer(to))
	{
		// todo: remove the underlying comparisons? should 'ast?' not require a cast to 'ast mut?'
		if((ty_strip(ty_underlying(from)) == ty_strip(ty_underlying(to))) || either_is_weak)
		{
			return tyconv.ptr2ptr;
		}
	}
	if((from_isz > 0) && (to_isz > 0))
	{
		// integrals
		if(either_is_weak)
		{
			if(from_isz > to_isz)
			{
				// decreasing size
				return tyconv.trunc;
			}
			if(from_isz < to_isz)
			{
				// increasing size
				if(from_is_signed)
				{
					return tyconv.sext;
				}
				return tyconv.zext;
			}
			return tyconv.i2i;
		}
	}

	// enum -> s64
	if(ty_is_enumeration(from) && (ty_strip(to) == ty.s64) && either_is_weak)
	{
		return tyconv.enum2s64;
	}
	// s64 -> enum
	if((ty_strip(from) == ty.s64) && ty_is_enumeration(to) && either_is_weak)
	{
		return tyconv.s642enum;
	}

	// pointer -> u64
	if(ty_is_pointer(from) && (ty_strip(to) == ty.u64) && either_is_weak)
	{
		return tyconv.ptr2u64;
	}
	if((ty_strip(from) == ty.u64) && ty_is_pointer(to) && either_is_weak)
	{
		return tyconv.u642ptr;
	}
	
	warn_begin();
	putzstr("ty_converts_to NYI for type \0");
	putty(from);
	putzstr(" to \0");
	putty(to);
	putzstr(", just gonna return 'no this is not a valid conversion'\0");
	warn_end();
	return tyconv.no;
};


ty_of_arithmetic : func(lhs : ty, rhs : ty -> ty)
{
	if((ty_is_primitive(lhs) == false) || (ty_is_primitive(rhs) == false))
	{
		return ty.invalid;
	}
	return ty_of_arithmetic_base(lhs, rhs);
};

ty_of_arithmetic_base : func(lhs : ty, rhs : ty -> ty)
{
	if(ty_is_v0(lhs) || ty_is_v0(rhs))
	{
		return ty.invalid;
	}
		
	both_are_static ::= ty_is_static(lhs) && ty_is_static(rhs);
	if(ty_is_bool(lhs) || ty_is_bool(rhs))
	{
		if(ty_is_bool(lhs) && ty_is_bool(rhs))
		{
			return ty_strip_static_unless(ty.bool, both_are_static);
		}
		return ty.invalid;
	}
	lhs_i ::= ty_integral_size(lhs);
	lhs_f ::= ty_floating_point_size(lhs);
	lhs_arith ::= lhs_i + lhs_f;
	lhs_is_signed ::= ty_is_signed(lhs);
	rhs_i ::= ty_integral_size(rhs);
	rhs_f ::= ty_floating_point_size(rhs);
	rhs_arith ::= rhs_i + rhs_f;
	rhs_is_signed ::= ty_is_signed(rhs);
	// floating point and integral => lhs
	if((lhs_f > 0) && (rhs_i > 0))
	{
		return ty_strip_static_unless(lhs, both_are_static);
	}
	// integral and floating point => rhs
	if((lhs_i > 0) && (rhs_f > 0))
	{
		return ty_strip_static_unless(rhs, both_are_static);
	}
	// both are integral or both are floating point
	if(((lhs_i > 0) && (rhs_i > 0)) || ((lhs_f > 0) && (rhs_f > 0)))
	{
		// lhs_sz < rhs_sz => rhs
		if(lhs_arith < rhs_arith)
		{
			return ty_strip_static_unless(rhs, both_are_static);
		}
		// lhs_sz > rhs_sz => lhs
		if(lhs_arith > rhs_arith)
		{
			return ty_strip_static_unless(lhs, both_are_static);
		}
		// same size, prefer unsigned
		if(lhs_is_signed != rhs_is_signed)
		{
			if(lhs_is_signed)
			{
				// rhs is unsigned
				return ty_strip_static_unless(rhs, both_are_static);
			}
			// lhs is unsigned
			return ty_strip_static_unless(lhs, both_are_static);
		}
		// same size same signedness. prefer lhs
		return ty_strip_static_unless(lhs, both_are_static);
	}
	if(ty_strip(lhs) == ty_strip(rhs))
	{
		return ty_strip(lhs);
	}
	return zero;
};

ty_of_bitwise : func(lhs : ty, rhs : ty -> ty)
{
	return ty_of_arithmetic_base(lhs, rhs);
};
