find_build_region : func(node : ast mut?, name : u8?, name_len : u64 -> ast mut?)
{
	i : u32 mut;
	count ::= node->children_count;
	for(i = 0; i < count; i = i + 1)
	{
		child ::= node->children # i;
		if((child->tag == ast_tag.stmt) && ([ast_stmt_get_tag(child)] == ast_stmt_tag.region) && streql(name, name_len, [ast_region_get_name(child)], [ast_region_get_name_len(child)]))
		{
			return child;
		}
	}
	return zero;
};

execute_build_region : func(src : source, region_node : ast mut?, rel : file -> v0)
{
	build_scope : scope_t mut := zero;

	i : u32 mut;
	count ::= ast_region_get_body_count(region_node);
	body ::= ast_region_get_body(region_node);
	for(i = 0; i < count; i = i + 1)
	{
		child ::= body # i;
		out : val mut;
		execute_build_inst_stmt(child, src, rel, ref build_scope, ref out);
	}
};

execute_build_inst_stmt : func(stmt : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	[execute_build_inst_tbl # [ast_stmt_get_tag(stmt)]@s64](stmt, src, rel, scope, out);
};

execute_build_inst_expr : func(expr : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	[execute_build_inst_expr_tbl # [ast_expr_get_tag(expr)]@s64](expr, src, rel, scope, out);
};

execute_build_inst_decl : func(stmt : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	name ::= [ast_decl_get_name(stmt)];
	name_len ::= [ast_decl_get_name_len(stmt)];

	var : variable_t mut;
	var.node = stmt;
	var.src = src;
	var.type = zero;
	var.local_param_idx = ~0;
	scope_add_variable(scope, ref var);

	ctx : source_context mut;
	ctx.node = stmt;
	ctx.src = src;
	ctx.parent_fn = zero;
	ctx.type_only = false;
	
	semal_variable(ref var, ref ctx);
	// todo: set variable stuff.
	init_node ::= ast_decl_maybe_get_init_node(stmt);
	if(init_node != zero)
	{
		ctx.node = stmt;
		execute_build_inst_expr(init_node, src, rel, scope, ref(var.storage));
	}
};

execute_build_inst_symbol : func(literal : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
};

execute_build_inst_literal : func(literal : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	tag ::= [ast_literal_get_tag(literal)];
	if(tag == ast_literal_tag.string)
	{
		// string-literal is special-cased because otherwise it produces an ir global which is wrong.
		build_make_string_literal([ast_literal_get_string(literal)], [ast_literal_get_string_len(literal)], out);
		return;
	}
	ctx : source_context mut;
	ctx.src = src;
	ctx.node = literal;
	ctx.parent_fn = zero;
	ctx.type_only = false;
	val_from_node_expr_literal(ref ctx, out);
};

execute_build_inst_unop : func(unop : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	operand_node ::= ast_unop_get_operand(unop);
	operand_val : val mut;
	execute_build_inst_expr(operand_node, src, rel, scope, ref operand_val);
	ctx : source_context mut;
	ctx.node = unop;
	ctx.src = src;
	ctx.parent_fn = zero;
	ctx.type_only = false;

	[val_from_node_expr_unop_tbl # [ast_unop_get_tag(unop)]@s64](ref operand_val, ref ctx, out);
};

execute_build_inst_biop : func(biop : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	lhs_node ::= ast_biop_get_lhs(biop);
	lhs_val : val mut;
	execute_build_inst_expr(lhs_node, src, rel, scope, ref lhs_val);
	rhs_node ::= ast_biop_get_rhs(biop);
	rhs_val : val mut;
	if(ast_is_expr(rhs_node, ast_expr_tag.zero_value))
	{
		// special-case for biop.at
		if([ast_biop_get_tag(biop)] == ast_biop_tag.at)
		{
			val_zero_as(ty.s64, ref rhs_val);
		}
		else
		{
			// otherwise is zero@lhs.type
			val_zero_as(lhs_val.type, ref rhs_val);
		}
	}
	else
	{
		execute_build_inst_expr(rhs_node, src, rel, scope, ref rhs_val);
	}
	ctx : source_context mut;
	ctx.node = biop;
	ctx.src = src;
	ctx.parent_fn = zero;
	ctx.type_only = false;
	[val_from_node_expr_biop_tbl # [ast_biop_get_tag(biop)]@s64](lhs_node, rhs_node, ref lhs_val, ref rhs_val, ref ctx, out);
};

execute_build_inst_call : func(call : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	callee ::= ast_call_get_callee(call);
	if([ast_expr_get_tag(callee)] != ast_expr_tag.symbol)
	{
		err_begin();
		putzstr("callee must be a symbol expression in a build region at \0");
		putsrc(src, callee->src_beg@u64, callee->src_end@u64, putcol.red_underline);
		err_end();
	}
	// collect params
	params_count ::= ast_call_get_params_count(call)@u64;
	params_begin ::= ast_call_get_params(call);
	params : val mut? := arena_alloc(scratch_arena, params_count * sizeof val);
	i : u64 mut;
	for(i = 0; i < params_count; i = i + 1)
	{
		execute_build_inst_expr(params_begin # i, src, rel, scope, params # i);
	}
	// do builtin call
	if([ast_call_get_is_builtin_call(call)])
	{
		execute_build_builtin([ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)], params, params_count, src, call, rel, out);
	}
	else
	{
		// call other build region
		file_ast ::= ref(prog_get_source(src)->node);

		other_region ::= find_build_region(file_ast, [ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)]);
		if(other_region == zero)
		{
			err_begin();
			putzstr("call to build-region \0");
			putchar('"');
			putchars([ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)]);
			putchar('"');
			putzstr(", which is not found in the same source-file at \0");
			putsrc(src, call->src_beg@u64, call->src_end@u64, putcol.red_underline);
			err_end();
		}
		execute_build_region(src, other_region, rel);
	}
};

execute_build_inst_invalid : func(stmt : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	err_begin();
	putzstr("statement is not a valid build instruction\n\0");
	putsrc(src, stmt->src_beg@u64, stmt->src_end@u64, putcol.red_underline);
	err_end();
};

execute_build_inst_tbl ::= func(stmt : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)[countof ast_stmt_tag]
{
	.0 := execute_build_inst_expr;
	.1 := execute_build_inst_decl;
	.2 := execute_build_inst_invalid;
	.3 := execute_build_inst_invalid;
	.4 := execute_build_inst_invalid;
	.5 := execute_build_inst_invalid;
	.6 := execute_build_inst_invalid;
	.7 := execute_build_inst_invalid;
	.8 := execute_build_inst_invalid;
	.9 := execute_build_inst_invalid;
	.10 := execute_build_inst_invalid;
	.11 := execute_build_inst_invalid;
	.12 := execute_build_inst_invalid;
	.13 := execute_build_inst_invalid;
};

execute_build_inst_expr_tbl ::= func(expr : ast mut?, src : source, rel : file, scope : scope_t mut?, out : val mut? -> v0)[countof ast_expr_tag]
{
	.0 := execute_build_inst_symbol;
	.1 := execute_build_inst_literal;
	.2 := execute_build_inst_invalid;
	.3 := execute_build_inst_unop;
	.4 := execute_build_inst_biop;
	.5 := execute_build_inst_call;
	.6 := execute_build_inst_invalid;
	.7 := execute_build_inst_invalid;
	.8 := execute_build_inst_invalid;
	.9 := execute_build_inst_invalid;
	.10 := execute_build_inst_invalid;
	.11 := execute_build_inst_invalid;
	.12 := execute_build_inst_invalid;
	.13 := execute_build_inst_invalid;
};

build_make_string_literal : func(chars : u8?, chars_len : u64, out : val mut? -> v0)
{
	out->tag = val_tag.aggregate;
	mems : val mut? := arena_alloc(scratch_arena, chars_len * sizeof val);
	i : u64 mut;
	for(i = 0; i < chars_len; i = i + 1)
	{
		cur_val ::= mems # i;
		cur_val->tag = val_tag.scalar;
		cur_val->type = ty_char_literal();
		irval_bimm([chars # i], val_scalar_get_irval(cur_val));
	}

	[val_aggregate_get_members(out)] = mems;
	[val_aggregate_get_members_count(out)] = chars_len;
	// the concept of abi chunks doesnt exist at the build region level, because there is no ABI
	[val_aggregate_get_chunks(out)] = zero;
};

build_try_get_string_literal : func(v : val mut?, chars_out : u8 mut? mut?, chars_len_out : u64 mut? -> bool)
{
	if(v->tag != val_tag.aggregate)
	{
		return false;
	}
	len ::= [val_aggregate_get_members_count(v)];
	agg_begin ::= [val_aggregate_get_members(v)];
	out : u8 mut? := arena_alloc(global_arena, len);
	i : u64 mut;
	for(i = 0; i < len; i = i + 1)
	{
		agg_cur ::= agg_begin # i;
		if((agg_cur->tag != val_tag.scalar) || (agg_cur->type != ty_char_literal()))
		{
			return false;
		}
		[out # i] = [irval_imm_get_integer(val_scalar_get_irval(agg_cur))]@u8;
	}
	[chars_out] = out;
	[chars_len_out] = len;
	return true;
};

build_must_get_string_literal : func(v : val mut?, chars_out : u8 mut? mut?, chars_len_out : u64 mut? -> v0)
{
	if(!build_try_get_string_literal(v, chars_out, chars_len_out))
	{
		err_begin();
		putzstr("fucked up getting string literal data within a build region\0");
		err_end();
	}
};

execute_build_builtin_add_source_file : func(params : val mut?, params_count : u64, src : source, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(params # 0, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	add_source_file(zstr2path(path_zstr), rel);
};

execute_build_builtin_add_build_file : func(params : val mut?, params_count : u64, src : source, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(params # 0, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	the_path : path mut := zstr2path(path_zstr);

	// if the path contains a parent path, then we actually want that to be the relative path of the add_build_file, not our rel
	actual_rel ::= path_get_parent(the_path, rel, ref the_path);

	target_data : u8 mut? mut;
	target_len : u64 mut;
	build_must_get_string_literal(params # 1, ref target_data, ref target_len);
	add_build_file(the_path, target_data, target_len, actual_rel);
};

execute_build_builtin_add_source_directory : func(params : val mut?, params_count : u64, src : source, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(params # 0, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);

	dir ::= path_open(zstr2path(path_zstr), file.cwd, file_access.read, zero);
	directory_iterate(dir, build_builtin_add_source_directory_callback, rel@s64@u64);
	file_close(dir);
};

build_builtin_add_source_directory_callback : func(child_path : path, usrdata : v0? weak -> bool)
{
	rel ::= usrdata@u64@s64@file;
	add_source_file(path_dupe(child_path, global_arena), rel);
	return true;
};

execute_build_builtin_add_source_directory_recursive : func(params : val mut?, params_count : u64, src : source, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(params # 0, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	dir ::= path_open(zstr2path(path_zstr), rel, file_access.read, zero);
	directory_iterate(dir, build_builtin_add_source_directory_recursive_callback, dir@s64@u64);
	file_close(dir);
};

build_builtin_add_source_directory_recursive_callback : func(child_path : path, usrdata : v0? weak -> bool)
{
	rel ::= usrdata@u64@s64@file;

	stats : file_stats mut;
	err ::= path_get_stats(child_path, ref stats, rel);
	if(err == zero)
	{
		if(stats.type == file_type.dir)
		{
			// iterate again
			dir ::= path_open(child_path, rel, file_access.directory, zero);
			directory_iterate(dir, build_builtin_add_source_directory_recursive_callback, dir@s64@u64);
			file_close(dir);
		}
		else
		{
			add_source_file(path_dupe(child_path, global_arena), rel);
		}
	}
	else
	{
		err_begin();
		putzstr("within add_source_directory_recursive, failed to stat \0");
		putchar('"');
		putzstr(path2zstr(child_path));
		putchar('"');
		putzstr(": error code \0");
		putsint(err@s64);
		err_end();
	}
	return true;
};

execute_build_builtin_prebuild_command : func(params : val mut?, params_count : u64, src : source, out : val mut? -> v0)
{
	cmd_data : u8 mut? mut;
	cmd_len : u64 mut;
	build_must_get_string_literal(params # 0, ref cmd_data, ref cmd_len);
	cmd_zstr ::= sstr2zstr(cmd_data, cmd_len, global_arena);

	return_code : s32 := shell_command(cmd_zstr);
	out->tag = val_tag.scalar;
	out->type = ty_integer_literal();
	irval_qimm(return_code, val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
	
};

execute_build_builtin_set_optimization : func(params : val mut?, params_count : u64, src : source -> v0)
{
	opt_irval ::= val_scalar_get_irval(params # 0);
	prog.opt = [irval_imm_get_integer(opt_irval)]@program_optimisation;
};

execute_build_builtin_debug_symbols : func(params : val mut?, params_count : u64, src : source -> v0)
{
	opt_irval ::= val_scalar_get_irval(params # 0);
	prog.debug_symbols = ([irval_imm_get_integer(opt_irval)] != 0);
};

execute_build_builtin_output_directory : func(params : val mut?, params_count : u64, src : source -> v0)
{
	build_must_get_string_literal(params # 0, ref(prog.output_dir.data), ref(prog.output_dir.len));
};

execute_build_builtin_output_name : func(params : val mut?, params_count : u64, src : source -> v0)
{
	build_must_get_string_literal(params # 0, ref(prog.output_name.data), ref(prog.output_name.len));
};

execute_build_builtin_assert : func(params : val mut?, params_count : u64, src : source -> v0)
{
	the_irval ::= val_scalar_get_irval(params # 0);
	if([irval_imm_get_integer(the_irval)] == 0)
	{
		panic_begin();
		putzstr("$assert failure\0");
		panic_end();
	}
};

execute_build_builtin : func(name : u8?, name_len : u64, params : val mut?, params_count : u64, src : source, node : ast mut?, rel : file, out : val mut? -> v0)
{
	if(streql(name, name_len, "add_source_file", 15))
	{
		execute_build_builtin_add_source_file(params, params_count, src, rel);
		return;
	}
	if(streql(name, name_len, "add_build_file", 14))
	{
		execute_build_builtin_add_build_file(params, params_count, src, rel);
		return;
	}
	if(streql(name, name_len, "add_source_directory", 20))
	{
		execute_build_builtin_add_source_directory(params, params_count, src, rel);
		return;
	}
	if(streql(name, name_len, "add_source_directory_recursive", 30))
	{
		execute_build_builtin_add_source_directory_recursive(params, params_count, src, rel);
		return;
	}
	if(streql(name, name_len, "prebuild_command", 16))
	{
		execute_build_builtin_prebuild_command(params, params_count, src, out);
		return;
	}
	if(streql(name, name_len, "set_optimization", 16))
	{
		execute_build_builtin_set_optimization(params, params_count, src);
		return;
	}
	if(streql(name, name_len, "debug_symbols", 13))
	{
		execute_build_builtin_debug_symbols(params, params_count, src);
		return;
	}
	if(streql(name, name_len, "output_directory", 16))
	{
		execute_build_builtin_output_directory(params, params_count, src);
		return;
	}
	if(streql(name, name_len, "output_name", 11))
	{
		execute_build_builtin_output_name(params, params_count, src);
		return;
	}
	if(streql(name, name_len, "assert", 6))
	{
		execute_build_builtin_assert(params, params_count, src);
		return;
	}
	
	err_begin();
	putzstr("unrecognised build builtin '\0");
	putchars(name, name_len);
	putzstr("'\n\0");
	putsrc(src, node->src_beg@u64, node->src_end@u64, putcol.red_underline);
	err_end();
};
