// return pointer to node representing the build region in the AST, or zero if no such region exists.
find_build_region : func(node : ast mut?, name : u8?, name_len : u64 -> ast mut?)
{
	i : u32 mut;
	count ::= node->children_count;
	for(i = 0; i < count; i = i + 1)
	{
		child ::= node->children # i;
		if((child->tag == ast_tag.stmt) && ([ast_stmt_get_tag(child)] == ast_stmt_tag.region) && streql(name, name_len, [ast_region_get_name(child)], [ast_region_get_name_len(child)]))
		{
			return child;
		}
	}
	return zero;
};

// go through the build region and interpret its contents as compile-time build instructions. this has a passing resemblence to code generation using the val system, and even tries to re-use a bunch of its code. but it has a handful of special-cases and restrictions because of course its build time.
// for example, as there is no ABI, you cant get the sizeof/alignof types
execute_build_region : func(src : source, region_node : ast mut?, rel : file, scope : scope_t mut? -> v0)
{
	new_scope : scope_t mut := zero;
	build_scope : scope_t mut? mut := scope;
	if(build_scope == zero)
	{
		build_scope = ref new_scope;
	}

	i : u32 mut;
	count ::= ast_region_get_body_count(region_node);
	body ::= ast_region_get_body(region_node);
	for(i = 0; i < count; i = i + 1)
	{
		child ::= body # i;
		out : val mut;
		ctx : source_context mut;
		ctx.src = src;
		ctx.node = child;
		ctx.parent_fn = zero;
		ctx.type_only = false;
		execute_build_inst_stmt(ref ctx, rel, build_scope, ref out);
	}
};

// val_from_node_stmt but for a build region
execute_build_inst_stmt : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	[execute_build_inst_tbl # [ast_stmt_get_tag(ctx->node)]@s64](ctx, rel, scope, out);
};

// val_from_node_expr but for a build region
execute_build_inst_expr : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	[execute_build_inst_expr_tbl # [ast_expr_get_tag(ctx->node)]@s64](ctx, rel, scope, out);
};

// val_from_node_stmt_decl but for a build region. the hoisting behaviour only exists in the runtime codegen; here we generate new variable_t's on-the-fly and add them to our scope representing the current build region.
execute_build_inst_decl : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	name ::= [ast_decl_get_name(ctx->node)];
	name_len ::= [ast_decl_get_name_len(ctx->node)];

	var : variable_t mut;
	var.node = ctx->node;
	var.src = ctx->src;
	var.type = zero;
	var.local_param_idx = ~0;
	
	semal_variable(ref var, ctx);
	// if we dont have an init node, then its a val_tag.invalid from semal_variable
	// if we do then turn the node into a val
	init_node ::= ast_decl_maybe_get_init_node(ctx->node);
	if(init_node != zero)
	{
		init_ctx : source_context mut := [ctx];
		init_ctx.node = init_node;
		execute_build_inst_expr(ref init_ctx, rel, scope, ref(var.storage));
	}
	else
	{
		err_begin();
		putzstr("build-region decl \0");
		putchars(name, name_len);
		putzstr(" has no initialiser at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	if(var.storage.tag == val_tag.invalid)
	{
		err_begin();
		putzstr("build-region decl \0");
		putchars(name, name_len);
		putzstr(" had an initialiser that doesn't yield a value at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	scope_add_variable(scope, ref var);
};

execute_build_inst_symbol : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	val_from_node_expr_symbol_from_scope(ctx, scope, out);
};

execute_build_inst_literal : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	tag ::= [ast_literal_get_tag(ctx->node)];
	if(tag == ast_literal_tag.string)
	{
		// string-literal is special-cased because otherwise it produces an ir global which is wrong.
		build_make_string_literal([ast_literal_get_string(ctx->node)], [ast_literal_get_string_len(ctx->node)], out);
		return;
	}
	val_from_node_expr_literal(ctx, out);
};

execute_build_inst_unop : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	operand_val : val mut;

	operand_ctx : source_context mut := [ctx];
	operand_ctx.node = ast_unop_get_operand(ctx->node);
	execute_build_inst_expr(ref operand_ctx, rel, scope, ref operand_val);
	[val_from_node_expr_unop_tbl # [ast_unop_get_tag(ctx->node)]@s64](ref operand_val, ctx, out);
};

execute_build_inst_biop : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	lhs_node ::= ast_biop_get_lhs(ctx->node);

	lhs_context : source_context mut := [ctx];
	lhs_context.node = lhs_node;
	lhs_val : val mut;
	execute_build_inst_expr(ref lhs_context, rel, scope, ref lhs_val);

	rhs_node ::= ast_biop_get_rhs(ctx->node);
	rhs_val : val mut;
	if(ast_is_expr(rhs_node, ast_expr_tag.zero_value))
	{
		// special-case for biop.at
		if([ast_biop_get_tag(ctx->node)] == ast_biop_tag.at)
		{
			val_zero_as(ty.s64, ref rhs_val);
		}
		else
		{
			// otherwise is zero@lhs.type
			val_zero_as(lhs_val.type, ref rhs_val);
		}
	}
	else
	{
		rhs_context : source_context mut := [ctx];
		rhs_context.node = rhs_node;
		execute_build_inst_expr(ref rhs_context, rel, scope, ref rhs_val);
	}
	[val_from_node_expr_biop_tbl # [ast_biop_get_tag(ctx->node)]@s64](lhs_node, rhs_node, ref lhs_val, ref rhs_val, ctx, out);
};

execute_build_inst_call : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	callee ::= ast_call_get_callee(ctx->node);
	if([ast_expr_get_tag(callee)] != ast_expr_tag.symbol)
	{
		err_begin();
		putzstr("callee must be a symbol expression in a build region at \0");
		putsrc(ctx->src, callee->src_beg@u64, callee->src_end@u64, putcol.red_underline);
		err_end();
	}
	// collect params
	params_count ::= ast_call_get_params_count(ctx->node)@u64;
	params_begin ::= ast_call_get_params(ctx->node);
	params : val mut? := arena_alloc(scratch_arena, params_count * sizeof val);
	i : u64 mut;
	for(i = 0; i < params_count; i = i + 1)
	{
		param_ctx : source_context mut := [ctx];
		param_ctx.node = params_begin # i;
		execute_build_inst_expr(ref param_ctx, rel, scope, params # i);
	}
	// do builtin call
	if([ast_call_get_is_builtin_call(ctx->node)])
	{
		execute_build_builtin([ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)], params, params_count, ctx, rel, scope, out);
	}
	else
	{
		// call other build region
		file_ast ::= ref(prog_get_source(ctx->src)->node);

		other_region ::= find_build_region(file_ast, [ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)]);
		if(other_region == zero)
		{
			err_begin();
			putzstr("call to build-region \0");
			putchar('"');
			putchars([ast_symbol_get_data(callee)], [ast_symbol_get_data_len(callee)]);
			putchar('"');
			putzstr(", which is not found in the same source-file at \0");
			putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
			err_end();
		}
		execute_build_region(ctx->src, other_region, rel, scope);
	}
};

execute_build_inst_invalid : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	err_begin();
	putzstr("statement is not a valid build instruction\n\0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	err_end();
};

execute_build_inst_if_stmt : func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	// get the condition and evaluate it immediately
	// if its truthy, then execute the if-body
	cond_expr ::= ast_if_get_condition_expression(ctx->node);
	cond_val : val mut;
	cond_val.tag = val_tag.invalid;
	cond_ctx : source_context mut := [ctx];
	cond_ctx.node = cond_expr;
	execute_build_inst_expr(ref cond_ctx, rel, scope, ref cond_val);
	if(cond_val.tag != val_tag.scalar)
	{
		err_begin();
		putzstr("condition of if-statement in build region did not produce a valid value at \0");
		putsrc(ctx->src, cond_expr->src_beg@u64, cond_expr->src_end@u64, putcol.red_underline);
		err_end();
	}
	val_conv(ref cond_val, ty.bool, ref cond_val, ref cond_ctx);
	the_value ::= [irval_imm_get_integer(val_scalar_get_irval(ref cond_val))]@u8;
	if(the_value != 0)
	{
		body_begin ::= ast_if_get_body(ctx->node);
		body_count ::= ast_if_get_body_count(ctx->node)@u64;
		// execute the body
		i : u64 mut;
		for(i = 0; i < body_count; i = i + 1)
		{
			dummy : val mut;
			body_ctx : source_context mut := [ctx];
			body_ctx.node = body_begin # i;
			execute_build_inst_stmt(ref body_ctx, rel, scope, ref dummy);
		}
	}
};

execute_build_inst_tbl ::= func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)[countof ast_stmt_tag]
{
	.0 := execute_build_inst_expr;
	.1 := execute_build_inst_decl;
	.2 := execute_build_inst_invalid;
	.3 := execute_build_inst_invalid;
	.4 := execute_build_inst_invalid;
	.5 := execute_build_inst_invalid;
	.6 := execute_build_inst_invalid;
	.7 := execute_build_inst_if_stmt;
	.8 := execute_build_inst_invalid;
	.9 := execute_build_inst_invalid;
	.10 := execute_build_inst_invalid;
	.11 := execute_build_inst_invalid;
	.12 := execute_build_inst_invalid;
	.13 := execute_build_inst_invalid;
};

execute_build_inst_expr_tbl ::= func(ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)[countof ast_expr_tag]
{
	.0 := execute_build_inst_symbol;
	.1 := execute_build_inst_literal;
	.2 := execute_build_inst_invalid;
	.3 := execute_build_inst_unop;
	.4 := execute_build_inst_biop;
	.5 := execute_build_inst_call;
	.6 := execute_build_inst_invalid;
	.7 := execute_build_inst_invalid;
	.8 := execute_build_inst_invalid;
	.9 := execute_build_inst_invalid;
	.10 := execute_build_inst_invalid;
	.11 := execute_build_inst_invalid;
	.12 := execute_build_inst_invalid;
	.13 := execute_build_inst_invalid;
};

build_make_string_literal : func(chars : u8?, chars_len : u64, out : val mut? -> v0)
{
	out->tag = val_tag.aggregate;
	mems : val mut? := arena_alloc(scratch_arena, chars_len * sizeof val);
	i : u64 mut;
	for(i = 0; i < chars_len; i = i + 1)
	{
		cur_val ::= mems # i;
		cur_val->tag = val_tag.scalar;
		cur_val->type = ty_char_literal();
		[val_scalar_get_displacement(cur_val)] = 0;
		irval_bimm([chars # i], val_scalar_get_irval(cur_val));
	}

	[val_aggregate_get_members(out)] = mems;
	[val_aggregate_get_members_count(out)] = chars_len;
	// the concept of abi chunks doesnt exist at the build region level, because there is no ABI
	[val_aggregate_get_chunks(out)] = zero;
};

build_try_get_string_literal : func(v : val mut?, chars_out : u8 mut? mut?, chars_len_out : u64 mut? -> bool)
{
	if(v->tag != val_tag.aggregate)
	{
		return false;
	}
	len ::= [val_aggregate_get_members_count(v)];
	agg_begin ::= [val_aggregate_get_members(v)];
	out : u8 mut? := arena_alloc(global_arena, len);
	i : u64 mut;
	for(i = 0; i < len; i = i + 1)
	{
		agg_cur ::= agg_begin # i;
		if((agg_cur->tag != val_tag.scalar) || (agg_cur->type != ty_char_literal()))
		{
			return false;
		}
		[out # i] = [irval_imm_get_integer(val_scalar_get_irval(agg_cur))]@u8;
	}
	[chars_out] = out;
	[chars_len_out] = len;
	return true;
};

build_must_get_string_literal : func(v : val mut?, chars_out : u8 mut? mut?, chars_len_out : u64 mut? -> v0)
{
	if(!build_try_get_string_literal(v, chars_out, chars_len_out))
	{
		err_begin();
		putzstr("fucked up getting string literal data within a build region\0");
		err_end();
	}
};

execute_build_builtin_add_source_file : func(param : val mut?, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(param, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	add_source_file(zstr2path(path_zstr), rel);
};

execute_build_builtin_add_build_file : func(params : val mut?, params_count : u64, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(params # 0, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	the_path : path mut := zstr2path(path_zstr);

	// if the path contains a parent path, then we actually want that to be the relative path of the add_build_file, not our rel
	actual_rel ::= path_get_parent(the_path, rel, ref the_path);

	target_data : u8 mut? mut;
	target_len : u64 mut;
	build_must_get_string_literal(params # 1, ref target_data, ref target_len);
	add_build_file(the_path, target_data, target_len, actual_rel);
};

execute_build_builtin_add_source_directory : func(param : val mut?, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(param, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);

	dir ::= path_open(zstr2path(path_zstr), file.cwd, file_access.read, zero);
	directory_iterate(dir, build_builtin_add_source_directory_callback, rel@s64@u64);
	file_close(dir);
};

build_builtin_add_source_directory_callback : func(child_path : path, usrdata : v0? weak -> bool)
{
	rel ::= usrdata@u64@s64@file;
	add_source_file(path_dupe(child_path, global_arena), rel);
	return true;
};

execute_build_builtin_add_source_directory_recursive : func(param : val mut?, rel : file -> v0)
{
	path_data : u8 mut? mut;
	path_len : u64 mut;
	build_must_get_string_literal(param, ref path_data, ref path_len);
	path_zstr ::= sstr2zstr(path_data, path_len, global_arena);
	dir ::= path_open(zstr2path(path_zstr), rel, file_access.read, zero);
	directory_iterate(dir, build_builtin_add_source_directory_recursive_callback, dir@s64@u64);
	file_close(dir);
};

build_builtin_add_source_directory_recursive_callback : func(child_path : path, usrdata : v0? weak -> bool)
{
	rel ::= usrdata@u64@s64@file;

	stats : file_stats mut;
	err ::= path_get_stats(child_path, ref stats, rel);
	if(err == zero)
	{
		if(stats.type == file_type.dir)
		{
			// iterate again
			dir ::= path_open(child_path, rel, file_access.directory, zero);
			directory_iterate(dir, build_builtin_add_source_directory_recursive_callback, dir@s64@u64);
			file_close(dir);
		}
		else
		{
			add_source_file(path_dupe(child_path, global_arena), rel);
		}
	}
	else
	{
		err_begin();
		putzstr("within add_source_directory_recursive, failed to stat \0");
		putchar('"');
		putzstr(path2zstr(child_path));
		putchar('"');
		putzstr(": error code \0");
		putsint(err@s64);
		err_end();
	}
	return true;
};

execute_build_builtin_prebuild_command : func(param : val mut?, rel : file, out : val mut? -> v0)
{
	cmd_data : u8 mut? mut;
	cmd_len : u64 mut;
	build_must_get_string_literal(param, ref cmd_data, ref cmd_len);
	cmd_zstr ::= sstr2zstr(cmd_data, cmd_len, global_arena);

	return_code : s32 := shell_command(cmd_zstr, rel);
	out->tag = val_tag.scalar;
	out->type = ty_integer_literal();
	irval_qimm(return_code, val_scalar_get_irval(out));
	[val_scalar_get_displacement(out)] = 0;
};

execute_build_builtin_postbuild_command : func(param : val mut?, rel : file, out : val mut? -> v0)
{
	cmd_data : u8 mut? mut;
	cmd_len : u64 mut;
	build_must_get_string_literal(param, ref cmd_data, ref cmd_len);
	cmd ::= postbuild_command_t mut
	{
		.cmd := sstr2zstr(cmd_data, cmd_len, global_arena);
		.rel := rel;
	};

	prog_add_postbuild_command(ref cmd);
};

execute_build_builtin_set_optimization : func(param : val mut? -> v0)
{
	opt_irval ::= val_scalar_get_irval(param);
	prog.opt = [irval_imm_get_integer(opt_irval)]@program_optimisation;
};

execute_build_builtin_debug_symbols : func(param : val mut? -> v0)
{
	opt_irval ::= val_scalar_get_irval(param);
	prog.debug_symbols = ([irval_imm_get_integer(opt_irval)] != 0);
};

execute_build_builtin_output_directory : func(param : val mut? -> v0)
{
	build_must_get_string_literal(param, ref(prog.output_dir.data), ref(prog.output_dir.len));
};

execute_build_builtin_output_name : func(param : val mut? -> v0)
{
	build_must_get_string_literal(param, ref(prog.output_name.data), ref(prog.output_name.len));
};

execute_build_builtin_assert : func(param : val mut?, ctx : source_context mut? -> v0)
{
	the_irval ::= val_scalar_get_irval(param);
	if([irval_imm_get_integer(the_irval)] == 0)
	{
		panic_begin();
		putzstr("$assert failure in build region at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
};

execute_build_builtin_define : func(param_node : ast mut?, ctx : source_context mut?, scope : scope_t mut? -> v0)
{
	// assume param_node is a symbol expression
	name ::= [ast_symbol_get_data(param_node)];
	name_len ::= [ast_symbol_get_data_len(param_node)];
	the_var ::= scope_find_variable(scope, name, name_len);
	if(the_var == zero)
	{
		err_begin();
		putzstr("could not $define variable \0");
		putchar('"');
		putchars(name, name_len);
		putchar('"');
		putzstr(" because no such variable was defined within this or a caller build region at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	prog_add_global_variable(the_var);
};

execute_build_builtin : func(name : u8?, name_len : u64, params : val mut?, params_count : u64, ctx : source_context mut?, rel : file, scope : scope_t mut?, out : val mut? -> v0)
{
	if(streql(name, name_len, "add_source_file", 15))
	{
		execute_build_builtin_add_source_file(params, rel);
		return;
	}
	if(streql(name, name_len, "add_build_file", 14))
	{
		execute_build_builtin_add_build_file(params, params_count, rel);
		return;
	}
	if(streql(name, name_len, "add_source_directory", 20))
	{
		execute_build_builtin_add_source_directory(params, rel);
		return;
	}
	if(streql(name, name_len, "add_source_directory_recursive", 30))
	{
		execute_build_builtin_add_source_directory_recursive(params, rel);
		return;
	}
	if(streql(name, name_len, "prebuild_command", 16))
	{
		execute_build_builtin_prebuild_command(params, rel, out);
		return;
	}
	if(streql(name, name_len, "postbuild_command", 17))
	{
		execute_build_builtin_postbuild_command(params, rel, out);
		return;
	}
	if(streql(name, name_len, "set_optimization", 16))
	{
		execute_build_builtin_set_optimization(params);
		return;
	}
	if(streql(name, name_len, "debug_symbols", 13))
	{
		execute_build_builtin_debug_symbols(params);
		return;
	}
	if(streql(name, name_len, "output_directory", 16))
	{
		execute_build_builtin_output_directory(params);
		return;
	}
	if(streql(name, name_len, "output_name", 11))
	{
		execute_build_builtin_output_name(params);
		return;
	}
	if(streql(name, name_len, "assert", 6))
	{
		execute_build_builtin_assert(params, ctx);
		return;
	}
	if(streql(name, name_len, "define", 6))
	{
		execute_build_builtin_define(ast_call_get_params(ctx->node), ctx, scope);
		return;
	}
	
	err_begin();
	putzstr("unrecognised build builtin '\0");
	putchars(name, name_len);
	putzstr("'\n\0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	err_end();
};
