populate_structures : func(-> v0)
{
	i : u64 mut;
	count ::= ty_storage.data_count;
	for(i = 0; i < count; i = i + 1)
	{
		cur ::= ty_storage.data # i;
		// structs need to be populated now
		if(cur->tag == tydata_tag.structure)
		{
			populate_structure_type(cur);
		}
		// todo: delete once we're happy with it
		//base : ty := ty.custom_begin;
		//putty((i@s64 + base@s64)@ty);
		//putchar('\n');
	}
};

populate_structure_type : func(d : tydata mut? -> v0)
{
	// we have a bunch of decls as children
	i : u64 mut;
	member_decl_nodes ::= ast_structure_get_data_members(d->reference);
	for(i = 0; i < d->members_count; i = i + 1)
	{
		typename_node ::= ast_decl_get_typename(member_decl_nodes # i);
		typename_ctx : source_context mut;
		typename_ctx.node = typename_node;
		typename_ctx.parent_fn = zero;
		typename_ctx.src = d->src;
		typename_ctx.type_only = true;
		[d->members # i] = ty_from_typename_node(ref typename_ctx);
	}
};

semal_variable : func(var : variable_t mut?, ctx : source_context mut? -> v0)
{
	putsrc(ctx->src, var->node->src_beg@u64, var->node->src_end@u64, putcol.yellow_underline);
	typename_node ::= ast_decl_get_typename(var->node);
	if([ast_typename_get_tag(typename_node)] == ast_typename_tag.deduced)
	{
		// must have an initialiser
		init ::= ast_decl_maybe_get_init_node(var->node);
		if(init == zero)
		{
			err_begin();
			putzstr("deduced declaration \0");
			putchar('"');
			putchars([ast_decl_get_name(var->node)], [ast_decl_get_name_len(var->node)]);
			putchar('"');
			putzstr(" did not have an initialiser. all deduced declarations *must* have an initialiser\0");
			err_end();
		}
		init_val : val mut;
		init_ctx : source_context mut := [ctx];
		init_ctx.node = init;
		init_ctx.type_only = true;
		var->type = type_from_node(ref init_ctx);
	}
	else
	{
		typename_ctx : source_context mut := [ctx];
		typename_ctx.node = typename_node;
		typename_ctx.type_only = true;
		var->type = ty_from_typename_node(ref typename_ctx);
	}
	if(var->type == ty.invalid)
	{
		err_begin();
		putzstr("could not decipher type of global variable \0");
		putchars([ast_decl_get_name(var->node)], [ast_decl_get_name_len(var->node)]);
		putzstr("\n\0");
		putsrc(var->src, var->node->src_beg@u64, var->node->src_end@u64, putcol.red_underline);
		err_end();
	}
	var->storage.tag = val_tag.invalid;
	var->storage.type = var->type;
	putsrc(ctx->src, var->node->src_beg@u64, var->node->src_end@u64, putcol.blue_underline);
};

populate_globals : func(-> v0)
{
	i : u64 mut;
	count ::= prog.global_scope.vars_count;

	for(i = 0; i < count; i = i + 1)
	{
		var ::= prog.global_scope.vars # i;
		global_variable_ctx : source_context mut;
		global_variable_ctx.node = var->node;
		global_variable_ctx.parent_fn = zero;
		global_variable_ctx.src = var->src;
		global_variable_ctx.type_only = true;
		semal_variable(var, ref global_variable_ctx);
	}
};

populate_function_declarations : func(-> v0)
{
	i : u64 mut;
	j : u64 mut;
	count ::= prog.global_scope.funcs_count;
	for(i = 0; i < count; i = i + 1)
	{
		fn ::= prog.global_scope.funcs # i;
		fn_typename_node ::= ast_function_get_typename(fn->node);
		fn_typename_ctx : source_context mut;
		fn_typename_ctx.node = fn_typename_node;
		fn_typename_ctx.parent_fn = zero;
		fn_typename_ctx.src = fn->src;
		fn_typename_ctx.type_only = true;
		fn->type = ty_from_typename_node(ref fn_typename_ctx);

		param_count ::= ty_countof(fn->type);
		param_decls ::= ast_typename_function_get_param_decls(fn_typename_node);
		for(j = 0; j < param_count; j = j + 1)
		{
			param_node ::= param_decls # j;
			param_ctx : source_context mut;
			param_ctx.node = ast_decl_get_typename(param_node);
			param_ctx.parent_fn = fn;
			param_ctx.src = fn->src;
			param_ctx.type_only = true;

			var : variable_t mut;
			var.node = param_node;
			var.src = fn->src;
			var.type = ty_from_typename_node(ref param_ctx);
			var.local_param_idx = j@u8;
			var.storage.tag = val_tag.invalid;
			var.storage.type = var.type;
			scope_add_variable(ref(fn->scope), ref var);
		}
	}
};

populate_function_definitions : func(-> v0)
{
	i : u64 mut;
	j : u64 mut;
	count ::= prog.global_scope.funcs_count;
	for(i = 0; i < count; i = i + 1)
	{
		semal_func_collect_locals(prog.global_scope.funcs # i);
	}
};

semal : func(-> v0)
{
	populate_structures();
	populate_function_declarations();
	populate_globals();
	populate_function_definitions();
	populate_assemblies();
};

semal_func_collect_locals_usrdata : struct
{
	fn : function_t mut?;
	scope : scope_t mut?;
	src : source;
};

semal_func_collect_locals_callback : func(node : ast mut?, usrdata : v0? weak -> v0)
{
	u ::= usrdata@semal_func_collect_locals_usrdata mut?;
	t ::= [ast_stmt_get_tag(node)];
	if((t == ast_stmt_tag.if_blk))
	{
		semal_node_collect_locals(node, 1, node->children_count@u64, u);
	}
	if((t == ast_stmt_tag.while_blk))
	{
		semal_node_collect_locals(node, 1, node->children_count@u64, u);
	}
	if((t == ast_stmt_tag.for_blk))
	{
		semal_node_collect_locals(node, 3, node->children_count@u64, u);
	}
	if((t == ast_stmt_tag.else_blk))
	{
		semal_node_collect_locals(node, 0, node->children_count@u64, u);
	}
	if((t == ast_stmt_tag.decl))
	{
		var : variable_t mut;	
		var.node = node;
		var.src = u->src;
		var.type = zero;
		var.local_param_idx = ~0;

		var_ctx : source_context mut;
		var_ctx.node = node;
		var_ctx.parent_fn = u->fn;
		var_ctx.src = u->src;
		var_ctx.type_only = true;
		semal_variable(ref var, ref var_ctx);
		scope_add_variable(u->scope, ref var);
	}
};

semal_node_collect_locals : func(node : ast mut?, begin : u64, end : u64, u : semal_func_collect_locals_usrdata mut? -> v0)
{
	ast_walk(node, begin, end, semal_func_collect_locals_callback, u);
};

semal_func_collect_locals : func(fn : function_t mut? -> v0)
{
	usrdata : semal_func_collect_locals_usrdata mut;
	usrdata.fn = fn;
	usrdata.scope = ref(fn->scope);
	usrdata.src = fn->src;
	semal_node_collect_locals(fn->node, 1, fn->node->children_count@u64, ref usrdata);
};

populate_assemblies : func(-> v0)
{
	i : u64 mut;
	count ::= prog.global_scope.asms_count;
	for(i = 0; i < count; i = i + 1)
	{
		as ::= prog.global_scope.asms # i;
		as->type = x64_constraints_to_ty(as->constraints, as->constraints_len);
	}
};
