int3 : asm(->)
{
	int3
};

exit_failure : func(-> v0)
{
	static_if(is_debug)
	{
		int3();
	}
	else
	{
		linux_exit(-1);
	}
};

warn_begin : func(-> v0)
{
	linux_write(1, "syc ", 4);
	colour_yellow();
	linux_write(1, "warning: ", 9);
	colour_reset();
};

warn_end : func(-> v0)
{
	linux_write(1, "\n", 1);
};

err_begin : func(-> v0)
{
	linux_write(1, "\nsyc ", 5);
	colour_red();
	linux_write(1, "error: ", 7);
	colour_reset();
};

err_end : func(-> v0)
{
	linux_write(1, "\n", 1);
	exit_failure();
};

panic_begin : func(-> v0)
{
	linux_write(1, "\nsyc ", 5);
	colour_dark_red();
	linux_write(1, "panic: ", 7);
	colour_reset();
};

panic_end : func(-> v0)
{
	linux_write(1, "\n", 1);
	exit_failure();
};

msg_begin : func(-> v0)
{
	linux_write(1, "\nsyc ", 5);
	colour_blue();
	linux_write(1, "message: ", 9);
	colour_reset();
};

msg_end : func(-> v0)
{
	linux_write(1, "\n", 1);
};
