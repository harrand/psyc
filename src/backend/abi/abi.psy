abi : enum
{
	.psy64 := 0;
};

abi_chunk : func(a : abi, tys : ty?, tys_count : u64, out_chunks : irchunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)
{
	[abi_chunk_tbl # (a@s64)](tys, tys_count, out_chunks, out_chunks_count, ar);
};


abi_chunk_tbl ::= func(tys : ty?, tys_count : u64, out_chunks : irchunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)[countof abi]
{
	.0 := abi_chunk_psy64;
};

abi_sizeof : func(a : abi, type : ty -> u64)
{
	return [abi_sizeof_tbl # (a@s64)](type);
};

abi_sizeof_tbl ::= func(type : ty -> u64)[countof abi]
{
	.0 := abi_sizeof_psy64;
};

abi_alignof : func(a : abi, type : ty -> u64)
{
	return [abi_alignof_tbl # (a@s64)](type);
};

abi_alignof_tbl ::= func(type : ty -> u64)[countof abi]
{
	.0 := abi_alignof_psy64;
};

abi_offsetof_struct : func(a : abi, type : ty, idx : u64 -> u64)
{
	return [abi_offsetof_struct_tbl # (a@s64)](type, idx);
};

abi_offsetof_struct_tbl ::= func(type : ty, idx : u64 -> u64)[countof abi]
{
	.0 := abi_offsetof_struct_psy64;
};
