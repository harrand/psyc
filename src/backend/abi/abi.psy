abi_tag : enum
{
	.psy64 := 0;
};

abi_chunk_tys : func(a : abi_tag, tys : ty?, tys_count : u64, out_chunks : abi_chunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)
{
	[abi_chunk_tys_tbl # (a@s64)](tys, tys_count, out_chunks, out_chunks_count, ar);
};


abi_chunk_tys_tbl ::= func(tys : ty?, tys_count : u64, out_chunks : abi_chunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)[countof abi_tag]
{
	.0 := abi_chunk_tys_psy64;
};

abi_sizeof : func(a : abi_tag, type : ty -> u64)
{
	return [abi_sizeof_tbl # (a@s64)](type);
};

abi_sizeof_tbl ::= func(type : ty -> u64)[countof abi_tag]
{
	.0 := abi_sizeof_psy64;
};

abi_alignof : func(a : abi_tag, type : ty -> u64)
{
	return [abi_alignof_tbl # (a@s64)](type);
};

abi_alignof_tbl ::= func(type : ty -> u64)[countof abi_tag]
{
	.0 := abi_alignof_psy64;
};

abi_offsetof_struct : func(a : abi_tag, type : ty, idx : u64 -> u64)
{
	return [abi_offsetof_struct_tbl # (a@s64)](type, idx);
};

abi_offsetof_struct_tbl ::= func(type : ty, idx : u64 -> u64)[countof abi_tag]
{
	.0 := abi_offsetof_struct_psy64;
};

abi_serialise_val_to : func(a : abi_tag, w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	[abi_serialise_val_to_tbl # (a@s64)](w, v, ctx);
};

abi_serialise_val_to_tbl ::= func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)[countof abi_tag]
{
	.0 := abi_serialise_val_to_psy64;
};
