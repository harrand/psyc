_chunkhelper_append : func(chunks : abi_chunk mut? mut?, count : u64 mut?, cap : u64 mut?, new : abi_chunk mut?, ar : arena mut? -> v0)
{
	if([chunks] == zero)
	{
		[cap] = 8;
		[chunks] = arena_alloc(ar, [cap] * sizeof abi_chunk);
	}
	while([cap] <= [count])
	{
		old ::= [chunks];
		oldcap ::= [cap];
		[cap] = [cap] * 2;
		[chunks] = arena_alloc(ar, [cap] * sizeof abi_chunk);
		memcopy([chunks], old, oldcap * sizeof abi_chunk);
	}
	[[chunks] # [count]] = [new];
	[count] = [count] + 1;
};

abi_chunk_tys_psy64 : func(tys : ty?, tys_count : u64, out_chunks : abi_chunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)
{
	[out_chunks] = zero;
	[out_chunks_count] = 0;
	if(tys_count == 0)
	{
		return;
	}
	chunks_cap : u64 mut := tys_count;
	[out_chunks] = arena_alloc(ar, chunks_cap * sizeof abi_chunk);
	i : u64 mut;
	j : u64 mut;
	for(i = 0; i < tys_count; i = i + 1)
	{
		curty ::= [tys # i];
		curty_sz ::= abi_sizeof_psy64(curty);
		if(curty_sz > 0)
		{
			if(ty_is_structure(curty) || ty_is_array(curty))
			{
				agg ::= ty_unwrap(curty);
				subchunks : abi_chunk mut? mut;
				subchunks_count : u64 mut := 0;
				abi_chunk_tys_psy64(agg->members, agg->members_count, ref subchunks, ref subchunks_count, scratch_arena);
				for(j = 0; j < subchunks_count; j = j + 1)
				{
					ptr ::= subchunks # j;
					ptr->src_byte_offset = ptr->src_byte_offset + abi_offsetof_struct_psy64(curty, ptr->src_idx_begin);
					ptr->src_idx_begin = i;
					ptr->src_idx_end = i;
					_chunkhelper_append(out_chunks, out_chunks_count, ref chunks_cap, ptr, ar);
				}
			}
			else
			{
				new : abi_chunk mut;
				if(ty_floating_point_size(curty) > 0)
				{
					// fp
					new.tag = abi_chunk_tag.fp;
				}
				else
				{
					// non fp
					new.tag = abi_chunk_tag.nonfp;
				}
				// scalar
				new.src_idx_begin = i;
				new.src_idx_end = i;
				new.src_byte_offset = 0;
				new.sz = curty_sz;
				_chunkhelper_append(out_chunks, out_chunks_count, ref chunks_cap, ref new, ar);
			}
		}
	}
};

abi_sizeof_psy64 : func(type : ty -> u64)
{
	if(ty_is_v0(type))
	{
		return 0;
	}
	isz ::= ty_integral_size(type);
	if(isz > 0)
	{
		return isz;
	}
	fsz ::= ty_floating_point_size(type);
	if(fsz > 0)
	{
		return fsz;
	}
	if(ty_is_bool(type))
	{
		return abi_sizeof_psy64(ty.u8);
	}
	if(ty_is_pointer(type))
	{
		return abi_sizeof_psy64(ty.u64);
	}
	if(ty_is_enumeration(type))
	{
		return abi_sizeof_psy64(ty.s64);
	}
	if(ty_is_array(type))
	{
		return abi_sizeof_psy64(ty_underlying(type)) * ty_countof(type);
	}
	if(ty_is_function(type))
	{
		return abi_sizeof_psy64(ty.u64);
	}
	if(ty_is_structure(type))
	{
		return abi_sizeof_struct_psy64(type);
	}
	panic_begin();
	putzstr("reached end of abi_sizeof_psy64 for type \0");
	putchar('"');
	putty(type);
	putchar('"');
	panic_end();
	return zero;
};

abi_sizeof_struct_psy64 : func(type : ty -> u64)
{
	align ::= abi_alignof_struct_psy64(type);
	strct ::= ty_unwrap(type);
	i : u64 mut;
	cursor : u64 mut := 0;
	for(i = 0; i < strct->members_count; i = i + 1)
	{
		curalign ::= abi_alignof(abi_tag.psy64, [strct->members # i]);
		cursz ::= abi_sizeof(abi_tag.psy64, [strct->members # i]);
		padding ::= (-cursor) & (curalign - 1);
		cursor = cursor + padding;
		cursor = cursor + cursz;
	}
	// trailing padding
	return cursor + ((-cursor) & (align - 1));
};

abi_alignof_psy64 : func(type : ty -> u64)
{
	if(ty_is_v0(type))
	{
		return 0;
	}
	isz ::= ty_integral_size(type);
	if(isz > 0)
	{
	 return isz;
	}
	fsz ::= ty_floating_point_size(type);
	if(fsz > 0)
	{
		return fsz;
	}
	if(ty_is_bool(type))
	{
		return abi_alignof_psy64(ty.u8);
	}
    if(ty_is_pointer(type))
	{
		return abi_alignof_psy64(ty.u64);
	}
	if(ty_is_enumeration(type))
	{
		return abi_alignof_psy64(ty.s64);
	}
	if(ty_is_array(type))
	{
		return abi_alignof_psy64(ty_underlying(type));
	}
	if(ty_is_function(type))
	{
		return abi_alignof_psy64(ty.u64);
	}
	if(ty_is_structure(type))
	{
		return abi_alignof_struct_psy64(type);
	}
	putzstr("reached end of abi_alignof_psy64 for type \0");
	putchar('"');
	putty(type);
	putchar('"');
	return zero;
};

abi_alignof_struct_psy64 : func(type : ty -> u64)
{
	strct ::= ty_unwrap(type);
	i : u64 mut;
	max_align : u64 mut := 1;
	for(i = 0; i < strct->members_count; i = i + 1)
	{
		curalign ::= abi_alignof(abi_tag.psy64, [strct->members # i]);
		if(curalign > max_align)
		{
			max_align = curalign;
		}
	}
	return max_align;
};

abi_offsetof_struct_psy64 : func(type : ty, idx : u64 -> u64)
{
	strct ::= ty_unwrap(type);
	cursor : u64 mut := 0;
	i : u64 mut;
	for(i = 0; i < idx; i = i + 1)
	{
		curalign ::= abi_alignof(abi_tag.psy64, [strct->members # i]);
		cursz ::= abi_sizeof(abi_tag.psy64, [strct->members # i]);
		padding ::= (-cursor) & (curalign - 1);
		cursor = cursor + padding;
		cursor = cursor + cursz;
	}
	final_align ::= abi_alignof(abi_tag.psy64, [strct->members # i]);
	return cursor + ((-cursor) & (final_align - 1));
};

abi_serialise_val_to_psy64 : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	[abi_serialise_val_to_psy64_tbl # v->tag@s64](w, v, ctx);
};

abi_serialise_val_to_psy64_nyi : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	panic_begin();
	putzstr("abi_serialise_val_to_psy64 is NYI for val_tag.\0");
	putsint(v->tag@s64);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

abi_serialise_val_to_psy64_invalid : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	err_begin();
	putzstr("cannot compile-time-serialise a value that cannot be computed at compile-time at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	err_end();
};

abi_serialise_val_to_psy64_zerovalue : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	err_begin();
	putzstr("cannot compile-time-serialise a typeless zero-value at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	err_end();
};

abi_serialise_val_to_psy64_scalar : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	if(ty_floating_point_size(v->type) > 0)
	{
		panic_begin();
		putzstr("serialising floating point data is NYI at \0");
		putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
		panic_end();
	}
	sz ::= abi_sizeof_psy64(v->type);
	int_imm ::= val_scalar_get_irval(v);
	int ::= [irval_imm_get_integer(int_imm)];
	if(sz == 1)
	{
		bwrite8(w, int);
		return;
	}
	if(sz == 2)
	{
		bwrite16(w, int);
		return;
	}
	if(sz == 4)
	{
		bwrite32(w, int);
		return;
	}
	if(sz == 8)
	{
		bwrite64(w, int);
		return;
	}
	panic_begin();
	putzstr("abi.psy64: don't know how to serialise integral scalar_literal of size \0");
	putuint(sz);
	putzstr(" at \0");
	putsrc(ctx->src, ctx->node->src_beg@u64, ctx->node->src_end@u64, putcol.red_underline);
	panic_end();
};

abi_serialise_val_to_psy64_aggregate : func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)
{
	data_begin ::= w->cursor;

	count ::= [val_aggregate_get_members_count(v)];
	members ::= [val_aggregate_get_members(v)];
	i : u64 mut;
	j : u64 mut;
	for(i = 0; i < count; i = i + 1)
	{
		offset_from_start ::= w->cursor - data_begin;
		// if our aggregate is a struct then we could have padding bytes
		if(ty_is_structure(v->type))
		{
			desired_offset_from_start ::= abi_offsetof_struct_psy64(v->type, i);
			for(j = offset_from_start; j < desired_offset_from_start; j = j + 1)
			{
				bwrite8(w, zero);
			}
		}
		abi_serialise_val_to_psy64(w, members # i, ctx);
	}
};

abi_serialise_val_to_psy64_tbl ::= func(w : bwriter mut?, v : val mut?, ctx : source_context mut? -> v0)[countof val_tag]
{
	.0 := abi_serialise_val_to_psy64_invalid;
	.1 := abi_serialise_val_to_psy64_invalid;
	.2 := abi_serialise_val_to_psy64_scalar;
	.3 := abi_serialise_val_to_psy64_invalid;
	.4 := abi_serialise_val_to_psy64_aggregate;
};
