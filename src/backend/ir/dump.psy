irval_dump_to_nyi : func(w : bwriter mut?, v : irval mut? -> v0)
{
	panic_begin();
	putzstr("todo: dumping of irval_tag.\0");
	putsint(v->tag@s64);
	panic_end();
};

irval_dump_to_invalid : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite_zstr(w, "<invalid>\0");
};

irval_dump_to_imm : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite_zstr(w, [irsz_names # ([irval_imm_get_sz(v)]@s64)]);
	bwrite_zstr(w, "imm \0");
	sz ::= [irval_imm_get_sz(v)];
	if((sz == irsz.f) || (sz == irsz.g))
	{
		bwritef64(w, [irval_imm_get_floating_point(v)]);
	}
	else
	{
		bwrite_sint(w, [irval_imm_get_integer(v)]);
	}
};

irval_dump_to_reg : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite8(w, '%');
	bwrite_zstr(w, [irsz_names # [irval_reg_get_sz(v)]@s64]);
	bwrite_uint(w, [irval_reg_get_idx(v)]);
};

irval_dump_to_globref : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite8(w, '@');
	bwrite_uint(w, [irval_globref_get_idx(v)]);
};

irval_dump_to_fnref : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite8(w, '$');
	idx ::= [irval_fnref_get_idx(v)];
	fn ::= irapi.prog.funcs # idx;
	if(fn->custom_name != zero)
	{
		bwrite_bytes(w, fn->custom_name, fn->custom_name_len);
	}
	else
	{
		bwrite_uint(w, idx);
	}
};

irval_dump_to_blkref : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite8(w, '_');
	bwrite_uint(w, [irval_blkref_get_idx(v)]);
};

irval_dump_to_asmref : func(w : bwriter mut?, v : irval mut? -> v0)
{
	bwrite8(w, '#');
	idx ::= [irval_asmref_get_idx(v)];
	as ::= irapi.prog.asms # idx;
	if(as->custom_name != zero)
	{
		bwrite_bytes(w, as->custom_name, as->custom_name_len);
	}
	else
	{
		bwrite_uint(w, idx);
	}
};

irval_dump_to_tbl ::= func(w : bwriter mut?, v : irval mut? -> v0)[countof irval_tag]
{
	.0 := irval_dump_to_invalid;
	.1 := irval_dump_to_imm;
	.2 := irval_dump_to_reg;
	.3 := irval_dump_to_globref;
	.4 := irval_dump_to_fnref;
	.5 := irval_dump_to_blkref;
	.6 := irval_dump_to_asmref;
};

irval_dump_to : func(w : bwriter mut?, v : irval mut? -> v0)
{
	[irval_dump_to_tbl # (v->tag@s64)](w, v);
};

irval_dump : func(v : irval mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 8, scratch_arena);
	irval_dump_to(w, v);
	putchars(w->buf, w->cursor);
};

irinst_analyse : func(inst : irinst mut?, first_out_idx : u64 mut?, out_count : u64 mut?, first_param_idx : u64 mut?, param_count : u64 mut? -> v0)
{
	count : s8 mut weak := [irinst_outcounts # (inst->tag@s64)];
	[first_out_idx] = 0;
	[first_param_idx] = count;
	if(count == -1)
	{
		count = [irval_imm_get_integer(inst->operands # 0)];
		[first_out_idx] = 1;
		[first_param_idx] = count + 1;
	}
	[out_count] = count@u64;
	[param_count] = inst->operands_count - ([first_param_idx]);
};

irinst_dump_to : func(w : bwriter mut?, inst : irinst mut? -> v0)
{
	outs_begin : u64 mut;
	outs_count : u64 mut;
	params_begin : u64 mut;
	params_count : u64 mut;
	irinst_analyse(inst, ref outs_begin, ref outs_count, ref params_begin, ref params_count);
	i : u64 mut;
	for(i = 0; i < outs_count; i = i + 1)
	{
		irval_dump_to(w, inst->operands # (outs_begin + i));
		if(i < (outs_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	if(outs_count > 0)
	{
		bwrite_zstr(w, " = \0");
	}
	bwrite_zstr(w, [irinst_names # (inst->tag@s64)]);
	if(params_count > 0)
	{
		bwrite8(w, ' ');
	}
	for(i = 0; i < params_count; i = i + 1)
	{
		irval_dump_to(w, inst->operands # (params_begin + i));
		if(i < (params_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite8(w, '\n');
};

irinst_dump : func(inst : irinst mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 32, scratch_arena);
	irinst_dump_to(w, inst);
	putchars(w->buf, w->cursor);
};

irblk_dump_verbosely_to : func(w : bwriter mut?, blk : irblk mut? -> v0)
{
	// defs
	bwrite_colour_green(w);
	i : u64 mut;
	bwrite_zstr(w, "defs: \0");
	for(i = 0; i < blk->defs_count; i = i + 1)
	{
		cur_def ::= blk->defs # i;
		bwrite_zstr(w, "%\0");
		bwrite_uint(w, cur_def->reg_idx);
		bwrite8(w, ':');
		bwrite_sint(w, cur_def->instruction_id);
		if(i < (blk->defs_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_colour_reset(w);
	bwrite8(w, '\n');

	// uses
	bwrite_colour_yellow(w);
	i : u64 mut;
	bwrite_zstr(w, "uses: \0");
	for(i = 0; i < blk->uses_count; i = i + 1)
	{
		cur_use ::= blk->uses # i;
		bwrite_zstr(w, "%\0");
		bwrite_uint(w, cur_use->reg_idx);
		bwrite8(w, ':');
		bwrite_uint(w, cur_use->instruction_id);
		if(i < (blk->uses_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_colour_reset(w);
	bwrite8(w, '\n');
	
	// live-in
	bwrite_colour_blue(w);
	i : u64 mut;
	bwrite_zstr(w, "live-in: \0");
	for(i = 0; i < blk->live_in_count; i = i + 1)
	{
		bwrite_zstr(w, "%\0");
		bwrite_uint(w, [blk->live_in # i]);
		if(i < (blk->live_in_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_colour_reset(w);
	bwrite8(w, '\n');

	// live-out
	bwrite_colour_blue(w);
	i : u64 mut;
	bwrite_zstr(w, "live-out: \0");
	for(i = 0; i < blk->live_out_count; i = i + 1)
	{
		bwrite_zstr(w, "%\0");
		bwrite_uint(w, [blk->live_out # i]);
		if(i < (blk->live_out_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_colour_reset(w);
	bwrite8(w, '\n');
};

irblk_dump_to : func(w : bwriter mut?, blk : irblk mut? -> v0)
{
	bwrite8(w, '_');
	bwrite_uint(w, blk->idx);
	bwrite_zstr(w, ":\n\0");
	irblk_dump_verbosely_to(w, blk);
	i : u64 mut;
	for(i = 0; i < blk->insts_count; i = i + 1)
	{
		bwrite_zstr(w, "  \0");
		irinst_dump_to(w, blk->insts # i);
	}
};

irblk_dump : func(blk : irblk mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 1024, scratch_arena);
	irblk_dump_to(w, blk);
	putchars(w->buf, w->cursor);
};

irfunc_dump_to : func(w : bwriter mut?, fn : irfunc mut? -> v0)
{
	bwrite8(w, '$');
	if(fn->custom_name != zero)
	{
		bwrite_bytes(w, fn->custom_name, fn->custom_name_len);
	}
	else
	{
		bwrite_uint(w, fn->idx);
	}
	bwrite_zstr(w, " : func(\0");
	i : u64 mut;
	for(i = 0; i < fn->params_count; i = i + 1)
	{
		v : irval mut;
		v.tag = irval_tag.reg;
		[irval_reg_get_sz(ref v)] = [fn->params # i];
		[irval_reg_get_idx(ref v)] = i;
		irval_dump_to(w, ref v);
		if(i < (fn->params_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_zstr(w, ") -> \0");
	for(i = 0; i < fn->returns_count; i = i + 1)
	{
		bwrite_zstr(w, [irsz_names # [fn->returns # i]@s64]);
		if(i < (fn->returns_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	if(fn->returns_count == 0)
	{
		bwrite_zstr(w, "none\0");
	}
	bwrite_zstr(w, "\n{\n\0");

	for(i = 0; i < fn->blks_count; i = i + 1)
	{
		irblk_dump_to(w, fn->blks # i);
	}
	bwrite_zstr(w, "\n}\n\0");
};

irfunc_dump : func(fn : irfunc mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 1024, scratch_arena);
	irfunc_dump_to(w, fn);
	putchars(w->buf, w->cursor);
};

irasm_dump_to : func(w : bwriter mut?, as : irasm mut? -> v0)
{
	bwrite8(w, '#');
	if(as->custom_name != zero)
	{
		bwrite_bytes(w, as->custom_name, as->custom_name_len);
	}
	else
	{
		bwrite_uint(w, as->idx);
	}
	bwrite_zstr(w, " : asm(\0");
	i : u64 mut;
	for(i = 0; i < as->params_count; i = i + 1)
	{
		bwrite_zstr(w, [irsz_names # [as->params # i]@s64]);
		if(i < (as->params_count - 1))
		{
			bwrite_zstr(w, ", \0");
		}
	}
	bwrite_zstr(w, ") -> \0");
	bwrite_zstr(w, [irsz_names # (as->ret@s64)]);
	bwrite_zstr(w, " '");
	bwrite_bytes(w, as->constraint, as->constraint_len);
	bwrite_zstr(w, "'\n{\n\0");
	bwrite_bytes(w, as->code, as->code_len);
	bwrite_zstr(w, "\n}\n\0");
};

irasm_dump : func(as : irasm mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 1024, scratch_arena);
	irasm_dump_to(w, as);
	putchars(w->buf, w->cursor);
};

irglob_dump_to : func(w : bwriter mut?, g : irglob mut? -> v0)
{
	bwrite8(w, '@');
	bwrite_uint(w, g->idx);
	if(g->is_mut)
	{
		bwrite_zstr(w, " mut\n{\n  \0");
	}
	else
	{
		bwrite_zstr(w, " const\n{\n  \0");
	}
	i : u64 mut;
	iter_max : u64 mut := g->data_size;
	if(iter_max > 32)
	{
		iter_max = 32;
	}
	for(i = 0; i < iter_max; i = i + 1)
	{
		bwrite_uint8x(w, [g->data # i]);
		if((((i + 1) % 8) == 0) && (i < (iter_max - 1)))
		{
			bwrite_zstr(w, "\n  \0");
		}
		else
		{
			bwrite8(w, ' ');
		}
	}
	if(iter_max != g->data_size)
	{
		bwrite_zstr(w, "...\0");
	}
	bwrite_zstr(w, "\n} (size: \0");
	bwrite_uint(w, g->data_size);
	bwrite_zstr(w, ")\n\0");
};

irglob_dump : func(g : irglob mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 1024, scratch_arena);
	irglob_dump_to(w, g);
	putchars(w->buf, w->cursor);
};

irprog_dump_to : func(w : bwriter mut?, p : irprog mut? -> v0)
{
	i : u64 mut;
	for(i = 0; i < p->funcs_count; i = i + 1)
	{
		irfunc_dump_to(w, p->funcs # i);
	}

	for(i = 0; i < p->asms_count; i = i + 1)
	{
		irasm_dump_to(w, p->asms # i);
	}

	for(i = 0; i < p->globs_count; i = i + 1)
	{
		irglob_dump_to(w, p->globs # i);
	}
};

irprog_dump : func(p : irprog mut? -> v0)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 1024, scratch_arena);
	irprog_dump_to(w, p);
	putchars(w->buf, w->cursor);
};
