igraph_node_x64 : struct
{
	value : x64val;
	edges : u64 mut?;
	edges_count : u64;
	edges_cap : u64;
	hints : x64val_list;
	colour_tag : igraph_node_x64_colour_tag;
	colour : u64 mut;
	replacement : x64val;
};

igraph_node_x64_colour_tag : enum
{
	.unset := 0;
	.unchanged := 1;
	.param := 2;
	.stack_spill := 3;
	.hwreg := 4;
};

// stores liveness-analysis + register allocation state for a single function
lower_x64_register_allocation_state : struct
{
	igraph_nodes : igraph_node_x64_list;
	// array of uses/defs/live-in/live-out lists of values. e.g blk_uses[i] == the list of used x64vals in fn.blks[i]
	blk_uses : x64val_list mut?;
	blk_defs : x64val_list mut?;
	blk_live_ins : x64val_list mut?;
	blk_live_outs : x64val_list mut?;

	// array of uses/defs/live-before/live-after lists of values. e.g inst_uses[i] == the list of used x64vals in fnx64.insts[i]
	inst_uses : x64val_list mut?;
	inst_defs : x64val_list mut?;
	inst_live_befores : x64val_list mut?;
	inst_live_afters : x64val_list mut?;

	abi_param_regs : x64val mut?;
	abi_param_regs_count : u64;
	abi_fp_param_regs : x64val mut?;
	abi_fp_param_regs_count : u64;
	abi_hwregs : x64val mut?;
	abi_hwregs_count : u64;
	abi_fp_hwregs : x64val mut?;
	abi_fp_hwregs_count : u64;
	abi_volatile_regs : x64val mut?;
	abi_volatile_regs_count : u64;
	abi_fp_volatile_regs : x64val mut?;
	abi_fp_volatile_regs_count : u64;
	abi_nonvolatile_regs : x64val mut?;
	abi_nonvolatile_regs_count : u64;
	abi_fp_nonvolatile_regs : x64val mut?;
	abi_fp_nonvolatile_regs_count : u64;
};

igraph_node_is_floating_point : func(n : igraph_node_x64 mut? -> bool)
{
	return x64val_vreg_floating_point_size(ref(n->value)) != 0;
};

irfunc_register_allocation_x64 : func(state : lower_x64_register_allocation_state mut?, fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	//warn_begin();
	//putzstr("irfunc_register_allocation_x64 is NYI\n\0");
	//warn_end();
	// 1. liveness analysis (data-flow analysis)
	irfunc_liveness_analysis_x64(state, fn, fnx64);

	// timing
	t : u64 mut := nanotime();

	should_print ::= args_has_asmdump_specific() && streql(fn->custom_name, fn->custom_name_len, args.asm_dump_specific.data, args.asm_dump_specific.len);
	if(should_print)
	{
		x64func_dump_with_liveness(state, fn, fnx64);
	}
	// 2. interference graph
	irfunc_build_interference_graph_x64(state, fn, fnx64);
	// 3. graph-colouring for ssa register nodes
	// note: this is semi-close to working but fucks up in certain edge-cases.
	irfunc_do_graph_colouring_x64(state, fn, fnx64);
	// 4. replace ssa operands in all instructions with their lowered variants
	irfunc_post_graph_colouring_patch_x64(state, fn, fnx64);

	compile_timings.assembly_register_allocation = compile_timings.assembly_register_allocation + (nanotime() - t);
};

irfunc_build_interference_graph_x64 : func(state : lower_x64_register_allocation_state mut?, fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	igraph_node_x64_list_empty(ref(state->igraph_nodes));
	// we want every value to have a node in the igraph
	// foreach(inst in fn)
	// {
	//   foreach(def in inst.defs)
	//   {
	//      foreach(out in inst.live_afters)
	//		{
	//        add_edge(def, out)
	//		}
    //   }
	// }
	i : u64 mut;
	j : u64 mut;
	k : u64 mut;
	for(i = 0; i < fnx64->insts_count; i = i + 1)
	{
		inst ::= fnx64->insts # i;
		if(x64inst_is_valid(inst))
		{
			if(x64inst_is_custom(inst, ir_lower_x64inst_tag.reghint))
			{
				// reghint is treated specially...
				op0 ::= inst->operands # 0;
				op1 ::= inst->operands # 1;
				op0_node_id ::= igraph_node_x64_list_append_unique(ref(state->igraph_nodes), op0);
				x64val_list_append_unique((ref(state->igraph_nodes.data # op0_node_id)->hints), op1);
			}
			uses ::= state->inst_uses # i;
			defs ::= state->inst_defs # i;
			live_afters ::= state->inst_live_afters # i;
			for(j = 0; j < uses->count; j = j + 1)
			{
				igraph_node_x64_list_append_unique(ref(state->igraph_nodes), uses->data # j);
			}
			for(j = 0; j < defs->count; j = j + 1)
			{
				igraph_node_x64_list_append_unique(ref(state->igraph_nodes), defs->data # j);
			}
			for(j = 0; j < defs->count; j = j + 1)
			{
				cur_def ::= defs->data # j;
				for(k = 0; k < live_afters->count; k = k + 1)
				{
					cur_after ::= live_afters->data # k;
					if(!x64val_equal_to(cur_after, cur_def))
					{
						// add an edge between the two nodes...
						def_node_id ::= igraph_node_x64_list_append_unique(ref(state->igraph_nodes), cur_def);
						after_node_id ::= igraph_node_x64_list_append_unique(ref(state->igraph_nodes), cur_after);
						igraph_node_x64_add_edge_unique(state->igraph_nodes.data # def_node_id, after_node_id);
						igraph_node_x64_add_edge_unique(state->igraph_nodes.data # after_node_id, def_node_id);
					}
				}
			}
		}
	}

	if(args_has_asmdump_specific() && streql(fn->custom_name, fn->custom_name_len, args.asm_dump_specific.data, args.asm_dump_specific.len))
	{
	putzstr("\nigraph for function \0");
	putchars(fn->custom_name, fn->custom_name_len);
	putzstr(": \n\0");
	// dump the interference graph:
	for(i = 0; i < state->igraph_nodes.count; i = i + 1)
	{
		node ::= state->igraph_nodes.data # i;
		x64val_dump(ref(node->value));
		putzstr(": \0");
		for(j = 0; j < node->edges_count; j = j + 1)
		{
			other_node ::= state->igraph_nodes.data # [node->edges # j];
			x64val_dump(ref(other_node->value));
			if(j < (node->edges_count - 1))
			{
				putzstr(", \0");
			}
		}
		if(node->hints.count > 0)
		{
			putzstr("\n\treghints: \0");
			for(j = 0; j < node->hints.count; j = j + 1)
			{
				x64val_dump(node->hints.data # j);
				if(j < (node->edges_count - 1))
				{
					putzstr(", \0");
				}
			}
		}
		putchar('\n');
	}
	putchar('\n');
	}
};

igraph_node_find_neighbour_by_value : func(node : igraph_node_x64 mut?, state : lower_x64_register_allocation_state mut?, v : x64val mut? -> igraph_node_x64 mut?)
{
	i : u64 mut;
	for(i = 0; i < node->edges_count; i = i + 1)
	{
		neighbour_node ::= state->igraph_nodes.data # [node->edges # i];
		if(x64val_equal_to(ref(neighbour_node->value), v))
		{
			return neighbour_node;
		}
	}
	return zero;
};

igraph_node_any_neighbour_has_colour : func(node : igraph_node_x64 mut?, state : lower_x64_register_allocation_state mut?, hwreg_col : u64 -> bool)
{
	i : u64 mut;
	is_fp ::= igraph_node_is_floating_point(node);
	for(i = 0; i < node->edges_count; i = i + 1)
	{
		neighbour_node ::= state->igraph_nodes.data # [node->edges # i];
		// check if the node is coloured the hwreg
		// if their fp-ness differs, then they cannot have the same colour
		if(is_fp == igraph_node_is_floating_point(neighbour_node))
		{
			if((neighbour_node->colour_tag == igraph_node_x64_colour_tag.hwreg) && (neighbour_node->colour == hwreg_col))
			{
				return true;
			}
			if(is_fp)
			{
				// also check if the node *is* the hwreg
				the_fp_hwreg ::= state->abi_fp_hwregs # (hwreg_col);
				if(x64val_equal_to(ref(neighbour_node->value), the_fp_hwreg))
				{
					return true;
				}
			}
			else
			{
				// also check if the node *is* the hwreg
				the_hwreg ::= state->abi_hwregs # (hwreg_col);
				if(x64val_equal_to(ref(neighbour_node->value), the_hwreg))
				{
					return true;
				}
			}
		}
	}
	return false;
};

irfunc_do_graph_colouring_x64 : func(state : lower_x64_register_allocation_state mut?, fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	// do graph colouring based on the edges, and a set of colours (NYI TODO)
	// foreach node, assign them a colour
	// if there are any hints, choose the first one thats not already precoloured
	// if not, choose the first scratch volatile/nonvolatile register that doesnt have the same colour as any of our neighbours
	i : u64 mut;
	j : u64 mut;
	for(i = 0; i < state->igraph_nodes.count; i = i + 1)
	{
		node ::= state->igraph_nodes.data # i;
		is_fp ::= igraph_node_is_floating_point(node);
		if(ir_lower_x64val_is_register(ref(node->value)) && (node->colour_tag == igraph_node_x64_colour_tag.unset))
		{
			if(is_fp)
			{
				for(j = 0; j < state->abi_fp_hwregs_count; j = j + 1)
				{
					// colour j
					// iterate over neighbours and see if j is taken
					if((node->colour_tag == igraph_node_x64_colour_tag.unset) && !igraph_node_any_neighbour_has_colour(node, state, j))
					{
						// cool!
						node->colour_tag = igraph_node_x64_colour_tag.hwreg;
						node->colour = j;
					}
				}
			}
			else
			{
				for(j = 0; j < state->abi_hwregs_count; j = j + 1)
				{
					// colour j
					// iterate over neighbours and see if j is taken
					if((node->colour_tag == igraph_node_x64_colour_tag.unset) && !igraph_node_any_neighbour_has_colour(node, state, j))
					{
						// cool!
						node->colour_tag = igraph_node_x64_colour_tag.hwreg;
						node->colour = j;
					}
				}
			}
			if(node->colour_tag == igraph_node_x64_colour_tag.unset)
			{
				// couldnt find a colour. it gets spilled now.
				node->colour_tag = igraph_node_x64_colour_tag.stack_spill;
			}
		}
	}
};

irfunc_post_graph_colouring_patch_x64 : func(state : lower_x64_register_allocation_state mut?, fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	// given a finalised, coloured interference graph, patch all of the vreg x64vals in the instructions of the function with their associated coloured x64val_tag.reg replacements (thus making the instructions encodeable)
	// this not only involves vreg -> reg but also vmemregs where the base/index registers are ssa registers
	replacement : x64val mut;

	i : u64 mut;
	j : u64 mut;
	k : u64 mut;
	nodes_count ::= state->igraph_nodes.count;
	node : igraph_node_x64 mut? mut;
	for(i = 0; i < nodes_count; i = i + 1)
	{
		node = state->igraph_nodes.data # i;
		node->replacement.tag = x64val_tag.invalid;
		nodeval ::= ref(node->value);
		is_fp ::= igraph_node_is_floating_point(node);
		if(is_fp)
		{
			if(node->colour_tag == igraph_node_x64_colour_tag.param)
			{
				node->replacement = [state->abi_fp_param_regs # node->colour];
			}
			if(node->colour_tag == igraph_node_x64_colour_tag.hwreg)
			{
				node->replacement = [state->abi_fp_hwregs # node->colour];
			}
		}
		else
		{
			if(node->colour_tag == igraph_node_x64_colour_tag.param)
			{
				node->replacement = [state->abi_param_regs # node->colour];
			}
			if(node->colour_tag == igraph_node_x64_colour_tag.hwreg)
			{
				node->replacement = [state->abi_hwregs # node->colour];
			}
		}
		if(node->colour_tag == igraph_node_x64_colour_tag.stack_spill)
		{
			node->replacement.tag = x64val_tag.memreg;
			[x64val_memreg_get_base(ref (node->replacement))] = x64_reg.rbp;
			[x64val_memreg_get_base_size(ref (node->replacement))] = 64;
			[x64val_memreg_get_index_size(ref (node->replacement))] = 0;
			[x64val_memreg_get_scale(ref (node->replacement))] = 0;
			fnx64->stack = fnx64->stack + 8;
			[x64val_memreg_get_displacement(ref (node->replacement))] = -fnx64->stack;
			[x64val_memreg_get_displacement_size(ref (node->replacement))] = 32;
		}
	}

	for(i = 0; i < fnx64->insts_count; i = i + 1)
	{
		inst ::= fnx64->insts # i;
		if(x64inst_is_valid(inst))
		{
			// if any operand matches any node (and that node has a replacement, make the replacement)
			for(j = 0; j < nodes_count; j = j + 1)
			{
				node = state->igraph_nodes.data # j;
				replacement_match ::= ref(node->value);
				replace_with ::= ref(node->replacement);

				ir_lower_replace_values_within(inst, replacement_match, replace_with, igraph_node_is_floating_point(node));
			}
		}
	}
};

ir_lower_replace_values_within : func(inst : x64inst mut?, replacement_match : x64val mut?, replace_with : x64val mut?, is_fp : bool -> v0)
{
	// for each operand V in the instruction, if the operand *contains* registers that are equal to 'replacement_match', then the registers are replaced with 'replace_with'
	// e.g for 'mov %q0, QWORD PTR [%q0]'
	// and replacement_match == %q0, replace_with = rax
	// yields => 'mov rax, QWORD PTR [rax]'

	// we cant just use ir_lower_x64val_get_contained_register because we need to not only retrieve the contained registers, but change them too (that function only allows retrieval for architectural reasons)
	// so what we actually need to do is manually check all the ways we could have a register (remember we havent transformed anything yet so this is still the semi-IR form! that means we care about:
	// - vregs
	// - vmemregs (base register)
	opcount ::= x64inst_operands_count(inst);
	i : u64 mut;
	for(i = 0; i < opcount; i = i + 1)
	{
		operand ::= inst->operands # i;
		if(ir_lower_x64val_is_vreg(operand))
		{
			ir_lower_replace_values_within_vreg(operand, replacement_match, replace_with, is_fp);
		}
		if(ir_lower_x64val_is_vmemreg(operand))
		{
			ir_lower_replace_values_within_vmemreg(operand, replacement_match, replace_with, is_fp);
		}
	}
};

ir_lower_replace_values_within_vreg : func(v : x64val mut?, replacement_match : x64val mut?, replace_with : x64val mut?, is_fp : bool -> v0)
{
	if(x64val_equal_to(v, replacement_match))
	{
		// remember the replacement match is not necessarily the same size as the actual value
		the_size ::= x64val_get_size(v);

		[v] = [replace_with];
		// replace_with is either a reg or a memreg
		// and we need to preserve the old size, so:
		if(replace_with->tag == x64val_tag.memreg)
		{
			[x64val_memreg_get_size(v)] = the_size;
		}
		else
		{
			if(is_fp)
			{
				// floats live in xmmN, stupid x64
				[x64val_reg_get_size(v)] = 128;
			}
			else
			{
				[x64val_reg_get_size(v)] = the_size;
			}
		}
	}
};

ir_lower_replace_values_within_vmemreg : func(v : x64val mut?, replacement_match : x64val mut?, replace_with : x64val mut?, is_fp : bool -> v0)
{
	// check the base reg (if there somehow isnt one we bail)
	the_vreg : x64val mut;
	if(!x64val_vmemreg_get_base_vreg(v, ref the_vreg))
	{
		return;
	}
	// now just check that
	if(x64val_equal_to(ref the_vreg, replacement_match))
	{
		// we need to turn this vmemreg with the vreg base register into a proper memreg with the proper base register
		// but this gets a bit complex - because replace_with isnt always a reg, it could be a memreg if we spilled
		// remember the replacement match is not necessarily the same size as the actual value
		the_mem_size ::= x64val_get_size(v);
		the_disp : s32 mut := [x64val_vmemreg_get_displacement(v)];
		v->tag = x64val_tag.memreg;
		[x64val_memreg_get_size(v)] = the_mem_size;
		[x64val_memreg_get_displacement_size(v)] = 32;
		// patch up the base register
		[x64val_memreg_get_base_size(v)] = x64val_get_size(ref the_vreg);
		// base register is not that simple because as stated previously replace_with could be a memreg so we have to check both:
		if(replace_with->tag == x64val_tag.memreg)
		{
			// preserve displacement
			the_disp = the_disp + [x64val_memreg_get_displacement(replace_with)]@s64@s32;
			[x64val_memreg_get_base(v)] = [x64val_memreg_get_base(replace_with)];
		}
		else
		{
			// easy, just set the register as the base register of the memreg
			[x64val_memreg_get_base(v)] = [x64val_reg_get_reg(replace_with)];
		}
		[x64val_memreg_get_displacement(v)] = the_disp@s64@u64;
		[x64val_memreg_get_index_size(v)] = 0;
		[x64val_memreg_get_scale(v)] = 0;
	}
};
