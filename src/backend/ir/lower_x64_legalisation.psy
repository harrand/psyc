irfunc_legalisation_x64 : func(fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	// iterate over all x64insts in the fnx64
	// keep legalising until they're all legal
	i : u64 mut;
	count ::= fnx64->insts_count;
	x64_position_start_func(fnx64->idx);
	for(i = 0; i < count; i = i + 1)
	{
		inst ::= fnx64->insts # i;
		ir_lower_handle_double_memory_operand(inst, i);
	}
};
