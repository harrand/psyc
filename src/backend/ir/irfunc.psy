irfunc : struct
{
	idx : u64;
	blks : irblk mut?;
	blks_count : u64;
	blks_cap : u64;

	params : irsz mut?;
	params_count : u64;
	params_cap : u64;

	returns : irsz mut?;
	returns_count : u64;
	returns_cap : u64;

	custom_name : u8?;
	custom_name_len : u64;

	counter : u64;
};

irfunc_add_param : func(fn : irfunc mut?, sz : irsz, out : irval mut? -> v0)
{
	if(fn->params == zero)
	{
		fn->params_cap = 8;
		fn->params = arena_alloc(global_arena, fn->params_cap * sizeof typeof([fn->params]));
	}
	while(fn->params_count >= fn->params_cap)
	{
		oldcap ::= fn->params_cap;
		olddata ::= fn->params;
		fn->params_cap = fn->params_cap * 2;
		fn->params = arena_alloc(global_arena, fn->params_cap * sizeof typeof([fn->params]));
		memcopy(fn->params, olddata, oldcap * sizeof typeof([fn->params]));
	}
	idx ::= fn->params_count;
	fn->params_count = (fn->params_count + 1);
	fn->counter = fn->counter + 1;

	[fn->params # idx] = sz;
	out->tag = irval_tag.reg;
	[irval_reg_get_sz(out)] = sz;
	[irval_reg_get_idx(out)] = idx;
	// entry block defines all params at instruction ~0
	irblk_add_def_if_register(fn->blks # 0, out, ~0);
};

irfunc_add_return : func(fn : irfunc mut?, sz : irsz -> v0)
{
	if(fn->returns == zero)
	{
		fn->returns_cap = 8;
		fn->returns = arena_alloc(global_arena, fn->returns_cap * sizeof typeof([fn->returns]));
	}
	while(fn->returns_count >= fn->returns_cap)
	{
		oldcap ::= fn->returns_cap;
		olddata ::= fn->returns;
		fn->returns_cap = fn->returns_cap * 2;
		fn->returns = arena_alloc(global_arena, fn->returns_cap * sizeof typeof([fn->returns]));
		memcopy(fn->returns, olddata, oldcap * sizeof typeof([fn->returns]));
	}
	idx ::= fn->returns_count;
	[fn->returns # idx] = sz;
	fn->returns_count = (fn->returns_count + 1);
};

irfunc_add_blk : func(fn : irfunc mut? -> irblk mut?)
{
	if(fn->blks == zero)
	{
		fn->blks_cap = 8;
		fn->blks = arena_alloc(global_arena, fn->blks_cap * sizeof typeof([fn->blks]));
	}
	while(fn->blks_count >= fn->blks_cap)
	{
		oldcap ::= fn->blks_cap;
		olddata ::= fn->blks;
		fn->blks_cap = fn->blks_cap * 2;
		fn->blks = arena_alloc(global_arena, fn->blks_cap * sizeof typeof([fn->blks]));
		memcopy(fn->blks, olddata, oldcap * sizeof typeof([fn->blks]));
	}
	idx ::= fn->blks_count;
	fn->blks_count = (fn->blks_count + 1);

	ptr ::= fn->blks # idx;
	ptr->idx = idx;
	ptr->insts = zero;
	ptr->insts_count = 0;
	ptr->insts_cap = 0;
	ptr->successors_count = 0;
	ptr->predecessors = zero;
	ptr->predecessors_count = 0;
	ptr->predecessors_cap = 0;
	ptr->defs = zero;
	ptr->defs_count = 0;
	ptr->defs_cap = 0;
	ptr->uses = zero;
	ptr->uses_count = 0;
	ptr->uses_cap = 0;
	ptr->live_in = zero;
	ptr->live_in_count = 0;
	ptr->live_in_cap = 0;
	ptr->live_out = zero;
	ptr->live_out_count = 0;
	ptr->live_out_cap = 0;
	return ptr;
};

irfunc_finalise : func(fn : irfunc mut? -> v0)
{
	putzstr("finalising $\0");
	putuint(fn->idx);
	putzstr("...\n\0");	
	irfunc_dump(ir_current_func());
	// calculate live-in/live-out foreach block
	// keep going until none of them changed
	keep_going : bool mut := true;
	i : s64 mut;
	while(keep_going == true)
	{
		keep_going = false;
		for(i = (fn->blks_count - 1)@s64; i >= 0; i = i - 1)
		{
			// returns true if changes
			// so if it ever returns false then we need to recurse
			if(irblk_calc_live_inout(fn, fn->blks # i))
			{
				keep_going = true;
			}
		}
	}
	for(i = 0; i@u64 < fn->blks_count; i = i + 1)
	{
		irblk_finalise_live_in(fn->blks # i);
		irblk_finalise_live_out(fn->blks # i);
	}
};
