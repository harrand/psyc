ir_add : func(out : irval mut?, lhs : irval mut?, rhs : irval mut? -> v0)
{
	inst : irinst mut := zero;
	inst.tag = irinst_tag.add;

	ir_new_reg_of(irval_get_sz(lhs), out);
	irinst_add_operand(ref inst, out);
	irinst_add_operand(ref inst, lhs);
	irinst_add_operand(ref inst, rhs);
	ir_add_instruction(ref inst);
};

ir_add_get_out : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 0;
};

ir_add_get_lhs : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 1;
};

ir_add_get_rhs : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 2;
};

