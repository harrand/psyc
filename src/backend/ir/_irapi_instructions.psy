ir_stack : func(out : irval mut?, size : irval mut?, align : irval mut? -> v0)
{
	inst : irinst mut := zero;
	inst.tag = irinst_tag.stack;

	ir_new_reg_of(irsz.q, out);
	irinst_add_operand(ref inst, out);
	irinst_add_operand(ref inst, size);
	irinst_add_operand(ref inst, align);
	ir_add_instruction(ref inst);
};

ir_stack_get_out : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 0;
};

ir_stack_get_size : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 1;
};

ir_stack_get_align : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 2;
};

ir_load : func(out : irval mut?, sz : irsz, base : irval mut?, disp : s32 -> v0)
{
	inst : irinst mut := zero;
	inst.tag = irinst_tag.load;

	ir_new_reg_of(sz, out);
	irinst_add_operand(ref inst, out);
	irinst_add_operand(ref inst, base);

	disp_irval : irval mut;
	irval_dimm(disp, ref disp_irval);
	irinst_add_operand(ref inst, ref disp_irval);

	ir_add_instruction(ref inst);
};

ir_load_get_out : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 0;
};

ir_load_get_base : func(inst : irinst mut? -> irval mut?)
{
	return inst->operands # 1;
};

ir_load_get_disp : func(inst : irinst mut? -> s32 mut?)
{
	return irval_imm_get_integer(inst->operands # 2)@s32 mut?;
};

ir_loadat : func(out : irval mut?, sz : irsz, base : irval mut?, index : irval mut?, scale : u8, disp : s32 -> v0)
{
	inst : irinst mut := zero;
