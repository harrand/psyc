ir_store : func(value : irval mut?, base : irval mut?, disp : s32 -> v0)
{
	inst : irinst mut := zero;
	inst.tag = irinst_tag.store;
	inst.operands = zero;
	inst.operands_count = 0;
	inst.operands_cap = 0;

	irinst_add_operand(ref inst, value);
	irinst_add_operand(ref inst, base);

	disp_irval : irval mut;
	irval_dimm(disp, ref disp_irval);
	irinst_add_operand(ref inst, ref disp_irval);

	ir_add_instruction(ref inst);
};

