irsz : enum
{
	.b := 0;
	.w := 1;
	.d := 2;
	.q := 3;
	.f := 4;
	.g := 5;
	.none := 6;
};

irval_tag : enum
{
	.invalid := 0;
	.imm := 1;
	.reg := 2;
	.globref := 3;
	.fnref := 4;
	.blkref := 5;
	.asmref := 6;
};

irval : struct
{
	tag : irval_tag;
	r1 : irsz;
	v1 : u64;
	v2 : u64;
	v3 : u64;
};

irval_reg_get_sz : func(v : irval mut? -> irsz mut?)
{
	return ref(v->r1);
};

irval_reg_get_idx : func(v : irval mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_imm_get_sz : func(v : irval mut? -> irsz mut?)
{
	return ref(v->r1);
};

irval_imm_get_integer : func(v : irval mut? -> s64 mut?)
{
	return ref(v->v1)@s64 mut?;
};

irval_imm_get_floating_point : func(v : irval mut? -> f64 mut?)
{
	return ref(v->v1)@f64 mut?;
};

irval_imm : func(imm : s64 weak, sz : irsz, out : irval mut? -> v0)
{
	out->tag = irval_tag.imm;
	[irval_imm_get_sz(out)] = sz;
	[irval_imm_get_integer(out)] = imm;
};

irval_bimm : func(bimm : s64 weak, out : irval mut? -> v0)
{
	irval_imm(bimm, irsz.b, out);
};

irval_wimm : func(wimm : s64 weak, out : irval mut? -> v0)
{
	irval_imm(wimm, irsz.w, out);
};

irval_dimm : func(dimm : s64 weak, out : irval mut? -> v0)
{
	irval_imm(dimm, irsz.d, out);
};

irval_qimm : func(qimm : s64 weak, out : irval mut? -> v0)
{
	irval_imm(qimm, irsz.q, out);
};

irval_fimm : func(fimm : f64 weak, out : irval mut? -> v0)
{
	out->tag = irval_tag.imm;
	[irval_imm_get_sz(out)] = irsz.f;
	[irval_imm_get_floating_point(out)] = fimm;
};

irval_gimm : func(gimm : f64 weak, out : irval mut? -> v0)
{
	out->tag = irval_tag.imm;
	[irval_imm_get_sz(out)] = irsz.g;
	[irval_imm_get_floating_point(out)] = gimm;
};

irval_globref_get_idx : func(v : irval mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_fnref_get_idx : func(v : irval mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_fnref : func(fn_idx : u64, out : irval mut? -> v0)
{
	out->tag = irval_tag.fnref;
	[irval_fnref_get_idx(out)] = fn_idx;
};

irval_blkref_get_idx : func(v : irval mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_asmref_get_idx : func(v : irval mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_get_sz : func(v : irval mut? -> irsz)
{
	return [irval_get_sz_tbl # (v->tag@s64)](v);
};

irsz_names ::= u8?[countof irsz]
{
	.0 := "b\0";
	.1 := "w\0";
	.2 := "d\0";
	.3 := "q\0";
	.4 := "f\0";
	.5 := "g\0";
	.6 := "none\0";
};

irsz_sizes ::= u64[countof irsz]
{
	.0 := 1;
	.1 := 2;
	.2 := 4;
	.3 := 8;
	.4 := 4;
	.5 := 8;
	.6 := 0;
};

irval_invalid_get_sz_ : func(v : irval mut? -> irsz)
{
	return irsz.none;
};

irval_imm_get_sz_ : func(v : irval mut? -> irsz)
{
	return [irval_imm_get_sz(v)];
};

irval_reg_get_sz_ : func(v : irval mut? -> irsz)
{
	return [irval_reg_get_sz(v)];
};

irval_globref_get_sz_ : func(v : irval mut? -> irsz)
{
	return irsz.q;
};

irval_fnref_get_sz_ : func(v : irval mut? -> irsz)
{
	return irsz.q;
};

irval_blkref_get_sz_ : func(v : irval mut? -> irsz)
{
	return irsz.q;
};

irval_asmref_get_sz_ : func(v : irval mut? -> irsz)
{
	return irsz.none;
};

irval_get_sz_tbl ::= typeof(irval_get_sz)[countof irval_tag]
{
	.0 := irval_invalid_get_sz_;
	.1 := irval_imm_get_sz_;
	.2 := irval_reg_get_sz_;
	.3 := irval_globref_get_sz_;
	.4 := irval_fnref_get_sz_;
	.5 := irval_blkref_get_sz_;
	.6 := irval_asmref_get_sz_;
};
