irabi : enum
{
	.psy64 := 0;
};

irabi_chunk : func(abi : irabi, tys : ty?, tys_count : u64, out_chunks : irchunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)
{
	[irabi_chunk_tbl # (abi@s64)](tys, tys_count, out_chunks, out_chunks_count, ar);
};


irabi_chunk_tbl ::= func(tys : ty?, tys_count : u64, out_chunks : irchunk mut? mut?, out_chunks_count : u64 mut?, ar : arena mut? -> v0)[countof irabi]
{
	.0 := irabi_chunk_psy64;
};

irabi_sizeof : func(abi : irabi, type : ty -> u64)
{
	return [irabi_sizeof_tbl # (abi@s64)](type);
};

irabi_sizeof_tbl ::= func(type : ty -> u64)[countof irabi]
{
	.0 := irabi_sizeof_psy64;
};

irabi_alignof : func(abi : irabi, type : ty -> u64)
{
	return [irabi_alignof_tbl # (abi@s64)](type);
};

irabi_alignof_tbl ::= func(type : ty -> u64)[countof irabi]
{
	.0 := irabi_alignof_psy64;
};

irabi_offsetof_struct : func(abi : irabi, type : ty, idx : u64 -> u64)
{
	return [irabi_offsetof_struct_tbl # (abi@s64)](type, idx);
};

irabi_offsetof_struct_tbl ::= func(type : ty, idx : u64 -> u64)[countof irabi]
{
	.0 := irabi_offsetof_struct_psy64;
};
