irprog : struct
{
	funcs : irfunc mut?;
	funcs_count : u64;
	funcs_cap : u64;

	asms : irasm mut?;
	asms_count : u64;
	asms_cap : u64;

	globs : irglob mut?;
	globs_count : u64;
	globs_cap : u64;

	//entrypoint : irpos;
	relocs : irreloc mut?;
	relocs_count : u64;
	relocs_cap : u64;
};

irprog_add_reloc : func(p : irprog mut?, reloc : irreloc mut? -> v0)
{
	if(p->relocs == zero)
	{
		p->relocs_cap = 64;
		p->relocs = arena_alloc(global_arena, p->relocs_cap * sizeof irreloc);
	}
	while(p->relocs_count >= p->relocs_cap)
	{
		old ::= p->relocs;
		oldcap ::= p->relocs_cap;
		p->relocs_cap = p->relocs_cap * 2;
		p->relocs = arena_alloc(global_arena, p->relocs_cap * sizeof irreloc);
		memcopy(p->relocs, old, oldcap * sizeof irreloc);
	}
	[p->relocs # p->relocs_count] = [reloc];
	p->relocs_count = p->relocs_count + 1;
};

irprog_add_func : func(p : irprog mut? -> irfunc mut?)
{
	if(p->funcs == zero)
	{
		p->funcs_cap = 8;
		p->funcs = arena_alloc(global_arena, p->funcs_cap * sizeof irfunc);
	}
	while(p->funcs_count >= p->funcs_cap)
	{
		oldcap ::= p->funcs_cap;
		old ::= p->funcs;
		p->funcs_cap = (p->funcs_cap * 2);
		p->funcs = arena_alloc(global_arena, p->funcs_cap * sizeof irfunc);
		memcopy(p->funcs, old, oldcap * sizeof irfunc);
	}
	idx ::= p->funcs_count;
	p->funcs_count = (p->funcs_count + 1);
	ptr ::= p->funcs # idx;
	ptr->idx = idx;
	ptr->blks = zero;
	ptr->blks_count = 0;
	ptr->blks_cap = 0;

	ptr->params = zero;
	ptr->params_count = 0;
	ptr->params_cap = 0;

	ptr->returns = zero;
	ptr->returns_count = 0;
	ptr->returns_cap = 0;

	ptr->custom_name = zero;
	ptr->custom_name_len = 0;

	ptr->counter = 0;
	return ptr;
};

irprog_add_asm : func(p : irprog mut?, params : irsz mut?, params_count : u64, ret : irsz, constraint : u8 mut?, constraint_len : u64, code : u8 mut?, code_len : u64 -> irasm mut?)
{
	if(p->asms == zero)
	{
		p->asms_cap = 8;
		p->asms = arena_alloc(global_arena, p->asms_cap * sizeof irasm);
	}
	while(p->asms_count >= p->asms_cap)
	{
		oldcap ::= p->asms_cap;
		old ::= p->asms;
		p->asms_cap = (p->asms_cap * 2);
		p->asms = arena_alloc(global_arena, p->asms_cap * sizeof irasm);
		memcopy(p->asms, old, oldcap * sizeof irasm);
	}
	idx ::= p->asms_count;
	p->asms_count = (p->asms_count + 1);
	ptr ::= p->asms # idx;
	ptr->idx = idx;
	ptr->params = params;
	ptr->params_count = params_count;
	ptr->ret = ret;
	ptr->constraint = constraint;
	ptr->constraint_len = constraint_len;
	ptr->code = code;
	ptr->code_len = code_len;
	return ptr;
};

irprog_add_glob : func(p : irprog mut?, data : u8 mut? weak, size : u64, is_mut : bool, out : irval mut? -> irglob mut?)
{
	if(p->globs == zero)
	{
		p->globs_cap = 8;
		p->globs = arena_alloc(global_arena, p->globs_cap * sizeof irglob);
	}
	while(p->globs_count >= p->globs_cap)
	{
		oldcap ::= p->globs_cap;
		old ::= p->globs;
		p->globs_cap = (p->globs_cap * 2);
		p->globs = arena_alloc(global_arena, p->globs_cap * sizeof irglob);
		memcopy(p->globs, old, oldcap * sizeof irglob);
	}
	idx ::= p->globs_count;
	p->globs_count = (p->globs_count + 1);
	ptr ::= p->globs # idx;
	ptr->idx = idx;
	ptr->data = data;
	ptr->data_size = size;
	ptr->is_mut = is_mut;

	out->tag = irval_tag.globref;
	[irval_globref_get_idx(out)] = idx;
	return ptr;
};
