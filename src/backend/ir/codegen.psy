codegen_ir : func(-> v0)
{
	i : u64 mut;
	for(i = 0; i < prog.global_scope.funcs_count; i = i + 1)
	{
		codegen_ir_funcsig(prog.global_scope.funcs # i);
	}
	for(i = 0; i < prog.global_scope.funcs_count; i = i + 1)
	{
		codegen_ir_funcdef(prog.global_scope.funcs # i);
	}

	if(args_should_dump_ir())
	{
		if(args_has_irdump_specific())
		{
			dump_fn ::= prog_find_function(args.ir_dump_specific.data, args.ir_dump_specific.len); 
			if(dump_fn == zero)
			{
				err_begin();
				putzstr("requested to dump-ir for function \0");
				putchar('"');
				putchars(args.ir_dump_specific.data, args.ir_dump_specific.len);
				putchar('"');
				putzstr(" but no function exists with this name\0");
				err_end();
			}
			irfunc_dump(irapi.prog.funcs # dump_fn->irfunc_idx);
		}
		else
		{
			irprog_dump(ref(irapi.prog));
		}
	}
};

codegen_ir_funcsig : func(fn : function_t mut? -> v0)
{
	myself : irval mut;
	irfn ::= ir_add_func(ref myself);
	fn_node ::= fn->node;
	fn_typename_node ::= ast_function_get_typename(fn_node);
	irfn->custom_name = [ast_function_get_name(fn_node)];
	irfn->custom_name_len = [ast_function_get_name_len(fn_node)];

	fnty ::= ty_unwrap(fn->type);

	abi_chunk_tys(fn->abi, fnty->members # 0, fnty->members_count, ref(fn->param_chunks), ref(fn->param_chunks_count), global_arena);

	abi_chunk_tys(fn->abi, ref(fnty->underlying), 1, ref(fn->return_chunks), ref(fn->return_chunks_count), global_arena);

	sz : irsz mut;
	i : u64 mut;
	j : u64 mut;

	params_count ::= ty_countof(fn->type);
	param_nodes ::= ast_typename_function_get_param_decls(fn_typename_node);
	for(i = 0; i < params_count; i = i + 1)
	{
		param_var ::= fn->scope.vars # i;
		param_storage ::= ref(param_var->storage);
		// calculate abi chunks again but only for this particular parameter
		chunks_for_this_param : abi_chunk mut? mut := zero;
		chunks_for_this_param_count : u64 mut := 0;
		abi_chunk_tys(fn->abi, fnty->members # i, 1, ref chunks_for_this_param, ref chunks_for_this_param_count, scratch_arena);
		if(chunks_for_this_param_count == 0)
		{
			// this param yielded zero chunks
			// it is either v0 (which is user-error) or something else, which is a compiler bug
			if(ty_strip(ty_at(fn->type, i)) == ty.v0)
			{
				err_begin();
				putzstr("parameter \0");
				putuint(i);
				putzstr(" of function \0");
				putchar('"');
				putchars(irfn->custom_name, irfn->custom_name_len);
				putchar('"');
				putzstr(" was 'v0', which is specifically not-allowed as a parameter type at \0");
				putsrc(fn->src, (param_nodes # i)->src_beg@u64, (param_nodes # i)->src_end@u64, putcol.red_underline);
				
				err_end();
			}
			else
			{
				panic_begin();
				putzstr("abi: parameter \0");
				putuint(i);
				putzstr(" of function \0");
				putchar('"');
				putchars(irfn->custom_name, irfn->custom_name_len);
				putchar('"');
				putzstr(" yielded zero chunks at \0");
				putsrc(fn->src, (param_nodes # i)->src_beg@u64, (param_nodes # i)->src_end@u64, putcol.red_underline);
				panic_end();
			}
		}
		if(chunks_for_this_param_count == 1)
		{
			param_storage->tag = val_tag.scalar;
			sz = abi_chunk_as_irsz(chunks_for_this_param # 0);
			ir_add_param(sz, val_scalar_get_irval(param_storage));
		}
		else
		{
			// aggregate
			param_storage->tag = val_tag.aggregate;
			[val_aggregate_get_members_count(param_storage)] = chunks_for_this_param_count;
			members_ptr : val mut? := arena_alloc(global_arena, chunks_for_this_param_count * sizeof val);
			[val_aggregate_get_members(param_storage)] = members_ptr;
			for(j = 0; j < chunks_for_this_param_count; j = j + 1)
			{
				sz = abi_chunk_as_irsz(chunks_for_this_param # j);
				ir_add_param(sz, val_scalar_get_irval(members_ptr # i));
			}
		}
	}

	return_node ::= ast_typename_function_get_return_typename(fn_typename_node);
	for(i = 0; i < fn->return_chunks_count; i = i + 1)
	{
		sz = abi_chunk_as_irsz(fn->return_chunks # i);
		if(sz == irsz.none)
		{
			panic_begin();
			putzstr("abi: return value of function \0");
			putchar('"');
			putchars(irfn->custom_name, irfn->custom_name_len);
			putchar('"');
			putzstr(" was not partitioned properly into valid chunk(s) at \0");
			putsrc(fn->src, return_node->src_beg@u64, return_node->src_end@u64, putcol.red_underline);
			panic_end();
		}
		ir_add_return(sz);
	}

	fn->irfunc_idx = irfn->idx;
};

codegen_ir_funcdef : func(fn : function_t mut? -> v0)
{
	// set irpos
	ir_position_end_of(fn->irfunc_idx, 0);
	param_count ::= ty_countof(fn->type);
	i : u64 mut;
	for(i = param_count; i < fn->scope.vars_count; i = i + 1)
	{
		var ::= fn->scope.vars # i;
		storage ::= ref(var->storage);
		storage->tag = val_tag.pointer;

		size_irval : irval mut;
		irval_dimm(abi_sizeof(fn->abi, var->type), ref size_irval);
		
		align_irval : irval mut;
		irval_dimm(abi_alignof(fn->abi, var->type), ref align_irval);

		ir_stack(ref size_irval, ref align_irval, val_pointer_get_irval(storage));
	}
};
