irapi_t : struct
{
	prog : irprog;
	funcpos : u64;
	blkpos : u64;
	instpos : u64;
};

irapi ::= irapi_t mut
{
	.prog := zero;
	.funcpos := zero;
	.blkpos := zero;
	.instpos := zero;
};

ir_add_func : func(out : irval mut? -> irfunc mut?)
{
	ret ::= irprog_add_func(ref(irapi.prog));
	irapi.funcpos = ret->idx;
	irapi.blkpos = 0;
	irapi.instpos = 0;

	ir_add_blk(out);
	return ret;
};

ir_current_func : func(-> irfunc mut?)
{
	return irapi.prog.funcs # irapi.funcpos;
};

ir_add_asm : func(out : irval mut?, params : irsz mut?, params_count : u64, ret : irsz, constraint : u8 mut?, constraint_len : u64, code : u8 mut?, code_len : u64 -> irasm mut?)
{
	iras ::= irprog_add_asm(ref(irapi.prog), params, params_count, ret, constraint, constraint_len, code, code_len);
	irval_asmref(iras->idx, out);
	return iras;
};

ir_new_reg_of : func(sz : irsz, out : irval mut? -> v0)
{
	out->tag = irval_tag.reg;
	[irval_reg_get_sz(out)] = sz;
	fn ::= ir_current_func();
	[irval_reg_get_idx(out)] = fn->counter;
	fn->counter = fn->counter + 1;
};

ir_current_blk : func(-> irblk mut?)
{
	return ir_current_func()->blks # irapi.blkpos;
};

ir_add_param : func(sz : irsz, out : irval mut? -> v0)
{
	irfunc_add_param(ir_current_func(), sz, out);
};

ir_add_return : func(sz : irsz -> v0)
{
	irfunc_add_return(ir_current_func(), sz);
};

ir_add_blk : func(out : irval mut? -> irblk mut?)
{
	ret ::= irfunc_add_blk(irapi.prog.funcs # (irapi.funcpos));
	irapi.blkpos = ret->idx;
	irapi.instpos = 0;
	return ret;
};

ir_add_glob : func(data : u8 mut? weak, size : u64, is_mut : bool, out : irval mut? -> irglob mut?)
{
	return irprog_add_glob(ref(irapi.prog), data, size, is_mut, out);
};

ir_add_instruction : func(inst : irinst mut? -> v0)
{
	irblk_add_inst_at(ir_current_func(), ir_current_blk(), inst, irapi.instpos);
	irapi.instpos = irapi.instpos + 1;
};

ir_delete_instruction : func(-> v0)
{
	blk ::= ir_current_blk();
	cpydst ::= blk->insts # x64api.instpos;
	count ::= blk->insts_count - (irapi.instpos + 1);
	memcopy(cpydst, cpydst # 1, sizeof x64inst * count);
	blk->insts_count = blk->insts_count - 1;
	if(irapi.instpos > 0)
	{
		irapi.instpos = irapi.instpos - 1;
	}
};

ir_current_instruction : func(-> irinst mut?)
{
	if(irapi.instpos == 0)
	{
		return zero;
	}
	return ir_current_blk()->insts # (irapi.instpos - 1);
};

ir_position_beginning_of_blk : func(blkidx : u64 -> v0)
{
	irapi.blkpos = blkidx;
	irapi.instpos = 0;
};

ir_position_end_of_blk : func(blkidx : u64 -> v0)
{
	irapi.blkpos = blkidx;
	irapi.instpos = ir_current_blk()->insts_count;
};

ir_position_beginning_of : func(funcidx : u64, blkidx : u64 -> v0)
{
	irapi.funcpos = funcidx;
	irapi.blkpos = blkidx;
	irapi.instpos = 0;
};

ir_position_end_of : func(funcidx : u64, blkidx : u64 -> v0)
{
	irapi.funcpos = funcidx;
	irapi.blkpos = blkidx;
	irapi.instpos = ir_current_blk()->insts_count;
};

ir_position_before : func(funcidx : u64, blkidx : u64, instidx : u64 -> v0)
{
	irapi.funcpos = funcidx;
	irapi.blkpos = blkidx;
	irapi.instpos = instidx;
};

ir_position_after : func(funcidx : u64, blkidx : u64, instidx : u64 -> v0)
{
	irapi.funcpos = funcidx;
	irapi.blkpos = blkidx;
	irapi.instpos = instidx + 1;
};

ir_add_reloc : func(reloc : irreloc mut? -> v0)
{
	irprog_add_reloc(ref(irapi.prog), reloc);
};
