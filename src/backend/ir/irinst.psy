irinst_tag : enum
{
	.stack := 0;
	.load := 1;
	.loadat := 2;
	.store := 3;
	.storeat := 4;
	.ret := 5;
	.jmp := 6;
	.jmpif := 7;
	.zex := 8;
	.sex := 9;
	.trunc := 10;
	.cvtf := 11;
	.cvti := 12;
	.add := 13;
	.sub := 14;
	.umul := 15;
	.smul := 16;
	.udiv := 17;
	.sdiv := 18;
	.smod := 19;
	.umod := 20;
	.fadd := 21;
	.fsub := 22;
	.fmul := 23;
	.fdiv := 24;
	.fmod := 25;
	.xor := 26;
	.or := 27;
	.and := 28;
	.shl := 29;
	.ushr := 30;
	.sshr := 31;	
	.not := 32;
	.cmp_eq := 33;
	.cmp_ne := 34;
	.cmp_slt := 35;
	.cmp_sle := 36;
	.cmp_sgt := 37;
	.cmp_sge := 38;
	.cmp_ult := 39;
	.cmp_ule := 40;
	.cmp_ugt := 41;
	.cmp_uge := 42;
	.cmp_flt := 43;
	.cmp_fle := 44;
	.cmp_fgt := 45;
	.cmp_fge := 46;
	.call := 47;
	.brk := 48;
	.unreach := 49;
};

irinst : struct
{
	tag : irinst_tag;
	operands : irval mut?;
	operands_count : u64;
	operands_cap : u64;
};

// workaround for compiler bug
//irinst_zero : irinst := zero;

irinst_add_operand : func(inst : irinst mut?, op : irval mut? -> v0)
{
	if(inst->operands == zero)
	{
		inst->operands_cap = 8;
		inst->operands = arena_alloc(global_arena, inst->operands_cap * sizeof irval);
	}
	while(inst->operands_cap <= inst->operands_count)
	{
		oldcap ::= inst->operands_cap;
		old ::= inst->operands;
		inst->operands_cap = inst->operands_cap * 2;
		inst->operands = arena_alloc(global_arena, inst->operands_cap * sizeof irval);
		memcopy(inst->operands, old, oldcap * sizeof irval);
	}
	[inst->operands # (inst->operands_count)] = [op];
	inst->operands_count = inst->operands_count + 1;
};

