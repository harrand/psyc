irblk_liveness : struct
{
	// which variable was touched (i.e used/defined)
	reg_idx : u64;
	// which instruction (relative to the start of the current block) did it happen
	instruction_id : u64;
};

irblk : struct
{
	idx : u64;
	insts : irinst mut?;
	insts_count : u64;
	insts_cap : u64;

	// liveness analysis helpers are below, used for register allocation and lowering but not core to the IR structure itself
	// this is basically a control-flow graph (CFG) node. successors are indices of blocks that this block could jump into. no successors implies it returns or hits unreachable code
	successors : u64 mut[2];
	successors_count : u64;
	// predecessors are the indices of blocks that could jump into us. no predecessors implies we are dead code or the entry block.
	predecessors : u64 mut?;
	predecessors_count : u64;
	predecessors_cap : u64;

	// list of all defs (register indices that are 'defined' in this block + the instruction-id of the definition)
	defs : irblk_liveness mut?;
	defs_count : u64;
	defs_cap : u64;

	// list of all uses (register indices that are 'used' in this block + the instruction-id of the usage)
	uses : irblk_liveness mut?;
	uses_count : u64;
	uses_cap : u64;

	// the following arent computed until irblk_finalise (when we are fully done generating the IR)
	// list of all register indices that are live when entering the block
	live_in : u64 mut?;
	live_in_count : u64;
	live_in_cap : u64;
	// list of all register indices that are live when exiting the block
	live_out : u64 mut?;
	live_out_count : u64;
	live_out_cap : u64;
};

irblk_add_def_if_register : func(blk : irblk mut?, reg : irval mut?, instid : u64 -> bool)
{
	if(reg->tag != irval_tag.reg)
	{
		return false;
	}
	if(blk->defs == zero)
	{
		blk->defs_cap = 8;
		blk->defs = arena_alloc(global_arena, blk->defs_cap * sizeof typeof([blk->defs]));
	}
	while(blk->defs_count >= blk->defs_cap)
	{
		old ::= blk->defs;
		oldcap ::= blk->defs_cap;
		blk->defs_cap = blk->defs_cap * 2;
		blk->defs = arena_alloc(global_arena, blk->defs_cap * sizeof typeof([blk->defs]));
		memcopy(blk->defs, old, oldcap * sizeof typeof([blk->defs]));
	}
	ptr ::= blk->defs # blk->defs_count;
	ptr->reg_idx = [irval_reg_get_idx(reg)];
	ptr->instruction_id = instid;
	blk->defs_count = blk->defs_count + 1;
	return true;
};

irblk_add_use_if_register : func(blk : irblk mut?, reg : irval mut?, instid : u64 -> bool)
{
	regidx ::= [irval_reg_get_idx(reg)];
	// note: remember, a use only counts if it is before a potential redefinition within the block
	// in other words, if this register id is already defined previously, then we skip.
	i : u64 mut;
	for(i = 0; i < blk->defs_count; i = i + 1)
	{
		if((blk->defs # i)->reg_idx == regidx)
		{
			// already (re)defined previously. early-out.
			return false;
		}
	}
	
	if(reg->tag != irval_tag.reg)
	{
		return false;
	}
	if(blk->uses == zero)
	{
		blk->uses_cap = 8;
		blk->uses = arena_alloc(global_arena, blk->uses_cap * sizeof typeof([blk->uses]));
	}
	while(blk->uses_count >= blk->uses_cap)
	{
		old ::= blk->uses;
		oldcap ::= blk->uses_cap;
		blk->uses_cap = blk->uses_cap * 2;
		blk->uses = arena_alloc(global_arena, blk->uses_cap * sizeof typeof([blk->uses]));
		memcopy(blk->uses, old, oldcap * sizeof typeof([blk->uses]));
	}
	ptr ::= blk->uses # blk->uses_count;
	ptr->reg_idx = regidx;
	ptr->instruction_id = instid;
	blk->uses_count = blk->uses_count + 1;
	return true;
};

irblk_add_predecessor : func(blk : irblk mut?, pred_blk_idx : u64 -> v0)
{
	if(blk->predecessors == zero)
	{
		blk->predecessors_cap = 8;
		blk->predecessors = arena_alloc(global_arena, blk->predecessors_cap * sizeof typeof([blk->predecessors]));
	}
	while(blk->predecessors_count >= blk->predecessors_cap)
	{
		old ::= blk->predecessors;
		oldcap ::= blk->predecessors_cap;
		blk->predecessors_cap = blk->predecessors_cap * 2;
		blk->predecessors = arena_alloc(global_arena, blk->predecessors_cap * sizeof typeof([blk->predecessors]));
		memcopy(blk->predecessors, old, oldcap * sizeof typeof([blk->predecessors]));
	}
	// its a set so careful of uniqueness
	i : u64 mut;
	for(i = 0; i < blk->predecessors_count; i = i + 1)
	{
		if([blk->predecessors # i] == pred_blk_idx)
		{
			// already knew this was a predecessor. early out
			return;
		}
	}
	[blk->predecessors # blk->predecessors_count] = pred_blk_idx;
	blk->predecessors_count = blk->predecessors_count + 1;
};

irblk_add_inst_at : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut?, pos : u64 -> v0)
{
	if(blk->insts == zero)
	{
		blk->insts_cap = 8;
		blk->insts = arena_alloc(global_arena, blk->insts_cap * sizeof typeof([blk->insts]));
	}
	while(blk->insts_count >= blk->insts_cap)
	{
		oldcap ::= blk->insts_cap;
		olddata ::= blk->insts;
		blk->insts_cap = blk->insts_cap * 2;
		blk->insts = arena_alloc(global_arena, blk->insts_cap * sizeof typeof([blk->insts]));
		memcopy(blk->insts, olddata, oldcap * sizeof typeof([blk->insts]));
	}
	if(pos < blk->insts_count)
	{
		// move all insts right by one otherwise we will overwrite
		cpysrc ::= blk->insts # pos;
		memcopy_backwards(cpysrc # 1, cpysrc, sizeof irinst * (1 + blk->insts_count - pos));
	}
	instid ::= blk->insts_count;
	blk->insts_count = (blk->insts_count + 1);
	[blk->insts # pos] = [inst];
	
	// update successors
	blk->successors_count = 0;
	if(inst->tag == irinst_tag.jmp)
	{
		// add the block as our successor
		succ ::= [ir_jmp_get_blkidx(inst)];
		[blk->successors # 0] = succ;
		blk->successors_count = 1;

		// add ourselves as the blocks predecessor
		irblk_add_predecessor(fn->blks # succ, blk->idx);
	}
	if(inst->tag == irinst_tag.jmpif)
	{
		succ0 ::= [ir_jmpif_get_true_blkidx(inst)];
		succ1 ::= [ir_jmpif_get_false_blkidx(inst)];
		[blk->successors # 0] = succ0;
		[blk->successors # 1] = succ1;
		blk->successors_count = 2;

		irblk_add_predecessor(fn->blks # succ0, blk->idx);
		irblk_add_predecessor(fn->blks # succ1, blk->idx);
	}

	// add uses/defs
	outs_begin : u64 mut;
	outs_count : u64 mut;
	params_begin : u64 mut;
	params_count : u64 mut;
	irinst_analyse(inst, ref outs_begin, ref outs_count, ref params_begin, ref params_count);
	i : u64 mut;
	for(i = 0; i < outs_count; i = i + 1)
	{
		cur_out ::= inst->operands # (outs_begin + i);
		irblk_add_def_if_register(blk, cur_out, instid);
	}

	for(i = 0; i < params_count; i = i + 1)
	{
		cur_param ::= inst->operands # (params_begin + i);
		irblk_add_use_if_register(blk, cur_param, instid);
	}
};

irblk_has_terminator : func(blk : irblk mut? -> bool)
{
	if(blk->insts_count == 0)
	{
		return false;
	}
	return irinst_is_terminator(blk->insts # (blk->insts_count - 1));
};

irblk_finalise : func(fn : irfunc mut?, blk : irblk mut? -> v0)
{
	// calculate livein(B)/liveout(B) using dataflow analysis
};
