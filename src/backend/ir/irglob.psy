irglob : struct
{
	idx : u64;
	data : u8 mut?;
	data_size : u64;
	is_mut : bool;

	custom_name : u8?;
	custom_name_len : u64;

	relocs : irreloc_list;
	// should_be_considered_ptr???

	//patches : irpatch mut?;
	//patches_count : u64;
	//patches_cap : u64;
};

irglob_add_reloc : func(glob : irglob mut?, reloc : irreloc mut? -> v0)
{
	irreloc_list_append(ref(glob->relocs), reloc);
};
