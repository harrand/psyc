// ======================
// ir -> x64 lowering top
// ======================
ir_lower_x64 : func(-> v0)
{
	// install custom handlers
	x64val_custom_dump_to_handler = ir_lower_x64val_custom_dump_to;

	i : u64 mut;
	for(i = 0; i < irapi.prog.funcs_count; i = i + 1)
	{
		irfunc_lower_x64(irapi.prog.funcs # i);
	}
	// todo: lower irapi.prog to x64api.prog
	if(args_should_dump_asm())
	{
		if(args_has_asmdump_specific())
		{
			dump_fn ::= prog_find_function(args.asm_dump_specific.data, args.asm_dump_specific.len); 
			if(dump_fn == zero)
			{
				err_begin();
				putzstr("requested to dump-asm for function \0");
				putchar('"');
				putchars(args.asm_dump_specific.data, args.asm_dump_specific.len);
				putchar('"');
				putzstr(" but no function exists with this name\0");
				err_end();
			}
			x64func_dump(x64api.prog.funcs # dump_fn->irfunc_idx);
		}
		else
		{
			x64prog_dump(ref(x64api.prog));
		}
	}
};

// ===================================
// irfunc + irblks -> x64func lowering
// ===================================

ir_lower_prolog_x64 : func(-> v0)
{
	rbp : x64val mut;
	rbp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rbp)] = x64_reg.rbp;
	[x64val_reg_get_size(ref rbp)] = 64;
	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;
	x64_push(ref rbp);
	x64_mov(ref rbp, ref rsp);
};

ir_lower_epilog_x64 : func(-> v0)
{
};

irfunc_lower_x64 : func(fn : irfunc mut? -> v0)
{
	dummy : x64val mut;
	fnx64 ::= x64_add_func(ref dummy);
	ir_lower_prolog_x64();
	fnx64->custom_name = fn->custom_name;
	fnx64->custom_name_len = fn->custom_name_len;
	i : u64 mut;
	for(i = 0; i < fn->blks_count; i = i + 1)
	{
		irblk_lower_x64(fn, fn->blks # i);
	}
};

irblk_lower_x64 : func(fn : irfunc mut?, blk : irblk mut? -> v0)
{
	i : u64 mut;
	for(i = 0; i < blk->insts_count; i = i + 1)
	{
		irinst_lower_x64(fn, blk, blk->insts # i);
	}
	x64_ret();
};

// ==========================
// irinst -> x64inst lowering
// ==========================

irinst_lower_x64 : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	[irinst_lower_x64_tbl # (inst->tag@s64)](fn, blk, inst);
};

irinst_lower_x64_nyi : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	//warn_begin();
	//putzstr("lowering of irinst.\0");
	//putsint(inst->tag@s64);
	//putzstr(" (\0");
	//putzstr([irinst_names # (inst->tag@s64)]);
	//putzstr(") is NYI\n\0");
	//warn_end();
};

irinst_lower_x64_stack : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_stack_get_out(inst), ref outx64);
	sizex64 : x64val mut;
	irval_lower_x64(ir_stack_get_size(inst), ref sizex64);
	alignx64 : x64val mut;
	irval_lower_x64(ir_stack_get_align(inst), ref alignx64);

	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;

	// todo: care about align?
	x64_sub(ref rsp, ref sizex64);

	x64_mov(ref outx64, ref rsp);
};

irinst_lower_x64_load : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_load_get_out(inst), ref outx64);
	sz ::= irval_get_sz(ir_load_get_out(inst));

	base ::= ir_load_get_base(inst);
	disp ::= [ir_load_get_disp(inst)];

	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.vmemreg;

	mem : x64val mut;
	mem.tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	// todo: confirm that base is a ssa reg. it could be a globref
	[x64val_vmemreg_get_base_tag(ref mem)] = base->tag;
	if(base->tag == irval_tag.reg)
	{
		[x64val_vmemreg_get_base_idx(ref mem)] = [irval_reg_get_idx(base)];
		[x64val_vmemreg_get_base_sz(ref mem)] = [irval_reg_get_sz(base)];
	}
	else
	{
		if(base->tag == irval_tag.globref)
		{
			[x64val_vmemreg_get_base_idx(ref mem)] = [irval_globref_get_idx(base)];
		}
		else
		{
			// panic
		}
	}
	[x64val_vmemreg_get_index_sz(ref mem)] = irsz.none;
	[x64val_vmemreg_get_index_idx(ref mem)] = 0;
	[x64val_vmemreg_get_displacement(ref mem)] = disp;
	[x64val_vmemreg_get_sz(ref mem)] = sz;

	// todo: generic move
	x64_mov(ref outx64, ref mem);
};

irinst_lower_x64_jmp : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	locx64 : x64val mut;
	irval_lower_x64(ir_jmp_get_loc(inst), ref locx64);
	x64_jmp(ref locx64);
};

irinst_lower_x64_jmpif : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	condx64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_cond(inst), ref condx64);
	truex64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_true_loc(inst), ref truex64);
	falsex64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_false_loc(inst), ref falsex64);

	x64_test(ref condx64, ref condx64);
	x64_jnz(ref truex64);
	x64_jmp(ref falsex64);
};

irinst_lower_x64_brk : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	x64_int3();
};

irinst_lower_x64_unreach : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	x64_int3();
};

irinst_lower_x64_tbl ::= func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)[countof irinst_tag]
{
	.0 := irinst_lower_x64_stack;
	.1 := irinst_lower_x64_load;
	.2 := irinst_lower_x64_nyi;
	.3 := irinst_lower_x64_nyi;
	.4 := irinst_lower_x64_nyi;
	.5 := irinst_lower_x64_nyi;
	.6 := irinst_lower_x64_jmp;
	.7 := irinst_lower_x64_jmpif;
	.8 := irinst_lower_x64_nyi;
	.9 := irinst_lower_x64_nyi;
	.10 := irinst_lower_x64_nyi;
	.11 := irinst_lower_x64_nyi;
	.12 := irinst_lower_x64_nyi;
	.13 := irinst_lower_x64_nyi;
	.14 := irinst_lower_x64_nyi;
	.15 := irinst_lower_x64_nyi;
	.16 := irinst_lower_x64_nyi;
	.17 := irinst_lower_x64_nyi;
	.18 := irinst_lower_x64_nyi;
	.19 := irinst_lower_x64_nyi;
	.20 := irinst_lower_x64_nyi;
	.21 := irinst_lower_x64_nyi;
	.22 := irinst_lower_x64_nyi;
	.23 := irinst_lower_x64_nyi;
	.24 := irinst_lower_x64_nyi;
	.25 := irinst_lower_x64_nyi;
	.26 := irinst_lower_x64_nyi;
	.27 := irinst_lower_x64_nyi;
	.28 := irinst_lower_x64_nyi;
	.29 := irinst_lower_x64_nyi;
	.30 := irinst_lower_x64_nyi;
	.31 := irinst_lower_x64_nyi;
	.32 := irinst_lower_x64_nyi;
	.33 := irinst_lower_x64_nyi;
	.34 := irinst_lower_x64_nyi;
	.35 := irinst_lower_x64_nyi;
	.36 := irinst_lower_x64_nyi;
	.37 := irinst_lower_x64_nyi;
	.38 := irinst_lower_x64_nyi;
	.39 := irinst_lower_x64_nyi;
	.40 := irinst_lower_x64_nyi;
	.41 := irinst_lower_x64_nyi;
	.42 := irinst_lower_x64_nyi;
	.43 := irinst_lower_x64_nyi;
	.44 := irinst_lower_x64_nyi;
	.45 := irinst_lower_x64_nyi;
	.46 := irinst_lower_x64_nyi;
	.47 := irinst_lower_x64_nyi;
	.48 := irinst_lower_x64_nyi;
	.49 := irinst_lower_x64_brk;
	.50 := irinst_lower_x64_unreach;
};

// ========================
// irval -> x64val lowering
// ========================

// custom x64val begin
ir_lower_x64val_tag : enum
{
	.vreg := 0; // irval_tag.reg (but stored in an x64val)
	.vmemreg := 1; // x64val_tag.memreg, but the base/index registers are irval_tag.regs
	.irblkref := 2; // irval_tag.blkref (but stored in an x64val)
};

// x64val_dump_to handler for custom x64val tags (i.e irvals that have been converted to x64val_tag but are in some non-encodeable, intermediate state.
ir_lower_x64val_custom_dump_to : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite_colour_blue(w);
	tagbase : x64val_tag := x64val_tag.custom;
	idx ::= v->tag@s64 - tagbase@s64;
	[ir_lower_x64val_custom_dump_to_tbl # idx](w, v);
	bwrite_colour_reset(w);
};

ir_lower_x64val_custom_dump_to_tbl ::= func(w : bwriter mut?, v : x64val mut? -> v0)[countof ir_lower_x64val_tag]
{
	.0 := ir_lower_x64val_custom_dump_to_vreg;
	.1 := ir_lower_x64val_custom_dump_to_vmemreg;
	.2 := ir_lower_x64val_custom_dump_to_irblkref;
};

ir_lower_x64val_custom_dump_to_vreg : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite8(w, '%');
	bwrite_zstr(w, [irsz_names # [x64val_vreg_get_sz(v)]@s64]);
	bwrite_uint(w, [x64val_vreg_get_idx(v)]);
};

ir_lower_x64val_custom_dump_to_vmemreg : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	sz ::= [x64val_vmemreg_get_sz(v)];
	bwrite_zstr(w, [irsz_names # sz@s64]);
	bwrite_zstr(w, "ptr [\0");

	base_tag ::= [x64val_vmemreg_get_base_tag(v)];
	base_idx ::= [x64val_vmemreg_get_base_idx(v)];
	if(base_tag == irval_tag.reg)
	{
		base_sz ::= [x64val_vmemreg_get_base_sz(v)];
		// print base vreg
		bwrite8(w, '%');
		bwrite_zstr(w, [irsz_names # base_sz@s64]);
		bwrite_uint(w, base_idx);
	}
	else
	{
		// globref
		bwrite8(w, '@');
		bwrite_uint(w, base_idx);
	}

	index_sz ::= [x64val_vmemreg_get_index_sz(v)];
	index_idx ::= [x64val_vmemreg_get_index_idx(v)];
	if(index_sz != irsz.none)
	{
		if(base_tag != irval_tag.invalid)
		{
			bwrite_zstr(w, " + \0");
		}
		scale ::= [x64val_vmemreg_get_scale(v)];
		bwrite8(w, '(');
		// print index vreg
		bwrite8(w, '%');
		bwrite_zstr(w, [irsz_names # index_sz@s64]);
		bwrite_uint(w, index_idx);
		// then scale
		bwrite8(w, '*');
		bwrite_uint(w, scale);
		bwrite8(w, ')');
	}
	disp ::= [x64val_vmemreg_get_displacement(v)]@s64;
	if(disp != 0)
	{
		if((base_tag != irval_tag.invalid) || (index_sz != irsz.none))
		{
			bwrite_zstr(w, " + \0");
		}
		bwrite_zstr(w, "imm32 \0");
		bwrite_sint(w, disp);
	}
	bwrite8(w, ']');
};

ir_lower_x64val_custom_dump_to_irblkref : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite8(w, '_');
	bwrite_uint(w, [x64val_irblkref_get_idx(v)]);
};

x64val_vreg_get_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->r1)@irsz mut?;
};

x64val_vreg_get_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

x64val_vmemreg_get_base_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->r1)@irsz mut?;
};

x64val_vmemreg_get_base_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

x64val_vmemreg_get_index_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->r2)@irsz mut?;
};

x64val_vmemreg_get_index_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v2);
};

x64val_vmemreg_get_scale : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v3);
};

x64val_vmemreg_get_displacement : func(v : x64val mut? -> s32 mut?)
{
	return ref(v->v4)@s32 mut?;
};

x64val_vmemreg_get_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->v5)@irsz mut?;
};

x64val_vmemreg_get_base_tag : func(v : x64val mut? -> irval_tag mut?)
{
	return ref(v->v6)@irval_tag mut?;
};

x64val_irblkref_get_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_lower_x64 : func(v : irval mut?, out : x64val mut? -> v0)
{
	[irval_lower_x64_tbl # (v->tag@s64)](v, out);
};

irval_lower_x64_invalid : func(v : irval mut?, out : x64val mut? -> v0)
{
	panic_begin();
	putzstr("irval_lower_x64_invalid for irval_tag.\0");
	putsint(v->tag@s64);
	panic_end();
};

irval_lower_x64_imm : func(v : irval mut?, out : x64val mut? -> v0)
{
	sz ::= [irval_imm_get_sz(v)];

	out->tag = x64val_tag.imm;
	[x64val_imm_get_size(out)] = [irsz_sizes # (irval_get_sz(v)@s64)] * 8;
	if((sz == irsz.f) || (sz == irsz.g))
	{
		[x64val_imm_get_value(out)@f64 mut?] = [irval_imm_get_floating_point(v)];
	}
	else
	{
		[x64val_imm_get_value(out)] = [irval_imm_get_integer(v)]@u64;
	}
};

irval_lower_x64_reg : func(v : irval mut?, out : x64val mut? -> v0)
{
	sz ::= [irval_imm_get_sz(v)];
	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.vreg;

	out->tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	[x64val_vreg_get_sz(out)] = [irval_reg_get_sz(v)];
	[x64val_vreg_get_idx(out)] = [irval_reg_get_idx(v)];
};

irval_lower_x64_blkref : func(v : irval mut?, out : x64val mut? -> v0)
{
	blkidx ::= [irval_blkref_get_idx(v)];
	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.irblkref;

	out->tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	[x64val_irblkref_get_idx(out)] = [irval_blkref_get_idx(v)];
};

irval_lower_x64_tbl ::= func(v : irval mut?, out : x64val mut? -> v0)[countof irval_tag]
{
	.0 := irval_lower_x64_invalid;
	.1 := irval_lower_x64_imm;
	.2 := irval_lower_x64_reg;
	.3 := irval_lower_x64_invalid;
	.4 := irval_lower_x64_invalid;
	.5 := irval_lower_x64_blkref;
	.6 := irval_lower_x64_invalid;
};
