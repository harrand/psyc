// ======================
// ir -> x64 lowering top
// ======================
ir_lower_x64 : func(-> v0)
{
	// install custom handlers
	x64inst_custom_dump_to_handler = ir_lower_x64inst_custom_dump_to;
	x64val_custom_dump_to_handler = ir_lower_x64val_custom_dump_to;
	x64val_custom_equal_to_handler = ir_lower_x64val_custom_equal_to;
	x64val_custom_is_any_memory_handler = ir_lower_x64val_is_memory;
	x64val_custom_is_any_register_handler = ir_lower_x64val_is_register;
	x64val_custom_contained_registers_count_handler = ir_lower_x64val_contained_registers_count;
	x64val_custom_get_contained_register_handler = ir_lower_x64val_get_contained_register;
	x64val_custom_get_size = ir_lower_x64val_get_size;
	if(args_should_skip_asm())
	{
		return;
	}
	warn_begin();
	putzstr("ir -> x64 generation is still a work-in-progress and may fail unexpectedly. pass --skip-asm to the CLI flags to skip it\n\0");
	warn_end();

	i : u64 mut;
	if(x64api.prog.globs_count != 0)
	{
		panic_begin();
		putzstr("expected no x64globs to exist at the beginning of lowering, but \0");
		putuint(x64api.prog.globs_count);
		putzstr(" exist...\n\0");
		panic_end();
	}
	for(i = 0; i < irapi.prog.globs_count; i = i + 1)
	{
		irglob_lower_x64(irapi.prog.globs # i);
	}
	if(x64api.prog.globs_count != irapi.prog.globs_count)
	{
		panic_begin();
		putzstr("expected the number of x64globs to be equal to the number of irglobs (\0");
		putuint(irapi.prog.globs_count);
		putzstr(") but it is instead \0");
		putuint(x64api.prog.globs_count);
		putzstr("...\n\0");
		panic_end();
	}
	for(i = 0; i < irapi.prog.funcs_count; i = i + 1)
	{
		irfunc_lower_x64(irapi.prog.funcs # i);
	}
	// todo: lower irapi.prog to x64api.prog
	if(args_should_dump_asm())
	{
		if(args_has_asmdump_specific())
		{
			dump_fn ::= prog_find_function(args.asm_dump_specific.data, args.asm_dump_specific.len); 
			if(dump_fn == zero)
			{
				err_begin();
				putzstr("requested to dump-asm for function \0");
				putchar('"');
				putchars(args.asm_dump_specific.data, args.asm_dump_specific.len);
				putchar('"');
				putzstr(" but no function exists with this name\0");
				err_end();
			}
			x64func_dump(x64api.prog.funcs # dump_fn->irfunc_idx);
		}
		else
		{
			x64prog_dump(ref(x64api.prog));
		}
	}
};

// ===================================
// irfunc + irblks -> x64func lowering
// ===================================

ir_lower_prolog_x64 : func(epilog_state : ir_lower_epilog_state mut? -> v0)
{
	rbp : x64val mut;
	rbp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rbp)] = x64_reg.rbp;
	[x64val_reg_get_size(ref rbp)] = 64;
	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;
	x64_push(ref rbp);
	x64_mov(ref rbp, ref rsp);

	i : u64 mut;
	for(i = 0; i < epilog_state->regs_to_pop_count; i = i + 1)
	{
		x64_push(epilog_state->regs_to_pop # i);
	}
	
	stackamt_imm : x64val mut;
	stackamt_imm.tag = x64val_tag.imm;
	[x64val_imm_get_size(ref stackamt_imm)] = 32;
	[x64val_imm_get_value(ref stackamt_imm)] = x64_current_func()->stack;
	x64_sub(ref rsp, ref stackamt_imm);
};

ir_lower_epilog_state : struct
{
	regs_to_pop : x64val mut?;
	regs_to_pop_count : u64;
};

// add rsp, <stackamt>
ir_lower_epilog_part_1 : func(-> v0)
{
	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;
	// add the stack amt
	stackamt_imm : x64val mut;
	stackamt_imm.tag = x64val_tag.imm;
	[x64val_imm_get_size(ref stackamt_imm)] = 32;
	[x64val_imm_get_value(ref stackamt_imm)] = x64_current_func()->stack;
	x64_add(ref rsp, ref stackamt_imm);
};

// mov rsp, rbp
// pop rbp
ir_lower_epilog_part_2 : func(-> v0)
{
	rbp : x64val mut;
	rbp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rbp)] = x64_reg.rbp;
	[x64val_reg_get_size(ref rbp)] = 64;
	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;

	x64_mov(ref rsp, ref rbp);
	x64_pop(ref rbp);
};

irglob_lower_x64 : func(glob : irglob mut? -> v0)
{
	g : x64glob mut;
	if(glob->is_mut)
	{
		g.tag = x64glob_tag.mutable;
	}
	else
	{
		g.tag = x64glob_tag.readonly;
	}
	g.size = glob->data_size;
	g.init_data = glob->data;
	g.init_data_size = glob->data_size;
	g.custom_name = glob->custom_name;
	g.custom_name_len = glob->custom_name_len;
	// any irglob could have irrelocs pointing to its data (sadly we cant immediately tell which irglobs are and which arent), so we just assume that they all are subject to change
	// this is important as sometimes we need to transform immediates (that dont fit properly as an operand to a certain x64 instruction e.g imul) into global data. we want to check if a global already exists with the exact immediate data so we can re-use it... BUT if that global is not finalised (aka it could still be written to) then we better not re-use that one
	// in simpler words, this makes sure no x64globs that are spawned from irglobs are potentially re-used when transforming immediates into globs (coz an x64glob and the irglob its spawned from share the same data-span which is subject to irreloc writes)
	g.data_finalised = false;

	dummy : x64val mut;
	x64_add_glob_no_memsize(ref dummy, ref g);
};

irfunc_lower_x64 : func(fn : irfunc mut? -> v0)
{
	dummy : x64val mut;
	fnx64 ::= x64_add_func(ref dummy);
	fnx64->custom_name = fn->custom_name;
	fnx64->custom_name_len = fn->custom_name_len;
	i : u64 mut;
	for(i = 0; i < fn->blks_count; i = i + 1)
	{
		irblk_lower_x64(fn, fn->blks # i);
	}

	// set the stack amt. note: if we don't use the stack, then we dont need to bother with prolog/epilog (but we'd have to deal with the epilog in a clever way)
	x64_position_before_inst(0);
	param_reg_count : u64 mut := abi_param_registers_count_x64(abi_tag.psy64);
	if(fn->params_count < param_reg_count)
	{
		param_reg_count = fn->params_count;
	}
	for(i = 0; i < param_reg_count; i = i + 1)
	{
		cur_param_ssa_reg : irval mut;
		cur_param_ssa_reg.tag = irval_tag.reg;
		[irval_reg_get_sz(ref cur_param_ssa_reg)] = [fn->params # i];
		[irval_reg_get_idx(ref cur_param_ssa_reg)] = i;
		cur_param_ssa_reg_x64 : x64val mut;
		irval_lower_x64(ref cur_param_ssa_reg, ref cur_param_ssa_reg_x64);

		abi_param_register : x64val mut := [abi_param_registers_begin_x64(abi_tag.psy64) # i];
		[x64val_reg_get_size(ref abi_param_register)] = x64val_get_size(ref cur_param_ssa_reg_x64);
		// hint: it would be nice if the param ssa reg could be lowered to the abi param register
		x64_custom_reghint(ref cur_param_ssa_reg_x64, ref abi_param_register);
		ir_lower_x64_generic_move_no_load(ref cur_param_ssa_reg_x64, ref abi_param_register);
	}

	// do register allocation
	state : lower_x64_register_allocation_state mut := zero;
	state.abi_param_regs = abi_param_registers_begin_x64(abi_tag.psy64);
	state.abi_param_regs_count = abi_param_registers_count_x64(abi_tag.psy64);
	state.abi_hwregs = abi_general_registers_begin_x64(abi_tag.psy64);
	state.abi_hwregs_count = abi_general_registers_count_x64(abi_tag.psy64);
	state.abi_volatile_regs = abi_volatile_registers_begin_x64(abi_tag.psy64);
	state.abi_volatile_regs_count = abi_volatile_registers_count_x64(abi_tag.psy64);
	state.abi_nonvolatile_regs = abi_nonvolatile_registers_begin_x64(abi_tag.psy64);
	state.abi_nonvolatile_regs_count = abi_nonvolatile_registers_count_x64(abi_tag.psy64);
	irfunc_register_allocation_x64(ref state, fn, fnx64);
	// legalise any instructions that are still invalid (e.g double memory operand)
	irfunc_legalisation_x64(fn, fnx64);

	x64_position_before_inst(0);

	epilog_state : ir_lower_epilog_state := zero;
	irfunc_abi_caller_saved_x64(fn, fnx64, ref epilog_state);
	ir_lower_prolog_x64(ref epilog_state);
	s : s64 mut;
	for(s = (fnx64->insts_count - 1)@s64; s >= 0; s = s - 1)
	{
		inst ::= fnx64->insts # s;
		if(x64inst_is_custom(inst, ir_lower_x64inst_tag.epilog))
		{
			x64_position_before_inst(s@u64);
			// delete the .epilog custom instruction
			x64_delete_instruction();
			// do part 1 of the epilog (must happen before the pops)
			ir_lower_epilog_part_1();
			for(i = 0; i < epilog_state.regs_to_pop_count; i = i + 1)
			{
				x64_pop(epilog_state.regs_to_pop # i);
			}
			// do part 2 of the epilog (must happen after the pops)
			ir_lower_epilog_part_2();
		}
	}
};

irfunc_abi_caller_saved_x64 : func(fn : irfunc mut?, fnx64 : x64func mut?, state : ir_lower_epilog_state mut? -> v0)
{
	cur_inst_id ::= x64_get_position();
	// iterate over all instructions
	// make a list of all volatile registers that are ever written to
	nonvolatiles ::= abi_nonvolatile_registers_begin_x64(abi_tag.psy64);
	cap ::= abi_nonvolatile_registers_count_x64(abi_tag.psy64);
	count ::= ref(state->regs_to_pop_count);
	data ::= ref(state->regs_to_pop);
	[count] = 0;
	[data] = arena_alloc(scratch_arena, cap * sizeof x64val);
	i : u64 mut;
	j : u64 mut;
	k : u64 mut;
	l : u64 mut;
	m : u64 mut;

	cur : x64val mut;
	curreg : x64val mut;
	regcount : u64 mut;
	for(i = 0; i < fnx64->insts_count; i = i + 1)
	{
		inst ::= fnx64->insts # i;
		enc ::= x64enc_fetch(inst);
		if(enc != zero)
		{
			write_count ::= x64enc_writes_count(enc);
			for(j = 0; j < write_count; j = j + 1)
			{
				if(x64enc_get_write(inst, enc, j, ref cur))
				{
					regcount = x64val_contained_registers_count(ref cur);
					for(k = 0; k < regcount; k = k + 1)
					{
						x64val_get_contained_register(ref cur, ref curreg, k);
						// if curreg is a nonvolatile register, then push it to the list
						for(l = 0; l < cap; l = l + 1)
						{
							if(x64val_equal_to(ref curreg, nonvolatiles # l))
							{
								// but only if we dont already have it
								already_saved_it : bool mut := false;
								for(m = 0; m < [count]; m = m + 1)
								{
									if(x64val_equal_to([data] # m, ref curreg))
									{
										already_saved_it = true;
									}
								}
								if(already_saved_it == false)
								{
									// save it as a 64-bit version.
									[x64val_reg_get_size(ref curreg)] = 64;
									[[data] # [count]] = curreg;
									[count] = [count] + 1;
								}
							}
						}
					}
				}
			}
		}
	}
};

ir_lower_handle_double_memory_operand : func(inst : x64inst mut?, inst_id : u64 -> v0)
{
	lhs ::= inst->operands # 0;
	rhs ::= inst->operands # 1;
	if(x64val_is_any_memory(lhs) && x64val_is_any_memory(rhs))
	{
		// potential todo: instead of hardcoding to use rax as a scratch register, should we create a new ssa register, custom_scratch it and regnospill it?
		intermediate : x64val mut;
		intermediate.tag = x64val_tag.reg;
		[x64val_reg_get_reg(ref intermediate)] = x64_reg.rax;
		[x64val_reg_get_size(ref intermediate)] = x64val_get_size(rhs);
		tmp : x64val mut := [rhs];
		[rhs] = intermediate;
		// do a mov
		x64_position_before_inst(inst_id);
		ir_lower_x64_generic_move(ref intermediate, ref tmp);
	}
};

irblk_lower_x64 : func(fn : irfunc mut?, blk : irblk mut? -> v0)
{
	x64_custom_blkbegin(blk);
	//if((blk->idx > 0) && (blk->predecessors_count == 0))
	//{
		// we are not entry block but also have no predecessors
		// aka dead code
	//	warn_begin();
	//	putzstr("block _\0");
	//	putuint(blk->idx);
	//	putzstr(" appears to be dead-code at:\n\0");
	//	irfunc_dump(fn);
	//	warn_end();
	//}
	i : u64 mut;
	for(i = 0; i < blk->insts_count; i = i + 1)
	{
		irinst_lower_x64(fn, blk, blk->insts # i);
	}
};

// ================
// helper functions
// ================

ir_lower_x64val_is_vmemreg : func(v : x64val mut? -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	return (idx == ir_lower_x64val_tag.vmemreg);
};

x64val_vmemreg_get_base_vreg : func(v : x64val mut?, out : x64val mut? -> bool)
{
	if(ir_lower_x64val_is_vmemreg(v) == false)
	{
		return false;
	}
	base_idx ::= [x64val_vmemreg_get_base_idx(v)];
	base_sz ::= [x64val_vmemreg_get_base_sz(v)];
	if(base_sz == irsz.none)
	{
		return false;
	}
	tagbase : x64val_tag := x64val_tag.custom;
	idx : ir_lower_x64val_tag := ir_lower_x64val_tag.vreg;
	out->tag = (tagbase@s64 + idx@s64)@x64val_tag;
	[x64val_vreg_get_idx(out)] = base_idx;
	[x64val_vreg_get_sz(out)] = base_sz;
	return true;
};

x64val_vmemreg_set_base_vreg : func(vmemreg : x64val mut?, vreg : x64val mut? -> v0)
{
	[x64val_vmemreg_get_base_idx(vmemreg)] = [x64val_vreg_get_idx(vreg)];
	[x64val_vmemreg_get_base_sz(vmemreg)] = [x64val_vreg_get_sz(vreg)];
};

ir_lower_x64val_is_memory : func(v : x64val mut? -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	return (idx == ir_lower_x64val_tag.vmemreg) || (idx == ir_lower_x64val_tag.irblkref);
};

ir_lower_x64val_is_vmemreg : func(v : x64val mut? -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	return (idx == ir_lower_x64val_tag.vmemreg);
};

ir_lower_x64val_is_register : func(v : x64val mut? -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	return (idx == ir_lower_x64val_tag.vreg);
};

ir_lower_x64val_contained_registers_count : func(v : x64val mut? -> u64)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	if(idx == ir_lower_x64val_tag.vreg)
	{
		return 1;
	}
	if(idx == ir_lower_x64val_tag.vmemreg)
	{
		count : u64 mut := 0;
		if([x64val_vmemreg_get_base_sz(v)] != irsz.none)
		{
			count = count + 1;
		}
		return count;
	}
	// irblkref has no registers
	return 0;
};

ir_lower_x64val_get_contained_register : func(v : x64val mut?, out : x64val mut?, idx : u64 -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	tagidx : s64 weak := v->tag@s64 - tagbase@s64;
	vreg : ir_lower_x64val_tag := ir_lower_x64val_tag.vreg;
	if(tagidx == ir_lower_x64val_tag.vreg)
	{
		if(idx == 0)
		{
			[out] = [v];
			return true;
		}
		return false;
	}
	if(tagidx == ir_lower_x64val_tag.vmemreg)
	{
		count : u64 mut := 0;
		if([x64val_vmemreg_get_base_sz(v)] != irsz.none)
		{
			if(idx == count)
			{
				out->tag = (tagbase@s64 + vreg@s64)@x64val_tag;
				[x64val_vreg_get_sz(out)] = [x64val_vmemreg_get_base_sz(v)];
				[x64val_vreg_get_idx(out)] = [x64val_vmemreg_get_base_idx(v)];
				return true;
			}
			count = count + 1;
		}
		return false;
	}
	// irblkref has no registers
	return false;
};

ir_lower_x64val_get_size : func(v : x64val mut? -> u64)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx : s64 weak := v->tag@s64 - tagbase@s64;
	if(idx == ir_lower_x64val_tag.vreg)
	{
		return [irsz_sizes # [x64val_vreg_get_sz(v)]@s64] * 8;
	}
	if(idx == ir_lower_x64val_tag.vmemreg)
	{
		return [irsz_sizes # [x64val_vmemreg_get_sz(v)]@s64] * 8;
	}
	if(idx == ir_lower_x64val_tag.irblkref)
	{
		return 64;
	}
	return 0;
};

// if the src is a memory operand, a mov will occur, acting as a load
ir_lower_x64_generic_move : func(dst : x64val mut?, src : x64val mut? -> v0)
{
	// todo: movss if float, movsd if double. movups/movupd/movdqu?
	x64_mov(dst, src);
};

// if the src is a memory operand, a lea will occur
ir_lower_x64_generic_move_no_load : func(dst : x64val mut?, src : x64val mut? -> v0)
{
	// todo: movss if float, movsd if double. movups/movupd/movdqu?
	if((x64val_is_any_memory(dst) == false) && x64val_is_any_memory(src))
	{
		x64_lea(dst, src);
		return;
	}
	x64_mov(dst, src);
};

// ==========================
// irinst -> x64inst lowering
// ==========================

// custom x64inst begin
ir_lower_x64inst_tag : enum
{
	.blkbegin := 0; // meta-instruction marking the beginning of block N
	.regnospill := 1;
	.reghint:= 2; // meta-instruction recommending that param0 (an ssa-register) ought to be lowered to hardware-register param1 (but correctness doesn't require this to be the case)
	.clobber := 3; // meta-instruction to mark a hardware register as clobbered
	.scratch := 4; // meta-instruction creating a new scratch register (that did not exist in the source-ir but is a lowering artifact)
	.epilog := 5; // meta-instruction representing the exit-point of a function (will turn into a proper epilog tearing down stackframe state etc...). does *not* include the ret
};
ir_lower_x64inst_tag_named ::= u8?[countof ir_lower_x64inst_tag]
{
	.0 := "blkbegin\0";
	.1 := "regnospill\0";
	.2 := "reghint\0";
	.3 := "clobber\0";
	.4 := "scratch\0";
	.5 := "epilog\0";
};

// x64inst_dump_to handler for custom x64inst tags (i.e irinsts that have been converted to x64inst_tag but are in some non-encodeable, intermediate state.
ir_lower_x64inst_custom_dump_to : func(w : bwriter mut?, inst : x64inst mut? -> v0)
{
	bwrite_colour_green(w);
	bwrite8(w, '.');
	tagbase : x64inst_tag := x64inst_tag.custom;
	idx ::= inst->tag@s64 - tagbase@s64;
	bwrite_zstr(w, [ir_lower_x64inst_tag_named # idx]);
	bwrite_colour_reset(w);
};

x64_custom_blkbegin : func(blk : irblk mut? -> v0)
{
	blkval : x64val mut := zero;

	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.irblkref;

	blkval.tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	[x64val_irblkref_get_idx(ref blkval)] = blk->idx;
	
	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.blkbegin;
	x64_custom(tag, ref blkval, 1);
};

x64_custom_regnospill : func(ssa_reg : x64val mut? -> v0)
{
	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.regnospill;
	x64_custom(tag, ssa_reg, 1);
};

x64_custom_reghint : func(ssa_reg : x64val mut?, hw_reg : x64val mut? -> v0)
{
	if((x64val_is_any_register(ssa_reg) == false) || (x64val_is_any_register(hw_reg) == false))
	{
		return;
	}
	params : x64val mut[2];
	[params # 0] = [ssa_reg];
	[params # 1] = [hw_reg];

	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.reghint;
	x64_custom(tag, params # 0, countof typeof(params));
};

x64_custom_clobber : func(hw_reg : x64val mut? -> v0)
{
	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.clobber;
	x64_custom(tag, hw_reg, 1);
};

x64_custom_scratch : func(ssa_reg : x64val mut? -> v0)
{
	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.scratch;
	x64_custom(tag, ssa_reg, 1);
};

x64_custom_epilog : func(-> v0)
{
	tag : ir_lower_x64inst_tag := ir_lower_x64inst_tag.epilog;
	x64_custom(tag, zero, zero);
};

irinst_lower_x64 : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	[irinst_lower_x64_tbl # (inst->tag@s64)](fn, blk, inst);
};

irinst_lower_x64_nyi : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	//warn_begin();
	panic_begin();
	putzstr("lowering of irinst.\0");
	putsint(inst->tag@s64);
	putzstr(" (\0");
	putzstr([irinst_names # (inst->tag@s64)]);
	putzstr(") is NYI\n\0");
	panic_end();
	//warn_end();
};

irinst_lower_x64_stack : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_stack_get_out(inst), ref outx64);
	sizex64 : x64val mut;
	irval_lower_x64(ir_stack_get_size(inst), ref sizex64);
	alignx64 : x64val mut;
	irval_lower_x64(ir_stack_get_align(inst), ref alignx64);

	fnx64 ::= x64_current_func();
	// make sure we are aligned properly...
	align_amt ::= [x64val_imm_get_value(ref alignx64)];
	padding ::= ((-(fnx64->stack@s64)) & (align_amt@s64 - 1))@u64;
	fnx64->stack = fnx64->stack + padding;

	// make sure fnx64->stack is aligned to our desired alignment!
	stack_sz_amt ::= [x64val_imm_get_value(ref sizex64)];
	stackpos : x64val mut;
	stackpos.tag = x64val_tag.memreg;
	[x64val_memreg_get_base(ref stackpos)] = x64_reg.rbp;
	[x64val_memreg_get_base_size(ref stackpos)] = 64;
	[x64val_memreg_get_index_size(ref stackpos)] = 0;
	[x64val_memreg_get_scale(ref stackpos)] = 0;
	[x64val_memreg_get_displacement(ref stackpos)] = fnx64->stack;
	[x64val_memreg_get_displacement_size(ref stackpos)] = 32;
	// note: the size of the memreg is unknowable - its up to load/store to overwrite it.
	// however anything that doesnt load/store it will treat it as a pointer to lea
	// in which case it should be pointer-sized (64-bit)
	[x64val_memreg_get_size(ref stackpos)] = 64;
	x64_add_stack_slot(ref outx64, ref stackpos);

	fnx64->stack = fnx64->stack + stack_sz_amt;
};

irinst_lower_x64_load : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_load_get_out(inst), ref outx64);
	sz ::= irval_get_sz(ir_load_get_out(inst));
	size ::= [irsz_sizes # (sz@s64)] * 8;

	base ::= ir_load_get_base(inst);
	basex64 : x64val mut;
	irval_lower_x64(base, ref basex64);
	disp ::= [ir_load_get_disp(inst)];

	tagbase : x64val_tag := x64val_tag.custom;
	customidx_vmemreg : ir_lower_x64val_tag := ir_lower_x64val_tag.vmemreg;

	mem : x64val mut;
	if(ir_lower_x64val_is_register(ref basex64))
	{
		mem.tag = (tagbase@s64 + customidx_vmemreg@s64)@x64val_tag;
		[x64val_vmemreg_get_base_idx(ref mem)] = [irval_reg_get_idx(base)];
		[x64val_vmemreg_get_base_sz(ref mem)] = [irval_reg_get_sz(base)];
		[x64val_vmemreg_get_displacement(ref mem)] = disp;
		[x64val_vmemreg_get_sz(ref mem)] = sz;
	}
	else
	{
		if(base->tag == irval_tag.globref)
		{
			mem.tag = x64val_tag.globref;
			[x64val_globref_get_index(ref mem)] = [irval_globref_get_idx(base)];
			[x64val_globref_get_size(ref mem)] = [irsz_sizes # (sz@s64)] * 8;
			[x64val_globref_get_displacement(ref mem)] = disp;
		}
		else
		{
			if(basex64.tag == x64val_tag.memreg)
			{
				mem = basex64;
				[x64val_memreg_get_displacement(ref mem)] = [x64val_memreg_get_displacement(ref mem)] + disp@s64@u64;
				// need to set the size too! the stack slot has no idea how much of it is being loaded/stored
				[x64val_memreg_get_size(ref mem)] = x64val_get_size(ref outx64);
			}
			else
			{
				// panic
				panic_begin();
				putzstr("ir.load base param is of irval_tag.\0");
				putsint(base->tag@s64);
				putzstr(", but expected either .reg or .globref...\n\0");
				panic_end();
			}
		}
	}

	ir_lower_x64_generic_move(ref outx64, ref mem);
};

irinst_lower_x64_store : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	valuex64 : x64val mut;
	irval_lower_x64(ir_store_get_value(inst), ref valuex64);

	sz ::= irval_get_sz(ir_store_get_value(inst));
	size ::= [irsz_sizes # (sz@s64)] * 8;
	if(sz == irsz.q)
	{
		x64val_imm_try_truncate_integer(ref valuex64, 32);
	}

	base ::= ir_store_get_base(inst);
	basex64 : x64val mut;
	irval_lower_x64(base, ref basex64);
	disp ::= [ir_store_get_disp(inst)];

	tagbase : x64val_tag := x64val_tag.custom;
	customidx_vmemreg : ir_lower_x64val_tag := ir_lower_x64val_tag.vmemreg;

	mem : x64val mut;
	// check the base -> x64 lower instead of just the base as an ssa reg (because it may be a stack-slot which has been replaced by a memreg)
	if(ir_lower_x64val_is_register(ref basex64))
	{
		mem.tag = (tagbase@s64 + customidx_vmemreg@s64)@x64val_tag;
		[x64val_vmemreg_get_base_idx(ref mem)] = [irval_reg_get_idx(base)];
		[x64val_vmemreg_get_base_sz(ref mem)] = [irval_reg_get_sz(base)];
		[x64val_vmemreg_get_displacement(ref mem)] = disp;
		[x64val_vmemreg_get_sz(ref mem)] = sz;
	}
	else
	{
		if(base->tag == irval_tag.globref)
		{
			mem.tag = x64val_tag.globref;
			[x64val_globref_get_index(ref mem)] = [irval_globref_get_idx(base)];
			[x64val_globref_get_size(ref mem)] = [irsz_sizes # (sz@s64)] * 8;
			[x64val_globref_get_displacement(ref mem)] = disp;
		}
		else
		{
			if(basex64.tag == x64val_tag.memreg)
			{
				mem = basex64;
				[x64val_memreg_get_displacement(ref mem)] = [x64val_memreg_get_displacement(ref mem)] + disp@s64@u64;
				// need to set the size too! the stack slot has no idea how much of it is being loaded/stored
				[x64val_memreg_get_size(ref mem)] = size;
			}
			else
			{
				// panic
				panic_begin();
				putzstr("ir.store base param is of irval_tag.\0");
				putsint(base->tag@s64);
				putzstr(", but expected either .reg or .globref...\n\0");
				panic_end();
			}
		}
	}

	ir_lower_x64_generic_move(ref mem, ref valuex64);
};

irinst_lower_x64_ret : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	// todo: move return values to their abi-specific output register(s)
	i : u64 mut;
	count ::= ir_ret_get_vals_count(inst);
	begin ::= ir_ret_get_vals(inst);
	output_registers_begin ::= abi_output_registers_begin_x64(abi_tag.psy64);
	output_registers_count ::= abi_output_registers_count_x64(abi_tag.psy64);
	if(output_registers_count < count)
	{
		err_begin();
		putzstr("abi only supports \0");
		putuint(output_registers_count);
		putzstr(" output registers, but the following instruction attempts to use \0");
		putuint(count);
		putzstr(":\n\0");
		irinst_dump(inst);
		err_end();
	}
	for(i = 0; i < count; i = i + 1)
	{
		cur_out : x64val mut;
		irval_lower_x64(begin # i, ref cur_out);
		cur_abi_out : x64val mut := [output_registers_begin # i];
		[x64val_reg_get_size(ref cur_abi_out)] = x64val_get_size(ref cur_out);
		ir_lower_x64_generic_move_no_load(ref cur_abi_out, ref cur_out);
	}
	x64_custom_epilog();
	//ir_lower_epilog_x64();
	x64_ret();
};

irinst_lower_x64_jmp : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	locx64 : x64val mut;
	irval_lower_x64(ir_jmp_get_loc(inst), ref locx64);
	x64_jmp(ref locx64);
};

irinst_lower_x64_jmpif : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	// jmpif conditions cannot be immediate (it would've been folded into a normal jmp)
	condx64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_cond(inst), ref condx64);
	truex64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_true_loc(inst), ref truex64);
	falsex64 : x64val mut;
	irval_lower_x64(ir_jmpif_get_false_loc(inst), ref falsex64);

	// so test with the cond twice should always be safe?
	x64_test(ref condx64, ref condx64);
	x64_jnz(ref truex64);
	x64_jmp(ref falsex64);
};

irinst_lower_x64_zex : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	in ::= ir_zex_get_operand(inst);
	inx64 : x64val mut;
	irval_lower_x64(in, ref inx64);

	out : irval mut := [ir_zex_get_out(inst)];
	outx64 : x64val mut;
	
	// if in is irsz.d then we use mov but to the 32-bit version of out
	// in all other cases, movzx
	if(irval_get_sz(in) == irsz.d)
	{
		if(irval_try_set_sz(ref out, irsz.d) == false)
		{
			panic_begin();
			putzstr("when lowering instruction:\n\0");
			irinst_dump(inst);
			putzstr(", failed to set operand '\0");
			irval_dump(ref out);
			putzstr("' to be 32-bit\0");
			panic_end();
		}
		irval_lower_x64(ref out, ref outx64);
		x64_mov(ref outx64, ref inx64);
	}
	else
	{
		irval_lower_x64(ref out, ref outx64);
		x64_movzx(ref outx64, ref inx64);
	}
};

irinst_lower_x64_sex : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	inx64 : x64val mut;
	irval_lower_x64(ir_sex_get_operand(inst), ref inx64);
	outx64 : x64val mut;
	irval_lower_x64(ir_sex_get_out(inst), ref outx64);
	
	x64_movsx(ref outx64, ref inx64);
};

irinst_lower_x64_trunc : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	// literally just change the size of the input to the size of the output and do a generic move
	in : irval mut := [ir_trunc_get_operand(inst)];
	out ::= ir_trunc_get_out(inst);
	outsz ::= irval_get_sz(out);
	if(irval_try_set_sz(ref in, outsz) == false)
	{
		panic_begin();
		putzstr("when lowering instruction:\n\0");
		irinst_dump(inst);
		putzstr(", failed to set operand '\0");
		irval_dump(ref in);
		putzstr("' to be irsz.\0");
		putsint(outsz@s64);
		panic_end();
	}
	inx64 : x64val mut;
	irval_lower_x64(ref in, ref inx64);
	outx64 : x64val mut;
	irval_lower_x64(out, ref outx64);
	
	ir_lower_x64_generic_move_no_load(ref outx64, ref inx64);
};

irinst_lower_x64_cvtf : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	warn_begin();
	putzstr("lowering of ctvf is NYI, skipping:\n\0");
	irinst_dump(inst);
	putchar('\n');
	warn_end();
};

irinst_lower_x64_cvti : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	warn_begin();
	putzstr("lowering of ctvi is NYI, skipping:\n\0");
	irinst_dump(inst);
	putchar('\n');
	warn_end();
};

irinst_lower_x64_add : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_add_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_add_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_add_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64_add(ref outx64, ref rhsx64);
};

irinst_lower_x64_sub : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_sub_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_sub_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_sub_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64_sub(ref outx64, ref rhsx64);
};

irinst_lower_x64_umul : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_umul_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_umul_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_umul_get_rhs(inst), ref rhsx64);

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64val_imm_try_match_integer(ref rhsx64, x64val_get_size(ref lhsx64));
	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_imul(ref outx64, ref rhsx64);
};

irinst_lower_x64_smul : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_smul_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_smul_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_smul_get_rhs(inst), ref rhsx64);

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64val_imm_try_match_integer(ref rhsx64, x64val_get_size(ref lhsx64));
	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_imul(ref outx64, ref rhsx64);
};

irinst_lower_x64_sdiv : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_sdiv_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_sdiv_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_sdiv_get_rhs(inst), ref rhsx64);
	
	rax_sized : x64val mut;
	rax_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rax_sized)] = x64_reg.rax;
	[x64val_reg_get_size(ref rax_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref rax_sized, ref lhsx64);

	// sign-extend rax to rdx
	lhs_sz ::= x64val_get_size(ref lhsx64);
	if(lhs_sz == 64)
	{
		x64_cqo();
	}
	if(lhs_sz == 32)
	{
		x64_cdq();
	}
	if(lhs_sz == 16)
	{
		x64_cwd();
	}
	if(lhs_sz == 8)
	{
		x64_cbw();
	}

	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_idiv(ref rhsx64);
	ir_lower_x64_generic_move_no_load(ref outx64, ref rax_sized);
};

irinst_lower_x64_udiv : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_udiv_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_udiv_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_udiv_get_rhs(inst), ref rhsx64);

	// rdx is the top-half of the numerator
	// and because we only support 64-bit numerators it must always be zero'd
	rdx_sized : x64val mut;
	rdx_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rdx_sized)] = x64_reg.rdx;
	[x64val_reg_get_size(ref rdx_sized)] = x64val_get_size(ref lhsx64);
	x64_xor(ref rdx_sized, ref rdx_sized);

	rax_sized : x64val mut;
	rax_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rax_sized)] = x64_reg.rax;
	[x64val_reg_get_size(ref rax_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref rax_sized, ref lhsx64);

	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_div(ref rhsx64);
	ir_lower_x64_generic_move_no_load(ref outx64, ref rax_sized);
};

irinst_lower_x64_smod : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_smod_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_smod_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_smod_get_rhs(inst), ref rhsx64);
	
	rax_sized : x64val mut;
	rax_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rax_sized)] = x64_reg.rax;
	[x64val_reg_get_size(ref rax_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref rax_sized, ref lhsx64);

	// sign-extend rax to rdx
	lhs_sz ::= x64val_get_size(ref lhsx64);
	if(lhs_sz == 64)
	{
		x64_cqo();
	}
	if(lhs_sz == 32)
	{
		x64_cdq();
	}
	if(lhs_sz == 16)
	{
		x64_cwd();
	}
	if(lhs_sz == 8)
	{
		x64_cbw();
	}

	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_idiv(ref rhsx64);

	rdx_sized : x64val mut;
	rdx_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rdx_sized)] = x64_reg.rdx;
	[x64val_reg_get_size(ref rdx_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref outx64, ref rdx_sized);
};

irinst_lower_x64_umod : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_umod_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_umod_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_umod_get_rhs(inst), ref rhsx64);

	// rdx is the top-half of the numerator
	// and because we only support 64-bit numerators it must always be zero'd
	rdx_sized : x64val mut;
	rdx_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rdx_sized)] = x64_reg.rdx;
	[x64val_reg_get_size(ref rdx_sized)] = x64val_get_size(ref lhsx64);
	x64_xor(ref rdx_sized, ref rdx_sized);

	rax_sized : x64val mut;
	rax_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rax_sized)] = x64_reg.rax;
	[x64val_reg_get_size(ref rax_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref rax_sized, ref lhsx64);

	x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	x64_div(ref rhsx64);

	rdx_sized : x64val mut;
	rdx_sized.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rdx_sized)] = x64_reg.rdx;
	[x64val_reg_get_size(ref rdx_sized)] = x64val_get_size(ref lhsx64);
	ir_lower_x64_generic_move_no_load(ref outx64, ref rdx_sized);
};

irinst_lower_x64_xor : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_xor_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_xor_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_xor_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}
	// if it fits in a 32-bit immediate but doesnt fit in a lhs-sized-immediate, then the immediate is simply too large and would overflow
	if(x64val_imm_try_truncate_integer(ref rhsx64, x64val_get_size(ref lhsx64)) == false)
	{
		panic_begin();
		putzstr("failed to lower:\n\0");
		irinst_dump(inst);
		putzstr("\nbecause the rhs-immediate-value in the rhs does not fit in \0");
		putuint(x64val_get_size(ref lhsx64));
		putzstr("-bits (the size of the lhs)\0");
		panic_end();
	}

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64_xor(ref outx64, ref rhsx64);
};

irinst_lower_x64_or : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
