	// if it fits in a 32-bit immediate but doesnt fit in a lhs-sized-immediate, then the immediate is simply too large and would overflow
	if(x64val_imm_try_truncate_integer(ref rhsx64, x64val_get_size(ref lhsx64)) == false)
