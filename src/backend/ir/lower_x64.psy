ir_lower_x64 : func(-> v0)
{
	i : u64 mut;
	for(i = 0; i < irapi.prog.funcs_count; i = i + 1)
	{
		irfunc_lower_x64(irapi.prog.funcs # i);
	}
	// todo: lower irapi.prog to x64api.prog
	if(args_should_dump_asm())
	{
		if(args_has_asmdump_specific())
		{
			dump_fn ::= prog_find_function(args.asm_dump_specific.data, args.asm_dump_specific.len); 
			if(dump_fn == zero)
			{
				err_begin();
				putzstr("requested to dump-asm for function \0");
				putchar('"');
				putchars(args.asm_dump_specific.data, args.asm_dump_specific.len);
				putchar('"');
				putzstr(" but no function exists with this name\0");
				err_end();
			}
			x64func_dump(x64api.prog.funcs # dump_fn->irfunc_idx);
		}
		else
		{
			x64prog_dump(ref(x64api.prog));
		}
	}
};

ir_lower_prolog_x64 : func(-> v0)
{
	rbp : x64val mut;
	rbp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rbp)] = x64_reg.rbp;
	[x64val_reg_get_size(ref rbp)] = 64;
	rsp : x64val mut;
	rsp.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref rsp)] = x64_reg.rsp;
	[x64val_reg_get_size(ref rsp)] = 64;
	x64_push(ref rbp);
	x64_mov(ref rbp, ref rsp);
};

ir_lower_epilog_x64 : func(-> v0)
{
};

irfunc_lower_x64 : func(fn : irfunc mut? -> v0)
{
	dummy : x64val mut;
	fnx64 ::= x64_add_func(ref dummy);
	ir_lower_prolog_x64();
	fnx64->custom_name = fn->custom_name;
	fnx64->custom_name_len = fn->custom_name_len;
	i : u64 mut;
	for(i = 0; i < fn->blks_count; i = i + 1)
	{
		irblk_lower_x64(fn, fn->blks # i);
	}
};

irblk_lower_x64 : func(fn : irfunc mut?, blk : irblk mut? -> v0)
{
	i : u64 mut;
	for(i = 0; i < blk->insts_count; i = i + 1)
	{
		irinst_lower_x64(fn, blk, blk->insts # i);
	}
	x64_ret();
};

irinst_lower_x64 : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	[irinst_lower_x64_tbl # (inst->tag@s64)](fn, blk, inst);
};

irinst_lower_x64_nyi : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	warn_begin();
	putzstr("lowering of irinst.\0");
	putsint(inst->tag@s64);
	putzstr(" (\0");
	putzstr([irinst_names # (inst->tag@s64)]);
	putzstr(") is NYI\n\0");
	warn_end();
};

irinst_lower_x64_tbl ::= func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)[countof irinst_tag]
{
	.0 := irinst_lower_x64_nyi;
	.1 := irinst_lower_x64_nyi;
	.2 := irinst_lower_x64_nyi;
	.3 := irinst_lower_x64_nyi;
