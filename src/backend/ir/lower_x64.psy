irinst_lower_x64_call : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	ir_callee ::= ir_call_get_callee(inst);
	if(ir_callee->tag == irval_tag.asmref)
	{
		irinst_lower_x64_asmcall(fn, blk, inst);
		return;
	}

	abi_begin ::= abi_param_registers_begin_x64(abi_tag.psy64);
	abi_count ::= abi_param_registers_count_x64(abi_tag.psy64);
	abi_retbegin ::= abi_output_registers_begin_x64(abi_tag.psy64);
	abi_retcount ::= abi_output_registers_count_x64(abi_tag.psy64);

	callcount ::= ir_call_get_params_count(inst)@u64;
	callbegin ::= ir_call_get_params(inst);
	if(callcount > abi_count)
	{
		panic_begin();
		putzstr("too many parameters in ir_call (abi specifies a maximum of \0");
		putuint(abi_count);
		putzstr(", but \0");
		putuint(callcount);
		putzstr(" were passed:\n\0");
		irinst_dump(inst);
		panic_end();
	}

	callee : x64val mut;
	irval_lower_x64(ir_callee, ref callee);
	i : u64 mut;
	for(i = 0; i < callcount; i = i + 1)
	{
		// resize abi_begin # i to be cur_param_sz to prevent e.g 'mov rbx, imm8 1', instead want 'mov bl, imm8 1'
		cur_abi_param : x64val mut := [abi_begin # i];
		cur_param : x64val mut;
		irval_lower_x64(callbegin # i, ref cur_param);
		[x64val_reg_get_size(ref cur_abi_param)] = x64val_get_size(ref cur_param);
		// hint: it would be nice if the param ssa reg could be lowered to the abi param register
		x64_custom_reghint(ref cur_param, ref cur_abi_param);
		ir_lower_x64_generic_move_no_load(ref cur_abi_param, ref cur_param);
	}
	x64_call(ref callee);

	retbegin ::= ir_call_get_returns(inst);
	retcount ::= ir_call_get_returns_count(inst)@u64;

	if(retcount > abi_retcount)
	{
		panic_begin();
		putzstr("too many returns in ir_call (abi specifies a maximum of \0");
		putuint(abi_retcount);
		putzstr(", but \0");
		putuint(retcount);
		putzstr(" were passed:\n\0");
		irinst_dump(inst);
		panic_end();
	}

	for(i = 0; i < retcount; i = i + 1)
	{
		cur_abi_ret : x64val mut := [abi_retbegin # i];
		cur_ret : x64val mut;
		irval_lower_x64(retbegin # i, ref cur_ret);
		[x64val_reg_get_size(ref cur_abi_ret)] = x64val_get_size(ref cur_ret);
		// hint: it would be nice if the output ssa reg could be lowered to the abi return register
		x64_custom_reghint(ref cur_ret, ref cur_abi_ret);
		ir_lower_x64_generic_move_no_load(ref cur_ret, ref cur_abi_ret);
	}
};

irinst_lower_x64_asmcall : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	asmref ::= ir_call_get_callee(inst);
	as ::= irapi.prog.asms # [irval_asmref_get_idx(asmref)];
	constraints : x64_constraints_data mut := zero;
	x64_parse_constraints(as->constraint, as->constraint_len, ref constraints);
	params_count ::= ir_call_get_params_count(inst)@u64;
	params_begin ::= ir_call_get_params(inst);

	paramsx64 : x64val mut? := arena_alloc(scratch_arena, params_count * sizeof x64val);
	i : u64 mut;
	for(i = 0; i < params_count; i = i + 1)
	{
		// move the param values to the input registers as requested by the constraint string
		// depending on lowering we could actually want to end up doing this in a different order. todo: emit a custom begin/end instruction to tell the legaliser to re-order these sensibly
		irval_lower_x64(params_begin # i, paramsx64 # i);
		ir_lower_x64_generic_move_no_load(constraints.inputs # i, paramsx64 # i);
	}
	x64_parse_asm(as->code, as->code_len, paramsx64 # 0, params_count);
	for(i = 0; i < constraints.clobbers_count; i = i + 1)
	{
		if(x64val_is_valid(constraints.clobbers # i))
		{
			x64_custom_clobber(constraints.clobbers # i);
		}
	}

	returns_count ::= ir_call_get_returns_count(inst)@u64;
	returns_begin ::= ir_call_get_returns(inst);
	for(i = 0; i < returns_count; i = i + 1)
	{
		cur_return : x64val mut;
		irval_lower_x64(returns_begin # i, ref cur_return);
		ir_lower_x64_generic_move_no_load(ref cur_return, constraints.outputs # i);
	}
};

irinst_lower_x64_brk : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	x64_int3();
};

irinst_lower_x64_unreach : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	x64_int3();
};

irinst_lower_x64_tbl ::= func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)[countof irinst_tag]
{
	.0 := irinst_lower_x64_stack;
	.1 := irinst_lower_x64_load;
	.2 := irinst_lower_x64_nyi;
	.3 := irinst_lower_x64_store;
	.4 := irinst_lower_x64_nyi;
	.5 := irinst_lower_x64_ret;
	.6 := irinst_lower_x64_jmp;
	.7 := irinst_lower_x64_jmpif;
	.8 := irinst_lower_x64_zex;
	.9 := irinst_lower_x64_sex;
	.10 := irinst_lower_x64_trunc;
	.11 := irinst_lower_x64_cvtf;
	.12 := irinst_lower_x64_cvti;
	.13 := irinst_lower_x64_add;
	.14 := irinst_lower_x64_sub;
	.15 := irinst_lower_x64_umul;
	.16 := irinst_lower_x64_smul;
	.17 := irinst_lower_x64_udiv;
	.18 := irinst_lower_x64_sdiv;
	.19 := irinst_lower_x64_smod;
	.20 := irinst_lower_x64_umod;
	.21 := irinst_lower_x64_nyi;
	.22 := irinst_lower_x64_nyi;
	.23 := irinst_lower_x64_nyi;
	.24 := irinst_lower_x64_nyi;
	.25 := irinst_lower_x64_nyi;
	.26 := irinst_lower_x64_xor;
	.27 := irinst_lower_x64_or;
	.28 := irinst_lower_x64_and;
	.29 := irinst_lower_x64_shl;
	.30 := irinst_lower_x64_ushr;
	.31 := irinst_lower_x64_sshr;
	.32 := irinst_lower_x64_not;
	.33 := irinst_lower_x64_neg;
	.34 := irinst_lower_x64_cmp_eq;
	.35 := irinst_lower_x64_cmp_ne;
	.36 := irinst_lower_x64_cmp_slt;
	.37 := irinst_lower_x64_cmp_sle;
	.38 := irinst_lower_x64_cmp_sgt;
	.39 := irinst_lower_x64_cmp_sge;
	.40 := irinst_lower_x64_cmp_ult;
	.41 := irinst_lower_x64_cmp_ule;
	.42 := irinst_lower_x64_cmp_ugt;
	.43 := irinst_lower_x64_cmp_uge;
	.44 := irinst_lower_x64_nyi;
	.45 := irinst_lower_x64_nyi;
	.46 := irinst_lower_x64_nyi;
	.47 := irinst_lower_x64_nyi;
	.48 := irinst_lower_x64_call;
	.49 := irinst_lower_x64_brk;
	.50 := irinst_lower_x64_unreach;
};

// ========================
// irval -> x64val lowering
// ========================

// custom x64val begin
ir_lower_x64val_tag : enum
{
	.vreg := 0; // irval_tag.reg (but stored in an x64val)
	.vmemreg := 1; // x64val_tag.memreg, but the base/index registers are optional irval_tag.regs
	.irblkref := 2; // irval_tag.blkref (but stored in an x64val)
};

// x64val_dump_to handler for custom x64val tags (i.e irvals that have been converted to x64val_tag but are in some non-encodeable, intermediate state.
ir_lower_x64val_custom_dump_to : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite_colour_blue(w);
	tagbase : x64val_tag := x64val_tag.custom;
	idx ::= v->tag@s64 - tagbase@s64;
	[ir_lower_x64val_custom_dump_to_tbl # idx](w, v);
	bwrite_colour_reset(w);
};

ir_lower_x64val_custom_equal_to : func(lhs : x64val mut?, rhs : x64val mut? -> bool)
{
	tagbase : x64val_tag := x64val_tag.custom;
	idx ::= (lhs->tag@s64 - tagbase@s64)@ir_lower_x64val_tag;
	if(idx == ir_lower_x64val_tag.vreg)
	{
		return [x64val_vreg_get_idx(lhs)] == [x64val_vreg_get_idx(rhs)];
	}
	if(idx == ir_lower_x64val_tag.vmemreg)
	{
		return ([x64val_vmemreg_get_base_sz(lhs)] == [x64val_vmemreg_get_base_sz(rhs)])
			&& ([x64val_vmemreg_get_base_idx(lhs)] == [x64val_vmemreg_get_base_idx(rhs)])
			&& ([x64val_vmemreg_get_displacement(lhs)] == [x64val_vmemreg_get_displacement(rhs)])
			&& ([x64val_vmemreg_get_sz(lhs)] == [x64val_vmemreg_get_sz(rhs)]);
	}
	if(idx == ir_lower_x64val_tag.irblkref)
	{
		return [x64val_irblkref_get_idx(lhs)] == [x64val_irblkref_get_idx(rhs)];
	}
	return false;
};

ir_lower_x64val_custom_dump_to_tbl ::= func(w : bwriter mut?, v : x64val mut? -> v0)[countof ir_lower_x64val_tag]
{
	.0 := ir_lower_x64val_custom_dump_to_vreg;
	.1 := ir_lower_x64val_custom_dump_to_vmemreg;
	.2 := ir_lower_x64val_custom_dump_to_irblkref;
};

ir_lower_x64val_custom_dump_to_vreg : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite8(w, '%');
	bwrite_zstr(w, [irsz_names # [x64val_vreg_get_sz(v)]@s64]);
	bwrite_uint(w, [x64val_vreg_get_idx(v)]);
};

ir_lower_x64val_custom_dump_to_vmemreg : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	sz ::= [x64val_vmemreg_get_sz(v)];
	bwrite_zstr(w, [irsz_names # sz@s64]);
	bwrite_zstr(w, "ptr [\0");

	base_sz ::= [x64val_vmemreg_get_base_sz(v)];
	base_idx ::= [x64val_vmemreg_get_base_idx(v)];
	if(base_sz != irsz.none)
	{
		// print base vreg
		bwrite8(w, '%');
		bwrite_zstr(w, [irsz_names # base_sz@s64]);
		bwrite_uint(w, base_idx);
	}

	disp ::= [x64val_vmemreg_get_displacement(v)]@s64;
	if(disp != 0)
	{
		if((base_sz != irsz.none))
		{
			bwrite_zstr(w, " + \0");
		}
		bwrite_zstr(w, "imm32 \0");
		bwrite_sint(w, disp);
	}
	bwrite8(w, ']');
};

ir_lower_x64val_custom_dump_to_irblkref : func(w : bwriter mut?, v : x64val mut? -> v0)
{
	bwrite8(w, '_');
	bwrite_uint(w, [x64val_irblkref_get_idx(v)]);
};

x64val_vreg_get_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->r1)@irsz mut?;
};

x64val_vreg_get_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

x64val_vmemreg_get_base_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->r1)@irsz mut?;
};

x64val_vmemreg_get_base_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

x64val_vmemreg_get_displacement : func(v : x64val mut? -> s32 mut?)
{
	return ref(v->v4)@s32 mut?;
};

x64val_vmemreg_get_sz : func(v : x64val mut? -> irsz mut?)
{
	return ref(v->v5)@irsz mut?;
};

x64val_irblkref_get_idx : func(v : x64val mut? -> u64 mut?)
{
	return ref(v->v1);
};

irval_lower_check_stack_slots : func(v : x64val mut? -> v0)
{
	// first check for stack_slots
	// if a vreg is a stack-slot (i.e it was the output of ir_stack) then replace any occurrences of it with the stack-slot
	// we dont have to check for vmemregs here because stack slots would've been loaded/stored to
	fnx64 ::= x64_current_func();
	i : u64 mut;
	for(i = 0; i < fnx64->stack_slot_count; i = i + 1)
	{
		if(x64val_equal_to(v, fnx64->stack_slot_froms # i))
		{
			[v] = [fnx64->stack_slot_tos # i];
			return;
		}
	}
};

irval_lower_x64 : func(v : irval mut?, out : x64val mut? -> v0)
{
	[irval_lower_x64_tbl # (v->tag@s64)](v, out);
	irval_lower_check_stack_slots(out);
};

irval_lower_x64_invalid : func(v : irval mut?, out : x64val mut? -> v0)
{
	panic_begin();
	putzstr("irval_lower_x64_invalid for irval_tag.\0");
	putsint(v->tag@s64);
	panic_end();
};

irval_lower_x64_imm : func(v : irval mut?, out : x64val mut? -> v0)
{
	sz ::= [irval_imm_get_sz(v)];

	out->tag = x64val_tag.imm;
	[x64val_imm_get_size(out)] = [irsz_sizes # (irval_get_sz(v)@s64)] * 8;
	if((sz == irsz.f) || (sz == irsz.g))
	{
		[x64val_imm_get_value(out)@f64 mut?] = [irval_imm_get_floating_point(v)];
	}
	else
	{
		[x64val_imm_get_value(out)] = [irval_imm_get_integer(v)]@u64;
	}
};

irval_lower_x64_reg : func(v : irval mut?, out : x64val mut? -> v0)
{
	sz ::= [irval_imm_get_sz(v)];
	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.vreg;

	out->tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	[x64val_vreg_get_sz(out)] = [irval_reg_get_sz(v)];
	[x64val_vreg_get_idx(out)] = [irval_reg_get_idx(v)];
};

irval_lower_x64_globref : func(v : irval mut?, out : x64val mut? -> v0)
{
	// if we see lower a globref individually as a value (and isnt special-cased by some instruction lowering handle), then we treat it as a pointer-to-the-start-of-the-globdata.
	// i.e irsz.q and no displacement
	out->tag = x64val_tag.globref;
	[x64val_globref_get_index(out)] = [irval_globref_get_idx(v)];
	[x64val_globref_get_displacement(out)] = 0;
	[x64val_globref_get_size(out)] = 64;
};

irval_lower_x64_fnref : func(v : irval mut?, out : x64val mut? -> v0)
{
	out->tag = x64val_tag.fnref;
	[x64val_fnref_get_index(out)] = [irval_fnref_get_idx(v)];
};

irval_lower_x64_blkref : func(v : irval mut?, out : x64val mut? -> v0)
{
	blkidx ::= [irval_blkref_get_idx(v)];
	tagbase : x64val_tag := x64val_tag.custom;
	customidx : ir_lower_x64val_tag := ir_lower_x64val_tag.irblkref;

	out->tag = (tagbase@s64 + customidx@s64)@x64val_tag;
	[x64val_irblkref_get_idx(out)] = [irval_blkref_get_idx(v)];
};

irval_lower_x64_tbl ::= func(v : irval mut?, out : x64val mut? -> v0)[countof irval_tag]
{
	.0 := irval_lower_x64_invalid;
	.1 := irval_lower_x64_imm;
	.2 := irval_lower_x64_reg;
	.3 := irval_lower_x64_globref;
	.4 := irval_lower_x64_fnref;
	.5 := irval_lower_x64_blkref;
	.6 := irval_lower_x64_invalid;
};
