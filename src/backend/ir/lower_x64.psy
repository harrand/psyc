	lhsx64 : x64val mut;
	irval_lower_x64(ir_or_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_or_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64_or(ref outx64, ref rhsx64);
};

irinst_lower_x64_and : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_and_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_and_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_and_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}

	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
	x64_and(ref outx64, ref rhsx64);
};

irinst_lower_x64_shl : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_shl_get_out(inst), ref outx64);
	lhs ::= ir_shl_get_lhs(inst);
	lhsx64 : x64val mut;
	irval_lower_x64(lhs, ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_shl_get_rhs(inst), ref rhsx64);

	// if lhs is an immediate then it needs to turn into a scratch register
	if(lhsx64.tag == x64val_tag.imm)
	{
		scratch : irval mut;
		ir_new_scratch_reg_of(fn, irval_get_sz(lhs), ref scratch);
		scratchx64 : x64val mut;
		irval_lower_x64(ref scratch, ref scratchx64);
		x64_custom_scratch(ref scratchx64);
		ir_lower_x64_generic_move_no_load(ref scratchx64, ref lhsx64);
		lhsx64 = scratchx64;
	}

	cl : x64val mut;
	cl.tag = x64val_tag.reg;
	[x64val_reg_get_reg(ref cl)] = x64_reg.rcx;
	[x64val_reg_get_size(ref cl)] = 8;

	needs_mov_to_cl : bool mut := rhsx64.tag != x64val_tag.imm;
	if(x64val_imm_try_truncate_integer(ref rhsx64, 8) == false)
	{
		// immediate that doesnt fit sadly...
		needs_mov_to_cl = true;
	}
	if(needs_mov_to_cl)
	{
		// note: always 8-bit so if rhsx64 is not infact 8-bit it gets auto-truncated
		if(x64val_get_size(ref rhsx64) != 8)
		{
			warn_begin();
			putzstr("rhs operand of the following instruction will be implicitly trunc'd to 8-bit:\n\0");
			irinst_dump(inst);
			warn_end();
		}
		rhscpy : irval mut := [ir_shl_get_rhs(inst)];
		if(irval_try_set_sz(ref rhscpy, irsz.b) == false)
		{
			panic_begin();
			putzstr("rhs operand of the following instruction could not be implicitly trunc'd to 8-bit:\n\0");
			irinst_dump(inst);
			panic_end();
		}
		irval_lower_x64(ref rhscpy, ref rhsx64);
		ir_lower_x64_generic_move_no_load(ref cl, ref rhsx64);
		rhsx64 = cl;
	}

	x64_shl(ref lhsx64, ref rhsx64);
	ir_lower_x64_generic_move_no_load(ref outx64, ref lhsx64);
};

irinst_lower_x64_cmp_slt : func(fn : irfunc mut?, blk : irblk mut?, inst : irinst mut? -> v0)
{
	outx64 : x64val mut;
	irval_lower_x64(ir_cmp_slt_get_out(inst), ref outx64);
	lhsx64 : x64val mut;
	irval_lower_x64(ir_cmp_slt_get_lhs(inst), ref lhsx64);
	rhsx64 : x64val mut;
	irval_lower_x64(ir_cmp_slt_get_rhs(inst), ref rhsx64);

	if(x64val_imm_try_truncate_integer(ref rhsx64, 32) == false)
	{
		x64val_imm_as_globref(ref rhsx64, ref rhsx64);
	}

	x64_cmp(ref lhsx64, ref rhsx64);
	x64_setl(ref outx64);
};

