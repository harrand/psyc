irasm : struct
{
	idx : u64;
	params : irsz mut?;
	params_count : u64;
	
	ret : irsz;
	constraints : assembly_constraint mut?;
	constraints_len : u64;
	return_constraints : assembly_constraint mut?;
	return_constraints_len : u64;
	code : u8 mut?;
	code_len : u64;

	custom_name : u8?;
	custom_name_len : u64;
};
