irreloc_tag : enum
{
	.fn := 0;
	.glob := 1;
};

irreloc : struct
{
	tag : irreloc_tag;
	idx : u64;
	data_offset : u64;
};

irreloc_list : struct
{
	data : irreloc mut?;
	count : u64;
	cap : u64;
};

irreloc_list_empty : func(list : irreloc_list mut? -> v0)
{
	list->data = zero;
	list->count = 0;
	list->cap = 0;
};

irreloc_list_append : func(list : irreloc_list mut?, reloc : irreloc mut? -> v0)
{
	if(list->data == zero)
	{
		list->cap = 8;
		list->data = arena_alloc(global_arena, list->cap * sizeof typeof([list->data]));
	}
	while(list->count >= list->cap)
	{
		old ::= list->data;
		oldcap ::= list->cap;
		list->cap = list->cap * 2;
		list->data = arena_alloc(global_arena, list->cap * sizeof typeof([list->data]));
		memcopy(list->data, old, oldcap * sizeof typeof([list->data]));
	}
	[list->data # list->count] = [reloc];
	list->count = list->count + 1;
};
