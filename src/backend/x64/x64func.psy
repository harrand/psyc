x64func : struct
{
	insts : x64inst mut?;
	insts_count : u64;
	insts_cap : u64;

	// implementation detail. represents some byte offset in an encoder where the code within this function starts
	stack : u64;
	enc_byte_offset_begin : u64;
	idx : u64;
	custom_name : u8?;
	custom_name_len : u64;

	replace_froms : x64val mut?;
	replace_tos : x64val mut?;
	replace_count : u64;
	replace_cap : u64;
};

x64func_add_replacement : func(fn : x64func mut?, from : x64val mut?, to : x64val mut? -> v0)
{
	if((fn->replace_froms == zero) || (fn->replace_tos == zero))
	{
		fn->replace_cap = 8;
		fn->replace_froms = arena_alloc(global_arena, fn->replace_cap * sizeof typeof([fn->replace_froms]));
		fn->replace_tos = arena_alloc(global_arena, fn->replace_cap * sizeof typeof([fn->replace_tos]));
	}
	while(fn->replace_count >= fn->replace_cap)
	{
		old_froms ::= fn->replace_froms;
		old_tos ::= fn->replace_tos;
		oldcap ::= fn->replace_cap;
		fn->replace_cap = fn->replace_cap * 2;
		fn->replace_froms = arena_alloc(global_arena, fn->replace_cap * sizeof typeof([fn->replace_froms]));
		memcopy(fn->replace_froms, old_froms, fn->replace_cap * sizeof typeof([fn->replace_froms]));
		fn->replace_tos = arena_alloc(global_arena, fn->replace_cap * sizeof typeof([fn->replace_tos]));
		memcopy(fn->replace_tos, old_tos, fn->replace_cap * sizeof typeof([fn->replace_tos]));
	}
	[fn->replace_froms # fn->replace_count] = [from];
	[fn->replace_tos # fn->replace_count] = [to];
	fn->replace_count = fn->replace_count + 1;
};

x64func_add_inst_at : func(fn : x64func mut?, inst : x64inst mut?, idx : u64 -> v0)
{
	if(fn->insts == zero)
	{
		fn->insts_cap = 8;
		fn->insts = arena_alloc(global_arena, fn->insts_cap * sizeof x64inst);
	}
	while(fn->insts_count >= fn->insts_cap)
	{
		oldcap ::= fn->insts_cap;
		old ::= fn->insts;
		fn->insts_cap = (fn->insts_cap * 2);
		fn->insts = arena_alloc(global_arena, fn->insts_cap * sizeof x64inst);
		memcopy(fn->insts, old, oldcap * sizeof x64inst);
	}
	if(idx < fn->insts_count)
	{
		// move all insts right by one otherwise we will overwrite
		cpysrc ::= fn->insts # idx;
		memcopy_backwards(cpysrc # 1, cpysrc, sizeof x64inst * (1 + fn->insts_count - idx));
	}
	x64api.instpos = x64api.instpos + 1;
	fn->insts_count = (fn->insts_count + 1);
	[fn->insts # idx] = [inst];
};
