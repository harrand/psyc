x64func : struct
{
	insts : x64inst mut?;
	insts_count : u64;
	insts_cap : u64;

	// implementation detail. represents some byte offset in an encoder where the code within this function starts
	stack : u64;
	enc_byte_offset_begin : u64;
	idx : u64;
	custom_name : u8?;
	custom_name_len : u64;

	stack_slot_froms : x64val mut?;
	stack_slot_tos : x64val mut?;
	stack_slot_count : u64;
	stack_slot_cap : u64;
};

x64func_add_stack_slot : func(fn : x64func mut?, from : x64val mut?, to : x64val mut? -> v0)
{
	if((fn->stack_slot_froms == zero) || (fn->stack_slot_tos == zero))
	{
		fn->stack_slot_cap = 8;
		fn->stack_slot_froms = arena_alloc(global_arena, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_froms]));
		fn->stack_slot_tos = arena_alloc(global_arena, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_tos]));
	}
	while(fn->stack_slot_count >= fn->stack_slot_cap)
	{
		old_froms ::= fn->stack_slot_froms;
		old_tos ::= fn->stack_slot_tos;
		oldcap ::= fn->stack_slot_cap;
		fn->stack_slot_cap = fn->stack_slot_cap * 2;
		fn->stack_slot_froms = arena_alloc(global_arena, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_froms]));
		memcopy(fn->stack_slot_froms, old_froms, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_froms]));
		fn->stack_slot_tos = arena_alloc(global_arena, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_tos]));
		memcopy(fn->stack_slot_tos, old_tos, fn->stack_slot_cap * sizeof typeof([fn->stack_slot_tos]));
	}
	[fn->stack_slot_froms # fn->stack_slot_count] = [from];
	[fn->stack_slot_tos # fn->stack_slot_count] = [to];
	fn->stack_slot_count = fn->stack_slot_count + 1;
};

x64func_add_inst_at : func(fn : x64func mut?, inst : x64inst mut?, idx : u64 -> v0)
{
	if(fn->insts == zero)
	{
		fn->insts_cap = 8;
		fn->insts = arena_alloc(global_arena, fn->insts_cap * sizeof x64inst);
	}
	while(fn->insts_count >= fn->insts_cap)
	{
		oldcap ::= fn->insts_cap;
		old ::= fn->insts;
		fn->insts_cap = (fn->insts_cap * 2);
		fn->insts = arena_alloc(global_arena, fn->insts_cap * sizeof x64inst);
		memcopy(fn->insts, old, oldcap * sizeof x64inst);
	}
	if(idx < fn->insts_count)
	{
		// move all insts right by one otherwise we will overwrite
		cpysrc ::= fn->insts # idx;
		memcopy_backwards(cpysrc # 1, cpysrc, sizeof x64inst * (1 + fn->insts_count - idx));
	}
	x64api.instpos = x64api.instpos + 1;
	fn->insts_count = (fn->insts_count + 1);
	[fn->insts # idx] = [inst];
};
