x64enc_meta : struct
{
	// absolute virtual address where the code starts
	begin_code_vaddr : u64;
	// absolute virtual address where the readonly global data (.rodata) starts
	begin_readonly_glob_vaddr : u64;
	// absolute virtual address where the mutable global data (.data) starts
	begin_mutable_glob_vaddr : u64;
	// absolute virtual address where the mutable zeroed global data (.bss) starts
	begin_mutablezero_glob_vaddr : u64;
	// how many bytes does the .bss region last?
	mutablezero_size : u64;
};

x64enc_meta_calculate_globref_riprel : func(glob_data_begin_vaddr : u64, globref_disp : s32, current_instruction_end_vaddr : u64 -> u64)
{
	// glob_addr = rip + rel32
	// rel32 = glob_addr - rip
	return (glob_data_begin_vaddr + globref_disp@s64@u64) - (current_instruction_end_vaddr);
};

x64enc_meta_calculate_fnref_riprel : func(fn_code_offset_bytes : u64, current_instruction_end_vaddr : u64 -> u64)
{
	// fn_addr = rip + rel32
	// rel32 = fn_addr - rip;
	return fn_code_offset_bytes - current_instruction_end_vaddr;
};

x64enc_meta_calculate_ripreli_riprel : func(target_inst_begin_vaddr : u64, current_instruction_end_vaddr : u64 -> u64)
{
	// addr = rip + rel32
	// rel32 = addr - rip
	return current_instruction_end_vaddr - target_inst_begin_vaddr;
};

x64enc_catch_edge_cases : func(inst : x64inst mut?, m : x64enc_meta mut? -> v0)
{
	i : u64 mut;
	// edge case 1: movzx r64, r/m32 does not exist. patch it to mov r32, r/m32 instead
	if(inst->tag == x64inst_tag.movzx)
	{
		if((x64val_get_size(inst->operands # 0) == 64) == (x64val_get_size(inst->operands # 1) == 32))
		{
			inst->tag = x64inst_tag.mov;
			[x64val_reg_get_size(inst->operands # 0)] = 32;
		}
	}
	count ::= x64inst_operands_count(inst);
	for(i = 0; i < count; i = i + 1)
	{
		op ::= inst->operands # i;
		if(op->tag == x64val_tag.memreg)
		{
			// edge case 2: if the base-reg of a memreg is rbp/r13 and there is no displacement, set one
			base ::= [x64val_memreg_get_base(op)];
			disp_sz ::= [x64val_memreg_get_displacement_size(op)];
			if((disp_sz == 0) && ((base == x64_reg.rbp) || (base == x64_reg.r13)))
			{
				[x64val_memreg_get_displacement_size(op)] = 1;
				[x64val_memreg_get_displacement(op)] = 0;
			}
		}
	}
};

x64enc_pre_encode_plus_reg : func(enc : x64enc_table_entry mut?, operands : x64val mut?, operands_count : u64, modrm_out : u8 mut? mut?, sib_out : u8 mut? mut? -> v0)
{
	// easy peasy. find the register
	i : u64 mut;
	for(i = 0; i < operands_count; i = i + 1)
	{
		type ::= [enc->operand_types # i];
		if((type == x64enc_operand_type.r8) || (type == x64enc_operand_type.r16) || (type == x64enc_operand_type.r32) || (type == x64enc_operand_type.r64) || (type == x64enc_operand_type.r128))
		{
			// this is our register
			regbits ::= [x64val_reg_get_reg(operands # i)];
			if(regbits@s64 > 0b111)
			{
				// rex_b to extend opcode
				enc->rex_prefix = (enc->rex_prefix | x64enc_rex_prefix.rex_b);
			}
			
			enc->opcode = (enc->opcode + ((regbits@s64 & 0b111)@u16));
		}
	}
	[modrm_out] = zero;
	[sib_out] = zero;
	return;
};

x64enc_pre_encode_reg : func(enc : x64enc_table_entry mut?, operands : x64val mut?, operands_count : u64, modrm_out : u8 mut? mut?, sib_out : u8 mut? mut? -> v0)
{
	i : u64 mut;
	mod_bits : u8 mut := 0;
	reg_bits : u8 mut := 0;

	scale_bits : u8 mut := 0;
	index_bits : u8 mut := 0;
	base_bits : u8 mut := 0;
	// modrm.reg is the register operand
	op : x64val mut? mut;
	type : x64enc_operand_type mut;
	for(i = 0; i < operands_count; i = i + 1)
	{
		op = operands # i;
		type = [enc->operand_types # i];
		if((type == x64enc_operand_type.r8) || (type == x64enc_operand_type.r16) || (type == x64enc_operand_type.r32) || (type == x64enc_operand_type.r64) || (type == x64enc_operand_type.r128))
		{
			// this is our register
			regbits ::= [x64val_reg_get_reg(op)];
			if(regbits@s64 > 0b111)
			{
				// rex_r to extend modrm.reg
				enc->rex_prefix = (enc->rex_prefix | x64enc_rex_prefix.rex_r);
			}
			
			reg_bits = (regbits@s64 & 0b111)@u8;
		}
	}
	for(i = 0; i < operands_count; i = i + 1)
	{
		op = operands # i;
		type = [enc->operand_types # i];
		if((type == x64enc_operand_type.rm8) || (type == x64enc_operand_type.rm16) || (type == x64enc_operand_type.rm32) || (type == x64enc_operand_type.rm64) || (type == x64enc_operand_type.rm128))
		{
			x64enc_pre_encode_handle_rm(enc, op, modrm_out, sib_out);
		}
	}
};

x64enc_pre_encode_handle_rm : func(enc : x64enc_table_entry mut?, rm_operand : x64val mut?, modrm_out : u8 mut? mut?, sib_out : u8 mut? mut? -> v0)
{
	i : u64 mut;

	scale_bits : u8 mut := 0;
	index_bits : u8 mut := 0;
	base_bits : u8 mut := 0;
	// we need to see if the rm_operand is a reg or a memreg
	if(rm_operand->tag == x64val_tag.reg)
	{
		// rm is a register
		rm_regbits ::= [x64val_reg_get_reg(rm_operand)];
		modrm_set_mod([modrm_out], 0b11);
		modrm_set_rm([modrm_out], (rm_regbits@s64 & 0b111)@u8);
		if(rm_regbits@s64 > 0b111)
		{
			// extend rm via rex.b
			enc->rex_prefix = (enc->rex_prefix | x64enc_rex_prefix.rex_b);
		}
		[sib_out] = zero;
		return;
	}
	else
	{
		// rm is a memory rm_operand
		rm_baseregbits : x64_reg mut := [x64val_memreg_get_base(rm_operand)];
		// catch ripreli/globref/fnref (which should be treated as a 32-bit rip-relative memory operand
		if((rm_operand->tag == x64val_tag.globref) || (rm_operand->tag == x64val_tag.fnref))
		{
			rm_baseregbits = x64_reg.rip;
		}
		modrm_set_rm([modrm_out], (rm_baseregbits@s64 & 0b111)@u8);
		if(rm_baseregbits@s64 > 0b111)
		{
			// extend rm via rex.b
			enc->rex_prefix = (enc->rex_prefix | x64enc_rex_prefix.rex_b);
		}
		// check if we have a displacement
		disp_sz : u64 mut := [x64val_memreg_get_displacement_size(rm_operand)];
		// catch ripreli/globref/fnref (which should be treated as a 32-bit rip-relative memory operand
		if((rm_operand->tag == x64val_tag.globref) || (rm_operand->tag == x64val_tag.fnref))
		{
			disp_sz = 32;
		}
		if(disp_sz != 0)
		{
			if(disp_sz == 8)
			{
				modrm_set_mod([modrm_out], 0b01);
			}
			else
			{
				if(disp_sz != 32)
				{
					panic_begin();
					putzstr("dodgy rm operand displacement size of \0");
					putuint(disp_sz);
					putzstr(" at: \0");
					x64val_dump(rm_operand);
					panic_end();
				}
				modrm_set_mod([modrm_out], 0b10);
			}
		}
		else
		{
			modrm_set_mod([modrm_out], 0b00);
		}

		// do we need a sib?
		if((rm_operand->tag == x64val_tag.fnref) || (rm_operand->tag == x64val_tag.globref) || ([x64val_memreg_get_index_size(rm_operand)] == 0) || ([x64val_memreg_get_scale(rm_operand)] == 0))
		{
			[sib_out] = zero;
			return;
		}
		base_bits = [[modrm_out]] & 0b00000111;
		modrm_set_rm([modrm_out], 0b100);
		// we do need a sib
		scale_bits = log2([x64val_memreg_get_scale(rm_operand)])@u8;
		rm_idxregbits ::= [x64val_memreg_get_index(rm_operand)];
		if(rm_idxregbits@s64 > 0b111)
		{
			// rex_x
			enc->rex_prefix = (enc->rex_prefix | x64enc_rex_prefix.rex_x);
		}
		index_bits = (rm_idxregbits@s64 & 0b111)@u8;
		[[sib_out]] = (scale_bits << 6) | (index_bits << 3) | base_bits;
	}
};

modrm_set_mod : func(modrm : u8 mut?, mod : u8 -> v0)
{
	[modrm] = [modrm] & 0b00111111;
	[modrm] = [modrm] | (mod << 6);
};

modrm_set_reg : func(modrm : u8 mut?, reg : u8 -> v0)
{
	[modrm] = [modrm] & 0b11000111;
	[modrm] = [modrm] | (reg << 3);
};

modrm_set_rm : func(modrm : u8 mut?, rm : u8 -> v0)
{
	[modrm] = [modrm] & 0b11111000;
	[modrm] = [modrm] | rm;
};

x64enc_pre_encode_plus_n : func(enc : x64enc_table_entry mut?, operands : x64val mut?, operands_count : u64, modrm_out : u8 mut? mut?, sib_out : u8 mut? mut? -> v0)
{
	i : u64 mut;

	for(i = 0; i < operands_count; i = i + 1)
	{
		op ::= operands # i;
		type ::= [enc->operand_types # i];
		if((type == x64enc_operand_type.rm8) || (type == x64enc_operand_type.rm16) || (type == x64enc_operand_type.rm32) || (type == x64enc_operand_type.rm64) || (type == x64enc_operand_type.rm128))
		{
			x64enc_pre_encode_handle_rm(enc, op, modrm_out, sib_out);
		}
	}

	modrm_set_mod([modrm_out], 0b11);
	base : x64enc_opmode := x64enc_opmode.plus_0;
	modrm_set_reg([modrm_out], (enc->ext@s64 - base@s64)@u8);
	[sib_out] = zero;
};

x64enc_pre_encode : func(enc : x64enc_table_entry mut?, operands : x64val mut?, operands_count : u64, modrm_out : u8 mut? mut?, sib_out : u8 mut? mut? -> v0)
{
	if(enc->ext == zero)
	{
		[modrm_out] = zero;
		[sib_out] = zero;
	}
	if(enc->ext == x64enc_opmode.plus_reg)
	{
		x64enc_pre_encode_plus_reg(enc, operands, operands_count, modrm_out, sib_out);
	}
	if(enc->ext == x64enc_opmode.reg)
	{
		x64enc_pre_encode_reg(enc, operands, operands_count, modrm_out, sib_out);
	}
	if(enc->ext@s64 >= x64enc_opmode.plus_0@s64)
	{
		x64enc_pre_encode_plus_n(enc, operands, operands_count, modrm_out, sib_out);
	}
};

x64inst_encode_to : func(w : bwriter mut?, inst : x64inst mut?, fn : x64func mut?, p : x64prog mut?, m : x64enc_meta mut?, allow_unencodeable : bool -> v0)
{
	if(x64inst_is_any_custom(inst))
	{
		return;
	}
	inst->enc_byte_offset_begin = w->cursor;
	count ::= x64inst_operands_count(inst);
	x64enc_catch_edge_cases(inst, m);

	if((x64inst_is_encodeable(inst) == false) && (allow_unencodeable == false))
	{
		panic_begin();
		putzstr("attempt to encode unencodeable instruction:\n\0");
		x64inst_dump(inst);
		panic_end();
	}
	// complex
	enc : x64enc_table_entry mut := [x64enc_fetch(inst)];
	modrm_val : u8 mut := 0;
	modrm : u8 mut? mut := ref modrm_val;
	sib_val : u8 mut := 0;
	sib : u8 mut? mut := ref sib_val;
	x64enc_pre_encode(ref enc, inst->operands # 0, count, ref modrm, ref sib);
	// first write out legacy prefixes (todo)
	i : u64 mut;
	for(i = 0; i < countof typeof(enc.legacy_prefixes); i = i + 1)
	{
		curprefix ::= [enc.legacy_prefixes # i];
		if(curprefix != zero)
		{
			bwrite8(w, curprefix@s64@u8);
		}
	}
	if(enc.rex_prefix != zero)
	{
		bwrite8(w, enc.rex_prefix@s64);
	}
	// then the opcode
	if(enc.opcode@s64 > 0xff)
	{
		// 2 byte opcode!
		bwrite16(w, enc.opcode);
	}
	else
	{
		// 1 byte opcode
		bwrite8(w, enc.opcode);
	}
	if(modrm != zero)
	{
		bwrite8(w, modrm_val);
		if(sib != zero)
		{
			bwrite8(w, sib_val);
		}
	}
	for(i = 0; i < count; i = i + 1)
	{
		op ::= inst->operands # i;
		if((x64val_is_encodeable(op) == false) && (allow_unencodeable == false))
		{
			//panic_begin();
			warn_begin();
			putzstr("attempt to request unencodeable instruction:\n\0");
			x64inst_dump(inst);
			putzstr("due to unencodeable operand \0");
			putchar('"');
			x64val_dump(op);
			putchar('"');
			warn_end();
			//panic_end();
		}
		if(op->tag == x64val_tag.memreg)
		{
			disp_sz ::= [x64val_memreg_get_displacement_size(op)];
			if(disp_sz == 8)
			{
				bwrite8(w, [x64val_memreg_get_displacement(op)]);
			}
			if(disp_sz == 32)
			{
				bwrite32(w, [x64val_memreg_get_displacement(op)]);
			}
		}
		if((op->tag == x64val_tag.riprelimm) || (op->tag == x64val_tag.fnref) || (op->tag == x64val_tag.globref))
		{
			bwrite32(w, zero);
		}
		if(op->tag == x64val_tag.imm)
		{
			immval ::= [x64val_imm_get_value(op)];
			immsz ::= [x64val_imm_get_size(op)];
			if(immsz == 8)
			{
				bwrite8(w, immval);
			}
			if(immsz == 16)
			{
				bwrite16(w, immval);
			}
			if(immsz == 32)
			{
				bwrite32(w, immval);
			}
			if(immsz == 64)
			{
				bwrite64(w, immval);
			}
		}
	}
	inst->enc_byte_offset_end = w->cursor;
};

x64func_encode_to : func(w : bwriter mut?, fn : x64func mut?, p : x64prog mut?, m : x64enc_meta mut? -> v0)
{
	fn->enc_byte_offset_begin = w->cursor;
	i : u64 mut;
	for(i = 0; i < fn->insts_count; i = i + 1)
	{
		x64inst_encode_to(w, fn->insts # i, fn, p, m, false);
	}
};

x64glob_encode_to : func(w : bwriter mut?, glob : x64glob mut?, p : x64prog mut?, m : x64enc_meta mut? -> v0)
{
	i : u64 mut;
	bwrite_bytes(w, glob->init_data, glob->init_data_size);
	for(i = glob->init_data_size; i < glob->size; i = i + 1)
	{
		bwrite8(w, 0);
	}
};

x64prog_encode_to : func(codew : bwriter mut?, readonlyw : bwriter mut?, mutablew : bwriter mut?, p : x64prog mut?, m : x64enc_meta mut? -> v0)
{
	i : u64 mut;
	for(i = 0; i < p->globs_count; i = i + 1)
	{
		glob ::= p->globs # i;
		if(glob->tag == x64glob_tag.readonly)
		{
			glob->data_begin_offset_bytes = readonlyw->cursor;
			x64glob_encode_to(readonlyw, glob, p, m);
		}
		if(glob->tag == x64glob_tag.mutable)
		{
			glob->data_begin_offset_bytes = mutablew->cursor;
			x64glob_encode_to(mutablew, glob, p, m);
		}
		if(glob->tag == x64glob_tag.mutablezero)
		{
			glob->data_begin_offset_bytes = m->mutablezero_size;
			m->mutablezero_size = m->mutablezero_size + glob->size;
		}
	}
	x64prog_patch_everything(p, m);
	for(i = 0; i < p->funcs_count; i = i + 1)
	{
		x64func_encode_to(codew, p->funcs # i, p, m);
	}
};

// given a clobber (and an instruction and its relevant encoding entry), write into 'out' an x64val corresponding to the clobber. if it fails (either due to a memory clobber which we cant represent an x64val with, or a dodgy clobber) then return false and dont write to it.
x64enc_clobber_as_value : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, clob : x64enc_clobber, out : x64val mut? -> bool)
{
	if(clob == x64enc_clobber.op0)
	{
		[out] = [inst->operands # 0];
		return true;
	}
	if(clob == x64enc_clobber.op1)
	{
		[out] = [inst->operands # 1];
		return true;
	}
	if(clob == x64enc_clobber.rax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.eax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.ax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.al)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rdx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.edx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.dx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.dl)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rcx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.ecx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.cx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.cl)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rsp)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rsp;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	i : u64 mut;
	operand : x64val mut? mut;
	if(clob == x64enc_clobber.membase)
	{
		for(i = 0; i < countof typeof(enc->operand_types); i = i + 1)
		{
			type ::= [enc->operand_types # i];
			if((type == x64enc_operand_type.m8) || (type == x64enc_operand_type.m16) || (type == x64enc_operand_type.m32) || (type == x64enc_operand_type.m64) || (type == x64enc_operand_type.m128))
			{
				operand = inst->operands # i;
				if(operand->tag == x64val_tag.memreg)
				{
					out->tag = x64val_tag.reg;
					[x64val_reg_get_reg(out)] = [x64val_memreg_get_base(operand)];
					[x64val_reg_get_size(out)] = [x64val_memreg_get_base_size(operand)];
					return true;
				}
			}
		}
	}
	if(clob == x64enc_clobber.memidx)
	{
		for(i = 0; i < countof typeof(enc->operand_types); i = i + 1)
		{
			type ::= [enc->operand_types # i];
			if((type == x64enc_operand_type.m8) || (type == x64enc_operand_type.m16) || (type == x64enc_operand_type.m32) || (type == x64enc_operand_type.m64) || (type == x64enc_operand_type.m128))
			{
				operand = inst->operands # i;
				if(operand->tag == x64val_tag.memreg)
				{
					out->tag = x64val_tag.reg;
					[x64val_reg_get_reg(out)] = [x64val_memreg_get_index(operand)];
					[x64val_reg_get_size(out)] = [x64val_memreg_get_index_size(operand)];
					return true;
				}
			}
		}
	}
	return false;
};

// how many things does this instruction encoding read from?
x64enc_reads_count : func(enc : x64enc_table_entry mut? -> u64)
{
	i : u64 mut;
	count ::= countof typeof(enc->reads);
	for(i = 0; i < count; i = i + 1)
	{
		if([enc->reads # i] == zero)
		{
			return i;
		}
	}
	return i;
};

// write into 'out' an x64val corresponding to the Nth thing that this instruction encoding reads from (idx should be between 0 and x64enc_reads_count(enc)) and return true. on failure, out is unchanged and we return false.
x64enc_get_read : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, idx : u64, out : x64val mut? -> bool)
{
	if(idx >= countof typeof(enc->reads))
	{
		return false;
	}
	clob ::= [enc->reads # idx];
	if(clob == zero)
	{
		return false;
	}
	return x64enc_clobber_as_value(inst, enc, clob, out);
};

// how many things does this instruction encoding write to?
x64enc_writes_count : func(enc : x64enc_table_entry mut? -> u64)
{
	i : u64 mut;
	count ::= countof typeof(enc->writes);
	for(i = 0; i < count; i = i + 1)
	{
		if([enc->writes # i] == zero)
		{
			return i;
		}
	}
	return i;
};

// write into 'out' an x64val corresponding to the Nth thing that this instruction encoding writes to (idx should be between 0 and x64enc_reads_count(enc)) and return true. on failure, out is unchanged and we return false.
x64enc_get_write : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, idx : u64, out : x64val mut? -> bool)
{
	if(idx >= countof typeof(enc->writes))
	{
		return false;
	}
	clob ::= [enc->writes # idx];
	if(clob == zero)
	{
		return false;
	}
	return x64enc_clobber_as_value(inst, enc, clob, out);
};

// get the encoding size of an instruction. the instruction must always be legal. the instruction must also be encodeable unless it's only unencodeable due to the presence of at least one of the following:
// - one or more riprelis
// - one or more riprelimms
// - one or more globrefs
x64inst_encode_size : func(inst : x64inst mut? -> u64)
{
	tmp : bwriter mut;
	w ::= ref tmp;
	bwriter_create_native(w, 16, scratch_arena);
	// todo: x64inst_encode_to shouldnt take an x64func and x64prog and x64enc_meta anyway because they're not needed.
	x64inst_encode_to(w, inst, zero, zero, zero, true);
	return w->cursor;
};

x64prog_patch_everything : func(p : x64prog mut?, m : x64enc_meta mut? -> v0)
{
	// patch:
	// - globrefs
	// - fnrefs
	// - ripreli
	// - riprelimm

	i : u64 mut;
	// todo: massive array of all instructions storing a u64 representing the byte distance from code_segment_begin to the beginning of the instruciton
	// assume no padding ever occurs, so the end of instruction X is the begin of instruction X+1
	total_instructions_count : u64 mut := 0;
	instruction_counter : u64 mut := 0;
	instruction_byte_counter : u64 mut := 0;
	for(i = 0; i < p->funcs_count; i = i + 1)
	{
		total_instructions_count = total_instructions_count + (p->funcs # i)->insts_count;
	}
	instruction_byte_distances : u64 mut? := arena_alloc(scratch_arena, total_instructions_count * sizeof u64);
	function_byte_distances : u64 mut? := arena_alloc(scratch_arena, p->funcs_count * sizeof u64);
	// todo: massive array of all functions toring a u64 representing the byte distance from code_segment to the beginning of the function
	j : u64 mut;
	// fill the aforementioned arrays
	fnx64 : x64func mut? mut;
	inst : x64inst mut? mut;
	for(i = 0; i < p->funcs_count; i = i + 1)
	{
		fnx64 = p->funcs # i;
		[function_byte_distances # i] = instruction_byte_counter;
		for(j = 0; j < fnx64->insts_count; j = j + 1)
		{
			inst = fnx64->insts # j;
			// encode the instruction to a temporary scratch encoder so we can figure out its length
			cur_inst_bytes ::= x64inst_encode_size(inst);
			[instruction_byte_distances # instruction_counter] = instruction_byte_counter;
			instruction_byte_counter = instruction_byte_counter + cur_inst_bytes;
			instruction_counter = instruction_counter + 1;
		}
	}

	// now we know the location of everything
	// iterate again, but also iterate over the operands of everything
	// everytime we see a globref, patch it to a riprel
	// everytime we see a ripreli, patch it to a riprel
	// everytime we see a riprelimm, patch it to an immediate
	instruction_counter = 0;
	k : u64 mut;
	for(i = 0; i < p->funcs_count; i = i + 1)
	{
		fnx64 = p->funcs # i;
		for(j = 0; j < fnx64->insts_count; j = j + 1)
		{
			inst = fnx64->insts # j;
			// dst from code begin to start of our instruction
			code_segment_offset_bytes ::= [instruction_byte_distances # instruction_counter];
			// dst from code begin to start of next instruction
			code_segment_offset_bytes_next : u64 mut;
			if(instruction_counter < total_instructions_count)
			{
				code_segment_offset_bytes_next ::= [instruction_byte_distances # (instruction_counter + 1)];
			}
			// iterate over operands
			count ::= x64inst_operands_count(inst);
			opcpy : x64val mut;
			for(k = 0; k < count; k = k + 1)
			{
				op ::= inst->operands # k;
				// globref -> riprel
				if(op->tag == x64val_tag.globref)
				{
					// get the glob
					glob ::= x64api.prog.globs # [x64val_globref_get_index(op)];
					glob_vaddr : u64 mut := 0;
					// get its dst from <region_begin>
					if(glob->tag == x64glob_tag.readonly)
					{
						glob_vaddr = m->begin_readonly_glob_vaddr + glob->data_begin_offset_bytes;
					}
					if(glob->tag == x64glob_tag.mutable)
					{
						glob_vaddr = m->begin_mutable_glob_vaddr + glob->data_begin_offset_bytes;
					}
					if(glob->tag == x64glob_tag.mutablezero)
					{
						glob_vaddr = m->begin_mutablezero_glob_vaddr + glob->data_begin_offset_bytes;
					}
					opcpy = [op];
					op->tag = x64val_tag.memreg;
					[x64val_memreg_get_base(op)] = x64_reg.rip;
					[x64val_memreg_get_base_size(op)] = 64;
					[x64val_memreg_get_index_size(op)] = zero;
					[x64val_memreg_get_scale(op)] = 0;
					[x64val_memreg_get_displacement(op)] = x64enc_meta_calculate_globref_riprel(glob_vaddr, [x64val_globref_get_displacement(ref opcpy)], code_segment_offset_bytes_next);
					[x64val_memreg_get_displacement_size(op)] = 32;
					[x64val_memreg_get_size(op)] = [x64val_globref_get_size(ref opcpy)];

					putzstr("globref \0");
					x64val_dump(ref opcpy);
					putzstr("\nturned into: \0");
					x64val_dump(op);
					putchar('\n');
				}
				// fnref -> rel32
				if(op->tag == x64val_tag.fnref)
				{
					// get the fn
					fn_begin_bytes ::= [function_byte_distances # [x64val_fnref_get_index(op)]];
					opcpy = [op];
					op->tag = x64val_tag.imm;
					[x64val_imm_get_value(op)] = x64enc_meta_calculate_fnref_riprel(fn_begin_bytes, code_segment_offset_bytes_next);
					[x64val_imm_get_size(op)] = 32;

					putzstr("fnref \0");
					x64val_dump(ref opcpy);
					putzstr("\nturned into: \0");
					x64val_dump(op);
					putchar('\n');
				}
				// riprelimm -> immediate
				if(op->tag == x64val_tag.riprelimm)
				{
					delta ::= [x64val_riprelimm_get_delta(op)]@s64@u64;
					target_inst_begin ::= [instruction_byte_distances # (j + delta)];
					opcpy = [op];

					opcpy = [op];
					op->tag = x64val_tag.imm;
					[x64val_imm_get_value(op)] = x64enc_meta_calculate_ripreli_riprel(target_inst_begin, code_segment_offset_bytes_next);
					[x64val_imm_get_size(op)] = 32;

					putzstr("riprelimm \0");
					x64val_dump(ref opcpy);
					putzstr("\nturned into: \0");
					x64val_dump(op);
					putchar('\n');
				}
			}
			instruction_counter = instruction_counter + 1;
		}
	}
};
