x64_constraints_data : struct
{
	outputs : x64val mut?;
	outputs_count : u64;
	outputs_cap : u64;
	inputs : x64val mut?;
	inputs_count : u64;
	inputs_cap : u64;
	clobbers : x64val mut?;
	clobbers_count : u64;
	clobbers_cap : u64;
};

x64_constraints_data_add_output : func(data : x64_constraints_data mut? -> x64val mut?)
{
	if(data->outputs == zero)
	{
		data->outputs_cap = 4;
		data->outputs = arena_alloc(global_arena, data->outputs_cap * sizeof x64val);
	}
	while(data->outputs_cap <= data->outputs_count)
	{
		old ::= data->outputs;
		oldcap ::= data->outputs_cap;
		data->outputs_cap = data->outputs_cap * 2;
		data->outputs = arena_alloc(global_arena, data->outputs_cap * sizeof x64val);
		memcopy(data->outputs, old, oldcap * sizeof x64val);
	}
	ptr ::= data->outputs # (data->outputs_count);
	data->outputs_count = data->outputs_count + 1;
	return ptr;
};

x64_constraints_data_add_input : func(data : x64_constraints_data mut? -> x64val mut?)
{
	if(data->inputs == zero)
	{
		data->inputs_cap = 4;
		data->inputs = arena_alloc(global_arena, data->inputs_cap * sizeof x64val);
	}
	while(data->inputs_cap <= data->inputs_count)
	{
		old ::= data->inputs;
		oldcap ::= data->inputs_cap;
		data->inputs_cap = data->inputs_cap * 2;
		data->inputs = arena_alloc(global_arena, data->inputs_cap * sizeof x64val);
		memcopy(data->inputs, old, oldcap * sizeof x64val);
	}
	ptr ::= data->inputs # (data->inputs_count);
	data->inputs_count = data->inputs_count + 1;
	return ptr;
};

x64_constraints_data_add_clobber : func(data : x64_constraints_data mut? -> x64val mut?)
{
	if(data->clobbers == zero)
	{
		data->clobbers_cap = 4;
		data->clobbers = arena_alloc(global_arena, data->clobbers_cap * sizeof x64val);
	}
	while(data->clobbers_cap <= data->clobbers_count)
	{
		old ::= data->clobbers;
		oldcap ::= data->clobbers_cap;
		data->clobbers_cap = data->clobbers_cap * 2;
		data->clobbers = arena_alloc(global_arena, data->clobbers_cap * sizeof x64val);
		memcopy(data->clobbers, old, oldcap * sizeof x64val);
	}
	ptr ::= data->clobbers # (data->clobbers_count);
	data->clobbers_count = data->clobbers_count + 1;
	return ptr;
};

x64_parse_a_constraint : func(constraints : u8?, constraints_len : u64, out : x64_constraints_data mut? -> u64)
{
	// constraints points to a valid constraint
	// it may be much shorter than constraints_len, so we return how much we parsed
	front ::= [constraints # 0];

	off : u64 mut := 0;
	con : x64val mut? mut := zero;
	if(front == '{')
	{
		off = 1;
		con = x64_constraints_data_add_input(out);
	}
	if(front == '=')
	{
		off = 2;
		con = x64_constraints_data_add_output(out);
	}
	if(front == '~')
	{
		off = 2;
		con = x64_constraints_data_add_clobber(out);
	}
	if((front >= '0') && (front <= '9'))
	{
		// N'th output becomes also an input
		number : parseutil_number mut;
		parse_dst ::= parseutil_parse_number(ref front, 1, ref number);
		[x64_constraints_data_add_input(out)] = [out->outputs # number.i];
		return parse_dst;
	}
	content ::= constraints # off;
	len ::= constraints_len - off;
	con->tag = x64val_tag.invalid;
	i : u64 mut;
	for(i = 0; i < countof typeof x64reg_name; i = i + 1)
	{
		cur ::= [x64reg_name # i];
		cur_len ::= zstrlen(cur);
		if(strstartswith(content, len, cur, cur_len))
		{
			// its this register
			// i == regidx * 7 + (log2(sz) - 3)
			// we want to get the regidx and sz
			// size is easy - (i mod 7) == 1 if 8 bit
			// 2 if 16 bit, and so on...
			mod ::= i % 7;
			j : u64 mut;
			sz : u64 mut := 1;
			for(j = 1; j < mod; j = j + 1)
			{
				sz = sz * 2;
			}
			// reggroup = (i - 1) / 7
			con->tag = x64val_tag.reg;
			[x64val_reg_get_size(con)] = sz * 8;
			[x64val_reg_get_reg(con)] = (i / 7)@s64@x64_reg;
			return cur_len + 1 + off;
		}
	}
	return 0;
};

x64_parse_constraints : func(constraints : u8?, constraints_len : u64, out : x64_constraints_data mut? -> v0)
{
	ptr : u8? mut := constraints;
	len : u64 mut := constraints_len;
	while(len > 0)
	{
		curparse : u64 mut := 0;
		if(parseutil_is_whitespace([ptr]) || ([ptr] == ','))
		{
			curparse = 1;
		}
		else
		{
			curparse = x64_parse_a_constraint(ptr, len, out);
			if(curparse == 0)
			{
				err_begin();
				putzstr("failed to parse constraint string \0");
				putchar('"');
				putchars(constraints, constraints_len);
				putchar('"');
				putzstr(" properly. got stuck \0");
				putuint(constraints_len - len);
				putzstr(" bytes in\0");
				err_end();
			}
		}
		ptr = ptr # curparse;
		len = len - curparse;
	}
};
// given a constraint string e.g '={rax},0,{rdi},~{rcx}'
// convert to a matching function type, e.g 'func(u64, u64 -> u64)'
x64_constraints_to_ty : func(constraints : u8?, constraints_len : u64 -> ty)
{
	constraint_data : x64_constraints_data mut := zero;
	x64_parse_constraints(constraints, constraints_len, ref constraint_data);
	u : tydata mut;
	u.tag = tydata_tag.function;
	u.name = zero;
	u.name_len = zero;
	u.underlying = ty.invalid;
	if(constraint_data.outputs_count == 0)
	{
		u.underlying = ty.v0;
	}
	else
	{
		if(constraint_data.outputs_count > 1)
		{
			err_begin();
			putzstr("constraint string \0");
			putchar('"');
			putchars(constraints, constraints_len);
			putchar('"');
			putzstr(" had \0");
			putuint(constraint_data.outputs_count);
			putzstr(" outputs, but constraint strings can only have 0 or 1 outputs.");
			err_end();
		}
		outsz ::= [x64val_reg_get_size(constraint_data.outputs # 0)];
		if(outsz == 8)
		{
			u.underlying = ty_add_weak(ty.u8);
		}
		if(outsz == 16)
		{
			u.underlying = ty_add_weak(ty.u16);
		}
		if(outsz == 32)
		{
			u.underlying = ty_add_weak(ty.u32);
		}
		if(outsz == 64)
		{
			u.underlying = ty_add_weak(ty.u64);
		}
	}

	u.members_count = constraint_data.inputs_count;
	u.members = arena_alloc(global_arena, u.members_count * sizeof ty);
	i : u64 mut;
	for(i = 0; i < u.members_count; i = i + 1)
	{
		insz ::= [x64val_reg_get_size(constraint_data.inputs # i)];
		curty : ty mut := ty.invalid;
		if(insz == 8)
		{
			curty = ty_add_weak(ty.u8);
		}
		if(insz == 16)
		{
			curty = ty_add_weak(ty.u16);
		}
		if(insz == 32)
		{
			curty = ty_add_weak(ty.u32);
		}
		if(insz == 64)
		{
			curty = ty_add_weak(ty.u64);
		}
		[u.members # i] = curty;
	}
	u.array_len = 0;
	u.reference = zero;

	//ret ::= ty_wrap(ref u);
	//putzstr("constraint string \0");
	//putchar('"');
	//putchars(constraints, constraints_len);
	//putchar('"');
	//putzstr(" yields type: \0");
	//putty(ret);
	//putchar('\n');
	//return ret;
	return ty_wrap(ref u);
};

x64_parse_asm_breaks : func(ch : u8 -> bool)
{
	return (ch == ' ') || (ch == '\t') || (ch == '\r') || (ch == '\n') || (ch == zero) || (ch == ',');
};

x64_parse_asm : func(code : u8?, code_len : u64, inputs : x64val mut?, inputs_count : u64 -> v0)
{
	// $N is treated as [inputs # N] (you are free to pass zero for both if you dont need to support that special syntax)
	cursor : u64 mut := 0;
	curinst : x64inst mut := zero;
	curop_is_mem : bool mut := false;
	curop_mem_sz : u64 mut := 0;
	curop : x64val mut := zero;
	// parse the assembly (please deal with memory operands too)
	i : u64 mut;
	j : u64 mut;
	while(cursor < code_len)
	{
		if([code # cursor] == '\n')
		{
			// we're done
			x64_add_instruction(ref curinst);
			cursor = cursor + 1;
			curinst = zero;
			curop_is_mem = false;
			curop_mem_sz = 0;
			curop = zero;
		}
		while(x64_parse_asm_breaks([code # cursor]))
		{
			// just skip the whitespacey thing
			cursor = cursor + 1;
		}
		if(curinst.tag == zero)
		{
			// expect an instruction name
			instword_begin ::= code # cursor;
			for(i = cursor; i <= code_len; i = i + 1)
			{
				idx : u64 mut := i;
				if(idx == code_len)
				{
					idx = idx - 1;
				}
				if(x64_parse_asm_breaks([code # idx]) || (i == code_len))
				{
					// we broke the word
					// match sstr{instword_begin, i} to an instruction name. error if it doesnt match any
					instword_len ::= i - cursor;
					for(j = 0; j < countof x64inst_tag; j = j + 1)
					{
						curinst_name_zstr ::= [x64inst_name # j];
						if(streql(instword_begin, instword_len, curinst_name_zstr, zstrlen(curinst_name_zstr)))
						{
							curinst.tag = j@s64@x64inst_tag;
						}
					}
					if(curinst.tag == zero)
					{
						err_begin();
						putzstr("could not recognise x64 instruction name \0");
						putchar('"');
						putchars(instword_begin, instword_len);
						putchar('"');
						putzstr(" within the following inline-asm code:\n\0");
						colour_red();
						putchars(code, code_len);
						colour_reset();
						err_end();
					}
					cursor = cursor + instword_len + 1;
					i = code_len + 1;
				}
			}
			// assume we hit the end (so we break the word in this case too)
		}
		else
		{
			// expect an operand
			// first we scan for _WORD PTR
			for(i = 0; i < countof typeof x64memreg_size_name; i = i + 1)
			{
				curname_zstr ::= [x64memreg_size_name # i];
				if(strstartswith(code # cursor, code_len - cursor, curname_zstr, zstrlen(curname_zstr)))
				{
					// ok we really should expect a memory operand.
					curop_is_mem = true;
					curop_mem_sz = 8 << i;
					cursor = cursor + zstrlen(curname_zstr);
				}
			}
			// ok now search all registers
			for(i = 1; i < countof typeof x64reg_name; i = i + 1)
			{
				curreg_idx : u64 := (i - 1) / 7;
				// workaround compiler bug (lhs of shift clearly is still an imm lmao)
				eight : u64 mut := 8;
				curreg_sz : u64 := eight << ((i - 1) % 7);
				curreg_zstr ::= [x64reg_name # i];
				if(strstartswith(code # cursor, code_len - cursor, curreg_zstr, zstrlen(curreg_zstr)))
				{
					curop.tag = x64val_tag.reg;
					[x64val_reg_get_reg(ref curop)] = curreg_idx@s64@x64_reg;
					[x64val_reg_get_size(ref curop)] = curreg_sz;
					cursor = cursor + zstrlen(curreg_zstr);
					i = countof typeof x64reg_name;
				}
			}
			number : parseutil_number mut := zero;
			// how about an integral literal?
			if(parseutil_is_digit([code # cursor]))
			{
				for(i = cursor + 1; i < code_len; i = i + 1)
				{
					if(parseutil_is_digit([code # i]) == false)
					{
						parseutil_parse_number(code # cursor, i - (cursor), ref number);
						// immediate
						curop.tag = x64val_tag.imm;
						// todo: support immX <num> instead of just taking a num directly and just assuming its 32-bit...
						[x64val_imm_get_size(ref curop)] = 32;
						[x64val_imm_get_value(ref curop)] = number.i@u64;
						// set cursor and end loop
						cursor = i;
						i = code_len;
					}
				}
			}

			// ok... is it a dollar?
			if([code # cursor] == '$')
			{
				// its an input!
				for(i = cursor + 1; i < code_len; i = i + 1)
				{
					if(parseutil_is_digit([code # i]) == false)
					{
						parseutil_parse_number(code # (cursor + 1), i - (cursor + 1), ref number);
						// input N
						if(number.i >= inputs_count@s64)
						{
							err_begin();
							putzstr("detected parsed-operand \0");
							putchar('"');
							putchars(code # cursor, i - cursor);
							putchar('"');
							putzstr(" (index \0");
							putsint(number.i);
							putzstr("), but the inline-asm only has \0");
							putuint(inputs_count);
							putzstr(" inputs...\n\0");
							err_end();
						}
						curop = [inputs # (number.i)];
						cursor = i;
						i = code_len;
					}
				}
			}
			
			if(curop.tag == zero)
			{
				panic_begin();
				putzstr("fucked up parsing an operand :/\n\0");
				x64inst_dump(ref curinst);
				panic_end();
			}
			if(curop_is_mem)
			{
				curop_cpy ::= curop;
				curop.tag = x64val_tag.memreg;
				[x64val_memreg_get_base(ref curop)] = [x64val_reg_get_reg(ref curop_cpy)];
				[x64val_memreg_get_base_size(ref curop)] = [x64val_reg_get_size(ref curop_cpy)];
				[x64val_memreg_get_index(ref curop)] = zero;
				[x64val_memreg_get_index_size(ref curop)] = zero;
				[x64val_memreg_get_scale(ref curop)] = zero;
				[x64val_memreg_get_displacement(ref curop)] = zero;
				[x64val_memreg_get_displacement_size(ref curop)] = zero;
				[x64val_memreg_get_size(ref curop)] = curop_mem_sz;
			}
			// lets fucking go
			x64inst_add_operand(ref curinst, ref curop);
			curop = zero;
			curop_is_mem = false;
			curop_mem_sz = 0;
		}
	}
	// we ran out of code
	// do we still have a curop in-flight? do the code again
	if(curinst.tag != zero)
	{
		if(curop.tag != zero)
		{
			if(curop_is_mem)
			{
				curop_cpy2 ::= curop;
				curop.tag = x64val_tag.memreg;
				[x64val_memreg_get_base(ref curop)] = [x64val_reg_get_reg(ref curop_cpy2)];
				[x64val_memreg_get_base_size(ref curop)] = [x64val_reg_get_size(ref curop_cpy2)];
				[x64val_memreg_get_index(ref curop)] = zero;
				[x64val_memreg_get_index_size(ref curop)] = zero;
				[x64val_memreg_get_scale(ref curop)] = zero;
				[x64val_memreg_get_displacement(ref curop)] = zero;
				[x64val_memreg_get_displacement_size(ref curop)] = zero;
				[x64val_memreg_get_size(ref curop)] = curop_mem_sz;
			}
			x64inst_add_operand(ref curinst, ref curop);
		}
		x64_add_instruction(ref curinst);
	}
};
