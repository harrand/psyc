// given a constraint string e.g '={rax},0,{rdi},~{rcx}'
// convert to a matching function type, e.g 'func(u64, u64 -> u64)'
x64_constraints_to_ty : func(constraints : u8?, constraints_len : u64 -> ty)
{
	warn_begin();
	putzstr("parsing of assembly constraint string:\n\0");
	colour_yellow();
	putchars(constraints, constraints_len);
	colour_reset();
	putzstr("\n is not yet implemented. yielding ty.invalid.\0");
	warn_end();
	return ty.invalid;
};

x64_parse_asm : func(code : u8?, code_len : u64, out_insts : x64inst mut? mut?, out_insts_count : u64 mut? -> v0)
{
	warn_begin();
	putzstr("parsing of assembly code:\n\0");
	colour_yellow();
	putchars(code, code_len);
	colour_reset();
	putzstr("\n is not yet implemented. zero instructions have been parsed.\0");
	warn_end();
	[out_insts] = zero;
	[out_insts_count] = 0;
};
