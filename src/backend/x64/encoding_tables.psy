x64enc_legacy_prefix : enum
{
	// group 1
	.lock := 0xf0;
	.repnz := 0xf2;
	.repz := 0xf3;
	// group 2
	.cs_seg_override := 0x2e;
	.ss_seg_override := 0x36;
	.ds_seg_override := 0x3e;
	.es_seg_override := 0x26;
	.fs_seg_override := 0x64;
	.gs_seg_override := 0x65;
	.branch_not_taken := 0x2e;
	// group 3
	.operand_size_override := 0x66;
	// group 4
	.address_size_override := 0x67;
};

x64enc_rex_prefix : enum
{
	.rex   := 0b01000000;
	.rex_w := 0b01001000;// 0: operand size determined by CS.D; 1: 64-bit operand size
	.rex_r := 0b01000100;// extension of ModR/M reg
	.rex_x := 0b01000010;// extension of SIB index
	.rex_b := 0b01000001;// extension of ModR/M rm, SIB base, or Opcode reg
	.all_but_w := 0b01000111;// REX RXB, no W
	.all := 0b01001111;// REX WRXB, all high
};

x64enc_opmode : enum
{
	.none     := 0; // no special opcode behaviour. trivial instruction.
	.reg      := 1; // /r
	.plus_reg := 2; // + rb
	.plus_0   := 3; // /0
	.plus_1   := 4; // /1
	.plus_2   := 5; // /2
	.plus_3   := 6; // /3
	.plus_4   := 7; // /4
	.plus_5   := 8; // /5
	.plus_6   := 9; // /6
	.plus_7   := 10; // /7
	// 3 => /1
	// 4 => /2
	// etc...
	.invalid_sentinel := 69420;
};

x64enc_operand_type : enum
{
	.r8 := 1;
	.r16 := 2;
	.r32 := 3;
	.r64 := 4;
	.r128 := 5;
	.rm8 := 6;
	.rm16 := 7;
	.rm32 := 8;
	.rm64 := 9;
	.rm128 := 10;
	.m8 := 11;
	.m16 := 12;
	.m32 := 13;
	.m64 := 14;
	.m128 := 15;
	.imm8 := 16;
	.imm16 := 17;
	.imm32 := 18;
	.imm64 := 19;
	.cl := 20;
};

x64enc_clobber : enum
{
	.op0 := 1;
	.op1 := 2;
	.rax := 5;
	.eax := 6;
	.ax := 7;
	.al := 8;
	.rdx := 9;
	.edx := 10;
	.dx := 11;
	.dl := 12;
	.rcx := 13;
	.ecx := 14;
	.cx := 15;
	.cl := 16;
	.rsp := 17;
	.mem := 18;
	// base register of the memory operand
	.membase := 19;
	// index register of the memory operand
	.memidx := 20;
};

x64enc_table_entry : struct
{
	opcode : u16;
	legacy_prefixes : x64enc_legacy_prefix[4];
	rex_prefix : x64enc_rex_prefix;
	ext : x64enc_opmode weak;
	operand_types : x64enc_operand_type[2];
	reads : x64enc_clobber[3];
	writes : x64enc_clobber[2];
};

// given a clobber (and an instruction and its relevant encoding entry), write into 'out' an x64val corresponding to the clobber. if it fails (either due to a memory clobber which we cant represent an x64val with, or a dodgy clobber) then return false and dont write to it.
x64enc_clobber_as_value : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, clob : x64enc_clobber, out : x64val mut? -> bool)
{
	if(clob == x64enc_clobber.op0)
	{
		[out] = [inst->operands # 0];
		return true;
	}
	if(clob == x64enc_clobber.op1)
	{
		[out] = [inst->operands # 1];
		return true;
	}
	if(clob == x64enc_clobber.rax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.eax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.ax)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.al)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rax;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rdx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.edx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.dx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.dl)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rdx;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rcx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	if(clob == x64enc_clobber.ecx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 32;
		return true;
	}
	if(clob == x64enc_clobber.cx)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 16;
		return true;
	}
	if(clob == x64enc_clobber.cl)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rcx;
		[x64val_reg_get_size(out)] = 8;
		return true;
	}
	if(clob == x64enc_clobber.rsp)
	{
		out->tag = x64val_tag.reg;
		[x64val_reg_get_reg(out)] = x64_reg.rsp;
		[x64val_reg_get_size(out)] = 64;
		return true;
	}
	i : u64 mut;
	operand : x64val mut? mut;
	if(clob == x64enc_clobber.membase)
	{
		for(i = 0; i < countof typeof(enc->operand_types); i = i + 1)
		{
			type ::= [enc->operand_types # i];
			if((type == x64enc_operand_type.m8) || (type == x64enc_operand_type.m16) || (type == x64enc_operand_type.m32) || (type == x64enc_operand_type.m64) || (type == x64enc_operand_type.m128))
			{
				operand = inst->operands # i;
				if(operand->tag == x64val_tag.memreg)
				{
					out->tag = x64val_tag.reg;
					[x64val_reg_get_reg(out)] = [x64val_memreg_get_base(operand)];
					[x64val_reg_get_size(out)] = [x64val_memreg_get_base_size(operand)];
					return true;
				}
			}
		}
	}
	if(clob == x64enc_clobber.memidx)
	{
		for(i = 0; i < countof typeof(enc->operand_types); i = i + 1)
		{
			type ::= [enc->operand_types # i];
			if((type == x64enc_operand_type.m8) || (type == x64enc_operand_type.m16) || (type == x64enc_operand_type.m32) || (type == x64enc_operand_type.m64) || (type == x64enc_operand_type.m128))
			{
				operand = inst->operands # i;
				if(operand->tag == x64val_tag.memreg)
				{
					out->tag = x64val_tag.reg;
					[x64val_reg_get_reg(out)] = [x64val_memreg_get_index(operand)];
					[x64val_reg_get_size(out)] = [x64val_memreg_get_index_size(operand)];
					return true;
				}
			}
		}
	}
	return false;
};

// how many things does this instruction encoding read from?
x64enc_reads_count : func(enc : x64enc_table_entry mut? -> u64)
{
	i : u64 mut;
	count ::= countof typeof(enc->reads);
	for(i = 0; i < count; i = i + 1)
	{
		if([enc->reads # i] == zero)
		{
			return i;
		}
	}
	return i;
};

// write into 'out' an x64val corresponding to the Nth thing that this instruction encoding reads from (idx should be between 0 and x64enc_reads_count(enc)) and return true. on failure, out is unchanged and we return false.
x64enc_get_read : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, idx : u64, out : x64val mut? -> bool)
{
	if(idx >= countof typeof(enc->reads))
	{
		return false;
	}
	clob ::= [enc->reads # idx];
	if(clob == zero)
	{
		return false;
	}
	return x64enc_clobber_as_value(inst, enc, clob, out);
};

// how many things does this instruction encoding write to?
x64enc_writes_count : func(enc : x64enc_table_entry mut? -> u64)
{
	i : u64 mut;
	count ::= countof typeof(enc->writes);
	for(i = 0; i < count; i = i + 1)
	{
		if([enc->writes # i] == zero)
		{
			return i;
		}
	}
	return i;
};

// write into 'out' an x64val corresponding to the Nth thing that this instruction encoding writes to (idx should be between 0 and x64enc_reads_count(enc)) and return true. on failure, out is unchanged and we return false.
x64enc_get_write : func(inst : x64inst mut?, enc : x64enc_table_entry mut?, idx : u64, out : x64val mut? -> bool)
{
	if(idx >= countof typeof(enc->writes))
	{
		return false;
	}
	clob ::= [enc->writes # idx];
	if(clob == zero)
	{
		return false;
	}
	return x64enc_clobber_as_value(inst, enc, clob, out);
};

encoding_tbl_nop ::= x64enc_table_entry[1] // 1 byte nop
{
	.0 := x64enc_table_entry
	{
		.opcode := 0x90;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := zero;
		.operand_types := zero;
		.reads := zero;
		.writes := zero;
	};
};

encoding_tbl_mov ::= x64enc_table_entry[13]
{
	// MOV r/m8, r8
	.0 := x64enc_table_entry
	{
		.opcode := 0x88;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm8;
			.1 := x64enc_operand_type.r8;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero; 
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero; 
		};
	};
	// MOV r/m16, r16
	.1 := x64enc_table_entry
	{
		.opcode := 0x89;
		.legacy_prefixes := x64enc_legacy_prefix[4]
		{
			.0 := x64enc_legacy_prefix.operand_size_override; .1 := zero; .2 := zero; .3 := zero;
		};
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm16;
			.1 := x64enc_operand_type.r16;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m32, r32
	.2 := x64enc_table_entry
	{
		.opcode := 0x89;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm32;
			.1 := x64enc_operand_type.r32;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m64, r64
	.3 := x64enc_table_entry
	{
		.opcode := 0x89;
		.legacy_prefixes := zero;
		.rex_prefix := x64enc_rex_prefix.rex_w;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm64;
			.1 := x64enc_operand_type.r64;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r8, r/m8
	.4 := x64enc_table_entry
	{
		.opcode := 0x8a;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r8;
			.1 := x64enc_operand_type.rm8;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r16, r/m16
	.5 := x64enc_table_entry
	{
		.opcode := 0x8b;
		.legacy_prefixes := x64enc_legacy_prefix[4]
		{
			.0 := x64enc_legacy_prefix.operand_size_override; .1 := zero; .2 := zero; .3 := zero;
		};
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r16;
			.1 := x64enc_operand_type.rm16;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r32, r/m32
	.6 := x64enc_table_entry
	{
		.opcode := 0x8b;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r32;
			.1 := x64enc_operand_type.rm32;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r64, r/m64
	.7 := x64enc_table_entry
	{
		.opcode := 0x8b;
		.legacy_prefixes := zero;
		.rex_prefix := x64enc_rex_prefix.rex_w;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r64;
			.1 := x64enc_operand_type.rm64;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m8, imm8
	.8 := x64enc_table_entry
	{
		.opcode := 0xc6;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.plus_0;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm8;
			.1 := x64enc_operand_type.imm8;
		};
		.reads := zero;
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m16, imm16
	.9 := x64enc_table_entry
	{
		.opcode := 0xc7;
		.legacy_prefixes := x64enc_legacy_prefix[4]
		{
			.0 := x64enc_legacy_prefix.operand_size_override; .1 := zero; .2 := zero; .3 := zero;
		};
		.rex_prefix := zero;
		.ext := x64enc_opmode.plus_0;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm16;
			.1 := x64enc_operand_type.imm16;
		};
		.reads := zero;
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m32, imm32
	.10 := x64enc_table_entry
	{
		.opcode := 0xc7;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.plus_0;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm32;
			.1 := x64enc_operand_type.imm32;
		};
		.reads := zero;
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r/m64, imm32
	.11 := x64enc_table_entry
	{
		.opcode := 0xc7;
		.legacy_prefixes := zero;
		.rex_prefix := x64enc_rex_prefix.rex_w;
		.ext := x64enc_opmode.plus_0;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.rm64;
			.1 := x64enc_operand_type.imm32;
		};
		.reads := zero;
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOV r64, imm64 (aka MOVABS)
	.12 := x64enc_table_entry
	{
		.opcode := 0xb8;
		.legacy_prefixes := zero;
		.rex_prefix := x64enc_rex_prefix.rex_w;
		.ext := x64enc_opmode.plus_reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r64;
			.1 := x64enc_operand_type.imm64;
		};
		.reads := zero;
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
};

encoding_tbl_movsx ::= x64enc_table_entry[6]
{
	// MOVSX r16, r/m8
	.0 := x64enc_table_entry
	{
		.opcode := 0xbe0f;
		.legacy_prefixes := x64enc_legacy_prefix[4]
		{
			.0 := x64enc_legacy_prefix.operand_size_override; .1 := zero; .2 := zero; .3 := zero;
		};
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r16;
			.1 := x64enc_operand_type.rm8;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOVSX r32, r/m8
	.1 := x64enc_table_entry
	{
		.opcode := 0xbe0f;
		.legacy_prefixes := zero;
		.rex_prefix := zero;
		.ext := x64enc_opmode.reg;
		.operand_types := x64enc_operand_type[2]
		{
			.0 := x64enc_operand_type.r32;
			.1 := x64enc_operand_type.rm8;
		};
		.reads := x64enc_clobber[3]
		{
			.0 := x64enc_clobber.op1; .1 := zero; .2 := zero;
		};
		.writes := x64enc_clobber[2]
		{
			.0 := x64enc_clobber.op0; .1 := zero;
		};
	};
	// MOVSX r64, r/m8
	.2 := x64enc_table_entry
	{
		.opcode := 0xbe0f;
		.legacy_prefixes := zero;
		.rex_prefix := x64enc_rex_prefix.rex_w;
		.ext := x64enc_opmode.reg;
