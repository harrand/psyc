x64inst_calc_live_in_out : func(inst : x64inst mut?, prev : x64inst mut?, next : x64inst mut? -> bool)
{
	i : u64 mut;
	j : u64 mut;
	old_live_out ::= inst->live_out;
	old_live_out_count ::= inst->live_out_count;
	inst->live_out = zero;
	inst->live_out_count = zero;
	inst->live_out_cap = zero;

	// iterate over successor
	if(next != zero)
	{
		for(i = 0; i < next->live_in_count; i = i + 1)
		{
			x64inst_add_live_out(inst, next->live_in # i);
		}
	}

	// now save the old live-in and recalculate it
	old_live_in ::= inst->live_in;
	old_live_in_count ::= inst->live_in_count;
	inst->live_in = zero;
	inst->live_in_count = zero;
	inst->live_in_cap = zero;

	tmp : x64val mut;

	// iterate over all uses and copy them to live_in if they're registery
	enc ::= x64enc_fetch(inst);
	if(enc != zero)
	{
		usecount ::= x64enc_reads_count(enc);
		for(i = 0; i < usecount; i = i + 1)
		{
			x64enc_get_read(inst, enc, i, ref tmp);
			if(x64val_is_any_register(ref tmp))
			{
				x64inst_add_live_in(inst, ref tmp);
			}
		}
	}
	// add all live-outs if they're not already in defs
	for(i = 0; i < inst->live_out_count; i = i + 1)
	{
		tmp = [inst->live_out # i];
		defcount ::= x64enc_writes_count(enc);
		tmp_is_in_defs : bool mut := false;
		for(j = 0; j < defcount; j = j + 1)
		{
			cur_def : x64val mut;
			x64enc_get_write(inst, enc, i, ref cur_def);
			if(x64val_equal_to(ref cur_def, ref tmp))
			{
				tmp_is_in_defs = true;
			}
		}
		if(tmp_is_in_defs == false)
		{
			x64inst_add_live_in(inst, ref tmp);
		}
	}
	// did we make any changes? if so, return true
	if((old_live_in_count != inst->live_in_count) || (old_live_out_count != inst->live_out_count))
	{
		return true;
	}
	for(i = 0; i < old_live_in_count; i = i + 1)
	{
		if(x64val_equal_to(old_live_in # i, inst->live_in # i) == false)
		{
			return true;
		}
	}
	for(i = 0; i < old_live_out_count; i = i + 1)
	{
		if(x64val_equal_to(old_live_out # i, inst->live_out # i) == false)
		{
			return true;
		}
	}
	return false;
};

x64inst_add_live_in : func(inst : x64inst mut?, v : x64val mut? -> v0)
{
	if(inst->live_in == zero)
	{
		inst->live_in_cap = 8;
		inst->live_in = arena_alloc(scratch_arena, inst->live_in_cap * sizeof typeof([inst->live_in]));
	}
	while(inst->live_in_count >= inst->live_in_cap)
	{
		old ::= inst->live_in;
		oldcap ::= inst->live_in_cap;
		inst->live_in_cap = inst->live_in_cap * 2;
		inst->live_in = arena_alloc(scratch_arena, inst->live_in_cap * sizeof typeof([inst->live_in]));
		memcopy(inst->live_in, old, oldcap * sizeof typeof([inst->live_in]));
	}
	[inst->live_in # inst->live_in_count] = [v];
	inst->live_in_count = inst->live_in_count + 1;
};

x64inst_finalise_live_in : func(inst : x64inst mut? -> v0)
{
	old ::= inst->live_in;
	i : u64 mut;
	inst->live_in = arena_alloc(global_arena, inst->live_in_cap * sizeof typeof([inst->live_in]));
	for(i = 0; i < inst->live_in_count; i = i + 1)
	{
		[inst->live_in # i] = [old # i];
	}
};

x64inst_add_live_out : func(inst : x64inst mut?, v : x64val mut? -> v0)
{
	if(inst->live_out == zero)
	{
		inst->live_out_cap = 8;
		inst->live_out = arena_alloc(scratch_arena, inst->live_out_cap * sizeof typeof([inst->live_out]));
	}
	while(inst->live_out_count >= inst->live_out_cap)
	{
		old ::= inst->live_out;
		oldcap ::= inst->live_out_cap;
		inst->live_out_cap = inst->live_out_cap * 2;
		inst->live_out = arena_alloc(scratch_arena, inst->live_out_cap * sizeof typeof([inst->live_out]));
		memcopy(inst->live_out, old, oldcap * sizeof typeof([inst->live_out]));
	}
	[inst->live_out # inst->live_out_count] = [v];
	inst->live_out_count = inst->live_out_count + 1;
};

x64inst_finalise_live_out : func(inst : x64inst mut? -> v0)
{
	old ::= inst->live_out;
	i : u64 mut;
	inst->live_out = arena_alloc(global_arena, inst->live_out_cap * sizeof typeof([inst->live_out]));
	for(i = 0; i < inst->live_out_count; i = i + 1)
	{
		[inst->live_out # i] = [old # i];
	}
};

