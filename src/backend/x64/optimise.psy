optimise_x64func : func(fn : irfunc mut?, fnx64 : x64func mut? -> v0)
{
	if(prog.opt@s64 <= program_optimisation.O0@s64)
	{
		return;
	}
	t ::= nanotime();

	x64_position_start_func(fn->idx);
	i : u64 mut := 0;
	while(i < fnx64->insts_count)
	{
		x64_position_before_inst(i);
		if(x64_optimise_current_inst_is_noop())
		{
			x64_delete_instruction();
		}
		x64_insert_plusminus1_with_incdec(x64_current_instruction());
		x64_replace_movzero_with_xor(x64_current_instruction());
		i = i + 1;
	}

	compile_timings.optimise_asm = compile_timings.optimise_asm + (nanotime() - t);
};

x64_optimise_current_inst_is_noop : func(-> bool)
{
	inst ::= x64_current_instruction();
	if((inst->tag == x64inst_tag.mov) || (inst->tag == x64inst_tag.movsd) || (inst->tag == x64inst_tag.movss))
	{
		return x64val_equal_to(inst->operands # 0, inst->operands # 1);
	}
	return false;
};

x64_insert_plusminus1_with_incdec : func(inst : x64inst mut? -> v0)
{
	op1 ::= inst->operands # 1;
	if((op1->tag == x64val_tag.imm) && ([x64val_imm_get_value(op1)] == 1))
	{
		if((inst->tag == x64inst_tag.add))
		{
			op1->tag = x64val_tag.invalid;
			inst->tag = x64inst_tag.inc;
		}
		if((inst->tag == x64inst_tag.sub))
		{
			op1->tag = x64val_tag.invalid;
			inst->tag = x64inst_tag.dec;
		}
	}
};

x64_replace_movzero_with_xor : func(inst : x64inst mut? -> v0)
{
	if(inst->tag == x64inst_tag.mov)
	{
		op0 ::= inst->operands # 0;
		op1 ::= inst->operands # 1;
		if((op0->tag == x64val_tag.reg) && (op1->tag == x64val_tag.imm) && ([x64val_imm_get_value(op1)] == 0))
		{
			// mov X, immN 0
			// => xor X, X
			inst->tag = x64inst_tag.xor;
			[op1] = [op0];
		}
	}
};
