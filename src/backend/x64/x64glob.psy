x64glob_tag : enum
{
	// readonly data aka 'rodata'
	.readonly := 0;
	// mutable (read + write) data 'data'
	.mutable := 1;
	// mutable (read + write) data (zeroed) aka 'bss'
	.mutablezero := 2;
};

x64glob : struct
{
	tag : x64glob_tag;
	size : u64;
	init_data : u8 mut? weak;
	init_data_size : u64;
	// whether we should assume init_data could be written to during a legalisation pass (if for example we have relocations in the data)
	data_finalised : bool;
};
