x64_mov : func(dst : x64val mut?, src : x64val mut? -> v0)
{
	inst : x64inst mut := zero;
	inst.tag = x64inst_tag.mov;
	x64inst_add_operand(ref inst, dst);
	x64inst_add_operand(ref inst, src);
	x64_add_instruction(ref inst);
};
x64_push : func(op : x64val mut? -> v0)
{
	inst : x64inst mut := zero;
	inst.tag = x64inst_tag.push;
	x64inst_add_operand(ref inst, op);
	x64_add_instruction(ref inst);
};

x64_ret : func(-> v0)
{
	inst : x64inst mut := zero;
	inst.tag = x64inst_tag.ret;
	x64_add_instruction(ref inst);
};
