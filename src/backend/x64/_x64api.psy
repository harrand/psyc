x64api_t : struct
{
	prog : x64prog;
	funcpos : u64;
	instpos : u64;
};

x64api ::= x64api_t mut
{
	.prog := zero;
	.funcpos := zero;
	.instpos := zero;
};

x64_add_func : func(out : x64val mut? -> x64func mut?)
{
	fn : x64func mut;
	fn.insts = zero;
	fn.insts_count = 0;
	fn.insts_cap = 0;
	fn.enc_byte_offset_begin = ~0;

	idx ::= x64prog_add_func(ref(x64api.prog), ref fn);
	out->tag = x64val_tag.fnref;
	[x64val_fnref_get_index(out)] = idx;

	x64api.funcpos = idx;
	x64api.instpos = 0;
	return x64api.prog.funcs # idx;
};

x64_add_glob : func(out : x64val mut?, g : x64glob mut?, memory_size : u64 -> v0)
{
	idx ::= x64prog_add_glob(ref(x64api.prog), g);
	out->tag = x64val_tag.globref;
	[x64val_globref_get_index(out)] = idx;
	[x64val_globref_get_size(out)] = memory_size;
	[x64val_globref_get_displacement(out)] = 0;
};

x64_add_glob_no_memsize : func(out : x64val mut?, g : x64glob mut? -> v0)
{
	x64_add_glob(out, g, 64);
};

// if a readonly global exists with an exact copy of the provided data, set 'out' to reference that global and return true. if no such global exists, return false
x64_find_const_glob_matching_bytes : func(data : u8?, data_count : u64, out : x64val mut? -> bool)
{
	i : u64 mut;
	j : u64 mut;
	count ::= x64api.prog.globs_count;
	for(i = 0; i < count; i = i + 1)
	{
		cur_glob ::= x64api.prog.globs # i;
		if((cur_glob->data_finalised) && (cur_glob->tag == x64glob_tag.readonly))
		{
			if(cur_glob->init_data_size == data_count)
			{
				for(j = 0; j < data_count; j = j + 1)
				{
					all_match : bool mut := true;
					if([cur_glob->init_data # j] != [data # j])
					{
						all_match = false;
					}
					if(all_match)
					{
						out->tag = x64val_tag.globref;
						[x64val_globref_get_index(out)] = i;
						[x64val_globref_get_displacement(out)] = 0;
						return true;
					}
				}
			}
		}
	}
	return false;
};

x64_set_entrypoint : func(fnref : x64val mut? -> v0)
{
	x64api.prog.entrypoint_func_index = [x64val_fnref_get_index(fnref)];
};

x64_current_func_index : func(-> u64)
{
	return x64api.funcpos;
};

x64_current_func : func(-> x64func mut?)
{
	return x64api.prog.funcs # x64api.funcpos;
};

x64_get_position : func(-> u64)
{
	return x64api.instpos;
};

x64_position_before_inst : func(inst_id : u64 -> v0)
{
	x64api.instpos = inst_id;
};

x64_position_after_inst : func(inst_id : u64 -> v0)
{
	x64api.instpos = inst_id + 1;
};

x64_position_start_func : func(func_index : u64 -> v0)
{
	x64api.funcpos = func_index;
	x64api.instpos = 0;
};

x64_add_instruction : func(inst : x64inst mut? -> v0)
{
	fn ::= x64_current_func();
	x64func_add_inst_at(fn, inst, x64api.instpos);
};

x64_delete_instruction : func(-> v0)
{
	fn ::= x64_current_func();
	cpydst ::= fn->insts # x64api.instpos;
	count ::= fn->insts_count - (x64api.instpos + 1);
	memcopy(cpydst, cpydst # 1, sizeof x64inst * count);
	fn->insts_count = fn->insts_count - 1;
	if(x64api.instpos > 0)
	{
		x64api.instpos = x64api.instpos - 1;
	}
};

x64_current_instruction : func(-> x64inst mut?)
{
	return x64_current_func()->insts # x64api.instpos;
};

x64val_imm_as_globref : func(imm : x64val mut?, out : x64val mut? -> v0)
{
	if(imm->tag != x64val_tag.imm)
	{
		[out] = [imm];
		return;
	}
	// create some global data containing an immediate value, and turn 'out' into a globref referencing that data
	bytes ::= x64val_imm_get_value(imm)@u8?;
	bytes_count ::= [x64val_imm_get_size(imm)];
	if(x64_find_const_glob_matching_bytes(bytes, bytes_count, out))
	{
		[x64val_globref_get_size(out)] = bytes_count;
		return;
	}
	// didnt find such a thing. create the glob.
	newglob : x64glob mut;
	newglob.tag = x64glob_tag.readonly;
	newglob.size = bytes_count;
	newglob.init_data = arena_alloc(global_arena, bytes_count);
	memcopy(newglob.init_data, bytes, bytes_count);
	newglob.init_data_size = bytes_count;
	newglob.data_finalised = true;
	x64_add_glob(out, ref newglob, bytes_count);
};

x64_dump : func(-> v0)
{
	x64prog_dump(ref x64api.prog);
};
