alignment_padding_req : func(input :  u64, align : u64 -> u64)
{
	return (-input) & (align - 1);
};

align_up : func(input : u64, align : u64 -> u64)
{
	return input + alignment_padding_req(input, align);
};

align_up_pagesize : func(input : u64 -> u64)
{
	return align_up(input, 0x1000);
};

elf_data : struct
{
	base_vaddr : u64;
	code : u8?;
	code_len : u64;
	entrypoint : u64;

	rodata : u8?;
	rodata_len : u64;
	data : u8?;
	data_len : u64;
	bss_len : u64;

	progsrc : x64prog mut?;
	include_function_names : bool;
};

elf_encode_to : func(w : bwriter mut?, e : elf_data mut? -> v0)
{
	elf_magic : u64 := 0x464c457f;
	elf_ident_type_little_endian : u64 := 1;
	elf_ident_type_big_endian : u64 := 1;
	elf_ident_32_bit : u64 := 1;
	elf_ident_64_bit : u64 := 2;
	elf_hdr_size : u64 := 64;

	elf_type_relocatable : u64 := 1;
	elf_type_executable : u64 := 2;
	elf_type_shared : u64 := 3;
	elf_type_core : u64 := 4;

	elf_instruction_set_x86 : u64 := 0x03;
	elf_instruction_set_x64 : u64 := 0x3e;
	elf_instruction_set_arm32 : u64 := 0x28;
	elf_instruction_set_arm64 : u64 := 0xb7;

	// note: 0 is sysv, but i explicitly dont want to use that because people will think it contains SYSV code
	// so i am unofficially designating the below number to represent psy64.
	elf_osabi_psy64 : u64 := 0;

	page_size : u64 := 0x1000;
	// elf header
	bwrite32(w, elf_magic);
	bwrite8(w, elf_ident_64_bit);
	bwrite8(w, elf_ident_type_little_endian);
	bwrite8(w, 1);
	bwrite8(w, elf_osabi_psy64);
	bwrite8(w, 0);

	bwrite8(w, 0);
	bwrite8(w, 0);
	bwrite8(w, 0);
	bwrite8(w, 0);
	bwrite8(w, 0);
	bwrite8(w, 0);
	bwrite8(w, 0);
	i : u64 mut;
	// calculate section sizes

	// 3 program headers (rodata, data + bss, code)
	proghdr_count : u64 := 3;
	proghdr_size : u64 := 56; // always 56 bytes each
	// byte offset from start of elf to code segment
	rodata_segment_begin ::= align_up_pagesize(elf_hdr_size + (proghdr_count * proghdr_size));
	data_and_bss_segment_begin ::= align_up_pagesize(rodata_segment_begin + e->rodata_len);
	code_segment_begin ::= align_up_pagesize(data_and_bss_segment_begin + e->data_len + e->bss_len);
	// entrypoint vaddr
	rodata_begin_addr ::= align_up(e->base_vaddr + rodata_segment_begin, page_size);
	data_and_bss_begin_addr ::= align_up(e->base_vaddr + data_and_bss_segment_begin, page_size);
	code_begin_addr ::= align_up(e->base_vaddr + code_segment_begin, page_size);

	sechdr_count : u16 mut := 0;
	sechdr_size : u64 := 64;
	if(e->include_function_names)
	{
		// nullheader, strtab, symtab, text and shstrtab
		sechdr_count = 5;
	}
	// rest of elf header
	bwrite16(w, elf_type_executable);
	bwrite16(w, elf_instruction_set_x64);
	bwrite32(w, 1);
	bwrite64(w, code_begin_addr + e->entrypoint);
	bwrite64(w, 64); // program header offset bytes
	sechdr_offset_offset : u64 mut := w->cursor;
	bwrite64(w, zero); // section header offset in bytes
	bwrite32(w, 0); // flags
	bwrite16(w, elf_hdr_size);
	bwrite16(w, proghdr_size);
	bwrite16(w, proghdr_count);
	bwrite16(w, sechdr_size); // section header table entry size bytes
	bwrite16(w, sechdr_count); // number of section header table entries
	bwrite16(w, 4); // section header table index associated with the section name string table

	// program headers
	PF_X : u64 := 0x1;
	PF_W : u64 := 0x2;
	PF_R : u64 := 0x4;
	PT_NULL : u64 := 0;
	PT_LOAD : u64 := 1;
	PT_DYNAMIC : u64 := 2;
	PT_INTERP : u64 := 3;
	PT_NOTE : u64 := 4;
	PT_SHLIB : u64 := 5;
	PT_PHDR : u64 := 6;
	PT_TLS : u64 := 7;
	// rodata
	bwrite32(w, PT_LOAD);
	bwrite32(w, PF_R);
	bwrite64(w, rodata_segment_begin);
	bwrite64(w, rodata_begin_addr);
	bwrite64(w, rodata_begin_addr);
	bwrite64(w, e->rodata_len);
	bwrite64(w, e->rodata_len);
	bwrite64(w, page_size);
	// data + bss
	bwrite32(w, PT_LOAD);
	bwrite32(w, PF_W | PF_R);
	bwrite64(w, data_and_bss_segment_begin);
	bwrite64(w, data_and_bss_begin_addr);
	bwrite64(w, data_and_bss_begin_addr);
	bwrite64(w, e->data_len);
	bwrite64(w, e->data_len + e->bss_len);
	bwrite64(w, page_size);
	// code
	bwrite32(w, PT_LOAD);
	bwrite32(w, PF_X | PF_R);
	bwrite64(w, code_segment_begin);
	bwrite64(w, code_begin_addr);
	bwrite64(w, code_begin_addr);
	bwrite64(w, e->code_len); // p_filesz (code)
	bwrite64(w, e->code_len); // p_memsz (code)
	bwrite64(w, page_size);

	// write rodata
	while(alignment_padding_req(w->cursor, page_size) != 0)
	{
		bwrite8(w, 0);
	}
	if(rodata_segment_begin != w->cursor)
	{
		panic_begin();
		putzstr("rodata_segment_begin seems to be off\0");
		panic_end();
	}
	bwrite_bytes(w, e->rodata, e->rodata_len);

	// write data+bss
	while(alignment_padding_req(w->cursor, page_size) != 0)
	{
		bwrite8(w, 0);
	}
	if(data_and_bss_segment_begin != w->cursor)
	{
		panic_begin();
		putzstr("data_and_bss_segment_begin seems to be off\0");
		panic_end();
	}
	bwrite_bytes(w, e->data, e->data_len);
	// note: writing bss out like this really shouldnt be necessary and completely defeats the point
	for(i = 0; i < e->bss_len; i = i + 1)
	{
		bwrite8(w, 0);
	}
	while(alignment_padding_req(w->cursor, page_size) != 0)
	{
		bwrite8(w, 0);
	}

	// code
	if(code_segment_begin != w->cursor)
	{
		panic_begin();
		putzstr("code_segment_begin seems to be off\0");
		panic_end();
	}
	bwrite_bytes(w, e->code, e->code_len);

	if(e->include_function_names)
	{
		// section header table starts here.
		while(alignment_padding_req(w->cursor, page_size) != 0)
		{
			bwrite8(w, 0);
		}
		[(w->buf # sechdr_offset_offset)@u64 mut?] = w->cursor;
		// null header (???)
		bwrite32(w, zero); // index into section header string table, location of a nultermd string (which we dont currently have)
		bwrite32(w, 0); // SH_SYMTAB
		bwrite64(w, 0); // flags (no runtime behaviour)
		bwrite64(w, 0); // no virtual address (no runtime behaviour)
		bwrite64(w, 0);
		bwrite64(w, 0);
		bwrite32(w, 0); // sh_link (which section am i associated with? well thats strtab which is section index 1)
		bwrite32(w, 0); // sh_info?
		bwrite64(w, 0); // sh_addralign (apparantly its 8 for symtab)
		bwrite64(w, 0); // sh_entsize (apparantly its 24 for symtab)


		// symtab header
		symtab_name_offset : u64 mut := w->cursor;
		bwrite32(w, zero); // index into section header string table, location of a nultermd string (which we dont currently have)
		bwrite32(w, 2); // SH_SYMTAB
		bwrite64(w, 0); // flags (no runtime behaviour)
		bwrite64(w, 0); // no virtual address (no runtime behaviour)
		symtab_begin_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		symtab_size_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		bwrite32(w, 2); // sh_link (which section am i associated with? well thats strtab which is section index 2)
		symtab_entrycount_offset : u64 mut := w->cursor;
		bwrite32(w, 0); // sh_info?
		bwrite64(w, 8); // sh_addralign (apparantly its 8 for symtab)
		bwrite64(w, 24); // sh_entsize (apparantly its 24 for symtab)
		
		// strtab header
		strtab_name_offset : u64 mut := w->cursor;
		bwrite32(w, zero); // index into section header string table, location of a nultermd string (which we dont currently have)
		bwrite32(w, 3); // SH_STRTAB
		bwrite64(w, 0); // flags (no runtime behaviour)
		bwrite64(w, 0); // no virtual address (no runtime behaviour)
		strtab_begin_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		strtab_size_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		bwrite32(w, 0); // sh_link (which section am i associated with? nobody)
		bwrite32(w, 0); // sh_info?
		bwrite64(w, 1); // sh_addralign (strtab contains chars so align 1)
		bwrite64(w, 0); // sh_entsize (variable-length so 0)

		// text header
		text_name_offset : u64 mut := w->cursor;
		bwrite32(w, zero); // index into section header string table, location of a nultermd string (which we dont currently have)
		bwrite32(w, 1); // SH_PROGBITS
		bwrite64(w, 0x2 | 0x4); // flags (SHF_ALLOC | SHF_EXECINSTR)
		bwrite64(w, code_begin_addr); // associated with the code vaddr
		bwrite64(w, code_segment_begin);
		bwrite64(w, e->code_len);
		bwrite32(w, 0); // sh_link (not associated with any other section)
		bwrite32(w, 0); // sh_info?
		bwrite64(w, page_size); // sh_addralign (page aligned)
		bwrite64(w, 0); // sh_entsize (apparantly its 24 for symtab)

		// shstrtab header
		shstrtab_name_offset : u64 mut := w->cursor;
		bwrite32(w, zero); // index into section header string table, location of a nultermd string (which we dont currently have)
		bwrite32(w, 3); // SH_STRTAB (again)
		bwrite64(w, 0); // flags (no runtime behaviour)
		bwrite64(w, 0); // no virtual address (no runtime behaviour)
		shstrtab_begin_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		shstrtab_size_offset : u64 mut := w->cursor;
		bwrite64(w, 0);
		bwrite32(w, 0); // sh_link (which section am i associated with? well thats strtab which is section index 1)
		bwrite32(w, 0); // sh_info?
		bwrite64(w, 1); // sh_addralign (apparantly its 8 for symtab)
		bwrite64(w, 0); // sh_entsize (apparantly its 24 for symtab)
		
		// symtab begins here
		//typedef struct {
			//Elf64_Word      st_name;
			//unsigned char   st_info;
			//unsigned char   st_other;
			//Elf64_Half      st_shndx;
			//Elf64_Addr      st_value;
			//Elf64_Xword     st_size;
		//} Elf64_Sym;
		[(w->buf # symtab_begin_offset)@u64 mut?] = w->cursor;
		symtab_begin ::= w->cursor;
		// cumulative_name_offset starts at 0 (and is used to represent the offset into strtab)
		cumulative_name_offset : u64 mut := 1;
		name_count : u64 mut := 1;
		fnx64 : x64func mut? mut;

		// write a single null symbol
		bwrite32(w, 0);
		bwrite8(w, 0);
		bwrite8(w, 0);
		bwrite16(w, 0);
		bwrite64(w, 0);
		bwrite64(w, 0);
		for(i = 0; i < e->progsrc->funcs_count; i = i + 1)
		{
			fnx64 = e->progsrc->funcs # i;
			if(fnx64->custom_name != zero)
			{
				// write Elf64_Sym
				bwrite32(w, cumulative_name_offset);
				bwrite8(w, 0b000000010); // st_info?
				bwrite8(w, 0); // st_other?
				bwrite16(w, 3); // st_shndx? (SHN_ABS == 65521 apparantly)
				fn_vaddr ::= e->base_vaddr + page_size + align_up_pagesize(e->rodata_len) + align_up_pagesize(e->data_len) + align_up_pagesize(e->bss_len) + fnx64->enc_byte_offset_begin;
				bwrite64(w, fn_vaddr);
				fn_bytesize : u64 mut;
				if(i == (e->progsrc->funcs_count - 1))
				{
					// if its the last function in the program, then it's between the vaddr start and the code_len
					fn_bytesize = e->code_len - fnx64->enc_byte_offset_begin;
				}
				else
				{
					// otherwise, its the distance between the start of this function and the next.
					fn_bytesize = ((e->progsrc->funcs # (i + 1))->enc_byte_offset_begin) - fnx64->enc_byte_offset_begin;
				}
				bwrite64(w, fn_bytesize);
				// make it null-terminated.
				cumulative_name_offset = cumulative_name_offset + fnx64->custom_name_len + 1;
				name_count = name_count + 1;
			}
		}
		[(w->buf # symtab_entrycount_offset)@u64 mut?] = name_count;
		[(w->buf # symtab_size_offset)@u64 mut?] = w->cursor - symtab_begin;

		strtab_begin ::= w->cursor;
		[(w->buf # strtab_begin_offset)@u64 mut?] = w->cursor;
		// random preceding null byte for some dumbass reason (its fine to delete it)
		bwrite8(w, 0);
		for(i = 0; i < e->progsrc->funcs_count; i = i + 1)
		{
			fnx64 = e->progsrc->funcs # i;
			bwrite_bytes(w, fnx64->custom_name, fnx64->custom_name_len);
			bwrite8(w, 0);
		}
		[(w->buf # strtab_size_offset)@u64 mut?] = w->cursor - strtab_begin;
		
		shstrtab_begin ::= w->cursor;
		[(w->buf # shstrtab_begin_offset)@u64 mut?] = w->cursor;
		bwrite8(w, 0);
		[(w->buf # shstrtab_name_offset)@u32 mut?] = (w->cursor - shstrtab_begin)@_;
		bwrite_zstr(w, ".shstrtab\0");
		bwrite8(w, 0);
		[(w->buf # symtab_name_offset)@u32 mut?] = (w->cursor - shstrtab_begin)@_;
		bwrite_zstr(w, ".symtab\0");
		bwrite8(w, 0);
		[(w->buf # strtab_name_offset)@u32 mut?] = (w->cursor - shstrtab_begin)@_;
		bwrite_zstr(w, ".strtab\0");
		bwrite8(w, 0);
		[(w->buf # text_name_offset)@u32 mut?] = (w->cursor - shstrtab_begin)@_;
		bwrite_zstr(w, ".text\0");
		bwrite8(w, 0);
		[(w->buf # shstrtab_size_offset)@u64 mut?] = (w->cursor - shstrtab_begin)@_;
	}
};
